[{"data":1,"prerenderedAt":202},["ShallowReactive",2],{"notes-latest-1":3,"post:\u002Fposts\u002Fmicro\u002Fgateway-auth-6":27,"surround:\u002Fposts\u002Fmicro\u002Fgateway-auth-6":130,"notes-latest-3":137},[4],{"id":5,"title":6,"body":7,"createdAt":19,"description":13,"extension":20,"meta":21,"navigation":22,"path":23,"seo":24,"stem":25,"__hash__":26},"notes\u002Fnotes\u002F2026-11-14-1-2.md","2026 11 14 1 2",{"type":8,"value":9,"toc":14},"minimark",[10],[11,12,13],"p",{},"站点上线了「随笔」：支持一个文件多个随笔",{"title":15,"searchDepth":16,"depth":17,"links":18},"",2,3,[],"2026-11-17","md",{},true,"\u002Fnotes\u002F2026-11-14-1-2",{"description":13},"notes\u002F2026-11-14-1-2","hDP9fvaunHzVrZQ6QifuOtj9VrqbxlPb_52KE5wSjD0",{"id":28,"title":29,"author":30,"body":31,"categories":110,"comment":22,"cover":30,"createdAt":112,"description":35,"draft":113,"extension":20,"meta":114,"navigation":22,"path":119,"readingTime":120,"recommend":113,"seo":121,"series":30,"stem":122,"tags":123,"top":113,"topics":126,"updatedAt":30,"words":128,"__hash__":129},"posts\u002Fposts\u002Fmicro\u002Fgateway-auth-6.md","网关层统一鉴权的设计（六）",null,{"type":8,"value":32,"toc":102},[33,36,40,43,46,49,52,55,58,61,64,67,70,73,76,78,81,84,87,90,93,96,99],[11,34,35],{},"又是拖了很久才动笔的一篇，草稿箱里躺了快一个月，趁周末把思路理一理，一次写完。",[37,38,39],"h2",{"id":39},"为什么收口到网关",[11,41,42],{},"鉴权收口到网关的价值是少写重复代码：登录态校验、token 解析、权限初筛这些横切逻辑，每个服务写一遍既冗余又容易漏。网关统一验证签名和 token，把用户身份放进请求头透传给下游，服务层只关心业务级的细粒度权限，两层职责分明。",[11,44,45],{},"设计时几个注意点：透传的身份头必须只信任网关注入的，外部伪造同名头要在网关层清掉，这是安全上的大事；鉴权失败的响应格式全局统一，前端好处理；白名单机制要显式管理，避免为了图省事把路径越加越宽。",[37,47,48],{"id":48},"性能与灰度",[11,50,51],{},"性能上网关是全量流量的入口，鉴权逻辑要保持轻：token 校验用本地公钥验签而不是每次查库，必要时加短 TTL 缓存；规则数量大了之后考虑编译成正则或者规则引擎，避免长 if 链。改动发布要走灰度，鉴权是全量组件，一个规则写错就是全站故障，我的习惯是新规则先在影子模式跑几天，只记录不生效，确认无误再切正式。",[37,53,54],{"id":54},"过程中的两个坑",[11,56,57],{},"顺手记一个这阵子碰到的问题：服务 CPU 突然打满，top -H 找到罪魁线程，jstack 里转十六进制一查，是个正则在长文本上回溯。改成预编译加上入参长度限制之后就好了，正则这个东西真是不能随手写。",[11,59,60],{},"还有一次排查 OOM，堆内存看着没超，最后发现是元空间爆了，某个框架在运行时动态生成类。加了 -XX:MaxMetaspaceSize 先兜底，再定位到生成源头关掉，内存曲线立刻平了。",[11,62,63],{},"一条 SQL 索引明明在，但执行计划就是不走，折腾半天发现是字段上包了层函数。把函数挪到参数那边改写之后，从八秒降到八十毫秒，这种问题每次遇到都痛恨自己一开始没看执行计划。",[37,65,66],{"id":66},"延伸几句",[11,68,69],{},"分布式链路上的每个环节都有失败概率，链路越长整体成功率越低，这是乘法。所以能合并的调用合并，能并行的不串行，能缓存的缓存。链路的长度就是系统的脆弱程度，设计时对调用深度保持敬畏。",[11,71,72],{},"观测能力在分布式系统里不是锦上添花，是基础设施。日志、指标、链路追踪三件套齐了，问题定位是做阅读理解；缺了，就是通灵。新服务接入的第一天就把观测配齐，比事后补课便宜十倍。",[11,74,75],{},"微服务这些年在业界的口碑经历了过山车，从万物皆可拆到反思拆得过细。我的体会是拆分粒度跟着团队和业务走：一个三人团队维护三十个服务，运维成本会吃掉所有架构收益。服务边界清晰比数量重要，能合并的别硬拆。",[11,77,69],{},[37,79,80],{"id":80},"又想到一些",[11,82,83],{},"再补充一个角度：做这些事情的时候，工具的顺滑度影响巨大。同样的活，称手的工具能让摩擦力小一半，这种差异日积月累就是人和人的差距。定期审视自己的工具链，删掉碍事的，补上趁手的，值得当成一个固定动作。",[11,85,86],{},"由这件事联想到阅读习惯：资料要看一手来源，译文和二手转述经常带着传播者的理解偏差，偏差叠几层之后和原意面目全非。多花十分钟读原文，省下的是未来几小时的排查，这笔账怎么算都划算。",[11,88,89],{},"还有个感受越来越深：知识落地成文字的过程本身就是学习的一部分。很多自以为想清楚的东西，写出来才发现逻辑有洞。写作是最好的检验，这也是坚持写博客这么多年的理由之一，写不出来的就是还没学会的。",[11,91,92],{},"过程中也反复体会到取舍的本质：没有完美的方案，只有当下约束下最合适的方案。把约束写清楚，方案的选择题就变成了证明题，这也是为什么我习惯先列约束再谈方案，顺序反了全是无效争论。",[37,94,95],{"id":95},"写在最后",[11,97,98],{},"泡的茶忘了喝，回过神已经凉透了，进入状态的时候对时间的感知就剩这点不好。",[11,100,101],{},"暂时记到这，下次接着说。",{"title":15,"searchDepth":16,"depth":17,"links":103},[104,105,106,107,108,109],{"id":39,"depth":16,"text":39},{"id":48,"depth":16,"text":48},{"id":54,"depth":16,"text":54},{"id":66,"depth":16,"text":66},{"id":80,"depth":16,"text":80},{"id":95,"depth":16,"text":95},[111],"微服务","2024-07-13",false,{"excerpt":115},{"type":8,"value":116},[117],[11,118,35],{},"\u002Fposts\u002Fmicro\u002Fgateway-auth-6",392100,{"title":29,"description":35},"posts\u002Fmicro\u002Fgateway-auth-6",[124,125],"网关","鉴权",[127],"micro",1307,"qWCBY_MNJr8UBvY1wx2XyPbo5aXX0bqqmVT__luCuTM",{"prev":131,"next":134},{"path":132,"title":133},"\u002Fposts\u002Fmicro\u002Fgateway-auth-5","网关层统一鉴权的设计（五）",{"path":135,"title":136},"\u002Fposts\u002Fmicro\u002Frate-limit","限流算法的选择与落地",[138,147,177],{"id":5,"title":6,"body":139,"createdAt":19,"description":13,"extension":20,"meta":145,"navigation":22,"path":23,"seo":146,"stem":25,"__hash__":26},{"type":8,"value":140,"toc":143},[141],[11,142,13],{},{"title":15,"searchDepth":16,"depth":17,"links":144},[],{},{"description":13},{"id":148,"title":149,"body":150,"createdAt":170,"description":171,"extension":20,"meta":172,"navigation":22,"path":173,"seo":174,"stem":175,"__hash__":176},"notes\u002Fnotes\u002F2026-11-14-1.md","2026 11 14 1",{"type":8,"value":151,"toc":168},[152],[11,153,154,155,159,160,167],{},"站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 ",[156,157,158],"strong",{},"Markdown","，写链接也不用到编辑器：",[161,162,166],"a",{"href":163,"rel":164},"https:\u002F\u002Fcontent.nuxt.com",[165],"nofollow","Nuxt Content","。",{"title":15,"searchDepth":16,"depth":17,"links":169},[],"2026-11-14","站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 Markdown，写链接也不用到编辑器：Nuxt Content。",{},"\u002Fnotes\u002F2026-11-14-1",{"description":171},"notes\u002F2026-11-14-1","LLJX_RKU7cgpT6aHw4DZWUZNQ_G_UzELWPKbksJvzfs",{"id":178,"title":179,"body":180,"createdAt":195,"description":196,"extension":20,"meta":197,"navigation":22,"path":198,"seo":199,"stem":200,"__hash__":201},"notes\u002Fnotes\u002F2026-11-14-2.md","2026 11 14 2",{"type":8,"value":181,"toc":193},[182],[11,183,184,188,189,192],{},[185,186,187],"code",{},"readPixels"," 读不到内容不是 bug，是 ",[185,190,191],{},"preserveDrawingBuffer"," 默认关闭——帧提交后缓冲即被清空。",{"title":15,"searchDepth":16,"depth":17,"links":194},[],"2026-11-13","readPixels 读不到内容不是 bug，是 preserveDrawingBuffer 默认关闭——帧提交后缓冲即被清空。",{},"\u002Fnotes\u002F2026-11-14-2",{"description":196},"notes\u002F2026-11-14-2","i7xWqq2eNoU_seSbLQjqlB9gE51fM-PVLUEYCHBkOA4",1795309548194]