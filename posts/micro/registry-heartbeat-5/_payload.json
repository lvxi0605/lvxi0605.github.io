[{"data":1,"prerenderedAt":205},["ShallowReactive",2],{"notes-latest-1":3,"post:\u002Fposts\u002Fmicro\u002Fregistry-heartbeat-5":27,"surround:\u002Fposts\u002Fmicro\u002Fregistry-heartbeat-5":133,"notes-latest-3":140},[4],{"id":5,"title":6,"body":7,"createdAt":19,"description":13,"extension":20,"meta":21,"navigation":22,"path":23,"seo":24,"stem":25,"__hash__":26},"notes\u002Fnotes\u002F2026-11-14-1-2.md","2026 11 14 1 2",{"type":8,"value":9,"toc":14},"minimark",[10],[11,12,13],"p",{},"站点上线了「随笔」：支持一个文件多个随笔",{"title":15,"searchDepth":16,"depth":17,"links":18},"",2,3,[],"2026-11-17","md",{},true,"\u002Fnotes\u002F2026-11-14-1-2",{"description":13},"notes\u002F2026-11-14-1-2","hDP9fvaunHzVrZQ6QifuOtj9VrqbxlPb_52KE5wSjD0",{"id":28,"title":29,"author":30,"body":31,"categories":113,"comment":22,"cover":30,"createdAt":115,"description":35,"draft":116,"extension":20,"meta":117,"navigation":22,"path":122,"readingTime":123,"recommend":116,"seo":124,"series":30,"stem":125,"tags":126,"top":116,"topics":129,"updatedAt":30,"words":131,"__hash__":132},"posts\u002Fposts\u002Fmicro\u002Fregistry-heartbeat-5.md","注册中心与心跳机制的工作方式（五）",null,{"type":8,"value":32,"toc":105},[33,36,40,43,46,50,53,56,59,62,65,68,71,74,77,79,81,84,87,90,93,96,99,102],[11,34,35],{},"写技术文章对我来说主要是个复盘的过程，写不清楚的地方往往就是还没想清楚的地方。",[37,38,39],"h2",{"id":39},"基本原理",[11,41,42],{},"服务发现解决的问题是：调用方怎么知道目标实例在哪。服务启动时把自己注册到注册中心，调用方从注册中心拉取可用实例列表。注册中心还有一个持续的任务是判断实例死活，靠的就是心跳：客户端定期上报，超过时限没收到就标记异常，再等一段时间仍无心跳就摘除。",[11,44,45],{},"摘除策略的设计很讲究，太灵敏会造成网络抖动时大批实例被误摘，流量全压到剩下的实例上引发连锁故障；太迟钝又会让真实挂掉的实例继续接流量。所以成熟的实现都加了保护阈值，不健康实例比例超过设定值时暂时不摘除，宁可保守一点。",[37,47,49],{"id":48},"ap-还是-cp","AP 还是 CP",[11,51,52],{},"选型时还有一个经典问题：注册中心要 AP 还是 CP。Eureka 走 AP，牺牲一致性保可用，网络分区时大家各持旧列表照样工作；ZooKeeper 走 CP，分区期间可能拒绝服务；Nacos 支持两种模式按场景切换。业务服务发现多数时候 AP 更合理，实例列表短暂不一致的代价远小于不可用的代价。理解这个取舍，比背各个产品的特性表更有用。",[37,54,55],{"id":55},"顺手记两个坑",[11,57,58],{},"Kafka 某个分区消费延迟特别高，看数据发现某大客户的消息占了总量一半，按 userId 分区全进了一个分区。大客户单独走一个 topic 才解决，倾斜问题在哪个中间件里都一样。",[11,60,61],{},"WebSocket 上线之后频繁断连，本地好好的，一上 Nginx 就出问题。代理默认不转发 Upgrade 头，补上之后世界清净了，这类中间件默认行为，不踩一次真的想不到。",[11,63,64],{},"发版之后用户还在用旧页面，报接口不存在的错。index.html 被强缓存了，给 HTML 加 no-cache、静态资源带 hash 长缓存，这是前端部署的标配，后端出身的我当年是真不知道。",[37,66,67],{"id":67},"一点延伸",[11,69,70],{},"观测能力在分布式系统里不是锦上添花，是基础设施。日志、指标、链路追踪三件套齐了，问题定位是做阅读理解；缺了，就是通灵。新服务接入的第一天就把观测配齐，比事后补课便宜十倍。",[11,72,73],{},"微服务这些年在业界的口碑经历了过山车，从万物皆可拆到反思拆得过细。我的体会是拆分粒度跟着团队和业务走：一个三人团队维护三十个服务，运维成本会吃掉所有架构收益。服务边界清晰比数量重要，能合并的别硬拆。",[11,75,76],{},"分布式链路上的每个环节都有失败概率，链路越长整体成功率越低，这是乘法。所以能合并的调用合并，能并行的不串行，能缓存的缓存。链路的长度就是系统的脆弱程度，设计时对调用深度保持敬畏。",[11,78,70],{},[11,80,73],{},[37,82,83],{"id":83},"再补充几句",[11,85,86],{},"然后想说，承认不懂是这行的美德。这次遇到不懂的地方，老老实实补了两天的课，比硬着头皮往上糊的方案强太多。不懂装懂的代价从来不会消失，只是延期，还带利息。",[11,88,89],{},"平衡感很重要的一件事：投入和收益的比例。所有优化都值得先问一句，这件事的收益上限是多少，值多少投入。无限打磨一个低价值的东西是工程师最常见的温柔陷阱，包括我自己在内。",[11,91,92],{},"忍不住再夸一下记录的力量，上周刚整理的笔记，这次直接翻出来就用，十分钟解决了当时花一下午的问题。给自己留下的每一份笔记，都是寄给未来的快递，寄件人签收时才觉得真香。",[11,94,95],{},"最后聊点感受：做技术这些年，越来越觉得最好的状态是既投入又抽离。投入是把事情做好，抽离是时不时跳出来看看方向对不对，两者缺一，要么辛苦没产出，要么轻松跑偏路。",[37,97,98],{"id":98},"写在最后",[11,100,101],{},"最近加班多了些，更新慢了一点，周五晚上泡杯茶写下这篇，算是给自己留点节奏。",[11,103,104],{},"就写到这吧，锅里还炖着东西，得去看一眼。",{"title":15,"searchDepth":16,"depth":17,"links":106},[107,108,109,110,111,112],{"id":39,"depth":16,"text":39},{"id":48,"depth":16,"text":49},{"id":55,"depth":16,"text":55},{"id":67,"depth":16,"text":67},{"id":83,"depth":16,"text":83},{"id":98,"depth":16,"text":98},[114],"微服务","2023-07-08",false,{"excerpt":118},{"type":8,"value":119},[120],[11,121,35],{},"\u002Fposts\u002Fmicro\u002Fregistry-heartbeat-5",403200,{"title":29,"description":35},"posts\u002Fmicro\u002Fregistry-heartbeat-5",[127,128],"注册中心","Nacos",[130],"micro",1344,"wJfWb42pFIpe6I2e17n2p5A_wNho90NdJezz34M6aQg",{"prev":134,"next":137},{"path":135,"title":136},"\u002Fposts\u002Fmicro\u002Fregistry-heartbeat-4","注册中心与心跳机制的工作方式（四）",{"path":138,"title":139},"\u002Fposts\u002Fmicro\u002Fregistry-heartbeat-6","注册中心与心跳机制的工作方式（六）",[141,150,180],{"id":5,"title":6,"body":142,"createdAt":19,"description":13,"extension":20,"meta":148,"navigation":22,"path":23,"seo":149,"stem":25,"__hash__":26},{"type":8,"value":143,"toc":146},[144],[11,145,13],{},{"title":15,"searchDepth":16,"depth":17,"links":147},[],{},{"description":13},{"id":151,"title":152,"body":153,"createdAt":173,"description":174,"extension":20,"meta":175,"navigation":22,"path":176,"seo":177,"stem":178,"__hash__":179},"notes\u002Fnotes\u002F2026-11-14-1.md","2026 11 14 1",{"type":8,"value":154,"toc":171},[155],[11,156,157,158,162,163,170],{},"站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 ",[159,160,161],"strong",{},"Markdown","，写链接也不用到编辑器：",[164,165,169],"a",{"href":166,"rel":167},"https:\u002F\u002Fcontent.nuxt.com",[168],"nofollow","Nuxt Content","。",{"title":15,"searchDepth":16,"depth":17,"links":172},[],"2026-11-14","站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 Markdown，写链接也不用到编辑器：Nuxt Content。",{},"\u002Fnotes\u002F2026-11-14-1",{"description":174},"notes\u002F2026-11-14-1","LLJX_RKU7cgpT6aHw4DZWUZNQ_G_UzELWPKbksJvzfs",{"id":181,"title":182,"body":183,"createdAt":198,"description":199,"extension":20,"meta":200,"navigation":22,"path":201,"seo":202,"stem":203,"__hash__":204},"notes\u002Fnotes\u002F2026-11-14-2.md","2026 11 14 2",{"type":8,"value":184,"toc":196},[185],[11,186,187,191,192,195],{},[188,189,190],"code",{},"readPixels"," 读不到内容不是 bug，是 ",[188,193,194],{},"preserveDrawingBuffer"," 默认关闭——帧提交后缓冲即被清空。",{"title":15,"searchDepth":16,"depth":17,"links":197},[],"2026-11-13","readPixels 读不到内容不是 bug，是 preserveDrawingBuffer 默认关闭——帧提交后缓冲即被清空。",{},"\u002Fnotes\u002F2026-11-14-2",{"description":199},"notes\u002F2026-11-14-2","i7xWqq2eNoU_seSbLQjqlB9gE51fM-PVLUEYCHBkOA4",1795274119153]