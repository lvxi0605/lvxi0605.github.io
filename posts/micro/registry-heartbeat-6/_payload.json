[{"data":1,"prerenderedAt":203},["ShallowReactive",2],{"notes-latest-1":3,"post:\u002Fposts\u002Fmicro\u002Fregistry-heartbeat-6":27,"surround:\u002Fposts\u002Fmicro\u002Fregistry-heartbeat-6":131,"notes-latest-3":138},[4],{"id":5,"title":6,"body":7,"createdAt":19,"description":13,"extension":20,"meta":21,"navigation":22,"path":23,"seo":24,"stem":25,"__hash__":26},"notes\u002Fnotes\u002F2026-11-14-1-2.md","2026 11 14 1 2",{"type":8,"value":9,"toc":14},"minimark",[10],[11,12,13],"p",{},"站点上线了「随笔」：支持一个文件多个随笔",{"title":15,"searchDepth":16,"depth":17,"links":18},"",2,3,[],"2026-11-17","md",{},true,"\u002Fnotes\u002F2026-11-14-1-2",{"description":13},"notes\u002F2026-11-14-1-2","hDP9fvaunHzVrZQ6QifuOtj9VrqbxlPb_52KE5wSjD0",{"id":28,"title":29,"author":30,"body":31,"categories":111,"comment":22,"cover":30,"createdAt":113,"description":35,"draft":114,"extension":20,"meta":115,"navigation":22,"path":120,"readingTime":121,"recommend":114,"seo":122,"series":30,"stem":123,"tags":124,"top":114,"topics":127,"updatedAt":30,"words":129,"__hash__":130},"posts\u002Fposts\u002Fmicro\u002Fregistry-heartbeat-6.md","注册中心与心跳机制的工作方式（六）",null,{"type":8,"value":32,"toc":103},[33,36,40,43,46,50,53,56,59,62,65,68,71,74,77,79,82,85,88,91,94,97,100],[11,34,35],{},"这篇整理一下最近在弄的东西，前后拖了些时间，趁记性还在赶紧写下来，免得过阵子细节全忘。",[37,38,39],"h2",{"id":39},"基本原理",[11,41,42],{},"服务发现解决的问题是：调用方怎么知道目标实例在哪。服务启动时把自己注册到注册中心，调用方从注册中心拉取可用实例列表。注册中心还有一个持续的任务是判断实例死活，靠的就是心跳：客户端定期上报，超过时限没收到就标记异常，再等一段时间仍无心跳就摘除。",[11,44,45],{},"摘除策略的设计很讲究，太灵敏会造成网络抖动时大批实例被误摘，流量全压到剩下的实例上引发连锁故障；太迟钝又会让真实挂掉的实例继续接流量。所以成熟的实现都加了保护阈值，不健康实例比例超过设定值时暂时不摘除，宁可保守一点。",[37,47,49],{"id":48},"ap-还是-cp","AP 还是 CP",[11,51,52],{},"选型时还有一个经典问题：注册中心要 AP 还是 CP。Eureka 走 AP，牺牲一致性保可用，网络分区时大家各持旧列表照样工作；ZooKeeper 走 CP，分区期间可能拒绝服务；Nacos 支持两种模式按场景切换。业务服务发现多数时候 AP 更合理，实例列表短暂不一致的代价远小于不可用的代价。理解这个取舍，比背各个产品的特性表更有用。",[37,54,55],{"id":55},"顺手记两个坑",[11,57,58],{},"数据库连接池耗尽告警，顺着栈一看，事务方法里调了个远程接口，慢的时候一占好几秒。把远程调用挪出事务，事务粒度改小，连接池立刻宽松了。事务里只做该做的事。",[11,60,61],{},"crontab 里的脚本手动跑正常、定时跑就报错，环境变量不一致是老坑。把依赖的环境都写进脚本头部，或者干脆用绝对路径，别指望定时任务的运行环境和你的终端一样。",[11,63,64],{},"单元测试月底跑挂了，因为断言里依赖系统当前日期。注入 Clock 之后再测，时间随意控制。第一次遇到这种问题觉得很玄学，理解了之后觉得这是依赖注入最生动的教学案例。",[37,66,67],{"id":67},"一点延伸",[11,69,70],{},"分布式链路上的每个环节都有失败概率，链路越长整体成功率越低，这是乘法。所以能合并的调用合并，能并行的不串行，能缓存的缓存。链路的长度就是系统的脆弱程度，设计时对调用深度保持敬畏。",[11,72,73],{},"观测能力在分布式系统里不是锦上添花，是基础设施。日志、指标、链路追踪三件套齐了，问题定位是做阅读理解；缺了，就是通灵。新服务接入的第一天就把观测配齐，比事后补课便宜十倍。",[11,75,76],{},"微服务这些年在业界的口碑经历了过山车，从万物皆可拆到反思拆得过细。我的体会是拆分粒度跟着团队和业务走：一个三人团队维护三十个服务，运维成本会吃掉所有架构收益。服务边界清晰比数量重要，能合并的别硬拆。",[11,78,70],{},[37,80,81],{"id":81},"再补充几句",[11,83,84],{},"忍不住再夸一下记录的力量，上周刚整理的笔记，这次直接翻出来就用，十分钟解决了当时花一下午的问题。给自己留下的每一份笔记，都是寄给未来的快递，寄件人签收时才觉得真香。",[11,86,87],{},"最后聊点感受：做技术这些年，越来越觉得最好的状态是既投入又抽离。投入是把事情做好，抽离是时不时跳出来看看方向对不对，两者缺一，要么辛苦没产出，要么轻松跑偏路。",[11,89,90],{},"写着写着想到，很多技术选择本质上都是在回答同一个问题：这个方案在出问题的时候是什么样子。不出问题的方案人人都写得出来，区分度全在故障时刻的表现。多想一层失败路径，很多纠结就自动有了答案。",[11,92,93],{},"这类经验在文档里通常只有一行字，背后的排查却是一整个下午。技术工作的大部分时间都花在这些不会写进简历的细节里，所以这些细节才更需要有人写出来，哪怕只是给未来某一天忘了的自己。",[37,95,96],{"id":96},"写在最后",[11,98,99],{},"写完这篇下楼跑了个五公里，脑子里剩下的方案细节，居然是跑步的时候理顺的。",[11,101,102],{},"这篇写得断断续续，总算收尾，下篇见。",{"title":15,"searchDepth":16,"depth":17,"links":104},[105,106,107,108,109,110],{"id":39,"depth":16,"text":39},{"id":48,"depth":16,"text":49},{"id":55,"depth":16,"text":55},{"id":67,"depth":16,"text":67},{"id":81,"depth":16,"text":81},{"id":96,"depth":16,"text":96},[112],"微服务","2022-09-20",false,{"excerpt":116},{"type":8,"value":117},[118],[11,119,35],{},"\u002Fposts\u002Fmicro\u002Fregistry-heartbeat-6",390600,{"title":29,"description":35},"posts\u002Fmicro\u002Fregistry-heartbeat-6",[125,126],"注册中心","Nacos",[128],"micro",1302,"VQvhGp6njaheohgmfkKomsHdFFDaDx2qcWysDVZto3Q",{"prev":132,"next":135},{"path":133,"title":134},"\u002Fposts\u002Fmicro\u002Fregistry-heartbeat-5","注册中心与心跳机制的工作方式（五）",{"path":136,"title":137},"\u002Fposts\u002Fmicro\u002Fseata-mode","分布式事务与 Seata 的使用体会",[139,148,178],{"id":5,"title":6,"body":140,"createdAt":19,"description":13,"extension":20,"meta":146,"navigation":22,"path":23,"seo":147,"stem":25,"__hash__":26},{"type":8,"value":141,"toc":144},[142],[11,143,13],{},{"title":15,"searchDepth":16,"depth":17,"links":145},[],{},{"description":13},{"id":149,"title":150,"body":151,"createdAt":171,"description":172,"extension":20,"meta":173,"navigation":22,"path":174,"seo":175,"stem":176,"__hash__":177},"notes\u002Fnotes\u002F2026-11-14-1.md","2026 11 14 1",{"type":8,"value":152,"toc":169},[153],[11,154,155,156,160,161,168],{},"站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 ",[157,158,159],"strong",{},"Markdown","，写链接也不用到编辑器：",[162,163,167],"a",{"href":164,"rel":165},"https:\u002F\u002Fcontent.nuxt.com",[166],"nofollow","Nuxt Content","。",{"title":15,"searchDepth":16,"depth":17,"links":170},[],"2026-11-14","站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 Markdown，写链接也不用到编辑器：Nuxt Content。",{},"\u002Fnotes\u002F2026-11-14-1",{"description":172},"notes\u002F2026-11-14-1","LLJX_RKU7cgpT6aHw4DZWUZNQ_G_UzELWPKbksJvzfs",{"id":179,"title":180,"body":181,"createdAt":196,"description":197,"extension":20,"meta":198,"navigation":22,"path":199,"seo":200,"stem":201,"__hash__":202},"notes\u002Fnotes\u002F2026-11-14-2.md","2026 11 14 2",{"type":8,"value":182,"toc":194},[183],[11,184,185,189,190,193],{},[186,187,188],"code",{},"readPixels"," 读不到内容不是 bug，是 ",[186,191,192],{},"preserveDrawingBuffer"," 默认关闭——帧提交后缓冲即被清空。",{"title":15,"searchDepth":16,"depth":17,"links":195},[],"2026-11-13","readPixels 读不到内容不是 bug，是 preserveDrawingBuffer 默认关闭——帧提交后缓冲即被清空。",{},"\u002Fnotes\u002F2026-11-14-2",{"description":197},"notes\u002F2026-11-14-2","i7xWqq2eNoU_seSbLQjqlB9gE51fM-PVLUEYCHBkOA4",1795309549038]