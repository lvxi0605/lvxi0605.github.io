[{"data":1,"prerenderedAt":202},["ShallowReactive",2],{"notes-latest-1":3,"post:\u002Fposts\u002Fmicro\u002Fgateway-auth":27,"surround:\u002Fposts\u002Fmicro\u002Fgateway-auth":130,"notes-latest-3":137},[4],{"id":5,"title":6,"body":7,"createdAt":19,"description":13,"extension":20,"meta":21,"navigation":22,"path":23,"seo":24,"stem":25,"__hash__":26},"notes\u002Fnotes\u002F2026-11-14-1-2.md","2026 11 14 1 2",{"type":8,"value":9,"toc":14},"minimark",[10],[11,12,13],"p",{},"站点上线了「随笔」：支持一个文件多个随笔",{"title":15,"searchDepth":16,"depth":17,"links":18},"",2,3,[],"2026-11-17","md",{},true,"\u002Fnotes\u002F2026-11-14-1-2",{"description":13},"notes\u002F2026-11-14-1-2","hDP9fvaunHzVrZQ6QifuOtj9VrqbxlPb_52KE5wSjD0",{"id":28,"title":29,"author":30,"body":31,"categories":110,"comment":22,"cover":30,"createdAt":112,"description":35,"draft":113,"extension":20,"meta":114,"navigation":22,"path":119,"readingTime":120,"recommend":113,"seo":121,"series":30,"stem":122,"tags":123,"top":113,"topics":126,"updatedAt":30,"words":128,"__hash__":129},"posts\u002Fposts\u002Fmicro\u002Fgateway-auth.md","网关层统一鉴权的设计",null,{"type":8,"value":32,"toc":102},[33,36,40,43,46,49,52,55,58,61,64,67,70,73,76,78,81,84,87,90,93,96,99],[11,34,35],{},"周五晚上泡了杯茶，把这阵子零散的笔记归拢成这一篇，也算是给这周收个尾。",[37,38,39],"h2",{"id":39},"为什么收口到网关",[11,41,42],{},"鉴权收口到网关的价值是少写重复代码：登录态校验、token 解析、权限初筛这些横切逻辑，每个服务写一遍既冗余又容易漏。网关统一验证签名和 token，把用户身份放进请求头透传给下游，服务层只关心业务级的细粒度权限，两层职责分明。",[11,44,45],{},"设计时几个注意点：透传的身份头必须只信任网关注入的，外部伪造同名头要在网关层清掉，这是安全上的大事；鉴权失败的响应格式全局统一，前端好处理；白名单机制要显式管理，避免为了图省事把路径越加越宽。",[37,47,48],{"id":48},"性能与灰度",[11,50,51],{},"性能上网关是全量流量的入口，鉴权逻辑要保持轻：token 校验用本地公钥验签而不是每次查库，必要时加短 TTL 缓存；规则数量大了之后考虑编译成正则或者规则引擎，避免长 if 链。改动发布要走灰度，鉴权是全量组件，一个规则写错就是全站故障，我的习惯是新规则先在影子模式跑几天，只记录不生效，确认无误再切正式。",[37,53,54],{"id":54},"过程中的两个坑",[11,56,57],{},"数据迁移演练时发现字段长度截断，源库字符集和目标库不一样，同一段中文占的长度都不同。迁移脚本先在影子表跑一遍，这种事不演练，上了生产就是事故。",[11,59,60],{},"@Transactional 加在私有方法上、或者同类里自调用，事务都是不生效的，因为绕过了代理对象。这类 AOP 的坑，理解了代理机制就一目了然，没理解之前就是玄学。",[11,62,63],{},"服务注册状态看着正常，流量却没打过来。心跳超时加上保护阈值，Nacos 短暂摘除了实例。注册中心的状态和真实可用性是两回事，健康检查永远要结合业务探活来看。",[37,65,66],{"id":66},"延伸几句",[11,68,69],{},"微服务这些年在业界的口碑经历了过山车，从万物皆可拆到反思拆得过细。我的体会是拆分粒度跟着团队和业务走：一个三人团队维护三十个服务，运维成本会吃掉所有架构收益。服务边界清晰比数量重要，能合并的别硬拆。",[11,71,72],{},"分布式链路上的每个环节都有失败概率，链路越长整体成功率越低，这是乘法。所以能合并的调用合并，能并行的不串行，能缓存的缓存。链路的长度就是系统的脆弱程度，设计时对调用深度保持敬畏。",[11,74,75],{},"观测能力在分布式系统里不是锦上添花，是基础设施。日志、指标、链路追踪三件套齐了，问题定位是做阅读理解；缺了，就是通灵。新服务接入的第一天就把观测配齐，比事后补课便宜十倍。",[11,77,69],{},[37,79,80],{"id":80},"又想到一些",[11,82,83],{},"另外觉得这件事里有个普遍适用的规律：复杂度不会消失，只会转移。你省掉的每一步设计，最后都会在排查、扩容或者交接的某个时刻加倍还回来。所谓好的方案，不过是把复杂度放到了值得的位置。",[11,85,86],{},"回顾这个过程，最大的教训其实是克制。可选项永远比需要的多，每个新方案看起来都比现状好一点，但都加上之后，系统就成了没人看得懂的拼贴画。做减法的判断比做加法的胆子更值钱。",[11,88,89],{},"这种事急不来，和锻炼身体是一个道理：练一天没变化，练三个月身体自己会说话。技术积累也是这样，每天一点，回过头看的时候差距已经拉开了，只是身在其中感觉不到而已。",[11,91,92],{},"想到一个问题：为什么同样的事情，不同的人做出来差别那么大。后来觉得答案在于对边界的处理，正常路径人人会写，边界和异常的处理习惯才是拉开差距的地方。做事和写代码一样，细节的密度决定成品的质量。",[37,94,95],{"id":95},"写在最后",[11,97,98],{},"周末在家调这个，家里领导问我看到底有什么乐趣，认真想了想，还真描述不上来，大概就是那种东西被自己理顺的舒服。",[11,100,101],{},"剩下的想起来再记，这篇到此为止。",{"title":15,"searchDepth":16,"depth":17,"links":103},[104,105,106,107,108,109],{"id":39,"depth":16,"text":39},{"id":48,"depth":16,"text":48},{"id":54,"depth":16,"text":54},{"id":66,"depth":16,"text":66},{"id":80,"depth":16,"text":80},{"id":95,"depth":16,"text":95},[111],"微服务","2025-04-07",false,{"excerpt":115},{"type":8,"value":116},[117],[11,118,35],{},"\u002Fposts\u002Fmicro\u002Fgateway-auth",387000,{"title":29,"description":35},"posts\u002Fmicro\u002Fgateway-auth",[124,125],"网关","鉴权",[127],"micro",1290,"dLsEgKQHL8_8fqSyRIoc_mZRyGCvzgKYpRVQr4uOSgc",{"prev":131,"next":134},{"path":132,"title":133},"\u002Fposts\u002Flife\u002Fwet-market-4","周末逛菜市场指南（四）",{"path":135,"title":136},"\u002Fposts\u002Fmicro\u002Fgateway-auth-2","网关层统一鉴权的设计（二）",[138,147,177],{"id":5,"title":6,"body":139,"createdAt":19,"description":13,"extension":20,"meta":145,"navigation":22,"path":23,"seo":146,"stem":25,"__hash__":26},{"type":8,"value":140,"toc":143},[141],[11,142,13],{},{"title":15,"searchDepth":16,"depth":17,"links":144},[],{},{"description":13},{"id":148,"title":149,"body":150,"createdAt":170,"description":171,"extension":20,"meta":172,"navigation":22,"path":173,"seo":174,"stem":175,"__hash__":176},"notes\u002Fnotes\u002F2026-11-14-1.md","2026 11 14 1",{"type":8,"value":151,"toc":168},[152],[11,153,154,155,159,160,167],{},"站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 ",[156,157,158],"strong",{},"Markdown","，写链接也不用到编辑器：",[161,162,166],"a",{"href":163,"rel":164},"https:\u002F\u002Fcontent.nuxt.com",[165],"nofollow","Nuxt Content","。",{"title":15,"searchDepth":16,"depth":17,"links":169},[],"2026-11-14","站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 Markdown，写链接也不用到编辑器：Nuxt Content。",{},"\u002Fnotes\u002F2026-11-14-1",{"description":171},"notes\u002F2026-11-14-1","LLJX_RKU7cgpT6aHw4DZWUZNQ_G_UzELWPKbksJvzfs",{"id":178,"title":179,"body":180,"createdAt":195,"description":196,"extension":20,"meta":197,"navigation":22,"path":198,"seo":199,"stem":200,"__hash__":201},"notes\u002Fnotes\u002F2026-11-14-2.md","2026 11 14 2",{"type":8,"value":181,"toc":193},[182],[11,183,184,188,189,192],{},[185,186,187],"code",{},"readPixels"," 读不到内容不是 bug，是 ",[185,190,191],{},"preserveDrawingBuffer"," 默认关闭——帧提交后缓冲即被清空。",{"title":15,"searchDepth":16,"depth":17,"links":194},[],"2026-11-13","readPixels 读不到内容不是 bug，是 preserveDrawingBuffer 默认关闭——帧提交后缓冲即被清空。",{},"\u002Fnotes\u002F2026-11-14-2",{"description":196},"notes\u002F2026-11-14-2","i7xWqq2eNoU_seSbLQjqlB9gE51fM-PVLUEYCHBkOA4",1795274508986]