[{"data":1,"prerenderedAt":202},["ShallowReactive",2],{"notes-latest-1":3,"post:\u002Fposts\u002Fmicro\u002Frate-limit-2":27,"surround:\u002Fposts\u002Fmicro\u002Frate-limit-2":130,"notes-latest-3":137},[4],{"id":5,"title":6,"body":7,"createdAt":19,"description":13,"extension":20,"meta":21,"navigation":22,"path":23,"seo":24,"stem":25,"__hash__":26},"notes\u002Fnotes\u002F2026-11-14-1-2.md","2026 11 14 1 2",{"type":8,"value":9,"toc":14},"minimark",[10],[11,12,13],"p",{},"站点上线了「随笔」：支持一个文件多个随笔",{"title":15,"searchDepth":16,"depth":17,"links":18},"",2,3,[],"2026-11-17","md",{},true,"\u002Fnotes\u002F2026-11-14-1-2",{"description":13},"notes\u002F2026-11-14-1-2","hDP9fvaunHzVrZQ6QifuOtj9VrqbxlPb_52KE5wSjD0",{"id":28,"title":29,"author":30,"body":31,"categories":110,"comment":22,"cover":30,"createdAt":112,"description":35,"draft":113,"extension":20,"meta":114,"navigation":22,"path":119,"readingTime":120,"recommend":113,"seo":121,"series":30,"stem":122,"tags":123,"top":113,"topics":126,"updatedAt":30,"words":128,"__hash__":129},"posts\u002Fposts\u002Fmicro\u002Frate-limit-2.md","限流算法的选择与落地（二）",null,{"type":8,"value":32,"toc":102},[33,36,40,43,46,49,52,55,58,61,64,67,70,73,76,78,81,84,87,90,93,96,99],[11,34,35],{},"周五晚上泡了杯茶，把这阵子零散的笔记归拢成这一篇，也算是给这周收个尾。",[37,38,39],"h2",{"id":39},"算法对比",[11,41,42],{},"常用限流算法几个：固定窗口计数最简单，窗口边界处会有两倍流量的毛刺；滑动窗口把窗口切碎统计，平滑一些；漏桶以恒定速率放行，削峰填谷但无法应对突发；令牌桶预生成令牌，允许一定程度的突发，多数场景它是平衡点。单机限流用 Guava 或 Sentinel 就够，集群限流要把计数放到 Redis，性能和精度之间做权衡。",[11,44,45],{},"限流的另一个关键是被限之后怎么办：直接拒绝返回友好错误、排队等待、还是降级到兜底逻辑，这些策略要和产品一起定义，用户看到什么取决于这里的处理。",[37,47,48],{"id":48},"粒度与层次",[11,50,51],{},"实践中还要想清楚限流的粒度：按接口、按用户、按来源系统，维度不同保护的靶子不同。我的习惯是分层次做：入口网关做粗粒度的全局限流防雪崩，服务内部对核心资源和下游依赖做细粒度限流，对外部调用方按配额管理。限流阈值不是拍出来的，压测数据加冗余系数，并且随着容量变化定期校准，长期不更新的阈值等于没有阈值。",[37,53,54],{"id":54},"记两个小问题",[11,56,57],{},"单元测试月底跑挂了，因为断言里依赖系统当前日期。注入 Clock 之后再测，时间随意控制。第一次遇到这种问题觉得很玄学，理解了之后觉得这是依赖注入最生动的教学案例。",[11,59,60],{},"grep 中文关键词死活匹配不上，最后确认是文件编码。iconv 转一道再查，两分钟的事排查了半小时，处理日志前先看编码，这个习惯值得保持。",[11,62,63],{},"磁盘告警，日志把盘写满了。给应用日志配上 logrotate 加上保留天数，再顺手把历史日志清了。存储这种东西，没有监控告警之前，所有人都以为它不会满。",[37,65,66],{"id":66},"顺便一提",[11,68,69],{},"微服务这些年在业界的口碑经历了过山车，从万物皆可拆到反思拆得过细。我的体会是拆分粒度跟着团队和业务走：一个三人团队维护三十个服务，运维成本会吃掉所有架构收益。服务边界清晰比数量重要，能合并的别硬拆。",[11,71,72],{},"分布式链路上的每个环节都有失败概率，链路越长整体成功率越低，这是乘法。所以能合并的调用合并，能并行的不串行，能缓存的缓存。链路的长度就是系统的脆弱程度，设计时对调用深度保持敬畏。",[11,74,75],{},"观测能力在分布式系统里不是锦上添花，是基础设施。日志、指标、链路追踪三件套齐了，问题定位是做阅读理解；缺了，就是通灵。新服务接入的第一天就把观测配齐，比事后补课便宜十倍。",[11,77,69],{},[37,79,80],{"id":80},"另外记几笔",[11,82,83],{},"写着写着想到，很多技术选择本质上都是在回答同一个问题：这个方案在出问题的时候是什么样子。不出问题的方案人人都写得出来，区分度全在故障时刻的表现。多想一层失败路径，很多纠结就自动有了答案。",[11,85,86],{},"这类经验在文档里通常只有一行字，背后的排查却是一整个下午。技术工作的大部分时间都花在这些不会写进简历的细节里，所以这些细节才更需要有人写出来，哪怕只是给未来某一天忘了的自己。",[11,88,89],{},"顺带聊聊方法论：遇到不熟悉的领域，我的习惯是先把最小闭环跑通，哪怕每一步都很粗糙。跑通之后再逐段替换成正经实现，过程中每一步都有可运行的版本。这个思路在工作和生活里都屡试不爽，比憋大招的成功率高得多。",[11,91,92],{},"另外觉得这件事里有个普遍适用的规律：复杂度不会消失，只会转移。你省掉的每一步设计，最后都会在排查、扩容或者交接的某个时刻加倍还回来。所谓好的方案，不过是把复杂度放到了值得的位置。",[37,94,95],{"id":95},"小结",[11,97,98],{},"上午改代码，下午陪家人逛了趟超市，晚上坐下来写这篇，一天过得挺满。",[11,100,101],{},"先记到这里，后面有新的进展再来补充。",{"title":15,"searchDepth":16,"depth":17,"links":103},[104,105,106,107,108,109],{"id":39,"depth":16,"text":39},{"id":48,"depth":16,"text":48},{"id":54,"depth":16,"text":54},{"id":66,"depth":16,"text":66},{"id":80,"depth":16,"text":80},{"id":95,"depth":16,"text":95},[111],"微服务","2025-06-13",false,{"excerpt":115},{"type":8,"value":116},[117],[11,118,35],{},"\u002Fposts\u002Fmicro\u002Frate-limit-2",388200,{"title":29,"description":35},"posts\u002Fmicro\u002Frate-limit-2",[124,125],"限流","高并发",[127],"micro",1294,"SUHVg5xICnE47IkuSDjjO4GgA4x1dmPh4ij_dz_GEgU",{"prev":131,"next":134},{"path":132,"title":133},"\u002Fposts\u002Fmicro\u002Frate-limit","限流算法的选择与落地",{"path":135,"title":136},"\u002Fposts\u002Fmicro\u002Frate-limit-3","限流算法的选择与落地（三）",[138,147,177],{"id":5,"title":6,"body":139,"createdAt":19,"description":13,"extension":20,"meta":145,"navigation":22,"path":23,"seo":146,"stem":25,"__hash__":26},{"type":8,"value":140,"toc":143},[141],[11,142,13],{},{"title":15,"searchDepth":16,"depth":17,"links":144},[],{},{"description":13},{"id":148,"title":149,"body":150,"createdAt":170,"description":171,"extension":20,"meta":172,"navigation":22,"path":173,"seo":174,"stem":175,"__hash__":176},"notes\u002Fnotes\u002F2026-11-14-1.md","2026 11 14 1",{"type":8,"value":151,"toc":168},[152],[11,153,154,155,159,160,167],{},"站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 ",[156,157,158],"strong",{},"Markdown","，写链接也不用到编辑器：",[161,162,166],"a",{"href":163,"rel":164},"https:\u002F\u002Fcontent.nuxt.com",[165],"nofollow","Nuxt Content","。",{"title":15,"searchDepth":16,"depth":17,"links":169},[],"2026-11-14","站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 Markdown，写链接也不用到编辑器：Nuxt Content。",{},"\u002Fnotes\u002F2026-11-14-1",{"description":171},"notes\u002F2026-11-14-1","LLJX_RKU7cgpT6aHw4DZWUZNQ_G_UzELWPKbksJvzfs",{"id":178,"title":179,"body":180,"createdAt":195,"description":196,"extension":20,"meta":197,"navigation":22,"path":198,"seo":199,"stem":200,"__hash__":201},"notes\u002Fnotes\u002F2026-11-14-2.md","2026 11 14 2",{"type":8,"value":181,"toc":193},[182],[11,183,184,188,189,192],{},[185,186,187],"code",{},"readPixels"," 读不到内容不是 bug，是 ",[185,190,191],{},"preserveDrawingBuffer"," 默认关闭——帧提交后缓冲即被清空。",{"title":15,"searchDepth":16,"depth":17,"links":194},[],"2026-11-13","readPixels 读不到内容不是 bug，是 preserveDrawingBuffer 默认关闭——帧提交后缓冲即被清空。",{},"\u002Fnotes\u002F2026-11-14-2",{"description":196},"notes\u002F2026-11-14-2","i7xWqq2eNoU_seSbLQjqlB9gE51fM-PVLUEYCHBkOA4",1795342436861]