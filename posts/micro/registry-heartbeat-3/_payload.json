[{"data":1,"prerenderedAt":203},["ShallowReactive",2],{"notes-latest-1":3,"post:\u002Fposts\u002Fmicro\u002Fregistry-heartbeat-3":27,"surround:\u002Fposts\u002Fmicro\u002Fregistry-heartbeat-3":131,"notes-latest-3":138},[4],{"id":5,"title":6,"body":7,"createdAt":19,"description":13,"extension":20,"meta":21,"navigation":22,"path":23,"seo":24,"stem":25,"__hash__":26},"notes\u002Fnotes\u002F2026-11-14-1-2.md","2026 11 14 1 2",{"type":8,"value":9,"toc":14},"minimark",[10],[11,12,13],"p",{},"站点上线了「随笔」：支持一个文件多个随笔",{"title":15,"searchDepth":16,"depth":17,"links":18},"",2,3,[],"2026-11-17","md",{},true,"\u002Fnotes\u002F2026-11-14-1-2",{"description":13},"notes\u002F2026-11-14-1-2","hDP9fvaunHzVrZQ6QifuOtj9VrqbxlPb_52KE5wSjD0",{"id":28,"title":29,"author":30,"body":31,"categories":111,"comment":22,"cover":30,"createdAt":113,"description":35,"draft":114,"extension":20,"meta":115,"navigation":22,"path":120,"readingTime":121,"recommend":114,"seo":122,"series":30,"stem":123,"tags":124,"top":114,"topics":127,"updatedAt":30,"words":129,"__hash__":130},"posts\u002Fposts\u002Fmicro\u002Fregistry-heartbeat-3.md","注册中心与心跳机制的工作方式（三）",null,{"type":8,"value":32,"toc":103},[33,36,40,43,46,50,53,56,59,62,65,68,71,74,77,79,82,85,88,91,94,97,100],[11,34,35],{},"这是一篇偏流水账的记录，重点不在结论，在过程和当时的判断依据，看官自行取用。",[37,38,39],"h2",{"id":39},"基本原理",[11,41,42],{},"服务发现解决的问题是：调用方怎么知道目标实例在哪。服务启动时把自己注册到注册中心，调用方从注册中心拉取可用实例列表。注册中心还有一个持续的任务是判断实例死活，靠的就是心跳：客户端定期上报，超过时限没收到就标记异常，再等一段时间仍无心跳就摘除。",[11,44,45],{},"摘除策略的设计很讲究，太灵敏会造成网络抖动时大批实例被误摘，流量全压到剩下的实例上引发连锁故障；太迟钝又会让真实挂掉的实例继续接流量。所以成熟的实现都加了保护阈值，不健康实例比例超过设定值时暂时不摘除，宁可保守一点。",[37,47,49],{"id":48},"ap-还是-cp","AP 还是 CP",[11,51,52],{},"选型时还有一个经典问题：注册中心要 AP 还是 CP。Eureka 走 AP，牺牲一致性保可用，网络分区时大家各持旧列表照样工作；ZooKeeper 走 CP，分区期间可能拒绝服务；Nacos 支持两种模式按场景切换。业务服务发现多数时候 AP 更合理，实例列表短暂不一致的代价远小于不可用的代价。理解这个取舍，比背各个产品的特性表更有用。",[37,54,55],{"id":55},"顺手记两个坑",[11,57,58],{},"接口偶发超时，压测环境复现不了，后来发现是连接池的 maxPoolSize 用了默认值，高峰期全在等连接。调大之后看监控，等待队列直接归零，这种参数还是得按自己的流量压一遍。",[11,60,61],{},"镜像优化前是 1.2G，换 alpine 基础镜像加上多阶段构建，砍到两百兆以内，拉取时间肉眼可见地降下来。构建上下文里别把无关文件拷进去，.dockerignore 值得认真配一次。",[11,63,64],{},"上传接口一直 413，代码怎么改都没用，最后才反应过来是 Nginx 的 client_max_body_size 默认 1m 挡住了。这种不在应用层的问题，排查方向一开始就该往链路上想。",[37,66,67],{"id":67},"一点延伸",[11,69,70],{},"分布式链路上的每个环节都有失败概率，链路越长整体成功率越低，这是乘法。所以能合并的调用合并，能并行的不串行，能缓存的缓存。链路的长度就是系统的脆弱程度，设计时对调用深度保持敬畏。",[11,72,73],{},"观测能力在分布式系统里不是锦上添花，是基础设施。日志、指标、链路追踪三件套齐了，问题定位是做阅读理解；缺了，就是通灵。新服务接入的第一天就把观测配齐，比事后补课便宜十倍。",[11,75,76],{},"微服务这些年在业界的口碑经历了过山车，从万物皆可拆到反思拆得过细。我的体会是拆分粒度跟着团队和业务走：一个三人团队维护三十个服务，运维成本会吃掉所有架构收益。服务边界清晰比数量重要，能合并的别硬拆。",[11,78,70],{},[37,80,81],{"id":81},"再补充几句",[11,83,84],{},"过程中也反复体会到取舍的本质：没有完美的方案，只有当下约束下最合适的方案。把约束写清楚，方案的选择题就变成了证明题，这也是为什么我习惯先列约束再谈方案，顺序反了全是无效争论。",[11,86,87],{},"想想还是补一段：任何习惯的养成都绕不开启动成本，最有效的办法是把启动成本降到接近零。想跑就把鞋放门口，想写就把文档开着置顶，环境准备到位了，行动只是顺水推舟。",[11,89,90],{},"从更高的视角看，这类问题都有一个共同结构：短期收益和长期收益打架。短期的诱惑总是具体而生动，长期的回报抽象而遥远，赢家通常是那些把长期目标拆成短期可感的小奖励的人。",[11,92,93],{},"讲个题外话，做这类事情的时候最好留个记录的习惯，当时的判断依据比结果更珍贵。结果好可能只是运气好，把决策过程记下来，好运才可能被复制，坏运才可能被规避。",[37,95,96],{"id":96},"写在最后",[11,98,99],{},"写完这篇正好十一点，窗外安静下来，这种时候码字效率出奇地高，就是第二天起床靠毅力。",[11,101,102],{},"先记到这里，后面有新的进展再来补充。",{"title":15,"searchDepth":16,"depth":17,"links":104},[105,106,107,108,109,110],{"id":39,"depth":16,"text":39},{"id":48,"depth":16,"text":49},{"id":55,"depth":16,"text":55},{"id":67,"depth":16,"text":67},{"id":81,"depth":16,"text":81},{"id":96,"depth":16,"text":96},[112],"微服务","2024-02-24",false,{"excerpt":116},{"type":8,"value":117},[118],[11,119,35],{},"\u002Fposts\u002Fmicro\u002Fregistry-heartbeat-3",379800,{"title":29,"description":35},"posts\u002Fmicro\u002Fregistry-heartbeat-3",[125,126],"注册中心","Nacos",[128],"micro",1266,"2SVb446oZM2dSBR-3Xq4t2d3LM85cKlw_9DMg3qUi0w",{"prev":132,"next":135},{"path":133,"title":134},"\u002Fposts\u002Fmicro\u002Fregistry-heartbeat-2","注册中心与心跳机制的工作方式（二）",{"path":136,"title":137},"\u002Fposts\u002Fmicro\u002Fregistry-heartbeat-4","注册中心与心跳机制的工作方式（四）",[139,148,178],{"id":5,"title":6,"body":140,"createdAt":19,"description":13,"extension":20,"meta":146,"navigation":22,"path":23,"seo":147,"stem":25,"__hash__":26},{"type":8,"value":141,"toc":144},[142],[11,143,13],{},{"title":15,"searchDepth":16,"depth":17,"links":145},[],{},{"description":13},{"id":149,"title":150,"body":151,"createdAt":171,"description":172,"extension":20,"meta":173,"navigation":22,"path":174,"seo":175,"stem":176,"__hash__":177},"notes\u002Fnotes\u002F2026-11-14-1.md","2026 11 14 1",{"type":8,"value":152,"toc":169},[153],[11,154,155,156,160,161,168],{},"站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 ",[157,158,159],"strong",{},"Markdown","，写链接也不用到编辑器：",[162,163,167],"a",{"href":164,"rel":165},"https:\u002F\u002Fcontent.nuxt.com",[166],"nofollow","Nuxt Content","。",{"title":15,"searchDepth":16,"depth":17,"links":170},[],"2026-11-14","站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 Markdown，写链接也不用到编辑器：Nuxt Content。",{},"\u002Fnotes\u002F2026-11-14-1",{"description":172},"notes\u002F2026-11-14-1","LLJX_RKU7cgpT6aHw4DZWUZNQ_G_UzELWPKbksJvzfs",{"id":179,"title":180,"body":181,"createdAt":196,"description":197,"extension":20,"meta":198,"navigation":22,"path":199,"seo":200,"stem":201,"__hash__":202},"notes\u002Fnotes\u002F2026-11-14-2.md","2026 11 14 2",{"type":8,"value":182,"toc":194},[183],[11,184,185,189,190,193],{},[186,187,188],"code",{},"readPixels"," 读不到内容不是 bug，是 ",[186,191,192],{},"preserveDrawingBuffer"," 默认关闭——帧提交后缓冲即被清空。",{"title":15,"searchDepth":16,"depth":17,"links":195},[],"2026-11-13","readPixels 读不到内容不是 bug，是 preserveDrawingBuffer 默认关闭——帧提交后缓冲即被清空。",{},"\u002Fnotes\u002F2026-11-14-2",{"description":197},"notes\u002F2026-11-14-2","i7xWqq2eNoU_seSbLQjqlB9gE51fM-PVLUEYCHBkOA4",1795278777647]