[{"data":1,"prerenderedAt":202},["ShallowReactive",2],{"notes-latest-1":3,"post:\u002Fposts\u002Fmicro\u002Fgateway-auth-3":27,"surround:\u002Fposts\u002Fmicro\u002Fgateway-auth-3":130,"notes-latest-3":137},[4],{"id":5,"title":6,"body":7,"createdAt":19,"description":13,"extension":20,"meta":21,"navigation":22,"path":23,"seo":24,"stem":25,"__hash__":26},"notes\u002Fnotes\u002F2026-11-14-1-2.md","2026 11 14 1 2",{"type":8,"value":9,"toc":14},"minimark",[10],[11,12,13],"p",{},"站点上线了「随笔」：支持一个文件多个随笔",{"title":15,"searchDepth":16,"depth":17,"links":18},"",2,3,[],"2026-11-17","md",{},true,"\u002Fnotes\u002F2026-11-14-1-2",{"description":13},"notes\u002F2026-11-14-1-2","hDP9fvaunHzVrZQ6QifuOtj9VrqbxlPb_52KE5wSjD0",{"id":28,"title":29,"author":30,"body":31,"categories":110,"comment":22,"cover":30,"createdAt":112,"description":35,"draft":113,"extension":20,"meta":114,"navigation":22,"path":119,"readingTime":120,"recommend":113,"seo":121,"series":30,"stem":122,"tags":123,"top":113,"topics":126,"updatedAt":30,"words":128,"__hash__":129},"posts\u002Fposts\u002Fmicro\u002Fgateway-auth-3.md","网关层统一鉴权的设计（三）",null,{"type":8,"value":32,"toc":102},[33,36,40,43,46,49,52,55,58,61,64,67,70,73,76,78,81,84,87,90,93,96,99],[11,34,35],{},"这篇整理一下最近在弄的东西，前后拖了些时间，趁记性还在赶紧写下来，免得过阵子细节全忘。",[37,38,39],"h2",{"id":39},"为什么收口到网关",[11,41,42],{},"鉴权收口到网关的价值是少写重复代码：登录态校验、token 解析、权限初筛这些横切逻辑，每个服务写一遍既冗余又容易漏。网关统一验证签名和 token，把用户身份放进请求头透传给下游，服务层只关心业务级的细粒度权限，两层职责分明。",[11,44,45],{},"设计时几个注意点：透传的身份头必须只信任网关注入的，外部伪造同名头要在网关层清掉，这是安全上的大事；鉴权失败的响应格式全局统一，前端好处理；白名单机制要显式管理，避免为了图省事把路径越加越宽。",[37,47,48],{"id":48},"性能与灰度",[11,50,51],{},"性能上网关是全量流量的入口，鉴权逻辑要保持轻：token 校验用本地公钥验签而不是每次查库，必要时加短 TTL 缓存；规则数量大了之后考虑编译成正则或者规则引擎，避免长 if 链。改动发布要走灰度，鉴权是全量组件，一个规则写错就是全站故障，我的习惯是新规则先在影子模式跑几天，只记录不生效，确认无误再切正式。",[37,53,54],{"id":54},"过程中的两个坑",[11,56,57],{},"HTTPS 证书配完，桌面浏览器都正常，部分安卓机型握手失败。是证书链不完整，中间证书没部署。证书工具会提示，但前提是你出问题之前主动去验证一次。",[11,59,60],{},"接手老代码，方法级 synchronized 把远程调用也包了进去，整个接口的吞吐被锁死。缩小锁范围只保护共享变量，性能立刻回来。锁的粒度，永远值得多看一眼。",[11,62,63],{},"jstat 看 GC 一切正常，但接口就是偶发抖动，最后发现宿主机在用 swap。禁掉 swap 加上内存预留，抖动消失。应用层之外，操作系统层面的问题也要纳入视野。",[37,65,66],{"id":66},"延伸几句",[11,68,69],{},"分布式链路上的每个环节都有失败概率，链路越长整体成功率越低，这是乘法。所以能合并的调用合并，能并行的不串行，能缓存的缓存。链路的长度就是系统的脆弱程度，设计时对调用深度保持敬畏。",[11,71,72],{},"观测能力在分布式系统里不是锦上添花，是基础设施。日志、指标、链路追踪三件套齐了，问题定位是做阅读理解；缺了，就是通灵。新服务接入的第一天就把观测配齐，比事后补课便宜十倍。",[11,74,75],{},"微服务这些年在业界的口碑经历了过山车，从万物皆可拆到反思拆得过细。我的体会是拆分粒度跟着团队和业务走：一个三人团队维护三十个服务，运维成本会吃掉所有架构收益。服务边界清晰比数量重要，能合并的别硬拆。",[11,77,69],{},[37,79,80],{"id":80},"又想到一些",[11,82,83],{},"写到这里顺便吐个槽，这类事情最难的部分往往不是技术本身，是说服别人相信它值得投入。方案再好，落不到排期上都是空谈，所以学会用数据的语言讲价值，算是这些年额外的必修课。",[11,85,86],{},"有时候会想，学一门新技术到底学到的是什么。语法和 API 会过时，真正的收获是它看问题的角度。多一门语言就多一副眼镜，同一副牌桌，能看到别人看不到的牌路，这是这么多年折腾下来最确定的回报。",[11,88,89],{},"记一个产生过的动摇：做到一半觉得这玩意儿是不是没什么意义。后来想通了，意义不是事情自带的，是你把它做完并沉淀下来之后长出来的。烂尾的才真的没意义，做完的最差也是一篇笔记。",[11,91,92],{},"顺便说说协作里的体会：这类事自己闷头做效率最高，但闷头做完往往返工最多。适度地提前同步，把方向先对齐，看似慢了半天，实际省掉的是几天的返工。沟通的时机比沟通的技巧更值得琢磨。",[37,94,95],{"id":95},"写在最后",[11,97,98],{},"楼下那家面馆老板都认识我了，加班晚归来一碗，很多难缠的问题都是吃完那碗面之后突然有思路的。",[11,100,101],{},"记录完毕，方便以后自己回来翻。",{"title":15,"searchDepth":16,"depth":17,"links":103},[104,105,106,107,108,109],{"id":39,"depth":16,"text":39},{"id":48,"depth":16,"text":48},{"id":54,"depth":16,"text":54},{"id":66,"depth":16,"text":66},{"id":80,"depth":16,"text":80},{"id":95,"depth":16,"text":95},[111],"微服务","2025-02-23",false,{"excerpt":115},{"type":8,"value":116},[117],[11,118,35],{},"\u002Fposts\u002Fmicro\u002Fgateway-auth-3",379500,{"title":29,"description":35},"posts\u002Fmicro\u002Fgateway-auth-3",[124,125],"网关","鉴权",[127],"micro",1265,"0Y2fNWb2EXXTomlP6Z_sBlvsvXNq8QKIuQVS7U_1L2c",{"prev":131,"next":134},{"path":132,"title":133},"\u002Fposts\u002Fmicro\u002Fgateway-auth-2","网关层统一鉴权的设计（二）",{"path":135,"title":136},"\u002Fposts\u002Fmicro\u002Fgateway-auth-4","网关层统一鉴权的设计（四）",[138,147,177],{"id":5,"title":6,"body":139,"createdAt":19,"description":13,"extension":20,"meta":145,"navigation":22,"path":23,"seo":146,"stem":25,"__hash__":26},{"type":8,"value":140,"toc":143},[141],[11,142,13],{},{"title":15,"searchDepth":16,"depth":17,"links":144},[],{},{"description":13},{"id":148,"title":149,"body":150,"createdAt":170,"description":171,"extension":20,"meta":172,"navigation":22,"path":173,"seo":174,"stem":175,"__hash__":176},"notes\u002Fnotes\u002F2026-11-14-1.md","2026 11 14 1",{"type":8,"value":151,"toc":168},[152],[11,153,154,155,159,160,167],{},"站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 ",[156,157,158],"strong",{},"Markdown","，写链接也不用到编辑器：",[161,162,166],"a",{"href":163,"rel":164},"https:\u002F\u002Fcontent.nuxt.com",[165],"nofollow","Nuxt Content","。",{"title":15,"searchDepth":16,"depth":17,"links":169},[],"2026-11-14","站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 Markdown，写链接也不用到编辑器：Nuxt Content。",{},"\u002Fnotes\u002F2026-11-14-1",{"description":171},"notes\u002F2026-11-14-1","LLJX_RKU7cgpT6aHw4DZWUZNQ_G_UzELWPKbksJvzfs",{"id":178,"title":179,"body":180,"createdAt":195,"description":196,"extension":20,"meta":197,"navigation":22,"path":198,"seo":199,"stem":200,"__hash__":201},"notes\u002Fnotes\u002F2026-11-14-2.md","2026 11 14 2",{"type":8,"value":181,"toc":193},[182],[11,183,184,188,189,192],{},[185,186,187],"code",{},"readPixels"," 读不到内容不是 bug，是 ",[185,190,191],{},"preserveDrawingBuffer"," 默认关闭——帧提交后缓冲即被清空。",{"title":15,"searchDepth":16,"depth":17,"links":194},[],"2026-11-13","readPixels 读不到内容不是 bug，是 preserveDrawingBuffer 默认关闭——帧提交后缓冲即被清空。",{},"\u002Fnotes\u002F2026-11-14-2",{"description":196},"notes\u002F2026-11-14-2","i7xWqq2eNoU_seSbLQjqlB9gE51fM-PVLUEYCHBkOA4",1795273157773]