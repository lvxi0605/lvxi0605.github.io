[{"data":1,"prerenderedAt":202},["ShallowReactive",2],{"notes-latest-1":3,"post:\u002Fposts\u002Fmicro\u002Frate-limit-6":27,"surround:\u002Fposts\u002Fmicro\u002Frate-limit-6":130,"notes-latest-3":137},[4],{"id":5,"title":6,"body":7,"createdAt":19,"description":13,"extension":20,"meta":21,"navigation":22,"path":23,"seo":24,"stem":25,"__hash__":26},"notes\u002Fnotes\u002F2026-11-14-1-2.md","2026 11 14 1 2",{"type":8,"value":9,"toc":14},"minimark",[10],[11,12,13],"p",{},"站点上线了「随笔」：支持一个文件多个随笔",{"title":15,"searchDepth":16,"depth":17,"links":18},"",2,3,[],"2026-11-17","md",{},true,"\u002Fnotes\u002F2026-11-14-1-2",{"description":13},"notes\u002F2026-11-14-1-2","hDP9fvaunHzVrZQ6QifuOtj9VrqbxlPb_52KE5wSjD0",{"id":28,"title":29,"author":30,"body":31,"categories":110,"comment":22,"cover":30,"createdAt":112,"description":35,"draft":113,"extension":20,"meta":114,"navigation":22,"path":119,"readingTime":120,"recommend":113,"seo":121,"series":30,"stem":122,"tags":123,"top":113,"topics":126,"updatedAt":30,"words":128,"__hash__":129},"posts\u002Fposts\u002Fmicro\u002Frate-limit-6.md","限流算法的选择与落地（六）",null,{"type":8,"value":32,"toc":102},[33,36,40,43,46,49,52,55,58,61,64,67,70,73,76,78,81,84,87,90,93,96,99],[11,34,35],{},"这个话题其实挺老的，但每次实际用到还是会踩出点新东西，索性记一篇备查，也给后来的同学提个醒。",[37,38,39],"h2",{"id":39},"算法对比",[11,41,42],{},"常用限流算法几个：固定窗口计数最简单，窗口边界处会有两倍流量的毛刺；滑动窗口把窗口切碎统计，平滑一些；漏桶以恒定速率放行，削峰填谷但无法应对突发；令牌桶预生成令牌，允许一定程度的突发，多数场景它是平衡点。单机限流用 Guava 或 Sentinel 就够，集群限流要把计数放到 Redis，性能和精度之间做权衡。",[11,44,45],{},"限流的另一个关键是被限之后怎么办：直接拒绝返回友好错误、排队等待、还是降级到兜底逻辑，这些策略要和产品一起定义，用户看到什么取决于这里的处理。",[37,47,48],{"id":48},"粒度与层次",[11,50,51],{},"实践中还要想清楚限流的粒度：按接口、按用户、按来源系统，维度不同保护的靶子不同。我的习惯是分层次做：入口网关做粗粒度的全局限流防雪崩，服务内部对核心资源和下游依赖做细粒度限流，对外部调用方按配额管理。限流阈值不是拍出来的，压测数据加冗余系数，并且随着容量变化定期校准，长期不更新的阈值等于没有阈值。",[37,53,54],{"id":54},"记两个小问题",[11,56,57],{},"jstat 看 GC 一切正常，但接口就是偶发抖动，最后发现宿主机在用 swap。禁掉 swap 加上内存预留，抖动消失。应用层之外，操作系统层面的问题也要纳入视野。",[11,59,60],{},"生产配置被本地配置悄悄覆盖，排查半天才发现是配置优先级没理清。把环境相关的配置全部收敛到配置中心，本地只留开发用的最小集，这种规矩早立早省心。",[11,62,63],{},"RabbitMQ 队列堆积，消费者明明在跑。看配置 prefetch 设得太大，单条消息处理又慢，吞吐全耗在慢消息上。把 prefetch 调小，吞吐反而上去了，多不一定快。",[37,65,66],{"id":66},"顺便一提",[11,68,69],{},"观测能力在分布式系统里不是锦上添花，是基础设施。日志、指标、链路追踪三件套齐了，问题定位是做阅读理解；缺了，就是通灵。新服务接入的第一天就把观测配齐，比事后补课便宜十倍。",[11,71,72],{},"微服务这些年在业界的口碑经历了过山车，从万物皆可拆到反思拆得过细。我的体会是拆分粒度跟着团队和业务走：一个三人团队维护三十个服务，运维成本会吃掉所有架构收益。服务边界清晰比数量重要，能合并的别硬拆。",[11,74,75],{},"分布式链路上的每个环节都有失败概率，链路越长整体成功率越低，这是乘法。所以能合并的调用合并，能并行的不串行，能缓存的缓存。链路的长度就是系统的脆弱程度，设计时对调用深度保持敬畏。",[11,77,69],{},[37,79,80],{"id":80},"另外记几笔",[11,82,83],{},"有时候会想，学一门新技术到底学到的是什么。语法和 API 会过时，真正的收获是它看问题的角度。多一门语言就多一副眼镜，同一副牌桌，能看到别人看不到的牌路，这是这么多年折腾下来最确定的回报。",[11,85,86],{},"记一个产生过的动摇：做到一半觉得这玩意儿是不是没什么意义。后来想通了，意义不是事情自带的，是你把它做完并沉淀下来之后长出来的。烂尾的才真的没意义，做完的最差也是一篇笔记。",[11,88,89],{},"顺便说说协作里的体会：这类事自己闷头做效率最高，但闷头做完往往返工最多。适度地提前同步，把方向先对齐，看似慢了半天，实际省掉的是几天的返工。沟通的时机比沟通的技巧更值得琢磨。",[11,91,92],{},"其实回看这些年踩的坑，大坑几乎都和贪快有关。快不是错，错的是想跳过必要步骤的快，地基没打牢盖得越快塌得越响。慢下来把该做的做扎实，反而是最快的路径，这话说了很多年，每次验证都对。",[37,94,95],{"id":95},"小结",[11,97,98],{},"楼下那家面馆老板都认识我了，加班晚归来一碗，很多难缠的问题都是吃完那碗面之后突然有思路的。",[11,100,101],{},"差不多了，剩下的细节等用到的时候再展开写。",{"title":15,"searchDepth":16,"depth":17,"links":103},[104,105,106,107,108,109],{"id":39,"depth":16,"text":39},{"id":48,"depth":16,"text":48},{"id":54,"depth":16,"text":54},{"id":66,"depth":16,"text":66},{"id":80,"depth":16,"text":80},{"id":95,"depth":16,"text":95},[111],"微服务","2023-08-24",false,{"excerpt":115},{"type":8,"value":116},[117],[11,118,35],{},"\u002Fposts\u002Fmicro\u002Frate-limit-6",382500,{"title":29,"description":35},"posts\u002Fmicro\u002Frate-limit-6",[124,125],"限流","高并发",[127],"micro",1275,"wnjoZn60BIfFLe1oyZzqnRGxl-NW5R1uL0JRXqebcOk",{"prev":131,"next":134},{"path":132,"title":133},"\u002Fposts\u002Fmicro\u002Frate-limit-5","限流算法的选择与落地（五）",{"path":135,"title":136},"\u002Fposts\u002Fmicro\u002Fregistry-heartbeat","注册中心与心跳机制的工作方式",[138,147,177],{"id":5,"title":6,"body":139,"createdAt":19,"description":13,"extension":20,"meta":145,"navigation":22,"path":23,"seo":146,"stem":25,"__hash__":26},{"type":8,"value":140,"toc":143},[141],[11,142,13],{},{"title":15,"searchDepth":16,"depth":17,"links":144},[],{},{"description":13},{"id":148,"title":149,"body":150,"createdAt":170,"description":171,"extension":20,"meta":172,"navigation":22,"path":173,"seo":174,"stem":175,"__hash__":176},"notes\u002Fnotes\u002F2026-11-14-1.md","2026 11 14 1",{"type":8,"value":151,"toc":168},[152],[11,153,154,155,159,160,167],{},"站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 ",[156,157,158],"strong",{},"Markdown","，写链接也不用到编辑器：",[161,162,166],"a",{"href":163,"rel":164},"https:\u002F\u002Fcontent.nuxt.com",[165],"nofollow","Nuxt Content","。",{"title":15,"searchDepth":16,"depth":17,"links":169},[],"2026-11-14","站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 Markdown，写链接也不用到编辑器：Nuxt Content。",{},"\u002Fnotes\u002F2026-11-14-1",{"description":171},"notes\u002F2026-11-14-1","LLJX_RKU7cgpT6aHw4DZWUZNQ_G_UzELWPKbksJvzfs",{"id":178,"title":179,"body":180,"createdAt":195,"description":196,"extension":20,"meta":197,"navigation":22,"path":198,"seo":199,"stem":200,"__hash__":201},"notes\u002Fnotes\u002F2026-11-14-2.md","2026 11 14 2",{"type":8,"value":181,"toc":193},[182],[11,183,184,188,189,192],{},[185,186,187],"code",{},"readPixels"," 读不到内容不是 bug，是 ",[185,190,191],{},"preserveDrawingBuffer"," 默认关闭——帧提交后缓冲即被清空。",{"title":15,"searchDepth":16,"depth":17,"links":194},[],"2026-11-13","readPixels 读不到内容不是 bug，是 preserveDrawingBuffer 默认关闭——帧提交后缓冲即被清空。",{},"\u002Fnotes\u002F2026-11-14-2",{"description":196},"notes\u002F2026-11-14-2","i7xWqq2eNoU_seSbLQjqlB9gE51fM-PVLUEYCHBkOA4",1795274509138]