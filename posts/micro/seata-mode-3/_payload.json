[{"data":1,"prerenderedAt":202},["ShallowReactive",2],{"notes-latest-1":3,"post:\u002Fposts\u002Fmicro\u002Fseata-mode-3":27,"surround:\u002Fposts\u002Fmicro\u002Fseata-mode-3":130,"notes-latest-3":137},[4],{"id":5,"title":6,"body":7,"createdAt":19,"description":13,"extension":20,"meta":21,"navigation":22,"path":23,"seo":24,"stem":25,"__hash__":26},"notes\u002Fnotes\u002F2026-11-14-1-2.md","2026 11 14 1 2",{"type":8,"value":9,"toc":14},"minimark",[10],[11,12,13],"p",{},"站点上线了「随笔」：支持一个文件多个随笔",{"title":15,"searchDepth":16,"depth":17,"links":18},"",2,3,[],"2026-11-17","md",{},true,"\u002Fnotes\u002F2026-11-14-1-2",{"description":13},"notes\u002F2026-11-14-1-2","hDP9fvaunHzVrZQ6QifuOtj9VrqbxlPb_52KE5wSjD0",{"id":28,"title":29,"author":30,"body":31,"categories":110,"comment":22,"cover":30,"createdAt":112,"description":35,"draft":113,"extension":20,"meta":114,"navigation":22,"path":119,"readingTime":120,"recommend":113,"seo":121,"series":30,"stem":122,"tags":123,"top":113,"topics":126,"updatedAt":30,"words":128,"__hash__":129},"posts\u002Fposts\u002Fmicro\u002Fseata-mode-3.md","分布式事务与 Seata 的使用体会（三）",null,{"type":8,"value":32,"toc":102},[33,36,40,43,46,49,52,55,58,61,64,67,70,73,76,78,81,84,87,90,93,96,99],[11,34,35],{},"周五晚上泡了杯茶，把这阵子零散的笔记归拢成这一篇，也算是给这周收个尾。",[37,38,39],"h2",{"id":39},"模式怎么选",[11,41,42],{},"跨服务的事务一致性，可选的方案按侵入度排：最保守是最终一致，用消息加本地事务加对账，业务侵入大但最稳；TCC 要求每个参与方实现 try、confirm、cancel 三个接口，侵入也大但性能可控；Seata 的 AT 模式最省事，框架通过代理数据源自动生成反向补偿，业务几乎无感。",[11,44,45],{},"AT 模式的适用边界要想清楚：它靠全局锁防止脏写，冲突频繁的场景性能会明显下降；回滚靠 undo log，被别的业务绕过框架改了数据就回不去。所以它适合冲突不高的常规业务，热点数据和跨框架的数据改动要另做设计。",[37,47,48],{"id":48},"实践建议",[11,50,51],{},"实践建议：全局事务的范围尽量小，把远程调用收窄到最必要的部分；每个参与方都要实现防悬挂和空回滚，这些 Seata 有配套但业务侧要确认开启；监控里盯全局事务的成功率和回滚率。另外从一开始就要想清楚，这个链路的一致性要求到底是强还是最终一致，很多场景其实消息方案就够了，别为了技术完整性强上分布式事务。",[37,53,54],{"id":54},"踩坑记录",[11,56,57],{},"WebSocket 上线之后频繁断连，本地好好的，一上 Nginx 就出问题。代理默认不转发 Upgrade 头，补上之后世界清净了，这类中间件默认行为，不踩一次真的想不到。",[11,59,60],{},"发版之后用户还在用旧页面，报接口不存在的错。index.html 被强缓存了，给 HTML 加 no-cache、静态资源带 hash 长缓存，这是前端部署的标配，后端出身的我当年是真不知道。",[11,62,63],{},"数据库连接池耗尽告警，顺着栈一看，事务方法里调了个远程接口，慢的时候一占好几秒。把远程调用挪出事务，事务粒度改小，连接池立刻宽松了。事务里只做该做的事。",[37,65,66],{"id":66},"多聊两句",[11,68,69],{},"微服务这些年在业界的口碑经历了过山车，从万物皆可拆到反思拆得过细。我的体会是拆分粒度跟着团队和业务走：一个三人团队维护三十个服务，运维成本会吃掉所有架构收益。服务边界清晰比数量重要，能合并的别硬拆。",[11,71,72],{},"分布式链路上的每个环节都有失败概率，链路越长整体成功率越低，这是乘法。所以能合并的调用合并，能并行的不串行，能缓存的缓存。链路的长度就是系统的脆弱程度，设计时对调用深度保持敬畏。",[11,74,75],{},"观测能力在分布式系统里不是锦上添花，是基础设施。日志、指标、链路追踪三件套齐了，问题定位是做阅读理解；缺了，就是通灵。新服务接入的第一天就把观测配齐，比事后补课便宜十倍。",[11,77,69],{},[37,79,80],{"id":80},"继续聊聊",[11,82,83],{},"平衡感很重要的一件事：投入和收益的比例。所有优化都值得先问一句，这件事的收益上限是多少，值多少投入。无限打磨一个低价值的东西是工程师最常见的温柔陷阱，包括我自己在内。",[11,85,86],{},"忍不住再夸一下记录的力量，上周刚整理的笔记，这次直接翻出来就用，十分钟解决了当时花一下午的问题。给自己留下的每一份笔记，都是寄给未来的快递，寄件人签收时才觉得真香。",[11,88,89],{},"最后聊点感受：做技术这些年，越来越觉得最好的状态是既投入又抽离。投入是把事情做好，抽离是时不时跳出来看看方向对不对，两者缺一，要么辛苦没产出，要么轻松跑偏路。",[11,91,92],{},"写着写着想到，很多技术选择本质上都是在回答同一个问题：这个方案在出问题的时候是什么样子。不出问题的方案人人都写得出来，区分度全在故障时刻的表现。多想一层失败路径，很多纠结就自动有了答案。",[37,94,95],{"id":95},"最后",[11,97,98],{},"写完这篇下楼跑了个五公里，脑子里剩下的方案细节，居然是跑步的时候理顺的。",[11,100,101],{},"这篇就写到这，希望对你有点参考价值。",{"title":15,"searchDepth":16,"depth":17,"links":103},[104,105,106,107,108,109],{"id":39,"depth":16,"text":39},{"id":48,"depth":16,"text":48},{"id":54,"depth":16,"text":54},{"id":66,"depth":16,"text":66},{"id":80,"depth":16,"text":80},{"id":95,"depth":16,"text":95},[111],"微服务","2024-12-02",false,{"excerpt":115},{"type":8,"value":116},[117],[11,118,35],{},"\u002Fposts\u002Fmicro\u002Fseata-mode-3",379200,{"title":29,"description":35},"posts\u002Fmicro\u002Fseata-mode-3",[124,125],"分布式事务","Seata",[127],"micro",1264,"0xGlT4-_wXZbmiIBHXwxJABHxk7KwJO0LQ_jnXP1oOQ",{"prev":131,"next":134},{"path":132,"title":133},"\u002Fposts\u002Fmicro\u002Fseata-mode-2","分布式事务与 Seata 的使用体会（二）",{"path":135,"title":136},"\u002Fposts\u002Fmicro\u002Fseata-mode-4","分布式事务与 Seata 的使用体会（四）",[138,147,177],{"id":5,"title":6,"body":139,"createdAt":19,"description":13,"extension":20,"meta":145,"navigation":22,"path":23,"seo":146,"stem":25,"__hash__":26},{"type":8,"value":140,"toc":143},[141],[11,142,13],{},{"title":15,"searchDepth":16,"depth":17,"links":144},[],{},{"description":13},{"id":148,"title":149,"body":150,"createdAt":170,"description":171,"extension":20,"meta":172,"navigation":22,"path":173,"seo":174,"stem":175,"__hash__":176},"notes\u002Fnotes\u002F2026-11-14-1.md","2026 11 14 1",{"type":8,"value":151,"toc":168},[152],[11,153,154,155,159,160,167],{},"站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 ",[156,157,158],"strong",{},"Markdown","，写链接也不用到编辑器：",[161,162,166],"a",{"href":163,"rel":164},"https:\u002F\u002Fcontent.nuxt.com",[165],"nofollow","Nuxt Content","。",{"title":15,"searchDepth":16,"depth":17,"links":169},[],"2026-11-14","站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 Markdown，写链接也不用到编辑器：Nuxt Content。",{},"\u002Fnotes\u002F2026-11-14-1",{"description":171},"notes\u002F2026-11-14-1","LLJX_RKU7cgpT6aHw4DZWUZNQ_G_UzELWPKbksJvzfs",{"id":178,"title":179,"body":180,"createdAt":195,"description":196,"extension":20,"meta":197,"navigation":22,"path":198,"seo":199,"stem":200,"__hash__":201},"notes\u002Fnotes\u002F2026-11-14-2.md","2026 11 14 2",{"type":8,"value":181,"toc":193},[182],[11,183,184,188,189,192],{},[185,186,187],"code",{},"readPixels"," 读不到内容不是 bug，是 ",[185,190,191],{},"preserveDrawingBuffer"," 默认关闭——帧提交后缓冲即被清空。",{"title":15,"searchDepth":16,"depth":17,"links":194},[],"2026-11-13","readPixels 读不到内容不是 bug，是 preserveDrawingBuffer 默认关闭——帧提交后缓冲即被清空。",{},"\u002Fnotes\u002F2026-11-14-2",{"description":196},"notes\u002F2026-11-14-2","i7xWqq2eNoU_seSbLQjqlB9gE51fM-PVLUEYCHBkOA4",1795333664737]