[{"data":1,"prerenderedAt":206},["ShallowReactive",2],{"notes-latest-1":3,"post:\u002Fposts\u002Fdb\u002Fbtree-index-6":27,"surround:\u002Fposts\u002Fdb\u002Fbtree-index-6":134,"notes-latest-3":141},[4],{"id":5,"title":6,"body":7,"createdAt":19,"description":13,"extension":20,"meta":21,"navigation":22,"path":23,"seo":24,"stem":25,"__hash__":26},"notes\u002Fnotes\u002F2026-11-14-1-2.md","2026 11 14 1 2",{"type":8,"value":9,"toc":14},"minimark",[10],[11,12,13],"p",{},"站点上线了「随笔」：支持一个文件多个随笔",{"title":15,"searchDepth":16,"depth":17,"links":18},"",2,3,[],"2026-11-17","md",{},true,"\u002Fnotes\u002F2026-11-14-1-2",{"description":13},"notes\u002F2026-11-14-1-2","hDP9fvaunHzVrZQ6QifuOtj9VrqbxlPb_52KE5wSjD0",{"id":28,"title":29,"author":30,"body":31,"categories":114,"comment":22,"cover":30,"createdAt":116,"description":35,"draft":117,"extension":20,"meta":118,"navigation":22,"path":123,"readingTime":124,"recommend":117,"seo":125,"series":30,"stem":126,"tags":127,"top":117,"topics":130,"updatedAt":30,"words":132,"__hash__":133},"posts\u002Fposts\u002Fdb\u002Fbtree-index-6.md","B+ 树与索引设计的底层逻辑（六）",null,{"type":8,"value":32,"toc":106},[33,36,41,44,47,50,53,56,59,62,65,68,71,74,77,80,82,85,88,91,94,97,100,103],[11,34,35],{},"想写这个话题很久了，一直没找到合适的角度，这篇先把核心的部分讲清楚，细节以后再展开。",[37,38,40],"h2",{"id":39},"为什么是-b-树","为什么是 B+ 树",[11,42,43],{},"索引结构选 B+ 树而不是二叉树或者哈希，原因可以从磁盘 IO 说起：树的高度决定一次查询要几次 IO，B+ 树的节点是一个页，单个节点能塞几百上千个键，三层的 B+ 树就能支撑两千万级的数据，也就是三次页访问。哈希虽然等值查询快，但范围查询和排序无能为力，而业务里这类查询太常见了。",[11,45,46],{},"聚簇索引把数据行直接挂在叶子节点上，二级索引的叶子存的是主键值，所以走二级索引再查整行需要回表。理解了回表，就理解了覆盖索引为什么快：查询的列都在索引里，省掉回表这一步，整个查询就是纯索引扫描。",[37,48,49],{"id":49},"设计索引的几条依据",[11,51,52],{},"落到设计上几条依据：区分度高的列放前面，等值条件优先于范围条件，因为范围之后的列用不上索引的有序性；联合索引尽量覆盖高频查询的列，减少回表；字符串列可以用前缀索引省空间。还有别忘了最左前缀原则，联合索引不是建了就能随便用，条件顺序和索引顺序对不上，优化器只能干瞪眼。",[37,54,55],{"id":55},"记两个小问题",[11,57,58],{},"定时任务上线后时间全不对，cron 是按服务器时区算的，容器里又是 UTC。统一时区这种事，应该在基础设施层一次做对，而不是每个应用各自打补丁。",[11,60,61],{},"分页参数没做上限校验，被前端误传了个 pageSize 一万，数据库当场趴下。所有来自外部的参数都不可信，这句话说了十年，依然每年有人用事故重新验证一遍。",[11,63,64],{},"并行流里往共享 ArrayList 里塞数据，测试没跑出来，上线偶发丢数据。收集操作老老实实用 collect，共享可变状态在并发场景下永远是个雷，不管包装得多漂亮。",[37,66,67],{"id":67},"顺便一提",[11,69,70],{},"数据量增长是所有方案失效的终极原因。现在跑得好好的查询，数据翻十倍之后可能完全是另一副面孔。容量规划不是运维一个人的事，写代码的时候对表的增长速度心里有数，才能提前留出退路。",[11,72,73],{},"备份和演练是数据库运维的两条底线。备份没验证过可恢复，等于心理安慰；恢复流程没演练过，真出事时的时间压力会放大所有操作失误。这两件事建议按季度固定做，形成肌肉记忆。",[11,75,76],{},"数据库问题的通用排查思路值得单独记一笔：先看监控确认是慢查询、锁等待还是资源瓶颈，再看执行计划和锁日志定位到具体语句，最后才考虑改索引或改写法。顺序反了容易在错误的方向上耗掉一晚上。",[11,78,79],{},"索引设计说到底是在读写之间做权衡，每加一个索引，写入成本就涨一分。我的习惯是定期审计索引的实际使用情况，把长期没被命中的索引下掉，这个动作在写入量大的表上收益立竿见影。",[11,81,70],{},[37,83,84],{"id":84},"另外记几笔",[11,86,87],{},"回顾这个过程，最大的教训其实是克制。可选项永远比需要的多，每个新方案看起来都比现状好一点，但都加上之后，系统就成了没人看得懂的拼贴画。做减法的判断比做加法的胆子更值钱。",[11,89,90],{},"这种事急不来，和锻炼身体是一个道理：练一天没变化，练三个月身体自己会说话。技术积累也是这样，每天一点，回过头看的时候差距已经拉开了，只是身在其中感觉不到而已。",[11,92,93],{},"想到一个问题：为什么同样的事情，不同的人做出来差别那么大。后来觉得答案在于对边界的处理，正常路径人人会写，边界和异常的处理习惯才是拉开差距的地方。做事和写代码一样，细节的密度决定成品的质量。",[11,95,96],{},"写到这里顺便吐个槽，这类事情最难的部分往往不是技术本身，是说服别人相信它值得投入。方案再好，落不到排期上都是空谈，所以学会用数据的语言讲价值，算是这些年额外的必修课。",[37,98,99],{"id":99},"写在最后",[11,101,102],{},"上午改代码，下午陪家人逛了趟超市，晚上坐下来写这篇，一天过得挺满。",[11,104,105],{},"大概就是这些，有不同做法欢迎评论区交流。",{"title":15,"searchDepth":16,"depth":17,"links":107},[108,109,110,111,112,113],{"id":39,"depth":16,"text":40},{"id":49,"depth":16,"text":49},{"id":55,"depth":16,"text":55},{"id":67,"depth":16,"text":67},{"id":84,"depth":16,"text":84},{"id":99,"depth":16,"text":99},[115],"数据库","2022-11-02",false,{"excerpt":119},{"type":8,"value":120},[121],[11,122,35],{},"\u002Fposts\u002Fdb\u002Fbtree-index-6",402600,{"title":29,"description":35},"posts\u002Fdb\u002Fbtree-index-6",[128,129],"MySQL","索引",[131],"db",1342,"dFQGvZnNF5EUGGL53ChIsEpji2BGw8oJ27B5GFjSPuk",{"prev":135,"next":138},{"path":136,"title":137},"\u002Fposts\u002Fdb\u002Fbtree-index-5","B+ 树与索引设计的底层逻辑（五）",{"path":139,"title":140},"\u002Fposts\u002Fdb\u002Fcount-optimize","count 统计的几种姿势对比",[142,151,181],{"id":5,"title":6,"body":143,"createdAt":19,"description":13,"extension":20,"meta":149,"navigation":22,"path":23,"seo":150,"stem":25,"__hash__":26},{"type":8,"value":144,"toc":147},[145],[11,146,13],{},{"title":15,"searchDepth":16,"depth":17,"links":148},[],{},{"description":13},{"id":152,"title":153,"body":154,"createdAt":174,"description":175,"extension":20,"meta":176,"navigation":22,"path":177,"seo":178,"stem":179,"__hash__":180},"notes\u002Fnotes\u002F2026-11-14-1.md","2026 11 14 1",{"type":8,"value":155,"toc":172},[156],[11,157,158,159,163,164,171],{},"站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 ",[160,161,162],"strong",{},"Markdown","，写链接也不用到编辑器：",[165,166,170],"a",{"href":167,"rel":168},"https:\u002F\u002Fcontent.nuxt.com",[169],"nofollow","Nuxt Content","。",{"title":15,"searchDepth":16,"depth":17,"links":173},[],"2026-11-14","站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 Markdown，写链接也不用到编辑器：Nuxt Content。",{},"\u002Fnotes\u002F2026-11-14-1",{"description":175},"notes\u002F2026-11-14-1","LLJX_RKU7cgpT6aHw4DZWUZNQ_G_UzELWPKbksJvzfs",{"id":182,"title":183,"body":184,"createdAt":199,"description":200,"extension":20,"meta":201,"navigation":22,"path":202,"seo":203,"stem":204,"__hash__":205},"notes\u002Fnotes\u002F2026-11-14-2.md","2026 11 14 2",{"type":8,"value":185,"toc":197},[186],[11,187,188,192,193,196],{},[189,190,191],"code",{},"readPixels"," 读不到内容不是 bug，是 ",[189,194,195],{},"preserveDrawingBuffer"," 默认关闭——帧提交后缓冲即被清空。",{"title":15,"searchDepth":16,"depth":17,"links":198},[],"2026-11-13","readPixels 读不到内容不是 bug，是 preserveDrawingBuffer 默认关闭——帧提交后缓冲即被清空。",{},"\u002Fnotes\u002F2026-11-14-2",{"description":200},"notes\u002F2026-11-14-2","i7xWqq2eNoU_seSbLQjqlB9gE51fM-PVLUEYCHBkOA4",1795275195776]