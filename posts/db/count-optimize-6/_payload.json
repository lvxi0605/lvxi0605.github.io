[{"data":1,"prerenderedAt":209},["ShallowReactive",2],{"notes-latest-1":3,"post:\u002Fposts\u002Fdb\u002Fcount-optimize-6":27,"surround:\u002Fposts\u002Fdb\u002Fcount-optimize-6":137,"notes-latest-3":144},[4],{"id":5,"title":6,"body":7,"createdAt":19,"description":13,"extension":20,"meta":21,"navigation":22,"path":23,"seo":24,"stem":25,"__hash__":26},"notes\u002Fnotes\u002F2026-11-14-1-2.md","2026 11 14 1 2",{"type":8,"value":9,"toc":14},"minimark",[10],[11,12,13],"p",{},"站点上线了「随笔」：支持一个文件多个随笔",{"title":15,"searchDepth":16,"depth":17,"links":18},"",2,3,[],"2026-11-17","md",{},true,"\u002Fnotes\u002F2026-11-14-1-2",{"description":13},"notes\u002F2026-11-14-1-2","hDP9fvaunHzVrZQ6QifuOtj9VrqbxlPb_52KE5wSjD0",{"id":28,"title":29,"author":30,"body":31,"categories":118,"comment":22,"cover":30,"createdAt":120,"description":35,"draft":121,"extension":20,"meta":122,"navigation":22,"path":127,"readingTime":128,"recommend":121,"seo":129,"series":30,"stem":130,"tags":131,"top":121,"topics":133,"updatedAt":30,"words":135,"__hash__":136},"posts\u002Fposts\u002Fdb\u002Fcount-optimize-6.md","count 统计的几种姿势对比（六）",null,{"type":8,"value":32,"toc":110},[33,36,40,48,51,54,57,60,63,66,69,72,75,78,81,84,86,89,92,95,98,101,104,107],[11,34,35],{},"又是拖了很久才动笔的一篇，草稿箱里躺了快一个月，趁周末把思路理一理，一次写完。",[37,38,39],"h2",{"id":39},"不同写法的成本",[11,41,42,43,47],{},"count(",[44,45,46],"em",{},")、count(1)、count(id)、count(col) 这几种写法的区别是老话题了：前两者语义相同，都是统计行数，优化器会挑最小的索引来扫；count(id) 也没什么额外优势；count(col) 语义不同，不统计该列为 null 的行，需要取出列值判断，成本反而高。日常统计行数就放心用 count(",")，不要有性能洁癖式的误解。",[11,49,50],{},"真正的问题是大表行数统计本身：千万级数据哪怕走最小的索引，也要扫完整个索引树，几秒起步。如果一个页面实时展示总量，数据库是扛不住的，这个矛盾要提前想。",[37,52,53],{"id":53},"三种业务侧方案",[11,55,56],{},"业务侧的方案大致三种：近似值用 explain 的 rows 估算，监控大盘够用了；要求准确又高频的，用 Redis 计数器增量维护，注意和写库放一个事务边界或者用对账兜底；要求严格但低频的，定时任务离线统计缓存住。选哪种取决于这个数字到底有多少人在看，别为了一个角落里的统计给主库加压。",[37,58,59],{"id":59},"踩坑记录",[11,61,62],{},"容器里日志时间和本地对不上，查了半天是时区，默认 UTC。在环境变量里把 TZ 设成 Asia\u002FShanghai，顺带把 JDK 参数也统一了，从此日志排查不用再做心算换算。",[11,64,65],{},"Feign 的超时配置怎么改都不生效，最后发现是配置前缀少写了一层，配置根本没被读到。教训是改完配置要打印生效值确认，光看配置文件自我感觉良好是不行的。",[11,67,68],{},"Kafka 某个分区消费延迟特别高，看数据发现某大客户的消息占了总量一半，按 userId 分区全进了一个分区。大客户单独走一个 topic 才解决，倾斜问题在哪个中间件里都一样。",[37,70,71],{"id":71},"多聊两句",[11,73,74],{},"数据库问题的通用排查思路值得单独记一笔：先看监控确认是慢查询、锁等待还是资源瓶颈，再看执行计划和锁日志定位到具体语句，最后才考虑改索引或改写法。顺序反了容易在错误的方向上耗掉一晚上。",[11,76,77],{},"索引设计说到底是在读写之间做权衡，每加一个索引，写入成本就涨一分。我的习惯是定期审计索引的实际使用情况，把长期没被命中的索引下掉，这个动作在写入量大的表上收益立竿见影。",[11,79,80],{},"数据量增长是所有方案失效的终极原因。现在跑得好好的查询，数据翻十倍之后可能完全是另一副面孔。容量规划不是运维一个人的事，写代码的时候对表的增长速度心里有数，才能提前留出退路。",[11,82,83],{},"备份和演练是数据库运维的两条底线。备份没验证过可恢复，等于心理安慰；恢复流程没演练过，真出事时的时间压力会放大所有操作失误。这两件事建议按季度固定做，形成肌肉记忆。",[11,85,74],{},[37,87,88],{"id":88},"继续聊聊",[11,90,91],{},"还有个感受越来越深：知识落地成文字的过程本身就是学习的一部分。很多自以为想清楚的东西，写出来才发现逻辑有洞。写作是最好的检验，这也是坚持写博客这么多年的理由之一，写不出来的就是还没学会的。",[11,93,94],{},"过程中也反复体会到取舍的本质：没有完美的方案，只有当下约束下最合适的方案。把约束写清楚，方案的选择题就变成了证明题，这也是为什么我习惯先列约束再谈方案，顺序反了全是无效争论。",[11,96,97],{},"想想还是补一段：任何习惯的养成都绕不开启动成本，最有效的办法是把启动成本降到接近零。想跑就把鞋放门口，想写就把文档开着置顶，环境准备到位了，行动只是顺水推舟。",[11,99,100],{},"从更高的视角看，这类问题都有一个共同结构：短期收益和长期收益打架。短期的诱惑总是具体而生动，长期的回报抽象而遥远，赢家通常是那些把长期目标拆成短期可感的小奖励的人。",[37,102,103],{"id":103},"最后",[11,105,106],{},"泡的茶忘了喝，回过神已经凉透了，进入状态的时候对时间的感知就剩这点不好。",[11,108,109],{},"暂时记到这，下次接着说。",{"title":15,"searchDepth":16,"depth":17,"links":111},[112,113,114,115,116,117],{"id":39,"depth":16,"text":39},{"id":53,"depth":16,"text":53},{"id":59,"depth":16,"text":59},{"id":71,"depth":16,"text":71},{"id":88,"depth":16,"text":88},{"id":103,"depth":16,"text":103},[119],"数据库","2026-09-30",false,{"excerpt":123},{"type":8,"value":124},[125],[11,126,35],{},"\u002Fposts\u002Fdb\u002Fcount-optimize-6",389400,{"title":29,"description":35},"posts\u002Fdb\u002Fcount-optimize-6",[132],"MySQL",[134],"db",1298,"lF_aX5vZEQsKe08ZMRUpCzWCCqzUo59xGlkSEbf8Q8k",{"prev":138,"next":141},{"path":139,"title":140},"\u002Fposts\u002Fdb\u002Fcount-optimize-5","count 统计的几种姿势对比（五）",{"path":142,"title":143},"\u002Fposts\u002Fdb\u002Fdeadlock-check","一次线上死锁的排查记录",[145,154,184],{"id":5,"title":6,"body":146,"createdAt":19,"description":13,"extension":20,"meta":152,"navigation":22,"path":23,"seo":153,"stem":25,"__hash__":26},{"type":8,"value":147,"toc":150},[148],[11,149,13],{},{"title":15,"searchDepth":16,"depth":17,"links":151},[],{},{"description":13},{"id":155,"title":156,"body":157,"createdAt":177,"description":178,"extension":20,"meta":179,"navigation":22,"path":180,"seo":181,"stem":182,"__hash__":183},"notes\u002Fnotes\u002F2026-11-14-1.md","2026 11 14 1",{"type":8,"value":158,"toc":175},[159],[11,160,161,162,166,167,174],{},"站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 ",[163,164,165],"strong",{},"Markdown","，写链接也不用到编辑器：",[168,169,173],"a",{"href":170,"rel":171},"https:\u002F\u002Fcontent.nuxt.com",[172],"nofollow","Nuxt Content","。",{"title":15,"searchDepth":16,"depth":17,"links":176},[],"2026-11-14","站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 Markdown，写链接也不用到编辑器：Nuxt Content。",{},"\u002Fnotes\u002F2026-11-14-1",{"description":178},"notes\u002F2026-11-14-1","LLJX_RKU7cgpT6aHw4DZWUZNQ_G_UzELWPKbksJvzfs",{"id":185,"title":186,"body":187,"createdAt":202,"description":203,"extension":20,"meta":204,"navigation":22,"path":205,"seo":206,"stem":207,"__hash__":208},"notes\u002Fnotes\u002F2026-11-14-2.md","2026 11 14 2",{"type":8,"value":188,"toc":200},[189],[11,190,191,195,196,199],{},[192,193,194],"code",{},"readPixels"," 读不到内容不是 bug，是 ",[192,197,198],{},"preserveDrawingBuffer"," 默认关闭——帧提交后缓冲即被清空。",{"title":15,"searchDepth":16,"depth":17,"links":201},[],"2026-11-13","readPixels 读不到内容不是 bug，是 preserveDrawingBuffer 默认关闭——帧提交后缓冲即被清空。",{},"\u002Fnotes\u002F2026-11-14-2",{"description":203},"notes\u002F2026-11-14-2","i7xWqq2eNoU_seSbLQjqlB9gE51fM-PVLUEYCHBkOA4",1795274106480]