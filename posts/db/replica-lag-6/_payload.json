[{"data":1,"prerenderedAt":205},["ShallowReactive",2],{"notes-latest-1":3,"post:\u002Fposts\u002Fdb\u002Freplica-lag-6":27,"surround:\u002Fposts\u002Fdb\u002Freplica-lag-6":133,"notes-latest-3":140},[4],{"id":5,"title":6,"body":7,"createdAt":19,"description":13,"extension":20,"meta":21,"navigation":22,"path":23,"seo":24,"stem":25,"__hash__":26},"notes\u002Fnotes\u002F2026-11-14-1-2.md","2026 11 14 1 2",{"type":8,"value":9,"toc":14},"minimark",[10],[11,12,13],"p",{},"站点上线了「随笔」：支持一个文件多个随笔",{"title":15,"searchDepth":16,"depth":17,"links":18},"",2,3,[],"2026-11-17","md",{},true,"\u002Fnotes\u002F2026-11-14-1-2",{"description":13},"notes\u002F2026-11-14-1-2","hDP9fvaunHzVrZQ6QifuOtj9VrqbxlPb_52KE5wSjD0",{"id":28,"title":29,"author":30,"body":31,"categories":113,"comment":22,"cover":30,"createdAt":115,"description":35,"draft":116,"extension":20,"meta":117,"navigation":22,"path":122,"readingTime":123,"recommend":116,"seo":124,"series":30,"stem":125,"tags":126,"top":116,"topics":129,"updatedAt":30,"words":131,"__hash__":132},"posts\u002Fposts\u002Fdb\u002Freplica-lag-6.md","主从延迟的那些原因与对策（六）",null,{"type":8,"value":32,"toc":105},[33,36,40,43,46,49,52,55,58,61,64,67,70,73,76,79,81,84,87,90,93,96,99,102],[11,34,35],{},"前几天有同事问到这个，我口头讲了一遍，回头想想还是写成文章更完整，也算把自己的理解再过一遍。",[37,38,39],"h2",{"id":39},"延迟从哪来",[11,41,42],{},"主从延迟的表现是写完主库立刻读从库，读到的还是旧数据。原因通常几类：从库单线程回放（高版本有并行复制但默认配置未必开启）、大事务在主库执行了几分钟从库就要回放几分钟、从库机器规格太低、还有表没有主键导致回放全表扫描。",[11,44,45],{},"业务上还有个常见的放大器：写完立刻读的强一致读场景，本该走主库却被路由到了从库。这类读并不多，但它们一出现就是必现的不一致，用户感知极强。",[37,47,48],{"id":48},"对策清单",[11,50,51],{},"对策清单：开启并行复制并调整 worker 数；大事务拆小，批量更新分批提交；确认所有表都有主键；对强一致读的业务代码里显式指定走主库，或者用读自己的写那套方案；监控上把延迟秒数做成告警而不是等用户反馈。延迟不会消失，只能被压到业务无感的程度，把哪些读可以容忍延迟想清楚，比盲目堆从库更有效。",[37,53,54],{"id":54},"过程中的两个坑",[11,56,57],{},"前端拿 Long 类型的 id 显示成了另一个数，JS 的 Number 精度上限就到 2 的 53 次方。序列化时把 Long 转 String，这是前后端协作里经典的暗坑，吃过一次亏就会记一辈子。",[11,59,60],{},"定时任务上线后时间全不对，cron 是按服务器时区算的，容器里又是 UTC。统一时区这种事，应该在基础设施层一次做对，而不是每个应用各自打补丁。",[11,62,63],{},"分页参数没做上限校验，被前端误传了个 pageSize 一万，数据库当场趴下。所有来自外部的参数都不可信，这句话说了十年，依然每年有人用事故重新验证一遍。",[37,65,66],{"id":66},"延伸几句",[11,68,69],{},"数据库问题的通用排查思路值得单独记一笔：先看监控确认是慢查询、锁等待还是资源瓶颈，再看执行计划和锁日志定位到具体语句，最后才考虑改索引或改写法。顺序反了容易在错误的方向上耗掉一晚上。",[11,71,72],{},"索引设计说到底是在读写之间做权衡，每加一个索引，写入成本就涨一分。我的习惯是定期审计索引的实际使用情况，把长期没被命中的索引下掉，这个动作在写入量大的表上收益立竿见影。",[11,74,75],{},"数据量增长是所有方案失效的终极原因。现在跑得好好的查询，数据翻十倍之后可能完全是另一副面孔。容量规划不是运维一个人的事，写代码的时候对表的增长速度心里有数，才能提前留出退路。",[11,77,78],{},"备份和演练是数据库运维的两条底线。备份没验证过可恢复，等于心理安慰；恢复流程没演练过，真出事时的时间压力会放大所有操作失误。这两件事建议按季度固定做，形成肌肉记忆。",[11,80,69],{},[37,82,83],{"id":83},"又想到一些",[11,85,86],{},"这种事急不来，和锻炼身体是一个道理：练一天没变化，练三个月身体自己会说话。技术积累也是这样，每天一点，回过头看的时候差距已经拉开了，只是身在其中感觉不到而已。",[11,88,89],{},"想到一个问题：为什么同样的事情，不同的人做出来差别那么大。后来觉得答案在于对边界的处理，正常路径人人会写，边界和异常的处理习惯才是拉开差距的地方。做事和写代码一样，细节的密度决定成品的质量。",[11,91,92],{},"写到这里顺便吐个槽，这类事情最难的部分往往不是技术本身，是说服别人相信它值得投入。方案再好，落不到排期上都是空谈，所以学会用数据的语言讲价值，算是这些年额外的必修课。",[11,94,95],{},"有时候会想，学一门新技术到底学到的是什么。语法和 API 会过时，真正的收获是它看问题的角度。多一门语言就多一副眼镜，同一副牌桌，能看到别人看不到的牌路，这是这么多年折腾下来最确定的回报。",[37,97,98],{"id":98},"小结",[11,100,101],{},"这个问题卡了我三天，最后是在等咖啡的间隙突然想明白的，回工位十分钟改完，人有时候就得离屏幕远一点。",[11,103,104],{},"如果你也遇到类似的情况，评论区聊聊。",{"title":15,"searchDepth":16,"depth":17,"links":106},[107,108,109,110,111,112],{"id":39,"depth":16,"text":39},{"id":48,"depth":16,"text":48},{"id":54,"depth":16,"text":54},{"id":66,"depth":16,"text":66},{"id":83,"depth":16,"text":83},{"id":98,"depth":16,"text":98},[114],"数据库","2025-03-02",false,{"excerpt":118},{"type":8,"value":119},[120],[11,121,35],{},"\u002Fposts\u002Fdb\u002Freplica-lag-6",397200,{"title":29,"description":35},"posts\u002Fdb\u002Freplica-lag-6",[127,128],"MySQL","主从",[130],"db",1324,"ug9BZj7ZyvYCMzrYFaiMoWfiC2ZPPTyEyckWvu7ZB8o",{"prev":134,"next":137},{"path":135,"title":136},"\u002Fposts\u002Fdb\u002Freplica-lag-5","主从延迟的那些原因与对策（五）",{"path":138,"title":139},"\u002Fposts\u002Fdb\u002Fslow-sql","慢 SQL 优化的固定套路",[141,150,180],{"id":5,"title":6,"body":142,"createdAt":19,"description":13,"extension":20,"meta":148,"navigation":22,"path":23,"seo":149,"stem":25,"__hash__":26},{"type":8,"value":143,"toc":146},[144],[11,145,13],{},{"title":15,"searchDepth":16,"depth":17,"links":147},[],{},{"description":13},{"id":151,"title":152,"body":153,"createdAt":173,"description":174,"extension":20,"meta":175,"navigation":22,"path":176,"seo":177,"stem":178,"__hash__":179},"notes\u002Fnotes\u002F2026-11-14-1.md","2026 11 14 1",{"type":8,"value":154,"toc":171},[155],[11,156,157,158,162,163,170],{},"站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 ",[159,160,161],"strong",{},"Markdown","，写链接也不用到编辑器：",[164,165,169],"a",{"href":166,"rel":167},"https:\u002F\u002Fcontent.nuxt.com",[168],"nofollow","Nuxt Content","。",{"title":15,"searchDepth":16,"depth":17,"links":172},[],"2026-11-14","站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 Markdown，写链接也不用到编辑器：Nuxt Content。",{},"\u002Fnotes\u002F2026-11-14-1",{"description":174},"notes\u002F2026-11-14-1","LLJX_RKU7cgpT6aHw4DZWUZNQ_G_UzELWPKbksJvzfs",{"id":181,"title":182,"body":183,"createdAt":198,"description":199,"extension":20,"meta":200,"navigation":22,"path":201,"seo":202,"stem":203,"__hash__":204},"notes\u002Fnotes\u002F2026-11-14-2.md","2026 11 14 2",{"type":8,"value":184,"toc":196},[185],[11,186,187,191,192,195],{},[188,189,190],"code",{},"readPixels"," 读不到内容不是 bug，是 ",[188,193,194],{},"preserveDrawingBuffer"," 默认关闭——帧提交后缓冲即被清空。",{"title":15,"searchDepth":16,"depth":17,"links":197},[],"2026-11-13","readPixels 读不到内容不是 bug，是 preserveDrawingBuffer 默认关闭——帧提交后缓冲即被清空。",{},"\u002Fnotes\u002F2026-11-14-2",{"description":199},"notes\u002F2026-11-14-2","i7xWqq2eNoU_seSbLQjqlB9gE51fM-PVLUEYCHBkOA4",1795303386588]