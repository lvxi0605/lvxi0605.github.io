[{"data":1,"prerenderedAt":206},["ShallowReactive",2],{"notes-latest-1":3,"post:\u002Fposts\u002Fdb\u002Fbtree-index-2":27,"surround:\u002Fposts\u002Fdb\u002Fbtree-index-2":134,"notes-latest-3":141},[4],{"id":5,"title":6,"body":7,"createdAt":19,"description":13,"extension":20,"meta":21,"navigation":22,"path":23,"seo":24,"stem":25,"__hash__":26},"notes\u002Fnotes\u002F2026-11-14-1-2.md","2026 11 14 1 2",{"type":8,"value":9,"toc":14},"minimark",[10],[11,12,13],"p",{},"站点上线了「随笔」：支持一个文件多个随笔",{"title":15,"searchDepth":16,"depth":17,"links":18},"",2,3,[],"2026-11-17","md",{},true,"\u002Fnotes\u002F2026-11-14-1-2",{"description":13},"notes\u002F2026-11-14-1-2","hDP9fvaunHzVrZQ6QifuOtj9VrqbxlPb_52KE5wSjD0",{"id":28,"title":29,"author":30,"body":31,"categories":114,"comment":22,"cover":30,"createdAt":116,"description":35,"draft":117,"extension":20,"meta":118,"navigation":22,"path":123,"readingTime":124,"recommend":117,"seo":125,"series":30,"stem":126,"tags":127,"top":117,"topics":130,"updatedAt":30,"words":132,"__hash__":133},"posts\u002Fposts\u002Fdb\u002Fbtree-index-2.md","B+ 树与索引设计的底层逻辑（二）",null,{"type":8,"value":32,"toc":106},[33,36,41,44,47,50,53,56,59,62,65,68,71,74,77,80,82,85,88,91,94,97,100,103],[11,34,35],{},"长话短说，这篇就是一次完整的记录，从问题怎么来的，到最后方案怎么定，中间的弯路也都保留。",[37,38,40],"h2",{"id":39},"为什么是-b-树","为什么是 B+ 树",[11,42,43],{},"索引结构选 B+ 树而不是二叉树或者哈希，原因可以从磁盘 IO 说起：树的高度决定一次查询要几次 IO，B+ 树的节点是一个页，单个节点能塞几百上千个键，三层的 B+ 树就能支撑两千万级的数据，也就是三次页访问。哈希虽然等值查询快，但范围查询和排序无能为力，而业务里这类查询太常见了。",[11,45,46],{},"聚簇索引把数据行直接挂在叶子节点上，二级索引的叶子存的是主键值，所以走二级索引再查整行需要回表。理解了回表，就理解了覆盖索引为什么快：查询的列都在索引里，省掉回表这一步，整个查询就是纯索引扫描。",[37,48,49],{"id":49},"设计索引的几条依据",[11,51,52],{},"落到设计上几条依据：区分度高的列放前面，等值条件优先于范围条件，因为范围之后的列用不上索引的有序性；联合索引尽量覆盖高频查询的列，减少回表；字符串列可以用前缀索引省空间。还有别忘了最左前缀原则，联合索引不是建了就能随便用，条件顺序和索引顺序对不上，优化器只能干瞪眼。",[37,54,55],{"id":55},"记两个小问题",[11,57,58],{},"数据迁移演练时发现字段长度截断，源库字符集和目标库不一样，同一段中文占的长度都不同。迁移脚本先在影子表跑一遍，这种事不演练，上了生产就是事故。",[11,60,61],{},"@Transactional 加在私有方法上、或者同类里自调用，事务都是不生效的，因为绕过了代理对象。这类 AOP 的坑，理解了代理机制就一目了然，没理解之前就是玄学。",[11,63,64],{},"服务注册状态看着正常，流量却没打过来。心跳超时加上保护阈值，Nacos 短暂摘除了实例。注册中心的状态和真实可用性是两回事，健康检查永远要结合业务探活来看。",[37,66,67],{"id":67},"顺便一提",[11,69,70],{},"数据量增长是所有方案失效的终极原因。现在跑得好好的查询，数据翻十倍之后可能完全是另一副面孔。容量规划不是运维一个人的事，写代码的时候对表的增长速度心里有数，才能提前留出退路。",[11,72,73],{},"备份和演练是数据库运维的两条底线。备份没验证过可恢复，等于心理安慰；恢复流程没演练过，真出事时的时间压力会放大所有操作失误。这两件事建议按季度固定做，形成肌肉记忆。",[11,75,76],{},"数据库问题的通用排查思路值得单独记一笔：先看监控确认是慢查询、锁等待还是资源瓶颈，再看执行计划和锁日志定位到具体语句，最后才考虑改索引或改写法。顺序反了容易在错误的方向上耗掉一晚上。",[11,78,79],{},"索引设计说到底是在读写之间做权衡，每加一个索引，写入成本就涨一分。我的习惯是定期审计索引的实际使用情况，把长期没被命中的索引下掉，这个动作在写入量大的表上收益立竿见影。",[11,81,70],{},[37,83,84],{"id":84},"另外记几笔",[11,86,87],{},"然后想说，承认不懂是这行的美德。这次遇到不懂的地方，老老实实补了两天的课，比硬着头皮往上糊的方案强太多。不懂装懂的代价从来不会消失，只是延期，还带利息。",[11,89,90],{},"平衡感很重要的一件事：投入和收益的比例。所有优化都值得先问一句，这件事的收益上限是多少，值多少投入。无限打磨一个低价值的东西是工程师最常见的温柔陷阱，包括我自己在内。",[11,92,93],{},"忍不住再夸一下记录的力量，上周刚整理的笔记，这次直接翻出来就用，十分钟解决了当时花一下午的问题。给自己留下的每一份笔记，都是寄给未来的快递，寄件人签收时才觉得真香。",[11,95,96],{},"最后聊点感受：做技术这些年，越来越觉得最好的状态是既投入又抽离。投入是把事情做好，抽离是时不时跳出来看看方向对不对，两者缺一，要么辛苦没产出，要么轻松跑偏路。",[37,98,99],{"id":99},"写在最后",[11,101,102],{},"写这篇的晚上楼下在下雨，敲键盘的声音混着雨声，挺配这种慢慢整理思路的节奏。",[11,104,105],{},"差不多了，剩下的细节等用到的时候再展开写。",{"title":15,"searchDepth":16,"depth":17,"links":107},[108,109,110,111,112,113],{"id":39,"depth":16,"text":40},{"id":49,"depth":16,"text":49},{"id":55,"depth":16,"text":55},{"id":67,"depth":16,"text":67},{"id":84,"depth":16,"text":84},{"id":99,"depth":16,"text":99},[115],"数据库","2024-12-16",false,{"excerpt":119},{"type":8,"value":120},[121],[11,122,35],{},"\u002Fposts\u002Fdb\u002Fbtree-index-2",401400,{"title":29,"description":35},"posts\u002Fdb\u002Fbtree-index-2",[128,129],"MySQL","索引",[131],"db",1338,"ha7Oys0EeL8bXN4x__PWuQwtGJjgvfZxQRJ-2knIQ8s",{"prev":135,"next":138},{"path":136,"title":137},"\u002Fposts\u002Fdb\u002Fbtree-index","B+ 树与索引设计的底层逻辑",{"path":139,"title":140},"\u002Fposts\u002Fdb\u002Fbtree-index-3","B+ 树与索引设计的底层逻辑（三）",[142,151,181],{"id":5,"title":6,"body":143,"createdAt":19,"description":13,"extension":20,"meta":149,"navigation":22,"path":23,"seo":150,"stem":25,"__hash__":26},{"type":8,"value":144,"toc":147},[145],[11,146,13],{},{"title":15,"searchDepth":16,"depth":17,"links":148},[],{},{"description":13},{"id":152,"title":153,"body":154,"createdAt":174,"description":175,"extension":20,"meta":176,"navigation":22,"path":177,"seo":178,"stem":179,"__hash__":180},"notes\u002Fnotes\u002F2026-11-14-1.md","2026 11 14 1",{"type":8,"value":155,"toc":172},[156],[11,157,158,159,163,164,171],{},"站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 ",[160,161,162],"strong",{},"Markdown","，写链接也不用到编辑器：",[165,166,170],"a",{"href":167,"rel":168},"https:\u002F\u002Fcontent.nuxt.com",[169],"nofollow","Nuxt Content","。",{"title":15,"searchDepth":16,"depth":17,"links":173},[],"2026-11-14","站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 Markdown，写链接也不用到编辑器：Nuxt Content。",{},"\u002Fnotes\u002F2026-11-14-1",{"description":175},"notes\u002F2026-11-14-1","LLJX_RKU7cgpT6aHw4DZWUZNQ_G_UzELWPKbksJvzfs",{"id":182,"title":183,"body":184,"createdAt":199,"description":200,"extension":20,"meta":201,"navigation":22,"path":202,"seo":203,"stem":204,"__hash__":205},"notes\u002Fnotes\u002F2026-11-14-2.md","2026 11 14 2",{"type":8,"value":185,"toc":197},[186],[11,187,188,192,193,196],{},[189,190,191],"code",{},"readPixels"," 读不到内容不是 bug，是 ",[189,194,195],{},"preserveDrawingBuffer"," 默认关闭——帧提交后缓冲即被清空。",{"title":15,"searchDepth":16,"depth":17,"links":198},[],"2026-11-13","readPixels 读不到内容不是 bug，是 preserveDrawingBuffer 默认关闭——帧提交后缓冲即被清空。",{},"\u002Fnotes\u002F2026-11-14-2",{"description":200},"notes\u002F2026-11-14-2","i7xWqq2eNoU_seSbLQjqlB9gE51fM-PVLUEYCHBkOA4",1795275195492]