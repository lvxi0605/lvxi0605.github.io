[{"data":1,"prerenderedAt":208},["ShallowReactive",2],{"notes-latest-1":3,"post:\u002Fposts\u002Fdb\u002Fdeadlock-check-6":27,"surround:\u002Fposts\u002Fdb\u002Fdeadlock-check-6":136,"notes-latest-3":143},[4],{"id":5,"title":6,"body":7,"createdAt":19,"description":13,"extension":20,"meta":21,"navigation":22,"path":23,"seo":24,"stem":25,"__hash__":26},"notes\u002Fnotes\u002F2026-11-14-1-2.md","2026 11 14 1 2",{"type":8,"value":9,"toc":14},"minimark",[10],[11,12,13],"p",{},"站点上线了「随笔」：支持一个文件多个随笔",{"title":15,"searchDepth":16,"depth":17,"links":18},"",2,3,[],"2026-11-17","md",{},true,"\u002Fnotes\u002F2026-11-14-1-2",{"description":13},"notes\u002F2026-11-14-1-2","hDP9fvaunHzVrZQ6QifuOtj9VrqbxlPb_52KE5wSjD0",{"id":28,"title":29,"author":30,"body":31,"categories":116,"comment":22,"cover":30,"createdAt":118,"description":35,"draft":119,"extension":20,"meta":120,"navigation":22,"path":125,"readingTime":126,"recommend":119,"seo":127,"series":30,"stem":128,"tags":129,"top":119,"topics":132,"updatedAt":30,"words":134,"__hash__":135},"posts\u002Fposts\u002Fdb\u002Fdeadlock-check-6.md","一次线上死锁的排查记录（六）",null,{"type":8,"value":32,"toc":108},[33,36,40,43,46,49,52,55,58,61,64,67,70,73,76,79,81,84,87,90,93,96,99,102,105],[11,34,35],{},"写技术文章对我来说主要是个复盘的过程，写不清楚的地方往往就是还没想清楚的地方。",[37,38,39],"h2",{"id":39},"现场与现象",[11,41,42],{},"那天告警群里蹦出一条死锁回滚的报错，频率不高，几分钟一条。打开 show engine innodb status，LATEST DETECTED DEADLOCK 一节把两个事务持有的锁和等待的锁列得清清楚楚：事务 A 持有某行 X 锁等待 Y，事务 B 正好相反。",[11,44,45],{},"顺着锁日志回到代码，两个入口分别是下单和取消订单，都会更新同一批库存行，只是更新顺序不同。经典的交叉更新死锁，教科书级别的案例，但业务代码混了几层之后就是没被发现。",[37,47,48],{"id":48},"解法与收敛",[11,50,51],{},"解法也朴素：把两个入口里对库存行的更新顺序统一，都按商品 ID 升序排列后再逐行更新，环路不存在了死锁自然消失。另外把死锁监控加了常驻告警，这类问题单次看是偶发，久了会侵蚀可用性。总结下来的心得是：死锁日志本身信息量很足，别急着加锁重试，先读懂数据库告诉你它到底在等什么。",[37,53,54],{"id":54},"踩坑记录",[11,56,57],{},"grep 中文关键词死活匹配不上，最后确认是文件编码。iconv 转一道再查，两分钟的事排查了半小时，处理日志前先看编码，这个习惯值得保持。",[11,59,60],{},"磁盘告警，日志把盘写满了。给应用日志配上 logrotate 加上保留天数，再顺手把历史日志清了。存储这种东西，没有监控告警之前，所有人都以为它不会满。",[11,62,63],{},"线程池的队列当初图省事用了无界，高峰期任务堆积，内存一路涨。改成有界队列加上合理的拒绝策略，宁可快速失败也别让问题积累到内存里爆出来。",[37,65,66],{"id":66},"多聊两句",[11,68,69],{},"数据库问题的通用排查思路值得单独记一笔：先看监控确认是慢查询、锁等待还是资源瓶颈，再看执行计划和锁日志定位到具体语句，最后才考虑改索引或改写法。顺序反了容易在错误的方向上耗掉一晚上。",[11,71,72],{},"索引设计说到底是在读写之间做权衡，每加一个索引，写入成本就涨一分。我的习惯是定期审计索引的实际使用情况，把长期没被命中的索引下掉，这个动作在写入量大的表上收益立竿见影。",[11,74,75],{},"数据量增长是所有方案失效的终极原因。现在跑得好好的查询，数据翻十倍之后可能完全是另一副面孔。容量规划不是运维一个人的事，写代码的时候对表的增长速度心里有数，才能提前留出退路。",[11,77,78],{},"备份和演练是数据库运维的两条底线。备份没验证过可恢复，等于心理安慰；恢复流程没演练过，真出事时的时间压力会放大所有操作失误。这两件事建议按季度固定做，形成肌肉记忆。",[11,80,69],{},[37,82,83],{"id":83},"继续聊聊",[11,85,86],{},"讲个题外话，做这类事情的时候最好留个记录的习惯，当时的判断依据比结果更珍贵。结果好可能只是运气好，把决策过程记下来，好运才可能被复制，坏运才可能被规避。",[11,88,89],{},"然后想说，承认不懂是这行的美德。这次遇到不懂的地方，老老实实补了两天的课，比硬着头皮往上糊的方案强太多。不懂装懂的代价从来不会消失，只是延期，还带利息。",[11,91,92],{},"平衡感很重要的一件事：投入和收益的比例。所有优化都值得先问一句，这件事的收益上限是多少，值多少投入。无限打磨一个低价值的东西是工程师最常见的温柔陷阱，包括我自己在内。",[11,94,95],{},"忍不住再夸一下记录的力量，上周刚整理的笔记，这次直接翻出来就用，十分钟解决了当时花一下午的问题。给自己留下的每一份笔记，都是寄给未来的快递，寄件人签收时才觉得真香。",[11,97,98],{},"最后聊点感受：做技术这些年，越来越觉得最好的状态是既投入又抽离。投入是把事情做好，抽离是时不时跳出来看看方向对不对，两者缺一，要么辛苦没产出，要么轻松跑偏路。",[37,100,101],{"id":101},"写在最后",[11,103,104],{},"写完这篇正好十一点，窗外安静下来，这种时候码字效率出奇地高，就是第二天起床靠毅力。",[11,106,107],{},"以上，一点心得，有说得不对的欢迎指正。",{"title":15,"searchDepth":16,"depth":17,"links":109},[110,111,112,113,114,115],{"id":39,"depth":16,"text":39},{"id":48,"depth":16,"text":48},{"id":54,"depth":16,"text":54},{"id":66,"depth":16,"text":66},{"id":83,"depth":16,"text":83},{"id":101,"depth":16,"text":101},[117],"数据库","2026-02-18",false,{"excerpt":121},{"type":8,"value":122},[123],[11,124,35],{},"\u002Fposts\u002Fdb\u002Fdeadlock-check-6",398700,{"title":29,"description":35},"posts\u002Fdb\u002Fdeadlock-check-6",[130,131],"MySQL","锁",[133],"db",1329,"xmGwxCYpMiIPiIzuWZtVfzE5O7ovEN9M3HvNnT-DiQU",{"prev":137,"next":140},{"path":138,"title":139},"\u002Fposts\u002Fdb\u002Fdeadlock-check-5","一次线上死锁的排查记录（五）",{"path":141,"title":142},"\u002Fposts\u002Fdb\u002Fdeep-pagination","深分页问题的几种解法",[144,153,183],{"id":5,"title":6,"body":145,"createdAt":19,"description":13,"extension":20,"meta":151,"navigation":22,"path":23,"seo":152,"stem":25,"__hash__":26},{"type":8,"value":146,"toc":149},[147],[11,148,13],{},{"title":15,"searchDepth":16,"depth":17,"links":150},[],{},{"description":13},{"id":154,"title":155,"body":156,"createdAt":176,"description":177,"extension":20,"meta":178,"navigation":22,"path":179,"seo":180,"stem":181,"__hash__":182},"notes\u002Fnotes\u002F2026-11-14-1.md","2026 11 14 1",{"type":8,"value":157,"toc":174},[158],[11,159,160,161,165,166,173],{},"站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 ",[162,163,164],"strong",{},"Markdown","，写链接也不用到编辑器：",[167,168,172],"a",{"href":169,"rel":170},"https:\u002F\u002Fcontent.nuxt.com",[171],"nofollow","Nuxt Content","。",{"title":15,"searchDepth":16,"depth":17,"links":175},[],"2026-11-14","站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 Markdown，写链接也不用到编辑器：Nuxt Content。",{},"\u002Fnotes\u002F2026-11-14-1",{"description":177},"notes\u002F2026-11-14-1","LLJX_RKU7cgpT6aHw4DZWUZNQ_G_UzELWPKbksJvzfs",{"id":184,"title":185,"body":186,"createdAt":201,"description":202,"extension":20,"meta":203,"navigation":22,"path":204,"seo":205,"stem":206,"__hash__":207},"notes\u002Fnotes\u002F2026-11-14-2.md","2026 11 14 2",{"type":8,"value":187,"toc":199},[188],[11,189,190,194,195,198],{},[191,192,193],"code",{},"readPixels"," 读不到内容不是 bug，是 ",[191,196,197],{},"preserveDrawingBuffer"," 默认关闭——帧提交后缓冲即被清空。",{"title":15,"searchDepth":16,"depth":17,"links":200},[],"2026-11-13","readPixels 读不到内容不是 bug，是 preserveDrawingBuffer 默认关闭——帧提交后缓冲即被清空。",{},"\u002Fnotes\u002F2026-11-14-2",{"description":202},"notes\u002F2026-11-14-2","i7xWqq2eNoU_seSbLQjqlB9gE51fM-PVLUEYCHBkOA4",1795303385329]