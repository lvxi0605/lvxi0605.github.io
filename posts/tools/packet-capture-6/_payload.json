[{"data":1,"prerenderedAt":202},["ShallowReactive",2],{"notes-latest-1":3,"post:\u002Fposts\u002Ftools\u002Fpacket-capture-6":27,"surround:\u002Fposts\u002Ftools\u002Fpacket-capture-6":130,"notes-latest-3":137},[4],{"id":5,"title":6,"body":7,"createdAt":19,"description":13,"extension":20,"meta":21,"navigation":22,"path":23,"seo":24,"stem":25,"__hash__":26},"notes\u002Fnotes\u002F2026-11-14-1-2.md","2026 11 14 1 2",{"type":8,"value":9,"toc":14},"minimark",[10],[11,12,13],"p",{},"站点上线了「随笔」：支持一个文件多个随笔",{"title":15,"searchDepth":16,"depth":17,"links":18},"",2,3,[],"2026-11-17","md",{},true,"\u002Fnotes\u002F2026-11-14-1-2",{"description":13},"notes\u002F2026-11-14-1-2","hDP9fvaunHzVrZQ6QifuOtj9VrqbxlPb_52KE5wSjD0",{"id":28,"title":29,"author":30,"body":31,"categories":110,"comment":22,"cover":30,"createdAt":112,"description":35,"draft":113,"extension":20,"meta":114,"navigation":22,"path":119,"readingTime":120,"recommend":113,"seo":121,"series":30,"stem":122,"tags":123,"top":113,"topics":126,"updatedAt":30,"words":128,"__hash__":129},"posts\u002Fposts\u002Ftools\u002Fpacket-capture-6.md","用抓包定位线上问题（六）",null,{"type":8,"value":32,"toc":102},[33,36,40,43,46,49,52,55,58,61,64,67,70,73,76,78,81,84,87,90,93,96,99],[11,34,35],{},"想写这个话题很久了，一直没找到合适的角度，这篇先把核心的部分讲清楚，细节以后再展开。",[37,38,39],"h2",{"id":39},"什么时候需要抓包",[11,41,42],{},"抓包是日志和网络排查之间的那把钥匙：日志说发了请求，对方说没收到，中间到底发生了什么，抓包一看便知。常用工具里，本机调试用 Fiddler 或 Charles，改请求重放都方便；服务器上直接 tcpdump 抓原始报文，拷回本地用 Wireshark 分析；HTTPS 流量要在解密点抓，不然看到的都是密文。",[11,44,45],{},"经典的使用场景包括：验证网关有没有真的转发某头部、确认超时发生在建连还是等待响应、排查重定向和缓存头的问题。",[37,47,48],{"id":48},"抓包的技巧",[11,50,51],{},"几个技巧：抓包过滤条件要收窄，一台高流量机器上全量抓几秒就把磁盘撑爆，按端口和主机过滤是基本功；分析时先看 TCP 三次握手和挥手，很多应用层的慢其实是连接层的问题；把典型的正常请求和异常请求的报文存档对比，异常点一目了然。抓包算不上常用技能，但它属于那种会了之后很多悬案直接结案的能力，值得抽个晚上练熟。",[37,53,54],{"id":54},"顺手记两个坑",[11,56,57],{},"Redis 里翻出个大 key，一个 list 存了几十万成员，直接 del 的时候整条命令阻塞。后来用 scan 分批渐进删除，线上才没抖。大 key 巡检这件事还是要定期做，不能等出事再想。",[11,59,60],{},"多实例部署之后定时任务重复执行，同一个数据处理了两遍。加分布式锁当然可以，最后偷懒换了调度平台的分片路由，一行配置解决，前提是任务本身可以按分片拆。",[11,62,63],{},"遇到过消息重复消费，原因是网络抖动触发重试，业务库里多了脏数据。消费端加幂等表之后彻底解决，结论很简单：所有 MQ 的幂等都得消费端自己做，寄希望于恰好一次是不现实的。",[37,65,66],{"id":66},"一点延伸",[11,68,69],{},"记录的价值再强调一次：排查过程、配置方法、踩坑结论，随手写进笔记。人类的记忆不适合存储这类细节，但非常适合存储“我记得我记过”这个索引，索引加笔记的组合，几乎能对付所有“以前遇到过”的问题。",[11,71,72],{},"自动化脚本的写与不写，判断标准很简单：这个操作会不会再发生。会再发生的就值得花时间自动化，哪怕脚本只有十行。时间的复利效应在工具积累上体现得最明显，写代码的人不做这个有点亏。",[11,74,75],{},"工具这件事我信奉一条：先掌握手头工具的深度，再考虑换新工具。大多数软件的效率上限远高于我们的使用水平，快捷键、模板、自动化脚本，这些存量功能的挖掘比追逐新工具的回报率高得多。",[11,77,69],{},[37,79,80],{"id":80},"再补充几句",[11,82,83],{},"忍不住再夸一下记录的力量，上周刚整理的笔记，这次直接翻出来就用，十分钟解决了当时花一下午的问题。给自己留下的每一份笔记，都是寄给未来的快递，寄件人签收时才觉得真香。",[11,85,86],{},"最后聊点感受：做技术这些年，越来越觉得最好的状态是既投入又抽离。投入是把事情做好，抽离是时不时跳出来看看方向对不对，两者缺一，要么辛苦没产出，要么轻松跑偏路。",[11,88,89],{},"写着写着想到，很多技术选择本质上都是在回答同一个问题：这个方案在出问题的时候是什么样子。不出问题的方案人人都写得出来，区分度全在故障时刻的表现。多想一层失败路径，很多纠结就自动有了答案。",[11,91,92],{},"这类经验在文档里通常只有一行字，背后的排查却是一整个下午。技术工作的大部分时间都花在这些不会写进简历的细节里，所以这些细节才更需要有人写出来，哪怕只是给未来某一天忘了的自己。",[37,94,95],{"id":95},"写在最后",[11,97,98],{},"上午改代码，下午陪家人逛了趟超市，晚上坐下来写这篇，一天过得挺满。",[11,100,101],{},"大概就是这些，有不同做法欢迎评论区交流。",{"title":15,"searchDepth":16,"depth":17,"links":103},[104,105,106,107,108,109],{"id":39,"depth":16,"text":39},{"id":48,"depth":16,"text":48},{"id":54,"depth":16,"text":54},{"id":66,"depth":16,"text":66},{"id":80,"depth":16,"text":80},{"id":95,"depth":16,"text":95},[111],"工具","2023-06-16",false,{"excerpt":115},{"type":8,"value":116},[117],[11,118,35],{},"\u002Fposts\u002Ftools\u002Fpacket-capture-6",378600,{"title":29,"description":35},"posts\u002Ftools\u002Fpacket-capture-6",[124,125],"抓包","排查",[127],"tools",1262,"-k0QuC0e9aUmcnkeqUm6vNSjYcuYOgIF4ifLYtXsFoM",{"prev":131,"next":134},{"path":132,"title":133},"\u002Fposts\u002Ftools\u002Fpacket-capture-5","用抓包定位线上问题（五）",{"path":135,"title":136},"\u002Fposts\u002Ftrip\u002Fancient-town","古镇游避坑与真香指南",[138,147,177],{"id":5,"title":6,"body":139,"createdAt":19,"description":13,"extension":20,"meta":145,"navigation":22,"path":23,"seo":146,"stem":25,"__hash__":26},{"type":8,"value":140,"toc":143},[141],[11,142,13],{},{"title":15,"searchDepth":16,"depth":17,"links":144},[],{},{"description":13},{"id":148,"title":149,"body":150,"createdAt":170,"description":171,"extension":20,"meta":172,"navigation":22,"path":173,"seo":174,"stem":175,"__hash__":176},"notes\u002Fnotes\u002F2026-11-14-1.md","2026 11 14 1",{"type":8,"value":151,"toc":168},[152],[11,153,154,155,159,160,167],{},"站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 ",[156,157,158],"strong",{},"Markdown","，写链接也不用到编辑器：",[161,162,166],"a",{"href":163,"rel":164},"https:\u002F\u002Fcontent.nuxt.com",[165],"nofollow","Nuxt Content","。",{"title":15,"searchDepth":16,"depth":17,"links":169},[],"2026-11-14","站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 Markdown，写链接也不用到编辑器：Nuxt Content。",{},"\u002Fnotes\u002F2026-11-14-1",{"description":171},"notes\u002F2026-11-14-1","LLJX_RKU7cgpT6aHw4DZWUZNQ_G_UzELWPKbksJvzfs",{"id":178,"title":179,"body":180,"createdAt":195,"description":196,"extension":20,"meta":197,"navigation":22,"path":198,"seo":199,"stem":200,"__hash__":201},"notes\u002Fnotes\u002F2026-11-14-2.md","2026 11 14 2",{"type":8,"value":181,"toc":193},[182],[11,183,184,188,189,192],{},[185,186,187],"code",{},"readPixels"," 读不到内容不是 bug，是 ",[185,190,191],{},"preserveDrawingBuffer"," 默认关闭——帧提交后缓冲即被清空。",{"title":15,"searchDepth":16,"depth":17,"links":194},[],"2026-11-13","readPixels 读不到内容不是 bug，是 preserveDrawingBuffer 默认关闭——帧提交后缓冲即被清空。",{},"\u002Fnotes\u002F2026-11-14-2",{"description":196},"notes\u002F2026-11-14-2","i7xWqq2eNoU_seSbLQjqlB9gE51fM-PVLUEYCHBkOA4",1795333671822]