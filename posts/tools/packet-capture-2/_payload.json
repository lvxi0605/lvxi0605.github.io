[{"data":1,"prerenderedAt":204},["ShallowReactive",2],{"notes-latest-1":3,"post:\u002Fposts\u002Ftools\u002Fpacket-capture-2":27,"surround:\u002Fposts\u002Ftools\u002Fpacket-capture-2":132,"notes-latest-3":139},[4],{"id":5,"title":6,"body":7,"createdAt":19,"description":13,"extension":20,"meta":21,"navigation":22,"path":23,"seo":24,"stem":25,"__hash__":26},"notes\u002Fnotes\u002F2026-11-14-1-2.md","2026 11 14 1 2",{"type":8,"value":9,"toc":14},"minimark",[10],[11,12,13],"p",{},"站点上线了「随笔」：支持一个文件多个随笔",{"title":15,"searchDepth":16,"depth":17,"links":18},"",2,3,[],"2026-11-17","md",{},true,"\u002Fnotes\u002F2026-11-14-1-2",{"description":13},"notes\u002F2026-11-14-1-2","hDP9fvaunHzVrZQ6QifuOtj9VrqbxlPb_52KE5wSjD0",{"id":28,"title":29,"author":30,"body":31,"categories":112,"comment":22,"cover":30,"createdAt":114,"description":35,"draft":115,"extension":20,"meta":116,"navigation":22,"path":121,"readingTime":122,"recommend":115,"seo":123,"series":30,"stem":124,"tags":125,"top":115,"topics":128,"updatedAt":30,"words":130,"__hash__":131},"posts\u002Fposts\u002Ftools\u002Fpacket-capture-2.md","用抓包定位线上问题（二）",null,{"type":8,"value":32,"toc":104},[33,36,40,43,46,49,52,55,58,61,64,67,70,73,76,78,80,83,86,89,92,95,98,101],[11,34,35],{},"长话短说，这篇就是一次完整的记录，从问题怎么来的，到最后方案怎么定，中间的弯路也都保留。",[37,38,39],"h2",{"id":39},"什么时候需要抓包",[11,41,42],{},"抓包是日志和网络排查之间的那把钥匙：日志说发了请求，对方说没收到，中间到底发生了什么，抓包一看便知。常用工具里，本机调试用 Fiddler 或 Charles，改请求重放都方便；服务器上直接 tcpdump 抓原始报文，拷回本地用 Wireshark 分析；HTTPS 流量要在解密点抓，不然看到的都是密文。",[11,44,45],{},"经典的使用场景包括：验证网关有没有真的转发某头部、确认超时发生在建连还是等待响应、排查重定向和缓存头的问题。",[37,47,48],{"id":48},"抓包的技巧",[11,50,51],{},"几个技巧：抓包过滤条件要收窄，一台高流量机器上全量抓几秒就把磁盘撑爆，按端口和主机过滤是基本功；分析时先看 TCP 三次握手和挥手，很多应用层的慢其实是连接层的问题；把典型的正常请求和异常请求的报文存档对比，异常点一目了然。抓包算不上常用技能，但它属于那种会了之后很多悬案直接结案的能力，值得抽个晚上练熟。",[37,53,54],{"id":54},"顺手记两个坑",[11,56,57],{},"HTTPS 证书配完，桌面浏览器都正常，部分安卓机型握手失败。是证书链不完整，中间证书没部署。证书工具会提示，但前提是你出问题之前主动去验证一次。",[11,59,60],{},"接手老代码，方法级 synchronized 把远程调用也包了进去，整个接口的吞吐被锁死。缩小锁范围只保护共享变量，性能立刻回来。锁的粒度，永远值得多看一眼。",[11,62,63],{},"jstat 看 GC 一切正常，但接口就是偶发抖动，最后发现宿主机在用 swap。禁掉 swap 加上内存预留，抖动消失。应用层之外，操作系统层面的问题也要纳入视野。",[37,65,66],{"id":66},"一点延伸",[11,68,69],{},"自动化脚本的写与不写，判断标准很简单：这个操作会不会再发生。会再发生的就值得花时间自动化，哪怕脚本只有十行。时间的复利效应在工具积累上体现得最明显，写代码的人不做这个有点亏。",[11,71,72],{},"工具这件事我信奉一条：先掌握手头工具的深度，再考虑换新工具。大多数软件的效率上限远高于我们的使用水平，快捷键、模板、自动化脚本，这些存量功能的挖掘比追逐新工具的回报率高得多。",[11,74,75],{},"记录的价值再强调一次：排查过程、配置方法、踩坑结论，随手写进笔记。人类的记忆不适合存储这类细节，但非常适合存储“我记得我记过”这个索引，索引加笔记的组合，几乎能对付所有“以前遇到过”的问题。",[11,77,69],{},[11,79,72],{},[37,81,82],{"id":82},"再补充几句",[11,84,85],{},"由这件事联想到阅读习惯：资料要看一手来源，译文和二手转述经常带着传播者的理解偏差，偏差叠几层之后和原意面目全非。多花十分钟读原文，省下的是未来几小时的排查，这笔账怎么算都划算。",[11,87,88],{},"还有个感受越来越深：知识落地成文字的过程本身就是学习的一部分。很多自以为想清楚的东西，写出来才发现逻辑有洞。写作是最好的检验，这也是坚持写博客这么多年的理由之一，写不出来的就是还没学会的。",[11,90,91],{},"过程中也反复体会到取舍的本质：没有完美的方案，只有当下约束下最合适的方案。把约束写清楚，方案的选择题就变成了证明题，这也是为什么我习惯先列约束再谈方案，顺序反了全是无效争论。",[11,93,94],{},"想想还是补一段：任何习惯的养成都绕不开启动成本，最有效的办法是把启动成本降到接近零。想跑就把鞋放门口，想写就把文档开着置顶，环境准备到位了，行动只是顺水推舟。",[37,96,97],{"id":97},"写在最后",[11,99,100],{},"写这篇的晚上楼下在下雨，敲键盘的声音混着雨声，挺配这种慢慢整理思路的节奏。",[11,102,103],{},"差不多了，剩下的细节等用到的时候再展开写。",{"title":15,"searchDepth":16,"depth":17,"links":105},[106,107,108,109,110,111],{"id":39,"depth":16,"text":39},{"id":48,"depth":16,"text":48},{"id":54,"depth":16,"text":54},{"id":66,"depth":16,"text":66},{"id":82,"depth":16,"text":82},{"id":97,"depth":16,"text":97},[113],"工具","2024-05-05",false,{"excerpt":117},{"type":8,"value":118},[119],[11,120,35],{},"\u002Fposts\u002Ftools\u002Fpacket-capture-2",396300,{"title":29,"description":35},"posts\u002Ftools\u002Fpacket-capture-2",[126,127],"抓包","排查",[129],"tools",1321,"k_rt23lxMMZyXHVTW_TGzr14xtDSvRrcvz_rQtFXZm4",{"prev":133,"next":136},{"path":134,"title":135},"\u002Fposts\u002Ftools\u002Fpacket-capture","用抓包定位线上问题",{"path":137,"title":138},"\u002Fposts\u002Ftools\u002Fpacket-capture-3","用抓包定位线上问题（三）",[140,149,179],{"id":5,"title":6,"body":141,"createdAt":19,"description":13,"extension":20,"meta":147,"navigation":22,"path":23,"seo":148,"stem":25,"__hash__":26},{"type":8,"value":142,"toc":145},[143],[11,144,13],{},{"title":15,"searchDepth":16,"depth":17,"links":146},[],{},{"description":13},{"id":150,"title":151,"body":152,"createdAt":172,"description":173,"extension":20,"meta":174,"navigation":22,"path":175,"seo":176,"stem":177,"__hash__":178},"notes\u002Fnotes\u002F2026-11-14-1.md","2026 11 14 1",{"type":8,"value":153,"toc":170},[154],[11,155,156,157,161,162,169],{},"站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 ",[158,159,160],"strong",{},"Markdown","，写链接也不用到编辑器：",[163,164,168],"a",{"href":165,"rel":166},"https:\u002F\u002Fcontent.nuxt.com",[167],"nofollow","Nuxt Content","。",{"title":15,"searchDepth":16,"depth":17,"links":171},[],"2026-11-14","站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 Markdown，写链接也不用到编辑器：Nuxt Content。",{},"\u002Fnotes\u002F2026-11-14-1",{"description":173},"notes\u002F2026-11-14-1","LLJX_RKU7cgpT6aHw4DZWUZNQ_G_UzELWPKbksJvzfs",{"id":180,"title":181,"body":182,"createdAt":197,"description":198,"extension":20,"meta":199,"navigation":22,"path":200,"seo":201,"stem":202,"__hash__":203},"notes\u002Fnotes\u002F2026-11-14-2.md","2026 11 14 2",{"type":8,"value":183,"toc":195},[184],[11,185,186,190,191,194],{},[187,188,189],"code",{},"readPixels"," 读不到内容不是 bug，是 ",[187,192,193],{},"preserveDrawingBuffer"," 默认关闭——帧提交后缓冲即被清空。",{"title":15,"searchDepth":16,"depth":17,"links":196},[],"2026-11-13","readPixels 读不到内容不是 bug，是 preserveDrawingBuffer 默认关闭——帧提交后缓冲即被清空。",{},"\u002Fnotes\u002F2026-11-14-2",{"description":198},"notes\u002F2026-11-14-2","i7xWqq2eNoU_seSbLQjqlB9gE51fM-PVLUEYCHBkOA4",1795273165996]