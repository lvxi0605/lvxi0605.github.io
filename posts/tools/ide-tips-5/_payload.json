[{"data":1,"prerenderedAt":204},["ShallowReactive",2],{"notes-latest-1":3,"post:\u002Fposts\u002Ftools\u002Fide-tips-5":27,"surround:\u002Fposts\u002Ftools\u002Fide-tips-5":132,"notes-latest-3":139},[4],{"id":5,"title":6,"body":7,"createdAt":19,"description":13,"extension":20,"meta":21,"navigation":22,"path":23,"seo":24,"stem":25,"__hash__":26},"notes\u002Fnotes\u002F2026-11-14-1-2.md","2026 11 14 1 2",{"type":8,"value":9,"toc":14},"minimark",[10],[11,12,13],"p",{},"站点上线了「随笔」：支持一个文件多个随笔",{"title":15,"searchDepth":16,"depth":17,"links":18},"",2,3,[],"2026-11-17","md",{},true,"\u002Fnotes\u002F2026-11-14-1-2",{"description":13},"notes\u002F2026-11-14-1-2","hDP9fvaunHzVrZQ6QifuOtj9VrqbxlPb_52KE5wSjD0",{"id":28,"title":29,"author":30,"body":31,"categories":112,"comment":22,"cover":30,"createdAt":114,"description":35,"draft":115,"extension":20,"meta":116,"navigation":22,"path":121,"readingTime":122,"recommend":115,"seo":123,"series":30,"stem":124,"tags":125,"top":115,"topics":128,"updatedAt":30,"words":130,"__hash__":131},"posts\u002Fposts\u002Ftools\u002Fide-tips-5.md","IDEA 效率设置几条（五）",null,{"type":8,"value":32,"toc":104},[33,36,40,43,46,49,52,55,58,61,64,67,70,73,76,78,80,83,86,89,92,95,98,101],[11,34,35],{},"最近被问了几次同一个问题，发现口头表达总是漏要点，干脆写成文，以后直接甩链接。",[37,38,39],"h2",{"id":39},"键盘优先",[11,41,42],{},"IDEA 的效率上限在键盘：双击 Shift 全局搜索、Ctrl Shift N 找文件、Ctrl Alt 左右方向键在跳转历史间穿梭、Alt Enter 万能修复，这几个动作练熟之后，鼠标的使用率能降到很低。再配上自定义的代码模板和后缀补全，常用结构两三个键就出来了。",[11,44,45],{},"重构相关的快捷键同样值得练：Shift F6 改名全项目联动、Ctrl Alt V 提取变量、Ctrl Alt M 提取方法，重构顺手了，代码坏味道的修复成本就低了，也更愿意随手改。",[37,47,48],{"id":48},"配置与插件",[11,50,51],{},"配置层面几条建议：内存给够，索引才快；exclude 掉不需要索引的目录；代码风格配置导出进仓库，团队统一。插件不用贪多，我长期留着的就几个：Git 相关增强、MyBatis 的 XML 跳转、翻译插件、Lombok 支持。工具这件事，把常用的二十个功能练到肌肉记忆，比装两百个插件用不明白强得多，隔一段时间审视一遍自己的操作，总有些低效的地方能找到对应的快捷键。",[37,53,54],{"id":54},"记两个小问题",[11,56,57],{},"@Transactional 加在私有方法上、或者同类里自调用，事务都是不生效的，因为绕过了代理对象。这类 AOP 的坑，理解了代理机制就一目了然，没理解之前就是玄学。",[11,59,60],{},"服务注册状态看着正常，流量却没打过来。心跳超时加上保护阈值，Nacos 短暂摘除了实例。注册中心的状态和真实可用性是两回事，健康检查永远要结合业务探活来看。",[11,62,63],{},"ES 深分页直接报错，from 加 size 超了上限。改用 search_after 滚动查询，性能稳定得多。分页这个需求，产品经理以为是免费的，实际上是数据库在替他扛。",[37,65,66],{"id":66},"顺便一提",[11,68,69],{},"记录的价值再强调一次：排查过程、配置方法、踩坑结论，随手写进笔记。人类的记忆不适合存储这类细节，但非常适合存储“我记得我记过”这个索引，索引加笔记的组合，几乎能对付所有“以前遇到过”的问题。",[11,71,72],{},"自动化脚本的写与不写，判断标准很简单：这个操作会不会再发生。会再发生的就值得花时间自动化，哪怕脚本只有十行。时间的复利效应在工具积累上体现得最明显，写代码的人不做这个有点亏。",[11,74,75],{},"工具这件事我信奉一条：先掌握手头工具的深度，再考虑换新工具。大多数软件的效率上限远高于我们的使用水平，快捷键、模板、自动化脚本，这些存量功能的挖掘比追逐新工具的回报率高得多。",[11,77,69],{},[11,79,72],{},[37,81,82],{"id":82},"另外记几笔",[11,84,85],{},"顺便说说协作里的体会：这类事自己闷头做效率最高，但闷头做完往往返工最多。适度地提前同步，把方向先对齐，看似慢了半天，实际省掉的是几天的返工。沟通的时机比沟通的技巧更值得琢磨。",[11,87,88],{},"其实回看这些年踩的坑，大坑几乎都和贪快有关。快不是错，错的是想跳过必要步骤的快，地基没打牢盖得越快塌得越响。慢下来把该做的做扎实，反而是最快的路径，这话说了很多年，每次验证都对。",[11,90,91],{},"有个观察分享给大家：技术的成长曲线不是线性的，是一段平台加一次跃迁。平台期最磨人，感觉学了很多没进步，其实是在攒素材，攒够了某个契机一到就突飞猛进。所以在平台期别否定自己，那是跃迁的前奏。",[11,93,94],{},"再补充一个角度：做这些事情的时候，工具的顺滑度影响巨大。同样的活，称手的工具能让摩擦力小一半，这种差异日积月累就是人和人的差距。定期审视自己的工具链，删掉碍事的，补上趁手的，值得当成一个固定动作。",[37,96,97],{"id":97},"最后",[11,99,100],{},"泡的茶忘了喝，回过神已经凉透了，进入状态的时候对时间的感知就剩这点不好。",[11,102,103],{},"这篇就先这样，想到了什么再回来补。",{"title":15,"searchDepth":16,"depth":17,"links":105},[106,107,108,109,110,111],{"id":39,"depth":16,"text":39},{"id":48,"depth":16,"text":48},{"id":54,"depth":16,"text":54},{"id":66,"depth":16,"text":66},{"id":82,"depth":16,"text":82},{"id":97,"depth":16,"text":97},[113],"工具","2024-09-04",false,{"excerpt":117},{"type":8,"value":118},[119],[11,120,35],{},"\u002Fposts\u002Ftools\u002Fide-tips-5",397500,{"title":29,"description":35},"posts\u002Ftools\u002Fide-tips-5",[126,127],"IDEA","效率",[129],"tools",1325,"rIPN7OeivlbhBf_WbgFiiVoTy05Jcq4uTYJUK2U2qEc",{"prev":133,"next":136},{"path":134,"title":135},"\u002Fposts\u002Ftools\u002Fide-tips-4","IDEA 效率设置几条（四）",{"path":137,"title":138},"\u002Fposts\u002Ftools\u002Fpacket-capture","用抓包定位线上问题",[140,149,179],{"id":5,"title":6,"body":141,"createdAt":19,"description":13,"extension":20,"meta":147,"navigation":22,"path":23,"seo":148,"stem":25,"__hash__":26},{"type":8,"value":142,"toc":145},[143],[11,144,13],{},{"title":15,"searchDepth":16,"depth":17,"links":146},[],{},{"description":13},{"id":150,"title":151,"body":152,"createdAt":172,"description":173,"extension":20,"meta":174,"navigation":22,"path":175,"seo":176,"stem":177,"__hash__":178},"notes\u002Fnotes\u002F2026-11-14-1.md","2026 11 14 1",{"type":8,"value":153,"toc":170},[154],[11,155,156,157,161,162,169],{},"站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 ",[158,159,160],"strong",{},"Markdown","，写链接也不用到编辑器：",[163,164,168],"a",{"href":165,"rel":166},"https:\u002F\u002Fcontent.nuxt.com",[167],"nofollow","Nuxt Content","。",{"title":15,"searchDepth":16,"depth":17,"links":171},[],"2026-11-14","站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 Markdown，写链接也不用到编辑器：Nuxt Content。",{},"\u002Fnotes\u002F2026-11-14-1",{"description":173},"notes\u002F2026-11-14-1","LLJX_RKU7cgpT6aHw4DZWUZNQ_G_UzELWPKbksJvzfs",{"id":180,"title":181,"body":182,"createdAt":197,"description":198,"extension":20,"meta":199,"navigation":22,"path":200,"seo":201,"stem":202,"__hash__":203},"notes\u002Fnotes\u002F2026-11-14-2.md","2026 11 14 2",{"type":8,"value":183,"toc":195},[184],[11,185,186,190,191,194],{},[187,188,189],"code",{},"readPixels"," 读不到内容不是 bug，是 ",[187,192,193],{},"preserveDrawingBuffer"," 默认关闭——帧提交后缓冲即被清空。",{"title":15,"searchDepth":16,"depth":17,"links":196},[],"2026-11-13","readPixels 读不到内容不是 bug，是 preserveDrawingBuffer 默认关闭——帧提交后缓冲即被清空。",{},"\u002Fnotes\u002F2026-11-14-2",{"description":198},"notes\u002F2026-11-14-2","i7xWqq2eNoU_seSbLQjqlB9gE51fM-PVLUEYCHBkOA4",1795309555658]