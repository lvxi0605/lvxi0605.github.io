[{"data":1,"prerenderedAt":202},["ShallowReactive",2],{"notes-latest-1":3,"post:\u002Fposts\u002Ftools\u002Fdesign-pattern-4":27,"surround:\u002Fposts\u002Ftools\u002Fdesign-pattern-4":130,"notes-latest-3":137},[4],{"id":5,"title":6,"body":7,"createdAt":19,"description":13,"extension":20,"meta":21,"navigation":22,"path":23,"seo":24,"stem":25,"__hash__":26},"notes\u002Fnotes\u002F2026-11-14-1-2.md","2026 11 14 1 2",{"type":8,"value":9,"toc":14},"minimark",[10],[11,12,13],"p",{},"站点上线了「随笔」：支持一个文件多个随笔",{"title":15,"searchDepth":16,"depth":17,"links":18},"",2,3,[],"2026-11-17","md",{},true,"\u002Fnotes\u002F2026-11-14-1-2",{"description":13},"notes\u002F2026-11-14-1-2","hDP9fvaunHzVrZQ6QifuOtj9VrqbxlPb_52KE5wSjD0",{"id":28,"title":29,"author":30,"body":31,"categories":110,"comment":22,"cover":30,"createdAt":112,"description":35,"draft":113,"extension":20,"meta":114,"navigation":22,"path":119,"readingTime":120,"recommend":113,"seo":121,"series":30,"stem":122,"tags":123,"top":113,"topics":126,"updatedAt":30,"words":128,"__hash__":129},"posts\u002Fposts\u002Ftools\u002Fdesign-pattern-4.md","设计模式在业务代码里的落点（四）",null,{"type":8,"value":32,"toc":102},[33,36,40,43,46,49,52,55,58,61,64,67,70,73,76,78,81,84,87,90,93,96,99],[11,34,35],{},"最近被问了几次同一个问题，发现口头表达总是漏要点，干脆写成文，以后直接甩链接。",[37,38,39],"h2",{"id":39},"业务里最常用的几个",[11,41,42],{},"二十三种设计模式，业务代码里真正高频的就那几个。策略模式配合 Spring 的依赖注入，按类型路由到不同实现，替掉满屏的 if else；模板方法统一流程骨架，子类填差异步骤；观察者解耦主流程和附属动作，下单之后发通知记日志这类事不再阻塞主链路；建造者组装参数多的对象，可读性好。",[11,44,45],{},"它们共同的特点是消除某一类变化带来的重复，用的是多态、组合这些朴素手段。",[37,47,48],{"id":48},"别为了模式而模式",[11,50,51],{},"反面提醒同样重要：别为了模式而模式。两个分支的 if else 拆成策略模式是过度设计，五个以上、并且还会继续增加的分支才值得抽象。判断标准我的经验是看变化的频率和维度的数量，变化频繁且维度还会扩展的才上模式，否则简单直白胜过一切。设计模式的书读三遍不如重构一次真实代码，找一段自己写的烂代码，对照模式逐步演进，体会比任何教程都深。",[37,53,54],{"id":54},"过程中的两个坑",[11,56,57],{},"前端双击重复提交导致创建了重复单据。token 机制先挡一层，唯一索引再兜一层，两层防线齐了才踏实。幂等这件事，永远要在离数据最近的地方兜底。",[11,59,60],{},"HTTPS 证书配完，桌面浏览器都正常，部分安卓机型握手失败。是证书链不完整，中间证书没部署。证书工具会提示，但前提是你出问题之前主动去验证一次。",[11,62,63],{},"接手老代码，方法级 synchronized 把远程调用也包了进去，整个接口的吞吐被锁死。缩小锁范围只保护共享变量，性能立刻回来。锁的粒度，永远值得多看一眼。",[37,65,66],{"id":66},"延伸几句",[11,68,69],{},"记录的价值再强调一次：排查过程、配置方法、踩坑结论，随手写进笔记。人类的记忆不适合存储这类细节，但非常适合存储“我记得我记过”这个索引，索引加笔记的组合，几乎能对付所有“以前遇到过”的问题。",[11,71,72],{},"自动化脚本的写与不写，判断标准很简单：这个操作会不会再发生。会再发生的就值得花时间自动化，哪怕脚本只有十行。时间的复利效应在工具积累上体现得最明显，写代码的人不做这个有点亏。",[11,74,75],{},"工具这件事我信奉一条：先掌握手头工具的深度，再考虑换新工具。大多数软件的效率上限远高于我们的使用水平，快捷键、模板、自动化脚本，这些存量功能的挖掘比追逐新工具的回报率高得多。",[11,77,69],{},[37,79,80],{"id":80},"又想到一些",[11,82,83],{},"再补充一个角度：做这些事情的时候，工具的顺滑度影响巨大。同样的活，称手的工具能让摩擦力小一半，这种差异日积月累就是人和人的差距。定期审视自己的工具链，删掉碍事的，补上趁手的，值得当成一个固定动作。",[11,85,86],{},"由这件事联想到阅读习惯：资料要看一手来源，译文和二手转述经常带着传播者的理解偏差，偏差叠几层之后和原意面目全非。多花十分钟读原文，省下的是未来几小时的排查，这笔账怎么算都划算。",[11,88,89],{},"还有个感受越来越深：知识落地成文字的过程本身就是学习的一部分。很多自以为想清楚的东西，写出来才发现逻辑有洞。写作是最好的检验，这也是坚持写博客这么多年的理由之一，写不出来的就是还没学会的。",[11,91,92],{},"过程中也反复体会到取舍的本质：没有完美的方案，只有当下约束下最合适的方案。把约束写清楚，方案的选择题就变成了证明题，这也是为什么我习惯先列约束再谈方案，顺序反了全是无效争论。",[37,94,95],{"id":95},"小结",[11,97,98],{},"写完这篇正好十一点，窗外安静下来，这种时候码字效率出奇地高，就是第二天起床靠毅力。",[11,100,101],{},"今天的记录就到这里，晚安。",{"title":15,"searchDepth":16,"depth":17,"links":103},[104,105,106,107,108,109],{"id":39,"depth":16,"text":39},{"id":48,"depth":16,"text":48},{"id":54,"depth":16,"text":54},{"id":66,"depth":16,"text":66},{"id":80,"depth":16,"text":80},{"id":95,"depth":16,"text":95},[111],"工具","2026-03-19",false,{"excerpt":115},{"type":8,"value":116},[117],[11,118,35],{},"\u002Fposts\u002Ftools\u002Fdesign-pattern-4",378900,{"title":29,"description":35},"posts\u002Ftools\u002Fdesign-pattern-4",[124,125],"设计模式","重构",[127],"tools",1263,"vMUtoa3ayZ8XTexTQwGCLWq_Oh4KywXVZ-zHjP7ey8o",{"prev":131,"next":134},{"path":132,"title":133},"\u002Fposts\u002Ftools\u002Fdesign-pattern-3","设计模式在业务代码里的落点（三）",{"path":135,"title":136},"\u002Fposts\u002Ftools\u002Fdesign-pattern-5","设计模式在业务代码里的落点（五）",[138,147,177],{"id":5,"title":6,"body":139,"createdAt":19,"description":13,"extension":20,"meta":145,"navigation":22,"path":23,"seo":146,"stem":25,"__hash__":26},{"type":8,"value":140,"toc":143},[141],[11,142,13],{},{"title":15,"searchDepth":16,"depth":17,"links":144},[],{},{"description":13},{"id":148,"title":149,"body":150,"createdAt":170,"description":171,"extension":20,"meta":172,"navigation":22,"path":173,"seo":174,"stem":175,"__hash__":176},"notes\u002Fnotes\u002F2026-11-14-1.md","2026 11 14 1",{"type":8,"value":151,"toc":168},[152],[11,153,154,155,159,160,167],{},"站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 ",[156,157,158],"strong",{},"Markdown","，写链接也不用到编辑器：",[161,162,166],"a",{"href":163,"rel":164},"https:\u002F\u002Fcontent.nuxt.com",[165],"nofollow","Nuxt Content","。",{"title":15,"searchDepth":16,"depth":17,"links":169},[],"2026-11-14","站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 Markdown，写链接也不用到编辑器：Nuxt Content。",{},"\u002Fnotes\u002F2026-11-14-1",{"description":171},"notes\u002F2026-11-14-1","LLJX_RKU7cgpT6aHw4DZWUZNQ_G_UzELWPKbksJvzfs",{"id":178,"title":179,"body":180,"createdAt":195,"description":196,"extension":20,"meta":197,"navigation":22,"path":198,"seo":199,"stem":200,"__hash__":201},"notes\u002Fnotes\u002F2026-11-14-2.md","2026 11 14 2",{"type":8,"value":181,"toc":193},[182],[11,183,184,188,189,192],{},[185,186,187],"code",{},"readPixels"," 读不到内容不是 bug，是 ",[185,190,191],{},"preserveDrawingBuffer"," 默认关闭——帧提交后缓冲即被清空。",{"title":15,"searchDepth":16,"depth":17,"links":194},[],"2026-11-13","readPixels 读不到内容不是 bug，是 preserveDrawingBuffer 默认关闭——帧提交后缓冲即被清空。",{},"\u002Fnotes\u002F2026-11-14-2",{"description":196},"notes\u002F2026-11-14-2","i7xWqq2eNoU_seSbLQjqlB9gE51fM-PVLUEYCHBkOA4",1795309555085]