[{"data":1,"prerenderedAt":205},["ShallowReactive",2],{"notes-latest-1":3,"post:\u002Fposts\u002Fdevops\u002Fdockerfile-optimize-4":27,"surround:\u002Fposts\u002Fdevops\u002Fdockerfile-optimize-4":133,"notes-latest-3":140},[4],{"id":5,"title":6,"body":7,"createdAt":19,"description":13,"extension":20,"meta":21,"navigation":22,"path":23,"seo":24,"stem":25,"__hash__":26},"notes\u002Fnotes\u002F2026-11-14-1-2.md","2026 11 14 1 2",{"type":8,"value":9,"toc":14},"minimark",[10],[11,12,13],"p",{},"站点上线了「随笔」：支持一个文件多个随笔",{"title":15,"searchDepth":16,"depth":17,"links":18},"",2,3,[],"2026-11-17","md",{},true,"\u002Fnotes\u002F2026-11-14-1-2",{"description":13},"notes\u002F2026-11-14-1-2","hDP9fvaunHzVrZQ6QifuOtj9VrqbxlPb_52KE5wSjD0",{"id":28,"title":29,"author":30,"body":31,"categories":113,"comment":22,"cover":30,"createdAt":115,"description":35,"draft":116,"extension":20,"meta":117,"navigation":22,"path":122,"readingTime":123,"recommend":116,"seo":124,"series":30,"stem":125,"tags":126,"top":116,"topics":129,"updatedAt":30,"words":131,"__hash__":132},"posts\u002Fposts\u002Fdevops\u002Fdockerfile-optimize-4.md","Dockerfile 优化的几板斧（四）",null,{"type":8,"value":32,"toc":105},[33,36,40,43,46,49,52,55,58,61,64,67,70,73,76,79,81,84,87,90,93,96,99,102],[11,34,35],{},"这个话题其实挺老的，但每次实际用到还是会踩出点新东西，索性记一篇备查，也给后来的同学提个醒。",[37,38,39],"h2",{"id":39},"镜像为什么大",[11,41,42],{},"镜像大的原因通常三个：基础镜像太重、层里堆了垃圾、构建工具被打了进去。对策也对应三条：Java 应用选 slim 或 alpine 系基础镜像，运行时不需要 JDK 全家桶，JRE 甚至定制运行时更省；多阶段构建让编译环境只存在于构建阶段，最终镜像只拷贝产物；每条 RUN 结尾清理缓存，或者合并成一层，减小层数与残留。",[11,44,45],{},"还有个容易被忽略的点：构建上下文。把 node_modules、日志、本地大文件都拷进 context，就算 Dockerfile 没用它们，传输和缓存判断也会变慢，一个像样的 .dockerignore 性价比极高。",[37,47,48],{"id":48},"缓存友好",[11,50,51],{},"除了小，还要快。层缓存是按顺序匹配的，依赖文件变化少的步骤放前面：先拷贝依赖清单装依赖，再拷贝源码编译，日常改代码就只命中后面的层，依赖安装的几分钟全省下来。这些优化做完，一个 Java 服务的镜像从 1G 上下降到一两百兆，构建从十分钟降到两分钟内，CI 的体感完全是两个世界。",[37,53,54],{"id":54},"顺手记两个坑",[11,56,57],{},"还有一次排查 OOM，堆内存看着没超，最后发现是元空间爆了，某个框架在运行时动态生成类。加了 -XX:MaxMetaspaceSize 先兜底，再定位到生成源头关掉，内存曲线立刻平了。",[11,59,60],{},"一条 SQL 索引明明在，但执行计划就是不走，折腾半天发现是字段上包了层函数。把函数挪到参数那边改写之后，从八秒降到八十毫秒，这种问题每次遇到都痛恨自己一开始没看执行计划。",[11,62,63],{},"Redis 里翻出个大 key，一个 list 存了几十万成员，直接 del 的时候整条命令阻塞。后来用 scan 分批渐进删除，线上才没抖。大 key 巡检这件事还是要定期做，不能等出事再想。",[37,65,66],{"id":66},"一点延伸",[11,68,69],{},"环境一致性是很多灵异问题的根源所在这：本地好的、测试坏的、生产偶尔坏。容器化解决了大部分，但配置漂移随时可能卷土重来，定期对比各环境的实际配置，当成例行的体检项目。",[11,71,72],{},"值班和告警的设计也值得花心思：告警分级，紧急的打电话，重要的进群，一般的攒日报。告警疲劳是运维事故的经典前置条件，值得忍痛把大量“看起来有用”的告警关掉，只留真正需要人处理的。",[11,74,75],{},"运维习惯养成的核心是自动化，凡是重复超过三次的操作都值得脚本化。手工操作的隐蔽成本不只是慢，是不可复现：同一次发布，脚本执行和手工执行的一致性完全不在一个量级。",[11,77,78],{},"基础设施的变更要遵循小步快跑的原则，一次改一个变量，改完观察再继续。一次性改一堆配置然后出了问题，最大的损失不是故障本身，是不知道哪一改才是元凶，回滚都无从下手。",[11,80,69],{},[37,82,83],{"id":83},"再补充几句",[11,85,86],{},"由这件事联想到阅读习惯：资料要看一手来源，译文和二手转述经常带着传播者的理解偏差，偏差叠几层之后和原意面目全非。多花十分钟读原文，省下的是未来几小时的排查，这笔账怎么算都划算。",[11,88,89],{},"还有个感受越来越深：知识落地成文字的过程本身就是学习的一部分。很多自以为想清楚的东西，写出来才发现逻辑有洞。写作是最好的检验，这也是坚持写博客这么多年的理由之一，写不出来的就是还没学会的。",[11,91,92],{},"过程中也反复体会到取舍的本质：没有完美的方案，只有当下约束下最合适的方案。把约束写清楚，方案的选择题就变成了证明题，这也是为什么我习惯先列约束再谈方案，顺序反了全是无效争论。",[11,94,95],{},"想想还是补一段：任何习惯的养成都绕不开启动成本，最有效的办法是把启动成本降到接近零。想跑就把鞋放门口，想写就把文档开着置顶，环境准备到位了，行动只是顺水推舟。",[37,97,98],{"id":98},"最后",[11,100,101],{},"写这篇之前刚给阳台的绿萝浇了水，照顾植物和写博客有个共同点，都靠长期的小坚持。",[11,103,104],{},"这篇写得断断续续，总算收尾，下篇见。",{"title":15,"searchDepth":16,"depth":17,"links":106},[107,108,109,110,111,112],{"id":39,"depth":16,"text":39},{"id":48,"depth":16,"text":48},{"id":54,"depth":16,"text":54},{"id":66,"depth":16,"text":66},{"id":83,"depth":16,"text":83},{"id":98,"depth":16,"text":98},[114],"DevOps","2023-05-04",false,{"excerpt":118},{"type":8,"value":119},[120],[11,121,35],{},"\u002Fposts\u002Fdevops\u002Fdockerfile-optimize-4",394200,{"title":29,"description":35},"posts\u002Fdevops\u002Fdockerfile-optimize-4",[127,128],"Docker","构建",[130],"devops",1314,"DDzDJmBmbocy5w4Vhp-GIl0tUgELVnYo5mA0W4AeaDc",{"prev":134,"next":137},{"path":135,"title":136},"\u002Fposts\u002Fdevops\u002Fdockerfile-optimize-3","Dockerfile 优化的几板斧（三）",{"path":138,"title":139},"\u002Fposts\u002Fdevops\u002Fdockerfile-optimize-5","Dockerfile 优化的几板斧（五）",[141,150,180],{"id":5,"title":6,"body":142,"createdAt":19,"description":13,"extension":20,"meta":148,"navigation":22,"path":23,"seo":149,"stem":25,"__hash__":26},{"type":8,"value":143,"toc":146},[144],[11,145,13],{},{"title":15,"searchDepth":16,"depth":17,"links":147},[],{},{"description":13},{"id":151,"title":152,"body":153,"createdAt":173,"description":174,"extension":20,"meta":175,"navigation":22,"path":176,"seo":177,"stem":178,"__hash__":179},"notes\u002Fnotes\u002F2026-11-14-1.md","2026 11 14 1",{"type":8,"value":154,"toc":171},[155],[11,156,157,158,162,163,170],{},"站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 ",[159,160,161],"strong",{},"Markdown","，写链接也不用到编辑器：",[164,165,169],"a",{"href":166,"rel":167},"https:\u002F\u002Fcontent.nuxt.com",[168],"nofollow","Nuxt Content","。",{"title":15,"searchDepth":16,"depth":17,"links":172},[],"2026-11-14","站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 Markdown，写链接也不用到编辑器：Nuxt Content。",{},"\u002Fnotes\u002F2026-11-14-1",{"description":174},"notes\u002F2026-11-14-1","LLJX_RKU7cgpT6aHw4DZWUZNQ_G_UzELWPKbksJvzfs",{"id":181,"title":182,"body":183,"createdAt":198,"description":199,"extension":20,"meta":200,"navigation":22,"path":201,"seo":202,"stem":203,"__hash__":204},"notes\u002Fnotes\u002F2026-11-14-2.md","2026 11 14 2",{"type":8,"value":184,"toc":196},[185],[11,186,187,191,192,195],{},[188,189,190],"code",{},"readPixels"," 读不到内容不是 bug，是 ",[188,193,194],{},"preserveDrawingBuffer"," 默认关闭——帧提交后缓冲即被清空。",{"title":15,"searchDepth":16,"depth":17,"links":197},[],"2026-11-13","readPixels 读不到内容不是 bug，是 preserveDrawingBuffer 默认关闭——帧提交后缓冲即被清空。",{},"\u002Fnotes\u002F2026-11-14-2",{"description":199},"notes\u002F2026-11-14-2","i7xWqq2eNoU_seSbLQjqlB9gE51fM-PVLUEYCHBkOA4",1795316730353]