[{"data":1,"prerenderedAt":203},["ShallowReactive",2],{"notes-latest-1":3,"post:\u002Fposts\u002Fdevops\u002Fcicd-pipeline-6":27,"surround:\u002Fposts\u002Fdevops\u002Fcicd-pipeline-6":131,"notes-latest-3":138},[4],{"id":5,"title":6,"body":7,"createdAt":19,"description":13,"extension":20,"meta":21,"navigation":22,"path":23,"seo":24,"stem":25,"__hash__":26},"notes\u002Fnotes\u002F2026-11-14-1-2.md","2026 11 14 1 2",{"type":8,"value":9,"toc":14},"minimark",[10],[11,12,13],"p",{},"站点上线了「随笔」：支持一个文件多个随笔",{"title":15,"searchDepth":16,"depth":17,"links":18},"",2,3,[],"2026-11-17","md",{},true,"\u002Fnotes\u002F2026-11-14-1-2",{"description":13},"notes\u002F2026-11-14-1-2","hDP9fvaunHzVrZQ6QifuOtj9VrqbxlPb_52KE5wSjD0",{"id":28,"title":29,"author":30,"body":31,"categories":111,"comment":22,"cover":30,"createdAt":113,"description":35,"draft":114,"extension":20,"meta":115,"navigation":22,"path":120,"readingTime":121,"recommend":114,"seo":122,"series":30,"stem":123,"tags":124,"top":114,"topics":127,"updatedAt":30,"words":129,"__hash__":130},"posts\u002Fposts\u002Fdevops\u002Fcicd-pipeline-6.md","一条顺手的 CI\u002FCD 流水线长什么样（六）",null,{"type":8,"value":32,"toc":103},[33,36,40,43,46,49,52,55,58,61,64,67,70,73,76,79,82,85,88,91,94,97,100],[11,34,35],{},"长话短说，这篇就是一次完整的记录，从问题怎么来的，到最后方案怎么定，中间的弯路也都保留。",[37,38,39],"h2",{"id":39},"阶段怎么划分",[11,41,42],{},"一条用起来舒服的流水线，阶段大致是：拉代码、编译构建、静态检查与单测、构建镜像推仓库、部署测试环境、自动化冒烟、人工确认后发布生产。每个阶段的失败都要能快速定位，日志结构化输出，产物用版本号管理，回滚就是部署上一个版本的镜像，一条命令的事。",[11,44,45],{},"速度是流水线的生命线。缓存依赖目录、并行跑无依赖的检查、构建产物增量复用，这些做到位之后，十几分钟的流水线能压到几分钟。反馈越快，开发者越愿意小步提交，集成的痛苦就越少。",[37,47,48],{"id":48},"几个原则",[11,50,51],{},"几个原则：主分支永远可部署，这是流水线存在的意义；环境配置全部走变量注入，镜像只构建一次多环境复用，同一镜像到处重新构建的团队迟早会踩配置漂移的坑；生产发布必须有人工闸门或者自动化的发布检查单；失败要通知到人，流水线挂了三天没人管，CI 就名存实亡了。工具选 Jenkins 还是 GitLab CI 都行，这些原则才是核心。",[37,53,54],{"id":54},"记两个小问题",[11,56,57],{},"数据迁移演练时发现字段长度截断，源库字符集和目标库不一样，同一段中文占的长度都不同。迁移脚本先在影子表跑一遍，这种事不演练，上了生产就是事故。",[11,59,60],{},"@Transactional 加在私有方法上、或者同类里自调用，事务都是不生效的，因为绕过了代理对象。这类 AOP 的坑，理解了代理机制就一目了然，没理解之前就是玄学。",[11,62,63],{},"服务注册状态看着正常，流量却没打过来。心跳超时加上保护阈值，Nacos 短暂摘除了实例。注册中心的状态和真实可用性是两回事，健康检查永远要结合业务探活来看。",[37,65,66],{"id":66},"顺便一提",[11,68,69],{},"环境一致性是很多灵异问题的根源所在这：本地好的、测试坏的、生产偶尔坏。容器化解决了大部分，但配置漂移随时可能卷土重来，定期对比各环境的实际配置，当成例行的体检项目。",[11,71,72],{},"值班和告警的设计也值得花心思：告警分级，紧急的打电话，重要的进群，一般的攒日报。告警疲劳是运维事故的经典前置条件，值得忍痛把大量“看起来有用”的告警关掉，只留真正需要人处理的。",[11,74,75],{},"运维习惯养成的核心是自动化，凡是重复超过三次的操作都值得脚本化。手工操作的隐蔽成本不只是慢，是不可复现：同一次发布，脚本执行和手工执行的一致性完全不在一个量级。",[11,77,78],{},"基础设施的变更要遵循小步快跑的原则，一次改一个变量，改完观察再继续。一次性改一堆配置然后出了问题，最大的损失不是故障本身，是不知道哪一改才是元凶，回滚都无从下手。",[37,80,81],{"id":81},"另外记几笔",[11,83,84],{},"回顾这个过程，最大的教训其实是克制。可选项永远比需要的多，每个新方案看起来都比现状好一点，但都加上之后，系统就成了没人看得懂的拼贴画。做减法的判断比做加法的胆子更值钱。",[11,86,87],{},"这种事急不来，和锻炼身体是一个道理：练一天没变化，练三个月身体自己会说话。技术积累也是这样，每天一点，回过头看的时候差距已经拉开了，只是身在其中感觉不到而已。",[11,89,90],{},"想到一个问题：为什么同样的事情，不同的人做出来差别那么大。后来觉得答案在于对边界的处理，正常路径人人会写，边界和异常的处理习惯才是拉开差距的地方。做事和写代码一样，细节的密度决定成品的质量。",[11,92,93],{},"写到这里顺便吐个槽，这类事情最难的部分往往不是技术本身，是说服别人相信它值得投入。方案再好，落不到排期上都是空谈，所以学会用数据的语言讲价值，算是这些年额外的必修课。",[37,95,96],{"id":96},"写在最后",[11,98,99],{},"周末在家调这个，家里领导问我看到底有什么乐趣，认真想了想，还真描述不上来，大概就是那种东西被自己理顺的舒服。",[11,101,102],{},"这篇就先这样，想到了什么再回来补。",{"title":15,"searchDepth":16,"depth":17,"links":104},[105,106,107,108,109,110],{"id":39,"depth":16,"text":39},{"id":48,"depth":16,"text":48},{"id":54,"depth":16,"text":54},{"id":66,"depth":16,"text":66},{"id":81,"depth":16,"text":81},{"id":96,"depth":16,"text":96},[112],"DevOps","2026-05-02",false,{"excerpt":116},{"type":8,"value":117},[118],[11,119,35],{},"\u002Fposts\u002Fdevops\u002Fcicd-pipeline-6",375600,{"title":29,"description":35},"posts\u002Fdevops\u002Fcicd-pipeline-6",[125,126],"CI\u002FCD","Jenkins",[128],"devops",1252,"GHe-rPYlczjxc1Kc3fWA-2OsA0HnPS5kUwXjcOLhHBo",{"prev":132,"next":135},{"path":133,"title":134},"\u002Fposts\u002Fdevops\u002Fcicd-pipeline-5","一条顺手的 CI\u002FCD 流水线长什么样（五）",{"path":136,"title":137},"\u002Fposts\u002Fdevops\u002Fdockerfile-optimize","Dockerfile 优化的几板斧",[139,148,178],{"id":5,"title":6,"body":140,"createdAt":19,"description":13,"extension":20,"meta":146,"navigation":22,"path":23,"seo":147,"stem":25,"__hash__":26},{"type":8,"value":141,"toc":144},[142],[11,143,13],{},{"title":15,"searchDepth":16,"depth":17,"links":145},[],{},{"description":13},{"id":149,"title":150,"body":151,"createdAt":171,"description":172,"extension":20,"meta":173,"navigation":22,"path":174,"seo":175,"stem":176,"__hash__":177},"notes\u002Fnotes\u002F2026-11-14-1.md","2026 11 14 1",{"type":8,"value":152,"toc":169},[153],[11,154,155,156,160,161,168],{},"站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 ",[157,158,159],"strong",{},"Markdown","，写链接也不用到编辑器：",[162,163,167],"a",{"href":164,"rel":165},"https:\u002F\u002Fcontent.nuxt.com",[166],"nofollow","Nuxt Content","。",{"title":15,"searchDepth":16,"depth":17,"links":170},[],"2026-11-14","站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 Markdown，写链接也不用到编辑器：Nuxt Content。",{},"\u002Fnotes\u002F2026-11-14-1",{"description":172},"notes\u002F2026-11-14-1","LLJX_RKU7cgpT6aHw4DZWUZNQ_G_UzELWPKbksJvzfs",{"id":179,"title":180,"body":181,"createdAt":196,"description":197,"extension":20,"meta":198,"navigation":22,"path":199,"seo":200,"stem":201,"__hash__":202},"notes\u002Fnotes\u002F2026-11-14-2.md","2026 11 14 2",{"type":8,"value":182,"toc":194},[183],[11,184,185,189,190,193],{},[186,187,188],"code",{},"readPixels"," 读不到内容不是 bug，是 ",[186,191,192],{},"preserveDrawingBuffer"," 默认关闭——帧提交后缓冲即被清空。",{"title":15,"searchDepth":16,"depth":17,"links":195},[],"2026-11-13","readPixels 读不到内容不是 bug，是 preserveDrawingBuffer 默认关闭——帧提交后缓冲即被清空。",{},"\u002Fnotes\u002F2026-11-14-2",{"description":197},"notes\u002F2026-11-14-2","i7xWqq2eNoU_seSbLQjqlB9gE51fM-PVLUEYCHBkOA4",1795274108434]