[{"data":1,"prerenderedAt":205},["ShallowReactive",2],{"notes-latest-1":3,"post:\u002Fposts\u002Fdevops\u002Fcicd-pipeline":27,"surround:\u002Fposts\u002Fdevops\u002Fcicd-pipeline":133,"notes-latest-3":140},[4],{"id":5,"title":6,"body":7,"createdAt":19,"description":13,"extension":20,"meta":21,"navigation":22,"path":23,"seo":24,"stem":25,"__hash__":26},"notes\u002Fnotes\u002F2026-11-14-1-2.md","2026 11 14 1 2",{"type":8,"value":9,"toc":14},"minimark",[10],[11,12,13],"p",{},"站点上线了「随笔」：支持一个文件多个随笔",{"title":15,"searchDepth":16,"depth":17,"links":18},"",2,3,[],"2026-11-17","md",{},true,"\u002Fnotes\u002F2026-11-14-1-2",{"description":13},"notes\u002F2026-11-14-1-2","hDP9fvaunHzVrZQ6QifuOtj9VrqbxlPb_52KE5wSjD0",{"id":28,"title":29,"author":30,"body":31,"categories":113,"comment":22,"cover":30,"createdAt":115,"description":35,"draft":116,"extension":20,"meta":117,"navigation":22,"path":122,"readingTime":123,"recommend":116,"seo":124,"series":30,"stem":125,"tags":126,"top":116,"topics":129,"updatedAt":30,"words":131,"__hash__":132},"posts\u002Fposts\u002Fdevops\u002Fcicd-pipeline.md","一条顺手的 CI\u002FCD 流水线长什么样",null,{"type":8,"value":32,"toc":105},[33,36,40,43,46,49,52,55,58,61,64,67,70,73,76,79,81,84,87,90,93,96,99,102],[11,34,35],{},"前几天有同事问到这个，我口头讲了一遍，回头想想还是写成文章更完整，也算把自己的理解再过一遍。",[37,38,39],"h2",{"id":39},"阶段怎么划分",[11,41,42],{},"一条用起来舒服的流水线，阶段大致是：拉代码、编译构建、静态检查与单测、构建镜像推仓库、部署测试环境、自动化冒烟、人工确认后发布生产。每个阶段的失败都要能快速定位，日志结构化输出，产物用版本号管理，回滚就是部署上一个版本的镜像，一条命令的事。",[11,44,45],{},"速度是流水线的生命线。缓存依赖目录、并行跑无依赖的检查、构建产物增量复用，这些做到位之后，十几分钟的流水线能压到几分钟。反馈越快，开发者越愿意小步提交，集成的痛苦就越少。",[37,47,48],{"id":48},"几个原则",[11,50,51],{},"几个原则：主分支永远可部署，这是流水线存在的意义；环境配置全部走变量注入，镜像只构建一次多环境复用，同一镜像到处重新构建的团队迟早会踩配置漂移的坑；生产发布必须有人工闸门或者自动化的发布检查单；失败要通知到人，流水线挂了三天没人管，CI 就名存实亡了。工具选 Jenkins 还是 GitLab CI 都行，这些原则才是核心。",[37,53,54],{"id":54},"记两个小问题",[11,56,57],{},"接口偶发超时，压测环境复现不了，后来发现是连接池的 maxPoolSize 用了默认值，高峰期全在等连接。调大之后看监控，等待队列直接归零，这种参数还是得按自己的流量压一遍。",[11,59,60],{},"镜像优化前是 1.2G，换 alpine 基础镜像加上多阶段构建，砍到两百兆以内，拉取时间肉眼可见地降下来。构建上下文里别把无关文件拷进去，.dockerignore 值得认真配一次。",[11,62,63],{},"上传接口一直 413，代码怎么改都没用，最后才反应过来是 Nginx 的 client_max_body_size 默认 1m 挡住了。这种不在应用层的问题，排查方向一开始就该往链路上想。",[37,65,66],{"id":66},"顺便一提",[11,68,69],{},"运维习惯养成的核心是自动化，凡是重复超过三次的操作都值得脚本化。手工操作的隐蔽成本不只是慢，是不可复现：同一次发布，脚本执行和手工执行的一致性完全不在一个量级。",[11,71,72],{},"基础设施的变更要遵循小步快跑的原则，一次改一个变量，改完观察再继续。一次性改一堆配置然后出了问题，最大的损失不是故障本身，是不知道哪一改才是元凶，回滚都无从下手。",[11,74,75],{},"环境一致性是很多灵异问题的根源所在这：本地好的、测试坏的、生产偶尔坏。容器化解决了大部分，但配置漂移随时可能卷土重来，定期对比各环境的实际配置，当成例行的体检项目。",[11,77,78],{},"值班和告警的设计也值得花心思：告警分级，紧急的打电话，重要的进群，一般的攒日报。告警疲劳是运维事故的经典前置条件，值得忍痛把大量“看起来有用”的告警关掉，只留真正需要人处理的。",[11,80,69],{},[37,82,83],{"id":83},"另外记几笔",[11,85,86],{},"从更高的视角看，这类问题都有一个共同结构：短期收益和长期收益打架。短期的诱惑总是具体而生动，长期的回报抽象而遥远，赢家通常是那些把长期目标拆成短期可感的小奖励的人。",[11,88,89],{},"讲个题外话，做这类事情的时候最好留个记录的习惯，当时的判断依据比结果更珍贵。结果好可能只是运气好，把决策过程记下来，好运才可能被复制，坏运才可能被规避。",[11,91,92],{},"然后想说，承认不懂是这行的美德。这次遇到不懂的地方，老老实实补了两天的课，比硬着头皮往上糊的方案强太多。不懂装懂的代价从来不会消失，只是延期，还带利息。",[11,94,95],{},"平衡感很重要的一件事：投入和收益的比例。所有优化都值得先问一句，这件事的收益上限是多少，值多少投入。无限打磨一个低价值的东西是工程师最常见的温柔陷阱，包括我自己在内。",[37,97,98],{"id":98},"写在最后",[11,100,101],{},"最近加班多了些，更新慢了一点，周五晚上泡杯茶写下这篇，算是给自己留点节奏。",[11,103,104],{},"大概就是这些，有不同做法欢迎评论区交流。",{"title":15,"searchDepth":16,"depth":17,"links":106},[107,108,109,110,111,112],{"id":39,"depth":16,"text":39},{"id":48,"depth":16,"text":48},{"id":54,"depth":16,"text":54},{"id":66,"depth":16,"text":66},{"id":83,"depth":16,"text":83},{"id":98,"depth":16,"text":98},[114],"DevOps","2025-01-30",false,{"excerpt":118},{"type":8,"value":119},[120],[11,121,35],{},"\u002Fposts\u002Fdevops\u002Fcicd-pipeline",386700,{"title":29,"description":35},"posts\u002Fdevops\u002Fcicd-pipeline",[127,128],"CI\u002FCD","Jenkins",[130],"devops",1289,"xc22OqjKaBwG0xjlYfFsRV_7jNCn6xUW-E2rtx4KkK0",{"prev":134,"next":137},{"path":135,"title":136},"\u002Fposts\u002Fdesign_pattern\u002F设计之魂的六大原则","设计之魂的六大原则",{"path":138,"title":139},"\u002Fposts\u002Fdevops\u002Fcicd-pipeline-2","一条顺手的 CI\u002FCD 流水线长什么样（二）",[141,150,180],{"id":5,"title":6,"body":142,"createdAt":19,"description":13,"extension":20,"meta":148,"navigation":22,"path":23,"seo":149,"stem":25,"__hash__":26},{"type":8,"value":143,"toc":146},[144],[11,145,13],{},{"title":15,"searchDepth":16,"depth":17,"links":147},[],{},{"description":13},{"id":151,"title":152,"body":153,"createdAt":173,"description":174,"extension":20,"meta":175,"navigation":22,"path":176,"seo":177,"stem":178,"__hash__":179},"notes\u002Fnotes\u002F2026-11-14-1.md","2026 11 14 1",{"type":8,"value":154,"toc":171},[155],[11,156,157,158,162,163,170],{},"站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 ",[159,160,161],"strong",{},"Markdown","，写链接也不用到编辑器：",[164,165,169],"a",{"href":166,"rel":167},"https:\u002F\u002Fcontent.nuxt.com",[168],"nofollow","Nuxt Content","。",{"title":15,"searchDepth":16,"depth":17,"links":172},[],"2026-11-14","站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 Markdown，写链接也不用到编辑器：Nuxt Content。",{},"\u002Fnotes\u002F2026-11-14-1",{"description":174},"notes\u002F2026-11-14-1","LLJX_RKU7cgpT6aHw4DZWUZNQ_G_UzELWPKbksJvzfs",{"id":181,"title":182,"body":183,"createdAt":198,"description":199,"extension":20,"meta":200,"navigation":22,"path":201,"seo":202,"stem":203,"__hash__":204},"notes\u002Fnotes\u002F2026-11-14-2.md","2026 11 14 2",{"type":8,"value":184,"toc":196},[185],[11,186,187,191,192,195],{},[188,189,190],"code",{},"readPixels"," 读不到内容不是 bug，是 ",[188,193,194],{},"preserveDrawingBuffer"," 默认关闭——帧提交后缓冲即被清空。",{"title":15,"searchDepth":16,"depth":17,"links":197},[],"2026-11-13","readPixels 读不到内容不是 bug，是 preserveDrawingBuffer 默认关闭——帧提交后缓冲即被清空。",{},"\u002Fnotes\u002F2026-11-14-2",{"description":199},"notes\u002F2026-11-14-2","i7xWqq2eNoU_seSbLQjqlB9gE51fM-PVLUEYCHBkOA4",1795273147455]