[{"data":1,"prerenderedAt":205},["ShallowReactive",2],{"notes-latest-1":3,"post:\u002Fposts\u002Fdevops\u002Fdockerfile-optimize-2":27,"surround:\u002Fposts\u002Fdevops\u002Fdockerfile-optimize-2":133,"notes-latest-3":140},[4],{"id":5,"title":6,"body":7,"createdAt":19,"description":13,"extension":20,"meta":21,"navigation":22,"path":23,"seo":24,"stem":25,"__hash__":26},"notes\u002Fnotes\u002F2026-11-14-1-2.md","2026 11 14 1 2",{"type":8,"value":9,"toc":14},"minimark",[10],[11,12,13],"p",{},"站点上线了「随笔」：支持一个文件多个随笔",{"title":15,"searchDepth":16,"depth":17,"links":18},"",2,3,[],"2026-11-17","md",{},true,"\u002Fnotes\u002F2026-11-14-1-2",{"description":13},"notes\u002F2026-11-14-1-2","hDP9fvaunHzVrZQ6QifuOtj9VrqbxlPb_52KE5wSjD0",{"id":28,"title":29,"author":30,"body":31,"categories":113,"comment":22,"cover":30,"createdAt":115,"description":35,"draft":116,"extension":20,"meta":117,"navigation":22,"path":122,"readingTime":123,"recommend":116,"seo":124,"series":30,"stem":125,"tags":126,"top":116,"topics":129,"updatedAt":30,"words":131,"__hash__":132},"posts\u002Fposts\u002Fdevops\u002Fdockerfile-optimize-2.md","Dockerfile 优化的几板斧（二）",null,{"type":8,"value":32,"toc":105},[33,36,40,43,46,49,52,55,58,61,64,67,70,73,76,79,81,84,87,90,93,96,99,102],[11,34,35],{},"这篇整理一下最近在弄的东西，前后拖了些时间，趁记性还在赶紧写下来，免得过阵子细节全忘。",[37,38,39],"h2",{"id":39},"镜像为什么大",[11,41,42],{},"镜像大的原因通常三个：基础镜像太重、层里堆了垃圾、构建工具被打了进去。对策也对应三条：Java 应用选 slim 或 alpine 系基础镜像，运行时不需要 JDK 全家桶，JRE 甚至定制运行时更省；多阶段构建让编译环境只存在于构建阶段，最终镜像只拷贝产物；每条 RUN 结尾清理缓存，或者合并成一层，减小层数与残留。",[11,44,45],{},"还有个容易被忽略的点：构建上下文。把 node_modules、日志、本地大文件都拷进 context，就算 Dockerfile 没用它们，传输和缓存判断也会变慢，一个像样的 .dockerignore 性价比极高。",[37,47,48],{"id":48},"缓存友好",[11,50,51],{},"除了小，还要快。层缓存是按顺序匹配的，依赖文件变化少的步骤放前面：先拷贝依赖清单装依赖，再拷贝源码编译，日常改代码就只命中后面的层，依赖安装的几分钟全省下来。这些优化做完，一个 Java 服务的镜像从 1G 上下降到一两百兆，构建从十分钟降到两分钟内，CI 的体感完全是两个世界。",[37,53,54],{"id":54},"顺手记两个坑",[11,56,57],{},"RabbitMQ 队列堆积，消费者明明在跑。看配置 prefetch 设得太大，单条消息处理又慢，吞吐全耗在慢消息上。把 prefetch 调小，吞吐反而上去了，多不一定快。",[11,59,60],{},"前端拿 Long 类型的 id 显示成了另一个数，JS 的 Number 精度上限就到 2 的 53 次方。序列化时把 Long 转 String，这是前后端协作里经典的暗坑，吃过一次亏就会记一辈子。",[11,62,63],{},"定时任务上线后时间全不对，cron 是按服务器时区算的，容器里又是 UTC。统一时区这种事，应该在基础设施层一次做对，而不是每个应用各自打补丁。",[37,65,66],{"id":66},"一点延伸",[11,68,69],{},"环境一致性是很多灵异问题的根源所在这：本地好的、测试坏的、生产偶尔坏。容器化解决了大部分，但配置漂移随时可能卷土重来，定期对比各环境的实际配置，当成例行的体检项目。",[11,71,72],{},"值班和告警的设计也值得花心思：告警分级，紧急的打电话，重要的进群，一般的攒日报。告警疲劳是运维事故的经典前置条件，值得忍痛把大量“看起来有用”的告警关掉，只留真正需要人处理的。",[11,74,75],{},"运维习惯养成的核心是自动化，凡是重复超过三次的操作都值得脚本化。手工操作的隐蔽成本不只是慢，是不可复现：同一次发布，脚本执行和手工执行的一致性完全不在一个量级。",[11,77,78],{},"基础设施的变更要遵循小步快跑的原则，一次改一个变量，改完观察再继续。一次性改一堆配置然后出了问题，最大的损失不是故障本身，是不知道哪一改才是元凶，回滚都无从下手。",[11,80,69],{},[37,82,83],{"id":83},"再补充几句",[11,85,86],{},"顺便说说协作里的体会：这类事自己闷头做效率最高，但闷头做完往往返工最多。适度地提前同步，把方向先对齐，看似慢了半天，实际省掉的是几天的返工。沟通的时机比沟通的技巧更值得琢磨。",[11,88,89],{},"其实回看这些年踩的坑，大坑几乎都和贪快有关。快不是错，错的是想跳过必要步骤的快，地基没打牢盖得越快塌得越响。慢下来把该做的做扎实，反而是最快的路径，这话说了很多年，每次验证都对。",[11,91,92],{},"有个观察分享给大家：技术的成长曲线不是线性的，是一段平台加一次跃迁。平台期最磨人，感觉学了很多没进步，其实是在攒素材，攒够了某个契机一到就突飞猛进。所以在平台期别否定自己，那是跃迁的前奏。",[11,94,95],{},"再补充一个角度：做这些事情的时候，工具的顺滑度影响巨大。同样的活，称手的工具能让摩擦力小一半，这种差异日积月累就是人和人的差距。定期审视自己的工具链，删掉碍事的，补上趁手的，值得当成一个固定动作。",[37,97,98],{"id":98},"最后",[11,100,101],{},"昨晚整理书架翻出大学的数据结构课本，页边写满了字，写这篇的时候还翻出来对了两个细节。",[11,103,104],{},"大概就是这些，有不同做法欢迎评论区交流。",{"title":15,"searchDepth":16,"depth":17,"links":106},[107,108,109,110,111,112],{"id":39,"depth":16,"text":39},{"id":48,"depth":16,"text":48},{"id":54,"depth":16,"text":54},{"id":66,"depth":16,"text":66},{"id":83,"depth":16,"text":83},{"id":98,"depth":16,"text":98},[114],"DevOps","2026-08-29",false,{"excerpt":118},{"type":8,"value":119},[120],[11,121,35],{},"\u002Fposts\u002Fdevops\u002Fdockerfile-optimize-2",390600,{"title":29,"description":35},"posts\u002Fdevops\u002Fdockerfile-optimize-2",[127,128],"Docker","构建",[130],"devops",1302,"kPNt9qVM-xgqB4p38X9LeHaXRiycDiMJ2tBDBdZOTpI",{"prev":134,"next":137},{"path":135,"title":136},"\u002Fposts\u002Fdevops\u002Fdockerfile-optimize","Dockerfile 优化的几板斧",{"path":138,"title":139},"\u002Fposts\u002Fdevops\u002Fdockerfile-optimize-3","Dockerfile 优化的几板斧（三）",[141,150,180],{"id":5,"title":6,"body":142,"createdAt":19,"description":13,"extension":20,"meta":148,"navigation":22,"path":23,"seo":149,"stem":25,"__hash__":26},{"type":8,"value":143,"toc":146},[144],[11,145,13],{},{"title":15,"searchDepth":16,"depth":17,"links":147},[],{},{"description":13},{"id":151,"title":152,"body":153,"createdAt":173,"description":174,"extension":20,"meta":175,"navigation":22,"path":176,"seo":177,"stem":178,"__hash__":179},"notes\u002Fnotes\u002F2026-11-14-1.md","2026 11 14 1",{"type":8,"value":154,"toc":171},[155],[11,156,157,158,162,163,170],{},"站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 ",[159,160,161],"strong",{},"Markdown","，写链接也不用到编辑器：",[164,165,169],"a",{"href":166,"rel":167},"https:\u002F\u002Fcontent.nuxt.com",[168],"nofollow","Nuxt Content","。",{"title":15,"searchDepth":16,"depth":17,"links":172},[],"2026-11-14","站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 Markdown，写链接也不用到编辑器：Nuxt Content。",{},"\u002Fnotes\u002F2026-11-14-1",{"description":174},"notes\u002F2026-11-14-1","LLJX_RKU7cgpT6aHw4DZWUZNQ_G_UzELWPKbksJvzfs",{"id":181,"title":182,"body":183,"createdAt":198,"description":199,"extension":20,"meta":200,"navigation":22,"path":201,"seo":202,"stem":203,"__hash__":204},"notes\u002Fnotes\u002F2026-11-14-2.md","2026 11 14 2",{"type":8,"value":184,"toc":196},[185],[11,186,187,191,192,195],{},[188,189,190],"code",{},"readPixels"," 读不到内容不是 bug，是 ",[188,193,194],{},"preserveDrawingBuffer"," 默认关闭——帧提交后缓冲即被清空。",{"title":15,"searchDepth":16,"depth":17,"links":197},[],"2026-11-13","readPixels 读不到内容不是 bug，是 preserveDrawingBuffer 默认关闭——帧提交后缓冲即被清空。",{},"\u002Fnotes\u002F2026-11-14-2",{"description":199},"notes\u002F2026-11-14-2","i7xWqq2eNoU_seSbLQjqlB9gE51fM-PVLUEYCHBkOA4",1795303387349]