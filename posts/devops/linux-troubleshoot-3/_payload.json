[{"data":1,"prerenderedAt":205},["ShallowReactive",2],{"notes-latest-1":3,"post:\u002Fposts\u002Fdevops\u002Flinux-troubleshoot-3":27,"surround:\u002Fposts\u002Fdevops\u002Flinux-troubleshoot-3":133,"notes-latest-3":140},[4],{"id":5,"title":6,"body":7,"createdAt":19,"description":13,"extension":20,"meta":21,"navigation":22,"path":23,"seo":24,"stem":25,"__hash__":26},"notes\u002Fnotes\u002F2026-11-14-1-2.md","2026 11 14 1 2",{"type":8,"value":9,"toc":14},"minimark",[10],[11,12,13],"p",{},"站点上线了「随笔」：支持一个文件多个随笔",{"title":15,"searchDepth":16,"depth":17,"links":18},"",2,3,[],"2026-11-17","md",{},true,"\u002Fnotes\u002F2026-11-14-1-2",{"description":13},"notes\u002F2026-11-14-1-2","hDP9fvaunHzVrZQ6QifuOtj9VrqbxlPb_52KE5wSjD0",{"id":28,"title":29,"author":30,"body":31,"categories":113,"comment":22,"cover":30,"createdAt":115,"description":35,"draft":116,"extension":20,"meta":117,"navigation":22,"path":122,"readingTime":123,"recommend":116,"seo":124,"series":30,"stem":125,"tags":126,"top":116,"topics":129,"updatedAt":30,"words":131,"__hash__":132},"posts\u002Fposts\u002Fdevops\u002Flinux-troubleshoot-3.md","线上排查的命令组合拳（三）",null,{"type":8,"value":32,"toc":105},[33,36,40,43,46,49,52,55,58,61,64,67,70,73,76,79,81,84,87,90,93,96,99,102],[11,34,35],{},"之前写过类似的话题，这篇算补充篇，主要记最近新的体会，两篇对照着看会更完整一些。",[37,38,39],"h2",{"id":39},"先看四个资源",[11,41,42],{},"线上机器出问题的排查，我基本固定一套顺序：top 看整体，谁在吃 CPU 和内存；free 看内存和 swap 有没有被动用；df 看磁盘是不是写满了，日志打爆磁盘引发的故障比想象中多；iostat 看磁盘 IO 是不是成瓶颈。四板斧下来，资源层面的问题基本能定位个七七八八。",[11,44,45],{},"进程层面，Java 服务先看线程，top -H 找到高 CPU 线程号，转十六进制去 jstack 里对号入座；网络问题用 ss 替代 netstat 看连接状态，大量 CLOSE_WAIT 说明应用没处理断开，TIME_WAIT 过多要调端口复用。",[37,47,48],{"id":48},"日志与定位",[11,50,51],{},"日志检索是最后一步也常常是决定性的一步：grep 加上下文、tail -f 盯实时、按时间切片缩小范围。还有一个容易被忽略的维度，把应用日志、系统日志和网络设备的记录对齐时间轴看，很多孤立的异常串起来就是完整的故事。排查完把过程写成文档归档，下次同类问题就是十分钟的事，团队的经验库就是这么攒起来的。",[37,53,54],{"id":54},"顺手记两个坑",[11,56,57],{},"前端双击重复提交导致创建了重复单据。token 机制先挡一层，唯一索引再兜一层，两层防线齐了才踏实。幂等这件事，永远要在离数据最近的地方兜底。",[11,59,60],{},"HTTPS 证书配完，桌面浏览器都正常，部分安卓机型握手失败。是证书链不完整，中间证书没部署。证书工具会提示，但前提是你出问题之前主动去验证一次。",[11,62,63],{},"接手老代码，方法级 synchronized 把远程调用也包了进去，整个接口的吞吐被锁死。缩小锁范围只保护共享变量，性能立刻回来。锁的粒度，永远值得多看一眼。",[37,65,66],{"id":66},"一点延伸",[11,68,69],{},"运维习惯养成的核心是自动化，凡是重复超过三次的操作都值得脚本化。手工操作的隐蔽成本不只是慢，是不可复现：同一次发布，脚本执行和手工执行的一致性完全不在一个量级。",[11,71,72],{},"基础设施的变更要遵循小步快跑的原则，一次改一个变量，改完观察再继续。一次性改一堆配置然后出了问题，最大的损失不是故障本身，是不知道哪一改才是元凶，回滚都无从下手。",[11,74,75],{},"环境一致性是很多灵异问题的根源所在这：本地好的、测试坏的、生产偶尔坏。容器化解决了大部分，但配置漂移随时可能卷土重来，定期对比各环境的实际配置，当成例行的体检项目。",[11,77,78],{},"值班和告警的设计也值得花心思：告警分级，紧急的打电话，重要的进群，一般的攒日报。告警疲劳是运维事故的经典前置条件，值得忍痛把大量“看起来有用”的告警关掉，只留真正需要人处理的。",[11,80,69],{},[37,82,83],{"id":83},"再补充几句",[11,85,86],{},"有时候会想，学一门新技术到底学到的是什么。语法和 API 会过时，真正的收获是它看问题的角度。多一门语言就多一副眼镜，同一副牌桌，能看到别人看不到的牌路，这是这么多年折腾下来最确定的回报。",[11,88,89],{},"记一个产生过的动摇：做到一半觉得这玩意儿是不是没什么意义。后来想通了，意义不是事情自带的，是你把它做完并沉淀下来之后长出来的。烂尾的才真的没意义，做完的最差也是一篇笔记。",[11,91,92],{},"顺便说说协作里的体会：这类事自己闷头做效率最高，但闷头做完往往返工最多。适度地提前同步，把方向先对齐，看似慢了半天，实际省掉的是几天的返工。沟通的时机比沟通的技巧更值得琢磨。",[11,94,95],{},"其实回看这些年踩的坑，大坑几乎都和贪快有关。快不是错，错的是想跳过必要步骤的快，地基没打牢盖得越快塌得越响。慢下来把该做的做扎实，反而是最快的路径，这话说了很多年，每次验证都对。",[37,97,98],{"id":98},"小结",[11,100,101],{},"天冷了，敲键盘手有点僵，新入手的木质腕托派上了用场，顺便把欠的这篇写完。",[11,103,104],{},"差不多了，剩下的细节等用到的时候再展开写。",{"title":15,"searchDepth":16,"depth":17,"links":106},[107,108,109,110,111,112],{"id":39,"depth":16,"text":39},{"id":48,"depth":16,"text":48},{"id":54,"depth":16,"text":54},{"id":66,"depth":16,"text":66},{"id":83,"depth":16,"text":83},{"id":98,"depth":16,"text":98},[114],"DevOps","2024-11-22",false,{"excerpt":118},{"type":8,"value":119},[120],[11,121,35],{},"\u002Fposts\u002Fdevops\u002Flinux-troubleshoot-3",386700,{"title":29,"description":35},"posts\u002Fdevops\u002Flinux-troubleshoot-3",[127,128],"Linux","排查",[130],"devops",1289,"TN2RQ83cW99QFpGzBXsz8bQL6yxdvUxmS7l0YHC2Yt4",{"prev":134,"next":137},{"path":135,"title":136},"\u002Fposts\u002Fdevops\u002Flinux-troubleshoot-2","线上排查的命令组合拳（二）",{"path":138,"title":139},"\u002Fposts\u002Fdevops\u002Flinux-troubleshoot-4","线上排查的命令组合拳（四）",[141,150,180],{"id":5,"title":6,"body":142,"createdAt":19,"description":13,"extension":20,"meta":148,"navigation":22,"path":23,"seo":149,"stem":25,"__hash__":26},{"type":8,"value":143,"toc":146},[144],[11,145,13],{},{"title":15,"searchDepth":16,"depth":17,"links":147},[],{},{"description":13},{"id":151,"title":152,"body":153,"createdAt":173,"description":174,"extension":20,"meta":175,"navigation":22,"path":176,"seo":177,"stem":178,"__hash__":179},"notes\u002Fnotes\u002F2026-11-14-1.md","2026 11 14 1",{"type":8,"value":154,"toc":171},[155],[11,156,157,158,162,163,170],{},"站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 ",[159,160,161],"strong",{},"Markdown","，写链接也不用到编辑器：",[164,165,169],"a",{"href":166,"rel":167},"https:\u002F\u002Fcontent.nuxt.com",[168],"nofollow","Nuxt Content","。",{"title":15,"searchDepth":16,"depth":17,"links":172},[],"2026-11-14","站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 Markdown，写链接也不用到编辑器：Nuxt Content。",{},"\u002Fnotes\u002F2026-11-14-1",{"description":174},"notes\u002F2026-11-14-1","LLJX_RKU7cgpT6aHw4DZWUZNQ_G_UzELWPKbksJvzfs",{"id":181,"title":182,"body":183,"createdAt":198,"description":199,"extension":20,"meta":200,"navigation":22,"path":201,"seo":202,"stem":203,"__hash__":204},"notes\u002Fnotes\u002F2026-11-14-2.md","2026 11 14 2",{"type":8,"value":184,"toc":196},[185],[11,186,187,191,192,195],{},[188,189,190],"code",{},"readPixels"," 读不到内容不是 bug，是 ",[188,193,194],{},"preserveDrawingBuffer"," 默认关闭——帧提交后缓冲即被清空。",{"title":15,"searchDepth":16,"depth":17,"links":197},[],"2026-11-13","readPixels 读不到内容不是 bug，是 preserveDrawingBuffer 默认关闭——帧提交后缓冲即被清空。",{},"\u002Fnotes\u002F2026-11-14-2",{"description":199},"notes\u002F2026-11-14-2","i7xWqq2eNoU_seSbLQjqlB9gE51fM-PVLUEYCHBkOA4",1795342426953]