[{"data":1,"prerenderedAt":211},["ShallowReactive",2],{"notes-latest-1":3,"post:\u002Fposts\u002Fcoffee\u002Fpourover-start-3":27,"surround:\u002Fposts\u002Fcoffee\u002Fpourover-start-3":139,"notes-latest-3":146},[4],{"id":5,"title":6,"body":7,"createdAt":19,"description":13,"extension":20,"meta":21,"navigation":22,"path":23,"seo":24,"stem":25,"__hash__":26},"notes\u002Fnotes\u002F2026-11-14-1-2.md","2026 11 14 1 2",{"type":8,"value":9,"toc":14},"minimark",[10],[11,12,13],"p",{},"站点上线了「随笔」：支持一个文件多个随笔",{"title":15,"searchDepth":16,"depth":17,"links":18},"",2,3,[],"2026-11-17","md",{},true,"\u002Fnotes\u002F2026-11-14-1-2",{"description":13},"notes\u002F2026-11-14-1-2","hDP9fvaunHzVrZQ6QifuOtj9VrqbxlPb_52KE5wSjD0",{"id":28,"title":29,"author":30,"body":31,"categories":120,"comment":22,"cover":30,"createdAt":122,"description":35,"draft":123,"extension":20,"meta":124,"navigation":22,"path":129,"readingTime":130,"recommend":123,"seo":131,"series":30,"stem":132,"tags":133,"top":123,"topics":135,"updatedAt":30,"words":137,"__hash__":138},"posts\u002Fposts\u002Fcoffee\u002Fpourover-start-3.md","手冲咖啡入门记录（三）",null,{"type":8,"value":32,"toc":112},[33,36,40,43,46,53,56,59,62,65,68,71,74,77,80,83,86,88,91,94,97,100,103,106,109],[11,34,35],{},"天气不错的一个周末，出去走了走，回来顺手把当天的感受记下来。",[37,38,39],"h2",{"id":39},"入门装备",[11,41,42],{},"入坑手冲咖啡，装备按最简原则配齐：一个手摇磨豆机、一个 V60 滤杯配滤纸、一个细口壶、一个电子秤带计时，全套下来不算贵，比天天买咖啡厅的账单划算。第一杯自己冲的咖啡谈不上惊艳，甚至有点寡淡，但那种亲手做出来的成就感是真实存在的。",[11,44,45],{},"参数上踩过的坑：水温太高萃取过度又苦又涩，九十二度左右是多数浅烘豆的舒适区；粉水比从一比十五起步调；研磨度对手冲的影响立竿见影，太细苦、太粗淡，磨豆机的刻度试出来一档偏粗半档偏细的位置，就锁定它。",[11,47,48],{},[49,50],"img",{"alt":51,"src":52},"手冲咖啡入门记录","\u002Fimg\u002F3.webp",[37,54,55],{"id":55},"风味与记录",[11,57,58],{},"喝了一阵之后开始能分辨风味了，酸、甜、苦之外，居然真的能喝出描述里的花果香，这件事的玄学外壳裂开了一条缝。我的做法是每支豆子记录冲煮参数和感受，几页笔记下来，偏好逐渐清晰：喜酸就挑非洲豆，喜醇厚就看曼特宁方向。",[11,60,61],{},"手冲这件事最大的吸引力在于它是个可调参的小系统，水温柔比研磨度水流高度，每个变量都能实验，对工程师来说简直量身定做。周末早上给自己冲一杯，闻着香气等水温降下来的十分钟，是一天里少有的完全属于自己的时间。",[37,63,64],{"id":64},"过程中的小心得",[11,66,67],{},"搬家时纸箱没标注，晚上要找充电器，十几个箱子翻到半夜。后来每个箱子外面用马克笔写清楚内容和房间，下次搬家的自己会感谢现在的自己。",[11,69,70],{},"机械键盘用了大半年没清，按键手感越来越肉，拔键帽一清理，底下灰积了一层。电子产品和房间一样，定期打扫手感完全不同。",[11,72,73],{},"冰箱塞得太满，冷风吹不到后排，最里面的菜悄悄坏掉才发现。留出空隙让空气流通，食物和代码里的缓存一样，堆太满就要出问题。",[37,75,76],{"id":76},"延伸几句",[11,78,79],{},"咖啡喝了几年的一个总结：器材的投入应该跟着需求的明确程度走。还没搞清楚自己喜欢什么的时候，入门装备加试错的心思比旗舰设备更划算，等口味稳定了再升级，钱才花在点子上。",[11,81,82],{},"咖啡的仪式感这个词被用滥了，但那个动作本身确实有价值：磨豆的十几秒、注水的两分钟，是一段强制离屏的时间。每天里有这么几分钟完全属于自己，这件事的价值可能大于咖啡因本身。",[11,84,85],{},"关于咖啡因的摄入，值得认真对待的只有两件事：总量和时段。了解自己的耐受度，下午三点以后基本戒断，剩下的就交给喜好。至于健康的长长短短的传闻，适量这个原则都成立。",[11,87,79],{},[37,89,90],{"id":90},"又想到一些",[11,92,93],{},"另外觉得这件事里有个普遍适用的规律：复杂度不会消失，只会转移。你省掉的每一步设计，最后都会在排查、扩容或者交接的某个时刻加倍还回来。所谓好的方案，不过是把复杂度放到了值得的位置。",[11,95,96],{},"回顾这个过程，最大的教训其实是克制。可选项永远比需要的多，每个新方案看起来都比现状好一点，但都加上之后，系统就成了没人看得懂的拼贴画。做减法的判断比做加法的胆子更值钱。",[11,98,99],{},"这种事急不来，和锻炼身体是一个道理：练一天没变化，练三个月身体自己会说话。技术积累也是这样，每天一点，回过头看的时候差距已经拉开了，只是身在其中感觉不到而已。",[11,101,102],{},"想到一个问题：为什么同样的事情，不同的人做出来差别那么大。后来觉得答案在于对边界的处理，正常路径人人会写，边界和异常的处理习惯才是拉开差距的地方。做事和写代码一样，细节的密度决定成品的质量。",[37,104,105],{"id":105},"最后",[11,107,108],{},"我把这件事当成一个小需求来管理，明确了目标和验收标准，中途改了两次方案，最后的效果自己挺满意。",[11,110,111],{},"剩下的想起来再记，这篇到此为止。",{"title":15,"searchDepth":16,"depth":17,"links":113},[114,115,116,117,118,119],{"id":39,"depth":16,"text":39},{"id":55,"depth":16,"text":55},{"id":64,"depth":16,"text":64},{"id":76,"depth":16,"text":76},{"id":90,"depth":16,"text":90},{"id":105,"depth":16,"text":105},[121],"咖啡","2022-08-16",false,{"excerpt":125},{"type":8,"value":126},[127],[11,128,35],{},"\u002Fposts\u002Fcoffee\u002Fpourover-start-3",384000,{"title":29,"description":35},"posts\u002Fcoffee\u002Fpourover-start-3",[134,121],"手冲",[136],"coffee",1280,"unQqz7Aky4ad-r6Xmw6vnuki_XzKIIP9a9u_3nUzOl0",{"prev":140,"next":143},{"path":141,"title":142},"\u002Fposts\u002Fcoffee\u002Fpourover-start-2","手冲咖啡入门记录（二）",{"path":144,"title":145},"\u002Fposts\u002Fcoffee\u002Fpourover-start-4","手冲咖啡入门记录（四）",[147,156,186],{"id":5,"title":6,"body":148,"createdAt":19,"description":13,"extension":20,"meta":154,"navigation":22,"path":23,"seo":155,"stem":25,"__hash__":26},{"type":8,"value":149,"toc":152},[150],[11,151,13],{},{"title":15,"searchDepth":16,"depth":17,"links":153},[],{},{"description":13},{"id":157,"title":158,"body":159,"createdAt":179,"description":180,"extension":20,"meta":181,"navigation":22,"path":182,"seo":183,"stem":184,"__hash__":185},"notes\u002Fnotes\u002F2026-11-14-1.md","2026 11 14 1",{"type":8,"value":160,"toc":177},[161],[11,162,163,164,168,169,176],{},"站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 ",[165,166,167],"strong",{},"Markdown","，写链接也不用到编辑器：",[170,171,175],"a",{"href":172,"rel":173},"https:\u002F\u002Fcontent.nuxt.com",[174],"nofollow","Nuxt Content","。",{"title":15,"searchDepth":16,"depth":17,"links":178},[],"2026-11-14","站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 Markdown，写链接也不用到编辑器：Nuxt Content。",{},"\u002Fnotes\u002F2026-11-14-1",{"description":180},"notes\u002F2026-11-14-1","LLJX_RKU7cgpT6aHw4DZWUZNQ_G_UzELWPKbksJvzfs",{"id":187,"title":188,"body":189,"createdAt":204,"description":205,"extension":20,"meta":206,"navigation":22,"path":207,"seo":208,"stem":209,"__hash__":210},"notes\u002Fnotes\u002F2026-11-14-2.md","2026 11 14 2",{"type":8,"value":190,"toc":202},[191],[11,192,193,197,198,201],{},[194,195,196],"code",{},"readPixels"," 读不到内容不是 bug，是 ",[194,199,200],{},"preserveDrawingBuffer"," 默认关闭——帧提交后缓冲即被清空。",{"title":15,"searchDepth":16,"depth":17,"links":203},[],"2026-11-13","readPixels 读不到内容不是 bug，是 preserveDrawingBuffer 默认关闭——帧提交后缓冲即被清空。",{},"\u002Fnotes\u002F2026-11-14-2",{"description":205},"notes\u002F2026-11-14-2","i7xWqq2eNoU_seSbLQjqlB9gE51fM-PVLUEYCHBkOA4",1795304789725]