[{"data":1,"prerenderedAt":206},["ShallowReactive",2],{"notes-latest-1":3,"post:\u002Fposts\u002Fcoffee\u002Finstant-vs-brew-4":27,"surround:\u002Fposts\u002Fcoffee\u002Finstant-vs-brew-4":134,"notes-latest-3":141},[4],{"id":5,"title":6,"body":7,"createdAt":19,"description":13,"extension":20,"meta":21,"navigation":22,"path":23,"seo":24,"stem":25,"__hash__":26},"notes\u002Fnotes\u002F2026-11-14-1-2.md","2026 11 14 1 2",{"type":8,"value":9,"toc":14},"minimark",[10],[11,12,13],"p",{},"站点上线了「随笔」：支持一个文件多个随笔",{"title":15,"searchDepth":16,"depth":17,"links":18},"",2,3,[],"2026-11-17","md",{},true,"\u002Fnotes\u002F2026-11-14-1-2",{"description":13},"notes\u002F2026-11-14-1-2","hDP9fvaunHzVrZQ6QifuOtj9VrqbxlPb_52KE5wSjD0",{"id":28,"title":29,"author":30,"body":31,"categories":115,"comment":22,"cover":30,"createdAt":117,"description":35,"draft":118,"extension":20,"meta":119,"navigation":22,"path":124,"readingTime":125,"recommend":118,"seo":126,"series":30,"stem":127,"tags":128,"top":118,"topics":130,"updatedAt":30,"words":132,"__hash__":133},"posts\u002Fposts\u002Fcoffee\u002Finstant-vs-brew-4.md","速溶、挂耳和现磨的选择题（四）",null,{"type":8,"value":32,"toc":107},[33,36,40,43,46,49,52,55,58,61,64,67,70,73,76,79,81,83,86,89,92,95,98,101,104],[11,34,35],{},"最近节奏慢了一些，多了点观察生活的时间，这篇就是这么来的。",[37,38,39],"h2",{"id":39},"三种形态的定位",[11,41,42],{},"工作日的咖啡摄入，我目前在三种形态间按场景分配，这篇把三者的定位说清楚。速溶是效率之王，三十秒出杯，缺点是风味flat、含糖款热量不低，我把它限定在加班救急场景；挂耳是便携和品质的平衡点，鲜度比预磨粉强不少，出差和办公室常备；现磨手冲是周末的仪式，风味天花板，时间和设备的门槛也在这里。",[11,44,45],{},"三者没有高下之分，是场景的问题。把速溶骂得一文不值和把手冲捧成信仰都大可不必，喝得开心、不过量，就是好的咖啡习惯。",[37,47,48],{"id":48},"我的配置方案",[11,50,51],{},"我的配置方案：办公室抽屉里挂耳和冻干速溶各一盒，分别对应从容的上午和崩溃的下午；家里手冲装备一套，周末使用；一个月的总咖啡支出比之前天天点外卖降了一半。顺便说个健康层面的提醒：摄入量控制在每天两三杯以内，下午三点后尽量不碰，睡眠的账迟早要还。",[11,53,54],{},"这篇写完顺手把办公室的挂耳补了货，咖啡这种日常小事，值得花一次心思理顺，之后每个月都在省钱和提神的双重收益里躺赢。",[37,56,57],{"id":57},"记下两点",[11,59,60],{},"随手记两个小教训：阳台那盆绿萝浇得太勤，根都泡烂了，剪掉烂的部分重新扦插，现在改了策略，土干了再浇，反倒精神了不少。",[11,62,63],{},"煮饭水放多了，成品介于饭和粥之间。后来老老实实用量杯，或者直接看水位线，凭感觉这种事，在厨房里基本靠不住。",[11,65,66],{},"跑步前偷懒不做热身，膝盖不舒服了整整一周。现在哪怕时间紧张，也留五分钟活动开，这个时间省不得。",[37,68,69],{"id":69},"多聊两句",[11,71,72],{},"咖啡喝了几年的一个总结：器材的投入应该跟着需求的明确程度走。还没搞清楚自己喜欢什么的时候，入门装备加试错的心思比旗舰设备更划算，等口味稳定了再升级，钱才花在点子上。",[11,74,75],{},"咖啡的仪式感这个词被用滥了，但那个动作本身确实有价值：磨豆的十几秒、注水的两分钟，是一段强制离屏的时间。每天里有这么几分钟完全属于自己，这件事的价值可能大于咖啡因本身。",[11,77,78],{},"关于咖啡因的摄入，值得认真对待的只有两件事：总量和时段。了解自己的耐受度，下午三点以后基本戒断，剩下的就交给喜好。至于健康的长长短短的传闻，适量这个原则都成立。",[11,80,72],{},[11,82,75],{},[37,84,85],{"id":85},"继续聊聊",[11,87,88],{},"还有个感受越来越深：知识落地成文字的过程本身就是学习的一部分。很多自以为想清楚的东西，写出来才发现逻辑有洞。写作是最好的检验，这也是坚持写博客这么多年的理由之一，写不出来的就是还没学会的。",[11,90,91],{},"过程中也反复体会到取舍的本质：没有完美的方案，只有当下约束下最合适的方案。把约束写清楚，方案的选择题就变成了证明题，这也是为什么我习惯先列约束再谈方案，顺序反了全是无效争论。",[11,93,94],{},"想想还是补一段：任何习惯的养成都绕不开启动成本，最有效的办法是把启动成本降到接近零。想跑就把鞋放门口，想写就把文档开着置顶，环境准备到位了，行动只是顺水推舟。",[11,96,97],{},"从更高的视角看，这类问题都有一个共同结构：短期收益和长期收益打架。短期的诱惑总是具体而生动，长期的回报抽象而遥远，赢家通常是那些把长期目标拆成短期可感的小奖励的人。",[37,99,100],{"id":100},"写在最后",[11,102,103],{},"折腾完顺手写了几行代码做了个统计，理工科思维的反应就是这样，朋友都笑我，但确实好用了。",[11,105,106],{},"记录完毕，方便以后自己回来翻。",{"title":15,"searchDepth":16,"depth":17,"links":108},[109,110,111,112,113,114],{"id":39,"depth":16,"text":39},{"id":48,"depth":16,"text":48},{"id":57,"depth":16,"text":57},{"id":69,"depth":16,"text":69},{"id":85,"depth":16,"text":85},{"id":100,"depth":16,"text":100},[116],"咖啡","2025-04-23",false,{"excerpt":120},{"type":8,"value":121},[122],[11,123,35],{},"\u002Fposts\u002Fcoffee\u002Finstant-vs-brew-4",384900,{"title":29,"description":35},"posts\u002Fcoffee\u002Finstant-vs-brew-4",[116,129],"对比",[131],"coffee",1283,"5KmVjMCC3nC9kolHDxktXJJDXIan7BN8wwNpa3YQTWc",{"prev":135,"next":138},{"path":136,"title":137},"\u002Fposts\u002Fcoffee\u002Finstant-vs-brew-3","速溶、挂耳和现磨的选择题（三）",{"path":139,"title":140},"\u002Fposts\u002Fcoffee\u002Fpourover-start","手冲咖啡入门记录",[142,151,181],{"id":5,"title":6,"body":143,"createdAt":19,"description":13,"extension":20,"meta":149,"navigation":22,"path":23,"seo":150,"stem":25,"__hash__":26},{"type":8,"value":144,"toc":147},[145],[11,146,13],{},{"title":15,"searchDepth":16,"depth":17,"links":148},[],{},{"description":13},{"id":152,"title":153,"body":154,"createdAt":174,"description":175,"extension":20,"meta":176,"navigation":22,"path":177,"seo":178,"stem":179,"__hash__":180},"notes\u002Fnotes\u002F2026-11-14-1.md","2026 11 14 1",{"type":8,"value":155,"toc":172},[156],[11,157,158,159,163,164,171],{},"站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 ",[160,161,162],"strong",{},"Markdown","，写链接也不用到编辑器：",[165,166,170],"a",{"href":167,"rel":168},"https:\u002F\u002Fcontent.nuxt.com",[169],"nofollow","Nuxt Content","。",{"title":15,"searchDepth":16,"depth":17,"links":173},[],"2026-11-14","站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 Markdown，写链接也不用到编辑器：Nuxt Content。",{},"\u002Fnotes\u002F2026-11-14-1",{"description":175},"notes\u002F2026-11-14-1","LLJX_RKU7cgpT6aHw4DZWUZNQ_G_UzELWPKbksJvzfs",{"id":182,"title":183,"body":184,"createdAt":199,"description":200,"extension":20,"meta":201,"navigation":22,"path":202,"seo":203,"stem":204,"__hash__":205},"notes\u002Fnotes\u002F2026-11-14-2.md","2026 11 14 2",{"type":8,"value":185,"toc":197},[186],[11,187,188,192,193,196],{},[189,190,191],"code",{},"readPixels"," 读不到内容不是 bug，是 ",[189,194,195],{},"preserveDrawingBuffer"," 默认关闭——帧提交后缓冲即被清空。",{"title":15,"searchDepth":16,"depth":17,"links":198},[],"2026-11-13","readPixels 读不到内容不是 bug，是 preserveDrawingBuffer 默认关闭——帧提交后缓冲即被清空。",{},"\u002Fnotes\u002F2026-11-14-2",{"description":200},"notes\u002F2026-11-14-2","i7xWqq2eNoU_seSbLQjqlB9gE51fM-PVLUEYCHBkOA4",1795342422680]