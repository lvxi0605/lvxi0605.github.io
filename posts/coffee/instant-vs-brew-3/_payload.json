[{"data":1,"prerenderedAt":204},["ShallowReactive",2],{"notes-latest-1":3,"post:\u002Fposts\u002Fcoffee\u002Finstant-vs-brew-3":27,"surround:\u002Fposts\u002Fcoffee\u002Finstant-vs-brew-3":132,"notes-latest-3":139},[4],{"id":5,"title":6,"body":7,"createdAt":19,"description":13,"extension":20,"meta":21,"navigation":22,"path":23,"seo":24,"stem":25,"__hash__":26},"notes\u002Fnotes\u002F2026-11-14-1-2.md","2026 11 14 1 2",{"type":8,"value":9,"toc":14},"minimark",[10],[11,12,13],"p",{},"站点上线了「随笔」：支持一个文件多个随笔",{"title":15,"searchDepth":16,"depth":17,"links":18},"",2,3,[],"2026-11-17","md",{},true,"\u002Fnotes\u002F2026-11-14-1-2",{"description":13},"notes\u002F2026-11-14-1-2","hDP9fvaunHzVrZQ6QifuOtj9VrqbxlPb_52KE5wSjD0",{"id":28,"title":29,"author":30,"body":31,"categories":113,"comment":22,"cover":30,"createdAt":115,"description":35,"draft":116,"extension":20,"meta":117,"navigation":22,"path":122,"readingTime":123,"recommend":116,"seo":124,"series":30,"stem":125,"tags":126,"top":116,"topics":128,"updatedAt":30,"words":130,"__hash__":131},"posts\u002Fposts\u002Fcoffee\u002Finstant-vs-brew-3.md","速溶、挂耳和现磨的选择题（三）",null,{"type":8,"value":32,"toc":105},[33,36,40,43,46,49,52,55,58,61,64,67,70,73,76,79,81,84,87,90,93,96,99,102],[11,34,35],{},"有些事不记下来，过阵子就忘了当时的感受，只剩下干巴巴的结论，所以还是趁热记一下。",[37,38,39],"h2",{"id":39},"三种形态的定位",[11,41,42],{},"工作日的咖啡摄入，我目前在三种形态间按场景分配，这篇把三者的定位说清楚。速溶是效率之王，三十秒出杯，缺点是风味flat、含糖款热量不低，我把它限定在加班救急场景；挂耳是便携和品质的平衡点，鲜度比预磨粉强不少，出差和办公室常备；现磨手冲是周末的仪式，风味天花板，时间和设备的门槛也在这里。",[11,44,45],{},"三者没有高下之分，是场景的问题。把速溶骂得一文不值和把手冲捧成信仰都大可不必，喝得开心、不过量，就是好的咖啡习惯。",[37,47,48],{"id":48},"我的配置方案",[11,50,51],{},"我的配置方案：办公室抽屉里挂耳和冻干速溶各一盒，分别对应从容的上午和崩溃的下午；家里手冲装备一套，周末使用；一个月的总咖啡支出比之前天天点外卖降了一半。顺便说个健康层面的提醒：摄入量控制在每天两三杯以内，下午三点后尽量不碰，睡眠的账迟早要还。",[11,53,54],{},"这篇写完顺手把办公室的挂耳补了货，咖啡这种日常小事，值得花一次心思理顺，之后每个月都在省钱和提神的双重收益里躺赢。",[37,56,57],{"id":57},"记下两点",[11,59,60],{},"下雨天骑车上班，一个转弯摔了，人没大事，裤子毁了，手机屏幕裂了道纹。从那之后雨天一律地铁，通勤的意义是到达，不是冒险。",[11,62,63],{},"花了半个小时找手机，最后发现它在冰箱里，旁边是牛奶。那天之后我认真审视了自己的疲劳程度，人不是机器，续航是有数的。",[11,65,66],{},"剩菜以前是等凉透再进冰箱，被科普之后才知道要尽快冷藏，细菌繁殖的窗口期比想象中短。生活里很多想当然的习惯，较真起来都有另一套答案。",[37,68,69],{"id":69},"多聊两句",[11,71,72],{},"咖啡的仪式感这个词被用滥了，但那个动作本身确实有价值：磨豆的十几秒、注水的两分钟，是一段强制离屏的时间。每天里有这么几分钟完全属于自己，这件事的价值可能大于咖啡因本身。",[11,74,75],{},"关于咖啡因的摄入，值得认真对待的只有两件事：总量和时段。了解自己的耐受度，下午三点以后基本戒断，剩下的就交给喜好。至于健康的长长短短的传闻，适量这个原则都成立。",[11,77,78],{},"咖啡喝了几年的一个总结：器材的投入应该跟着需求的明确程度走。还没搞清楚自己喜欢什么的时候，入门装备加试错的心思比旗舰设备更划算，等口味稳定了再升级，钱才花在点子上。",[11,80,72],{},[37,82,83],{"id":83},"继续聊聊",[11,85,86],{},"再补充一个角度：做这些事情的时候，工具的顺滑度影响巨大。同样的活，称手的工具能让摩擦力小一半，这种差异日积月累就是人和人的差距。定期审视自己的工具链，删掉碍事的，补上趁手的，值得当成一个固定动作。",[11,88,89],{},"由这件事联想到阅读习惯：资料要看一手来源，译文和二手转述经常带着传播者的理解偏差，偏差叠几层之后和原意面目全非。多花十分钟读原文，省下的是未来几小时的排查，这笔账怎么算都划算。",[11,91,92],{},"还有个感受越来越深：知识落地成文字的过程本身就是学习的一部分。很多自以为想清楚的东西，写出来才发现逻辑有洞。写作是最好的检验，这也是坚持写博客这么多年的理由之一，写不出来的就是还没学会的。",[11,94,95],{},"过程中也反复体会到取舍的本质：没有完美的方案，只有当下约束下最合适的方案。把约束写清楚，方案的选择题就变成了证明题，这也是为什么我习惯先列约束再谈方案，顺序反了全是无效争论。",[37,97,98],{"id":98},"写在最后",[11,100,101],{},"搞技术久了习惯找根因，生活里的很多问题其实也适用：先定位，再动手，别一上来就凭感觉乱试。",[11,103,104],{},"这篇就写到这，希望对你有点参考价值。",{"title":15,"searchDepth":16,"depth":17,"links":106},[107,108,109,110,111,112],{"id":39,"depth":16,"text":39},{"id":48,"depth":16,"text":48},{"id":57,"depth":16,"text":57},{"id":69,"depth":16,"text":69},{"id":83,"depth":16,"text":83},{"id":98,"depth":16,"text":98},[114],"咖啡","2026-06-06",false,{"excerpt":118},{"type":8,"value":119},[120],[11,121,35],{},"\u002Fposts\u002Fcoffee\u002Finstant-vs-brew-3",378900,{"title":29,"description":35},"posts\u002Fcoffee\u002Finstant-vs-brew-3",[114,127],"对比",[129],"coffee",1263,"fZCJ0Krk5zRFVJcZcO6WDtO32C_XAxKLRo9V0ads3Tk",{"prev":133,"next":136},{"path":134,"title":135},"\u002Fposts\u002Fcoffee\u002Finstant-vs-brew-2","速溶、挂耳和现磨的选择题（二）",{"path":137,"title":138},"\u002Fposts\u002Fcoffee\u002Finstant-vs-brew-4","速溶、挂耳和现磨的选择题（四）",[140,149,179],{"id":5,"title":6,"body":141,"createdAt":19,"description":13,"extension":20,"meta":147,"navigation":22,"path":23,"seo":148,"stem":25,"__hash__":26},{"type":8,"value":142,"toc":145},[143],[11,144,13],{},{"title":15,"searchDepth":16,"depth":17,"links":146},[],{},{"description":13},{"id":150,"title":151,"body":152,"createdAt":172,"description":173,"extension":20,"meta":174,"navigation":22,"path":175,"seo":176,"stem":177,"__hash__":178},"notes\u002Fnotes\u002F2026-11-14-1.md","2026 11 14 1",{"type":8,"value":153,"toc":170},[154],[11,155,156,157,161,162,169],{},"站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 ",[158,159,160],"strong",{},"Markdown","，写链接也不用到编辑器：",[163,164,168],"a",{"href":165,"rel":166},"https:\u002F\u002Fcontent.nuxt.com",[167],"nofollow","Nuxt Content","。",{"title":15,"searchDepth":16,"depth":17,"links":171},[],"2026-11-14","站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 Markdown，写链接也不用到编辑器：Nuxt Content。",{},"\u002Fnotes\u002F2026-11-14-1",{"description":173},"notes\u002F2026-11-14-1","LLJX_RKU7cgpT6aHw4DZWUZNQ_G_UzELWPKbksJvzfs",{"id":180,"title":181,"body":182,"createdAt":197,"description":198,"extension":20,"meta":199,"navigation":22,"path":200,"seo":201,"stem":202,"__hash__":203},"notes\u002Fnotes\u002F2026-11-14-2.md","2026 11 14 2",{"type":8,"value":183,"toc":195},[184],[11,185,186,190,191,194],{},[187,188,189],"code",{},"readPixels"," 读不到内容不是 bug，是 ",[187,192,193],{},"preserveDrawingBuffer"," 默认关闭——帧提交后缓冲即被清空。",{"title":15,"searchDepth":16,"depth":17,"links":196},[],"2026-11-13","readPixels 读不到内容不是 bug，是 preserveDrawingBuffer 默认关闭——帧提交后缓冲即被清空。",{},"\u002Fnotes\u002F2026-11-14-2",{"description":198},"notes\u002F2026-11-14-2","i7xWqq2eNoU_seSbLQjqlB9gE51fM-PVLUEYCHBkOA4",1795275911431]