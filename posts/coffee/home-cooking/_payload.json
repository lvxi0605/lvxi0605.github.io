[{"data":1,"prerenderedAt":207},["ShallowReactive",2],{"notes-latest-1":3,"post:\u002Fposts\u002Fcoffee\u002Fhome-cooking":27,"surround:\u002Fposts\u002Fcoffee\u002Fhome-cooking":135,"notes-latest-3":142},[4],{"id":5,"title":6,"body":7,"createdAt":19,"description":13,"extension":20,"meta":21,"navigation":22,"path":23,"seo":24,"stem":25,"__hash__":26},"notes\u002Fnotes\u002F2026-11-14-1-2.md","2026 11 14 1 2",{"type":8,"value":9,"toc":14},"minimark",[10],[11,12,13],"p",{},"站点上线了「随笔」：支持一个文件多个随笔",{"title":15,"searchDepth":16,"depth":17,"links":18},"",2,3,[],"2026-11-17","md",{},true,"\u002Fnotes\u002F2026-11-14-1-2",{"description":13},"notes\u002F2026-11-14-1-2","hDP9fvaunHzVrZQ6QifuOtj9VrqbxlPb_52KE5wSjD0",{"id":28,"title":29,"author":30,"body":31,"categories":115,"comment":22,"cover":30,"createdAt":117,"description":35,"draft":118,"extension":20,"meta":119,"navigation":22,"path":124,"readingTime":125,"recommend":118,"seo":126,"series":30,"stem":127,"tags":128,"top":118,"topics":131,"updatedAt":30,"words":133,"__hash__":134},"posts\u002Fposts\u002Fcoffee\u002Fhome-cooking.md","三道家常菜的练习心得",null,{"type":8,"value":32,"toc":107},[33,36,40,43,46,49,52,55,58,61,64,67,70,73,76,79,81,83,86,89,92,95,98,101,104],[11,34,35],{},"生活流水账一篇，主要是写给自己看的，也欢迎偶然点进来的你随便翻翻。",[37,38,39],"h2",{"id":39},"番茄炒蛋的重新学习",[11,41,42],{},"花了两个月认真练了三道家常菜，心得记录一下。第一道是番茄炒蛋，这道菜教我的事是火候和顺序：蛋液先炒到八成熟盛出，番茄炒出汁水再回锅合体，蛋才嫩番茄才有汁。以前一把全倒锅里乱炒，成品汤汤水水，根因就是流程错了。",[11,44,45],{},"第二道是青椒肉丝，肉丝上浆这一步是分水岭，淀粉和料酒抓匀腌十分钟，炒出来嫩滑不柴，省掉这步就是另一道菜。切肉的刀工练了一阵，逆纹切丝这个知识点，是吃了三次柴肉丝之后才记牢的。",[37,47,48],{"id":48},"第三道与总结",[11,50,51],{},"第三道选了个汤，玉米排骨汤，它教我的是时间观：焯水去沫、小火慢炖一个半小时，急不来的东西，高压锅省下的时间换来的是口感的差价。",[11,53,54],{},"三道菜练下来的总心得：家常菜的难度不在技巧在流程，备菜齐全、顺序明确、火候定时，成功率立刻上一个台阶。这套工程化思维用在厨房里意外地好用，最近又开始研究红烧肉了，肥瘦相间的那块学术问题，下篇继续。",[37,56,57],{"id":57},"一点反思",[11,59,60],{},"花了半个小时找手机，最后发现它在冰箱里，旁边是牛奶。那天之后我认真审视了自己的疲劳程度，人不是机器，续航是有数的。",[11,62,63],{},"剩菜以前是等凉透再进冰箱，被科普之后才知道要尽快冷藏，细菌繁殖的窗口期比想象中短。生活里很多想当然的习惯，较真起来都有另一套答案。",[11,65,66],{},"随手记两个小教训：阳台那盆绿萝浇得太勤，根都泡烂了，剪掉烂的部分重新扦插，现在改了策略，土干了再浇，反倒精神了不少。",[37,68,69],{"id":69},"顺便一提",[11,71,72],{},"关于咖啡因的摄入，值得认真对待的只有两件事：总量和时段。了解自己的耐受度，下午三点以后基本戒断，剩下的就交给喜好。至于健康的长长短短的传闻，适量这个原则都成立。",[11,74,75],{},"咖啡喝了几年的一个总结：器材的投入应该跟着需求的明确程度走。还没搞清楚自己喜欢什么的时候，入门装备加试错的心思比旗舰设备更划算，等口味稳定了再升级，钱才花在点子上。",[11,77,78],{},"咖啡的仪式感这个词被用滥了，但那个动作本身确实有价值：磨豆的十几秒、注水的两分钟，是一段强制离屏的时间。每天里有这么几分钟完全属于自己，这件事的价值可能大于咖啡因本身。",[11,80,72],{},[11,82,75],{},[37,84,85],{"id":85},"另外记几笔",[11,87,88],{},"由这件事联想到阅读习惯：资料要看一手来源，译文和二手转述经常带着传播者的理解偏差，偏差叠几层之后和原意面目全非。多花十分钟读原文，省下的是未来几小时的排查，这笔账怎么算都划算。",[11,90,91],{},"还有个感受越来越深：知识落地成文字的过程本身就是学习的一部分。很多自以为想清楚的东西，写出来才发现逻辑有洞。写作是最好的检验，这也是坚持写博客这么多年的理由之一，写不出来的就是还没学会的。",[11,93,94],{},"过程中也反复体会到取舍的本质：没有完美的方案，只有当下约束下最合适的方案。把约束写清楚，方案的选择题就变成了证明题，这也是为什么我习惯先列约束再谈方案，顺序反了全是无效争论。",[11,96,97],{},"想想还是补一段：任何习惯的养成都绕不开启动成本，最有效的办法是把启动成本降到接近零。想跑就把鞋放门口，想写就把文档开着置顶，环境准备到位了，行动只是顺水推舟。",[37,99,100],{"id":100},"最后",[11,102,103],{},"折腾完顺手写了几行代码做了个统计，理工科思维的反应就是这样，朋友都笑我，但确实好用了。",[11,105,106],{},"这篇就先这样，想到了什么再回来补。",{"title":15,"searchDepth":16,"depth":17,"links":108},[109,110,111,112,113,114],{"id":39,"depth":16,"text":39},{"id":48,"depth":16,"text":48},{"id":57,"depth":16,"text":57},{"id":69,"depth":16,"text":69},{"id":85,"depth":16,"text":85},{"id":100,"depth":16,"text":100},[116],"咖啡","2022-10-24",false,{"excerpt":120},{"type":8,"value":121},[122],[11,123,35],{},"\u002Fposts\u002Fcoffee\u002Fhome-cooking",386400,{"title":29,"description":35},"posts\u002Fcoffee\u002Fhome-cooking",[129,130],"做饭","家常菜",[132],"coffee",1288,"4wK8JERScgZn_sFIAMAkXum3VfBg7UV_G08tcf-sRlY",{"prev":136,"next":139},{"path":137,"title":138},"\u002Fposts\u002Fcoffee\u002Fbeans-choice-4","咖啡豆选购的避坑笔记（四）",{"path":140,"title":141},"\u002Fposts\u002Fcoffee\u002Fhome-cooking-2","三道家常菜的练习心得（二）",[143,152,182],{"id":5,"title":6,"body":144,"createdAt":19,"description":13,"extension":20,"meta":150,"navigation":22,"path":23,"seo":151,"stem":25,"__hash__":26},{"type":8,"value":145,"toc":148},[146],[11,147,13],{},{"title":15,"searchDepth":16,"depth":17,"links":149},[],{},{"description":13},{"id":153,"title":154,"body":155,"createdAt":175,"description":176,"extension":20,"meta":177,"navigation":22,"path":178,"seo":179,"stem":180,"__hash__":181},"notes\u002Fnotes\u002F2026-11-14-1.md","2026 11 14 1",{"type":8,"value":156,"toc":173},[157],[11,158,159,160,164,165,172],{},"站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 ",[161,162,163],"strong",{},"Markdown","，写链接也不用到编辑器：",[166,167,171],"a",{"href":168,"rel":169},"https:\u002F\u002Fcontent.nuxt.com",[170],"nofollow","Nuxt Content","。",{"title":15,"searchDepth":16,"depth":17,"links":174},[],"2026-11-14","站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 Markdown，写链接也不用到编辑器：Nuxt Content。",{},"\u002Fnotes\u002F2026-11-14-1",{"description":176},"notes\u002F2026-11-14-1","LLJX_RKU7cgpT6aHw4DZWUZNQ_G_UzELWPKbksJvzfs",{"id":183,"title":184,"body":185,"createdAt":200,"description":201,"extension":20,"meta":202,"navigation":22,"path":203,"seo":204,"stem":205,"__hash__":206},"notes\u002Fnotes\u002F2026-11-14-2.md","2026 11 14 2",{"type":8,"value":186,"toc":198},[187],[11,188,189,193,194,197],{},[190,191,192],"code",{},"readPixels"," 读不到内容不是 bug，是 ",[190,195,196],{},"preserveDrawingBuffer"," 默认关闭——帧提交后缓冲即被清空。",{"title":15,"searchDepth":16,"depth":17,"links":199},[],"2026-11-13","readPixels 读不到内容不是 bug，是 preserveDrawingBuffer 默认关闭——帧提交后缓冲即被清空。",{},"\u002Fnotes\u002F2026-11-14-2",{"description":201},"notes\u002F2026-11-14-2","i7xWqq2eNoU_seSbLQjqlB9gE51fM-PVLUEYCHBkOA4",1795304789422]