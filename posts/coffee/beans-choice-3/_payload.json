[{"data":1,"prerenderedAt":204},["ShallowReactive",2],{"notes-latest-1":3,"post:\u002Fposts\u002Fcoffee\u002Fbeans-choice-3":27,"surround:\u002Fposts\u002Fcoffee\u002Fbeans-choice-3":132,"notes-latest-3":139},[4],{"id":5,"title":6,"body":7,"createdAt":19,"description":13,"extension":20,"meta":21,"navigation":22,"path":23,"seo":24,"stem":25,"__hash__":26},"notes\u002Fnotes\u002F2026-11-14-1-2.md","2026 11 14 1 2",{"type":8,"value":9,"toc":14},"minimark",[10],[11,12,13],"p",{},"站点上线了「随笔」：支持一个文件多个随笔",{"title":15,"searchDepth":16,"depth":17,"links":18},"",2,3,[],"2026-11-17","md",{},true,"\u002Fnotes\u002F2026-11-14-1-2",{"description":13},"notes\u002F2026-11-14-1-2","hDP9fvaunHzVrZQ6QifuOtj9VrqbxlPb_52KE5wSjD0",{"id":28,"title":29,"author":30,"body":31,"categories":113,"comment":22,"cover":30,"createdAt":115,"description":35,"draft":116,"extension":20,"meta":117,"navigation":22,"path":122,"readingTime":123,"recommend":116,"seo":124,"series":30,"stem":125,"tags":126,"top":116,"topics":128,"updatedAt":30,"words":130,"__hash__":131},"posts\u002Fposts\u002Fcoffee\u002Fbeans-choice-3.md","咖啡豆选购的避坑笔记（三）",null,{"type":8,"value":32,"toc":105},[33,36,40,43,46,49,52,55,58,61,64,67,70,73,76,79,81,84,87,90,93,96,99,102],[11,34,35],{},"生活流水账一篇，主要是写给自己看的，也欢迎偶然点进来的你随便翻翻。",[37,38,39],"h2",{"id":39},"看懂包装信息",[11,41,42],{},"买豆子的第一课是看懂包装：烘焙日期比保质期重要得多，咖啡豆的最佳赏味期是烘焙后两周到一个月，写着生产日期含糊其辞的直接跳过；产地信息越具体越好，写明庄园和处理法的，通常比只写国家的用心；烘焙度是个参考项，浅烘偏酸果香足，深烘偏苦醇厚重。",[11,44,45],{},"渠道上我的经验是本地烘焙商优先，新鲜度有保障还能当面问；网购认准烘焙日期在一个月内的，囤货别超过三周的量。",[37,47,48],{"id":48},"风味偏好摸索",[11,50,51],{},"风味偏好需要摸索期，我的路径是每次买小包装，埃塞的果酸、哥伦比亚的均衡、曼特宁的厚重轮着试，两三个月后自己的口味地图就画出来了。避坑提示几个：拼配豆不等于劣质，但要看配方说明；所谓风味描述里的蓝莓巧克力，是风味联想不是添加，别理解错；促销清仓的豆子往往临近赏味期边界，慎拍。",[11,53,54],{},"最后一条实操建议：买回来的豆子用带单向阀的密封罐存，避光避潮，别放冰箱串味。豆子对了，冲煮的容错率会高很多，一杯咖啡的好坏，选豆占了六成。",[37,56,57],{"id":57},"两个小教训",[11,59,60],{},"空调滤网两年没洗，风越来越小还带味道，拆开一看吓一跳。一小时清理完，制冷立刻给力。家用电器的保养周期，说明书上写的那些建议真不是随口说说。",[11,62,63],{},"新买的锅没开锅就上灶，第一条鱼皮粘得惨不忍睹。老老实实开了锅，热锅凉油，之后煎什么都利索。工具要有工具的仪式，这道理在厨房通用。",[11,65,66],{},"出门忘带钥匙，蹲在门口等开锁师傅，等了一小时花了一百五。现在门口的暗格放了备用钥匙，出门摸一下口袋成了肌肉记忆。",[37,68,69],{"id":69},"一点延伸",[11,71,72],{},"关于咖啡因的摄入，值得认真对待的只有两件事：总量和时段。了解自己的耐受度，下午三点以后基本戒断，剩下的就交给喜好。至于健康的长长短短的传闻，适量这个原则都成立。",[11,74,75],{},"咖啡喝了几年的一个总结：器材的投入应该跟着需求的明确程度走。还没搞清楚自己喜欢什么的时候，入门装备加试错的心思比旗舰设备更划算，等口味稳定了再升级，钱才花在点子上。",[11,77,78],{},"咖啡的仪式感这个词被用滥了，但那个动作本身确实有价值：磨豆的十几秒、注水的两分钟，是一段强制离屏的时间。每天里有这么几分钟完全属于自己，这件事的价值可能大于咖啡因本身。",[11,80,72],{},[37,82,83],{"id":83},"再补充几句",[11,85,86],{},"有时候会想，学一门新技术到底学到的是什么。语法和 API 会过时，真正的收获是它看问题的角度。多一门语言就多一副眼镜，同一副牌桌，能看到别人看不到的牌路，这是这么多年折腾下来最确定的回报。",[11,88,89],{},"记一个产生过的动摇：做到一半觉得这玩意儿是不是没什么意义。后来想通了，意义不是事情自带的，是你把它做完并沉淀下来之后长出来的。烂尾的才真的没意义，做完的最差也是一篇笔记。",[11,91,92],{},"顺便说说协作里的体会：这类事自己闷头做效率最高，但闷头做完往往返工最多。适度地提前同步，把方向先对齐，看似慢了半天，实际省掉的是几天的返工。沟通的时机比沟通的技巧更值得琢磨。",[11,94,95],{},"其实回看这些年踩的坑，大坑几乎都和贪快有关。快不是错，错的是想跳过必要步骤的快，地基没打牢盖得越快塌得越响。慢下来把该做的做扎实，反而是最快的路径，这话说了很多年，每次验证都对。",[37,97,98],{"id":98},"小结",[11,100,101],{},"整个过程我写成了 checklist，下次照着走一遍就行，果然顺利多了。重复出现的事情就该被固化成流程，工作里如此，生活里也是。",[11,103,104],{},"先记到这里，后面有新的进展再来补充。",{"title":15,"searchDepth":16,"depth":17,"links":106},[107,108,109,110,111,112],{"id":39,"depth":16,"text":39},{"id":48,"depth":16,"text":48},{"id":57,"depth":16,"text":57},{"id":69,"depth":16,"text":69},{"id":83,"depth":16,"text":83},{"id":98,"depth":16,"text":98},[114],"咖啡","2025-10-18",false,{"excerpt":118},{"type":8,"value":119},[120],[11,121,35],{},"\u002Fposts\u002Fcoffee\u002Fbeans-choice-3",375600,{"title":29,"description":35},"posts\u002Fcoffee\u002Fbeans-choice-3",[114,127],"选购",[129],"coffee",1252,"fgyHbsoaQnHLZWmYgrOOj1spTH9d1Q5qwzyKD54rdfI",{"prev":133,"next":136},{"path":134,"title":135},"\u002Fposts\u002Fcoffee\u002Fbeans-choice-2","咖啡豆选购的避坑笔记（二）",{"path":137,"title":138},"\u002Fposts\u002Fcoffee\u002Fbeans-choice-4","咖啡豆选购的避坑笔记（四）",[140,149,179],{"id":5,"title":6,"body":141,"createdAt":19,"description":13,"extension":20,"meta":147,"navigation":22,"path":23,"seo":148,"stem":25,"__hash__":26},{"type":8,"value":142,"toc":145},[143],[11,144,13],{},{"title":15,"searchDepth":16,"depth":17,"links":146},[],{},{"description":13},{"id":150,"title":151,"body":152,"createdAt":172,"description":173,"extension":20,"meta":174,"navigation":22,"path":175,"seo":176,"stem":177,"__hash__":178},"notes\u002Fnotes\u002F2026-11-14-1.md","2026 11 14 1",{"type":8,"value":153,"toc":170},[154],[11,155,156,157,161,162,169],{},"站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 ",[158,159,160],"strong",{},"Markdown","，写链接也不用到编辑器：",[163,164,168],"a",{"href":165,"rel":166},"https:\u002F\u002Fcontent.nuxt.com",[167],"nofollow","Nuxt Content","。",{"title":15,"searchDepth":16,"depth":17,"links":171},[],"2026-11-14","站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 Markdown，写链接也不用到编辑器：Nuxt Content。",{},"\u002Fnotes\u002F2026-11-14-1",{"description":173},"notes\u002F2026-11-14-1","LLJX_RKU7cgpT6aHw4DZWUZNQ_G_UzELWPKbksJvzfs",{"id":180,"title":181,"body":182,"createdAt":197,"description":198,"extension":20,"meta":199,"navigation":22,"path":200,"seo":201,"stem":202,"__hash__":203},"notes\u002Fnotes\u002F2026-11-14-2.md","2026 11 14 2",{"type":8,"value":183,"toc":195},[184],[11,185,186,190,191,194],{},[187,188,189],"code",{},"readPixels"," 读不到内容不是 bug，是 ",[187,192,193],{},"preserveDrawingBuffer"," 默认关闭——帧提交后缓冲即被清空。",{"title":15,"searchDepth":16,"depth":17,"links":196},[],"2026-11-13","readPixels 读不到内容不是 bug，是 preserveDrawingBuffer 默认关闭——帧提交后缓冲即被清空。",{},"\u002Fnotes\u002F2026-11-14-2",{"description":198},"notes\u002F2026-11-14-2","i7xWqq2eNoU_seSbLQjqlB9gE51fM-PVLUEYCHBkOA4",1795274105191]