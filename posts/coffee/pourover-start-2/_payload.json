[{"data":1,"prerenderedAt":204},["ShallowReactive",2],{"notes-latest-1":3,"post:\u002Fposts\u002Fcoffee\u002Fpourover-start-2":27,"surround:\u002Fposts\u002Fcoffee\u002Fpourover-start-2":132,"notes-latest-3":139},[4],{"id":5,"title":6,"body":7,"createdAt":19,"description":13,"extension":20,"meta":21,"navigation":22,"path":23,"seo":24,"stem":25,"__hash__":26},"notes\u002Fnotes\u002F2026-11-14-1-2.md","2026 11 14 1 2",{"type":8,"value":9,"toc":14},"minimark",[10],[11,12,13],"p",{},"站点上线了「随笔」：支持一个文件多个随笔",{"title":15,"searchDepth":16,"depth":17,"links":18},"",2,3,[],"2026-11-17","md",{},true,"\u002Fnotes\u002F2026-11-14-1-2",{"description":13},"notes\u002F2026-11-14-1-2","hDP9fvaunHzVrZQ6QifuOtj9VrqbxlPb_52KE5wSjD0",{"id":28,"title":29,"author":30,"body":31,"categories":113,"comment":22,"cover":30,"createdAt":115,"description":35,"draft":116,"extension":20,"meta":117,"navigation":22,"path":122,"readingTime":123,"recommend":116,"seo":124,"series":30,"stem":125,"tags":126,"top":116,"topics":128,"updatedAt":30,"words":130,"__hash__":131},"posts\u002Fposts\u002Fcoffee\u002Fpourover-start-2.md","手冲咖啡入门记录（二）",null,{"type":8,"value":32,"toc":105},[33,36,40,43,46,49,52,55,58,61,64,67,70,73,76,79,81,84,87,90,93,96,99,102],[11,34,35],{},"又到周末，把这阵子的碎片想法归拢成一篇，写得随意一点。",[37,38,39],"h2",{"id":39},"入门装备",[11,41,42],{},"入坑手冲咖啡，装备按最简原则配齐：一个手摇磨豆机、一个 V60 滤杯配滤纸、一个细口壶、一个电子秤带计时，全套下来不算贵，比天天买咖啡厅的账单划算。第一杯自己冲的咖啡谈不上惊艳，甚至有点寡淡，但那种亲手做出来的成就感是真实存在的。",[11,44,45],{},"参数上踩过的坑：水温太高萃取过度又苦又涩，九十二度左右是多数浅烘豆的舒适区；粉水比从一比十五起步调；研磨度对手冲的影响立竿见影，太细苦、太粗淡，磨豆机的刻度试出来一档偏粗半档偏细的位置，就锁定它。",[37,47,48],{"id":48},"风味与记录",[11,50,51],{},"喝了一阵之后开始能分辨风味了，酸、甜、苦之外，居然真的能喝出描述里的花果香，这件事的玄学外壳裂开了一条缝。我的做法是每支豆子记录冲煮参数和感受，几页笔记下来，偏好逐渐清晰：喜酸就挑非洲豆，喜醇厚就看曼特宁方向。",[11,53,54],{},"手冲这件事最大的吸引力在于它是个可调参的小系统，水温柔比研磨度水流高度，每个变量都能实验，对工程师来说简直量身定做。周末早上给自己冲一杯，闻着香气等水温降下来的十分钟，是一天里少有的完全属于自己的时间。",[37,56,57],{"id":57},"过程中的小心得",[11,59,60],{},"跑步前偷懒不做热身，膝盖不舒服了整整一周。现在哪怕时间紧张，也留五分钟活动开，这个时间省不得。",[11,62,63],{},"咖啡粉磨太细，手冲出来又苦又涩还带杂味，一度怀疑是豆子的问题。调粗一格立刻正常，器材和参数的问题，别先怪豆子。",[11,65,66],{},"周末一口气睡到中午，起来反而头昏脑涨。生物钟这东西，补觉补不回来，规律比时长重要，这是身体反复教育我的。",[37,68,69],{"id":69},"延伸几句",[11,71,72],{},"咖啡的仪式感这个词被用滥了，但那个动作本身确实有价值：磨豆的十几秒、注水的两分钟，是一段强制离屏的时间。每天里有这么几分钟完全属于自己，这件事的价值可能大于咖啡因本身。",[11,74,75],{},"关于咖啡因的摄入，值得认真对待的只有两件事：总量和时段。了解自己的耐受度，下午三点以后基本戒断，剩下的就交给喜好。至于健康的长长短短的传闻，适量这个原则都成立。",[11,77,78],{},"咖啡喝了几年的一个总结：器材的投入应该跟着需求的明确程度走。还没搞清楚自己喜欢什么的时候，入门装备加试错的心思比旗舰设备更划算，等口味稳定了再升级，钱才花在点子上。",[11,80,72],{},[37,82,83],{"id":83},"又想到一些",[11,85,86],{},"这类经验在文档里通常只有一行字，背后的排查却是一整个下午。技术工作的大部分时间都花在这些不会写进简历的细节里，所以这些细节才更需要有人写出来，哪怕只是给未来某一天忘了的自己。",[11,88,89],{},"顺带聊聊方法论：遇到不熟悉的领域，我的习惯是先把最小闭环跑通，哪怕每一步都很粗糙。跑通之后再逐段替换成正经实现，过程中每一步都有可运行的版本。这个思路在工作和生活里都屡试不爽，比憋大招的成功率高得多。",[11,91,92],{},"另外觉得这件事里有个普遍适用的规律：复杂度不会消失，只会转移。你省掉的每一步设计，最后都会在排查、扩容或者交接的某个时刻加倍还回来。所谓好的方案，不过是把复杂度放到了值得的位置。",[11,94,95],{},"回顾这个过程，最大的教训其实是克制。可选项永远比需要的多，每个新方案看起来都比现状好一点，但都加上之后，系统就成了没人看得懂的拼贴画。做减法的判断比做加法的胆子更值钱。",[37,97,98],{"id":98},"最后",[11,100,101],{},"折腾完顺手写了几行代码做了个统计，理工科思维的反应就是这样，朋友都笑我，但确实好用了。",[11,103,104],{},"今天的记录就到这里，晚安。",{"title":15,"searchDepth":16,"depth":17,"links":106},[107,108,109,110,111,112],{"id":39,"depth":16,"text":39},{"id":48,"depth":16,"text":48},{"id":57,"depth":16,"text":57},{"id":69,"depth":16,"text":69},{"id":83,"depth":16,"text":83},{"id":98,"depth":16,"text":98},[114],"咖啡","2025-01-14",false,{"excerpt":118},{"type":8,"value":119},[120],[11,121,35],{},"\u002Fposts\u002Fcoffee\u002Fpourover-start-2",375300,{"title":29,"description":35},"posts\u002Fcoffee\u002Fpourover-start-2",[127,114],"手冲",[129],"coffee",1251,"8CIOHQvvQCxiRTYilKc-zbYJCCz-rBe2UUoYQU4LNk4",{"prev":133,"next":136},{"path":134,"title":135},"\u002Fposts\u002Fcoffee\u002Fpourover-start","手冲咖啡入门记录",{"path":137,"title":138},"\u002Fposts\u002Fcoffee\u002Fpourover-start-3","手冲咖啡入门记录（三）",[140,149,179],{"id":5,"title":6,"body":141,"createdAt":19,"description":13,"extension":20,"meta":147,"navigation":22,"path":23,"seo":148,"stem":25,"__hash__":26},{"type":8,"value":142,"toc":145},[143],[11,144,13],{},{"title":15,"searchDepth":16,"depth":17,"links":146},[],{},{"description":13},{"id":150,"title":151,"body":152,"createdAt":172,"description":173,"extension":20,"meta":174,"navigation":22,"path":175,"seo":176,"stem":177,"__hash__":178},"notes\u002Fnotes\u002F2026-11-14-1.md","2026 11 14 1",{"type":8,"value":153,"toc":170},[154],[11,155,156,157,161,162,169],{},"站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 ",[158,159,160],"strong",{},"Markdown","，写链接也不用到编辑器：",[163,164,168],"a",{"href":165,"rel":166},"https:\u002F\u002Fcontent.nuxt.com",[167],"nofollow","Nuxt Content","。",{"title":15,"searchDepth":16,"depth":17,"links":171},[],"2026-11-14","站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 Markdown，写链接也不用到编辑器：Nuxt Content。",{},"\u002Fnotes\u002F2026-11-14-1",{"description":173},"notes\u002F2026-11-14-1","LLJX_RKU7cgpT6aHw4DZWUZNQ_G_UzELWPKbksJvzfs",{"id":180,"title":181,"body":182,"createdAt":197,"description":198,"extension":20,"meta":199,"navigation":22,"path":200,"seo":201,"stem":202,"__hash__":203},"notes\u002Fnotes\u002F2026-11-14-2.md","2026 11 14 2",{"type":8,"value":183,"toc":195},[184],[11,185,186,190,191,194],{},[187,188,189],"code",{},"readPixels"," 读不到内容不是 bug，是 ",[187,192,193],{},"preserveDrawingBuffer"," 默认关闭——帧提交后缓冲即被清空。",{"title":15,"searchDepth":16,"depth":17,"links":196},[],"2026-11-13","readPixels 读不到内容不是 bug，是 preserveDrawingBuffer 默认关闭——帧提交后缓冲即被清空。",{},"\u002Fnotes\u002F2026-11-14-2",{"description":198},"notes\u002F2026-11-14-2","i7xWqq2eNoU_seSbLQjqlB9gE51fM-PVLUEYCHBkOA4",1795309534170]