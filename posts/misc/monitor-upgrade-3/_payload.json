[{"data":1,"prerenderedAt":206},["ShallowReactive",2],{"notes-latest-1":3,"post:\u002Fposts\u002Fmisc\u002Fmonitor-upgrade-3":27,"surround:\u002Fposts\u002Fmisc\u002Fmonitor-upgrade-3":134,"notes-latest-3":141},[4],{"id":5,"title":6,"body":7,"createdAt":19,"description":13,"extension":20,"meta":21,"navigation":22,"path":23,"seo":24,"stem":25,"__hash__":26},"notes\u002Fnotes\u002F2026-11-14-1-2.md","2026 11 14 1 2",{"type":8,"value":9,"toc":14},"minimark",[10],[11,12,13],"p",{},"站点上线了「随笔」：支持一个文件多个随笔",{"title":15,"searchDepth":16,"depth":17,"links":18},"",2,3,[],"2026-11-17","md",{},true,"\u002Fnotes\u002F2026-11-14-1-2",{"description":13},"notes\u002F2026-11-14-1-2","hDP9fvaunHzVrZQ6QifuOtj9VrqbxlPb_52KE5wSjD0",{"id":28,"title":29,"author":30,"body":31,"categories":115,"comment":22,"cover":30,"createdAt":117,"description":35,"draft":118,"extension":20,"meta":119,"navigation":22,"path":124,"readingTime":125,"recommend":118,"seo":126,"series":30,"stem":127,"tags":128,"top":118,"topics":130,"updatedAt":30,"words":132,"__hash__":133},"posts\u002Fposts\u002Fmisc\u002Fmonitor-upgrade-3.md","显示器升级的折腾史（三）",null,{"type":8,"value":32,"toc":107},[33,36,40,43,46,49,52,55,58,61,64,67,70,73,76,79,81,83,86,89,92,95,98,101,104],[11,34,35],{},"晚上洗完碗坐下来，忽然想写点什么，就写写这件小事。",[37,38,39],"h2",{"id":39},"选型的纠结",[11,41,42],{},"显示器升级的折腾记一篇。选型纠结了两周，尺寸、分辨率、面板类型各有取舍：二十七寸四百价位到四千价位的跨度让人眼花，最后确认自己的核心需求是长时间码字的舒适度，于是锁定 IPS 面板、四K、二十七寸，色彩和文字锐利度对眼友好，刷新率反而妥协了一下。",[11,44,45],{},"到手之后最惊喜的不是参数是支架，可升降旋转的支架让颈椎的姿势自由度大幅提升，竖屏模式写代码看文档效率直接翻倍，这个当年觉得\"支架加钱不值\"的我，现在想回去摇醒。",[37,47,48],{"id":48},"使用调节",[11,50,51],{},"使用层面几个调节记录：亮度调到和环境光匹配，夜间开低蓝光模式，色温偏暖一点眼睛舒服很多；系统缩放按自己的视力调，别硬扛小字。桌子的高度也顺带整治了一遍，手肘自然下垂九十度，显示器上沿平视，这一套人体工学调整下来的整体收益，比换显示器本身还大。",[11,53,54],{},"总结：显示器的升级不是买一块屏幕，是给每天八小时的工位做一次体检。这篇里的选型逻辑和调节参数都写详细了，正在纠结的朋友可以直接抄。",[37,56,57],{"id":57},"两个小教训",[11,59,60],{},"保温杯里闷了一晚上的茶，苦到怀疑人生。茶水分离的杯子买回来之后，每一泡都恰到好处，工具选对，体验立刻不同。",[11,62,63],{},"下雨天骑车上班，一个转弯摔了，人没大事，裤子毁了，手机屏幕裂了道纹。从那之后雨天一律地铁，通勤的意义是到达，不是冒险。",[11,65,66],{},"花了半个小时找手机，最后发现它在冰箱里，旁边是牛奶。那天之后我认真审视了自己的疲劳程度，人不是机器，续航是有数的。",[37,68,69],{"id":69},"一点延伸",[11,71,72],{},"设备折腾到一定阶段会明白，所谓生产力工具的终极形态是“感觉不到它的存在”：不卡顿、不响、不打扰，专注力才回得来。参数表上的每一分兴奋，最后都要靠日常使用的安静来兑现。",[11,74,75],{},"数字生活的定期整理值得当成季度例行：相册、文件、收藏夹、订阅列表，各花半小时。数字空间的整洁和房间的整洁是同一种东西，杂物少了，重要的东西才看得见。",[11,77,78],{},"数码消费这些年的原则越来越简单：为每天使用的东西买好的，为偶尔使用的东西买够用的。一天摸八小时的键盘和一年开三次的露营灯，预算分配应该差出一个数量级，反过来就是最常见的选择错误。",[11,80,72],{},[11,82,75],{},[37,84,85],{"id":85},"再补充几句",[11,87,88],{},"回顾这个过程，最大的教训其实是克制。可选项永远比需要的多，每个新方案看起来都比现状好一点，但都加上之后，系统就成了没人看得懂的拼贴画。做减法的判断比做加法的胆子更值钱。",[11,90,91],{},"这种事急不来，和锻炼身体是一个道理：练一天没变化，练三个月身体自己会说话。技术积累也是这样，每天一点，回过头看的时候差距已经拉开了，只是身在其中感觉不到而已。",[11,93,94],{},"想到一个问题：为什么同样的事情，不同的人做出来差别那么大。后来觉得答案在于对边界的处理，正常路径人人会写，边界和异常的处理习惯才是拉开差距的地方。做事和写代码一样，细节的密度决定成品的质量。",[11,96,97],{},"写到这里顺便吐个槽，这类事情最难的部分往往不是技术本身，是说服别人相信它值得投入。方案再好，落不到排期上都是空谈，所以学会用数据的语言讲价值，算是这些年额外的必修课。",[37,99,100],{"id":100},"写在最后",[11,102,103],{},"折腾完顺手写了几行代码做了个统计，理工科思维的反应就是这样，朋友都笑我，但确实好用了。",[11,105,106],{},"就写到这吧，锅里还炖着东西，得去看一眼。",{"title":15,"searchDepth":16,"depth":17,"links":108},[109,110,111,112,113,114],{"id":39,"depth":16,"text":39},{"id":48,"depth":16,"text":48},{"id":57,"depth":16,"text":57},{"id":69,"depth":16,"text":69},{"id":85,"depth":16,"text":85},{"id":100,"depth":16,"text":100},[116],"数码","2026-01-15",false,{"excerpt":120},{"type":8,"value":121},[122],[11,123,35],{},"\u002Fposts\u002Fmisc\u002Fmonitor-upgrade-3",384000,{"title":29,"description":35},"posts\u002Fmisc\u002Fmonitor-upgrade-3",[129,116],"显示器",[131],"misc",1280,"AGDHFUUGlhHVKJ3y4SljrBq2vhEBncWDDmJf_8v7PiE",{"prev":135,"next":138},{"path":136,"title":137},"\u002Fposts\u002Fmisc\u002Fmonitor-upgrade-2","显示器升级的折腾史（二）",{"path":139,"title":140},"\u002Fposts\u002Fmisc\u002Fmonitor-upgrade-4","显示器升级的折腾史（四）",[142,151,181],{"id":5,"title":6,"body":143,"createdAt":19,"description":13,"extension":20,"meta":149,"navigation":22,"path":23,"seo":150,"stem":25,"__hash__":26},{"type":8,"value":144,"toc":147},[145],[11,146,13],{},{"title":15,"searchDepth":16,"depth":17,"links":148},[],{},{"description":13},{"id":152,"title":153,"body":154,"createdAt":174,"description":175,"extension":20,"meta":176,"navigation":22,"path":177,"seo":178,"stem":179,"__hash__":180},"notes\u002Fnotes\u002F2026-11-14-1.md","2026 11 14 1",{"type":8,"value":155,"toc":172},[156],[11,157,158,159,163,164,171],{},"站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 ",[160,161,162],"strong",{},"Markdown","，写链接也不用到编辑器：",[165,166,170],"a",{"href":167,"rel":168},"https:\u002F\u002Fcontent.nuxt.com",[169],"nofollow","Nuxt Content","。",{"title":15,"searchDepth":16,"depth":17,"links":173},[],"2026-11-14","站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 Markdown，写链接也不用到编辑器：Nuxt Content。",{},"\u002Fnotes\u002F2026-11-14-1",{"description":175},"notes\u002F2026-11-14-1","LLJX_RKU7cgpT6aHw4DZWUZNQ_G_UzELWPKbksJvzfs",{"id":182,"title":183,"body":184,"createdAt":199,"description":200,"extension":20,"meta":201,"navigation":22,"path":202,"seo":203,"stem":204,"__hash__":205},"notes\u002Fnotes\u002F2026-11-14-2.md","2026 11 14 2",{"type":8,"value":185,"toc":197},[186],[11,187,188,192,193,196],{},[189,190,191],"code",{},"readPixels"," 读不到内容不是 bug，是 ",[189,194,195],{},"preserveDrawingBuffer"," 默认关闭——帧提交后缓冲即被清空。",{"title":15,"searchDepth":16,"depth":17,"links":198},[],"2026-11-13","readPixels 读不到内容不是 bug，是 preserveDrawingBuffer 默认关闭——帧提交后缓冲即被清空。",{},"\u002Fnotes\u002F2026-11-14-2",{"description":200},"notes\u002F2026-11-14-2","i7xWqq2eNoU_seSbLQjqlB9gE51fM-PVLUEYCHBkOA4",1795707445822]