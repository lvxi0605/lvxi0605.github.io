[{"data":1,"prerenderedAt":207},["ShallowReactive",2],{"notes-latest-1":3,"post:\u002Fposts\u002Fmisc\u002Fpodcast-playlist-3":27,"surround:\u002Fposts\u002Fmisc\u002Fpodcast-playlist-3":135,"notes-latest-3":142},[4],{"id":5,"title":6,"body":7,"createdAt":19,"description":13,"extension":20,"meta":21,"navigation":22,"path":23,"seo":24,"stem":25,"__hash__":26},"notes\u002Fnotes\u002F2026-11-14-1-2.md","2026 11 14 1 2",{"type":8,"value":9,"toc":14},"minimark",[10],[11,12,13],"p",{},"站点上线了「随笔」：支持一个文件多个随笔",{"title":15,"searchDepth":16,"depth":17,"links":18},"",2,3,[],"2026-11-17","md",{},true,"\u002Fnotes\u002F2026-11-14-1-2",{"description":13},"notes\u002F2026-11-14-1-2","hDP9fvaunHzVrZQ6QifuOtj9VrqbxlPb_52KE5wSjD0",{"id":28,"title":29,"author":30,"body":31,"categories":115,"comment":22,"cover":30,"createdAt":117,"description":35,"draft":118,"extension":20,"meta":119,"navigation":22,"path":124,"readingTime":125,"recommend":118,"seo":126,"series":30,"stem":127,"tags":128,"top":118,"topics":131,"updatedAt":30,"words":133,"__hash__":134},"posts\u002Fposts\u002Fmisc\u002Fpodcast-playlist-3.md","我的播客与歌单管理（三）",null,{"type":8,"value":32,"toc":107},[33,36,40,43,46,49,52,55,58,61,64,67,70,73,76,79,81,83,86,89,92,95,98,101,104],[11,34,35],{},"最近生活里有些小变化，趁着晚上安静，写两句给自己看。",[37,38,39],"h2",{"id":39},"播客的收听习惯",[11,41,42],{},"通勤时间的主要消遣从刷手机换成了听播客，这个转变的契机是发现刷完手机更累而听完播客更充实。目前的收听结构：技术访谈类两档、脱口秀类一档、文化类一档，每周更新量刚好填满通勤加跑步的时间，不多不少。",[11,44,45],{},"听播客的方法上有个心得：好内容值得二倍速之外再记一笔，我在备忘录里建了个\"播客碎片\"的文档，听到有意思的观点随手记一句，攒着攒着，很多博客文章的选题就从这里长出来了。",[37,47,48],{"id":48},"歌单的整理",[11,50,51],{},"歌单也做了次大整理，把几百首收藏按场景重新归档：写代码的纯音乐、跑步的节奏型、周末的慵懒系、深夜的民谣。整理完发现一个规律，歌单反映的是一天的时间结构，一天里有几种状态，歌单就该有几张。",[11,53,54],{},"数字生活的整理收益都被低估了，信息流理顺之后，注意力节省是复利级别的。这篇记录完，通勤的耳机里正好切到这周更新的那期，技术上聊到了大模型的工程化，观点比很多文章扎实，推荐指数五颗星。",[37,56,57],{"id":57},"一点反思",[11,59,60],{},"给花换盆的时机不对，大夏天动的土，缓了半个月才缓过来，叶子黄了一半。换盆要赶在春秋，园艺上的讲究背后都是植物的生理规律。",[11,62,63],{},"夜跑那阵子穿深色衣服，路过没有路灯的路段被司机按喇叭提醒，回想起来一阵后怕。后来买了反光背心，几十块钱买安心。",[11,65,66],{},"空调滤网两年没洗，风越来越小还带味道，拆开一看吓一跳。一小时清理完，制冷立刻给力。家用电器的保养周期，说明书上写的那些建议真不是随口说说。",[37,68,69],{"id":69},"顺便一提",[11,71,72],{},"数字生活的定期整理值得当成季度例行：相册、文件、收藏夹、订阅列表，各花半小时。数字空间的整洁和房间的整洁是同一种东西，杂物少了，重要的东西才看得见。",[11,74,75],{},"数码消费这些年的原则越来越简单：为每天使用的东西买好的，为偶尔使用的东西买够用的。一天摸八小时的键盘和一年开三次的露营灯，预算分配应该差出一个数量级，反过来就是最常见的选择错误。",[11,77,78],{},"设备折腾到一定阶段会明白，所谓生产力工具的终极形态是“感觉不到它的存在”：不卡顿、不响、不打扰，专注力才回得来。参数表上的每一分兴奋，最后都要靠日常使用的安静来兑现。",[11,80,72],{},[11,82,75],{},[37,84,85],{"id":85},"另外记几笔",[11,87,88],{},"由这件事联想到阅读习惯：资料要看一手来源，译文和二手转述经常带着传播者的理解偏差，偏差叠几层之后和原意面目全非。多花十分钟读原文，省下的是未来几小时的排查，这笔账怎么算都划算。",[11,90,91],{},"还有个感受越来越深：知识落地成文字的过程本身就是学习的一部分。很多自以为想清楚的东西，写出来才发现逻辑有洞。写作是最好的检验，这也是坚持写博客这么多年的理由之一，写不出来的就是还没学会的。",[11,93,94],{},"过程中也反复体会到取舍的本质：没有完美的方案，只有当下约束下最合适的方案。把约束写清楚，方案的选择题就变成了证明题，这也是为什么我习惯先列约束再谈方案，顺序反了全是无效争论。",[11,96,97],{},"想想还是补一段：任何习惯的养成都绕不开启动成本，最有效的办法是把启动成本降到接近零。想跑就把鞋放门口，想写就把文档开着置顶，环境准备到位了，行动只是顺水推舟。",[37,99,100],{"id":100},"小结",[11,102,103],{},"我给这事做了个简单的表格记录，朋友说我无药可救，但两个月的曲线摆在眼前，比嘴上的感觉可靠多了。",[11,105,106],{},"这篇写得断断续续，总算收尾，下篇见。",{"title":15,"searchDepth":16,"depth":17,"links":108},[109,110,111,112,113,114],{"id":39,"depth":16,"text":39},{"id":48,"depth":16,"text":48},{"id":57,"depth":16,"text":57},{"id":69,"depth":16,"text":69},{"id":85,"depth":16,"text":85},{"id":100,"depth":16,"text":100},[116],"数码","2023-05-31",false,{"excerpt":120},{"type":8,"value":121},[122],[11,123,35],{},"\u002Fposts\u002Fmisc\u002Fpodcast-playlist-3",389100,{"title":29,"description":35},"posts\u002Fmisc\u002Fpodcast-playlist-3",[129,130],"播客","歌单",[132],"misc",1297,"xlZ-kyj0bkqgMhm58yVj-KyXBtX_Qd4X05ic_zvG70Q",{"prev":136,"next":139},{"path":137,"title":138},"\u002Fposts\u002Fmisc\u002Fpodcast-playlist-2","我的播客与歌单管理（二）",{"path":140,"title":141},"\u002Fposts\u002Fmisc\u002Fpodcast-playlist-4","我的播客与歌单管理（四）",[143,152,182],{"id":5,"title":6,"body":144,"createdAt":19,"description":13,"extension":20,"meta":150,"navigation":22,"path":23,"seo":151,"stem":25,"__hash__":26},{"type":8,"value":145,"toc":148},[146],[11,147,13],{},{"title":15,"searchDepth":16,"depth":17,"links":149},[],{},{"description":13},{"id":153,"title":154,"body":155,"createdAt":175,"description":176,"extension":20,"meta":177,"navigation":22,"path":178,"seo":179,"stem":180,"__hash__":181},"notes\u002Fnotes\u002F2026-11-14-1.md","2026 11 14 1",{"type":8,"value":156,"toc":173},[157],[11,158,159,160,164,165,172],{},"站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 ",[161,162,163],"strong",{},"Markdown","，写链接也不用到编辑器：",[166,167,171],"a",{"href":168,"rel":169},"https:\u002F\u002Fcontent.nuxt.com",[170],"nofollow","Nuxt Content","。",{"title":15,"searchDepth":16,"depth":17,"links":174},[],"2026-11-14","站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 Markdown，写链接也不用到编辑器：Nuxt Content。",{},"\u002Fnotes\u002F2026-11-14-1",{"description":176},"notes\u002F2026-11-14-1","LLJX_RKU7cgpT6aHw4DZWUZNQ_G_UzELWPKbksJvzfs",{"id":183,"title":184,"body":185,"createdAt":200,"description":201,"extension":20,"meta":202,"navigation":22,"path":203,"seo":204,"stem":205,"__hash__":206},"notes\u002Fnotes\u002F2026-11-14-2.md","2026 11 14 2",{"type":8,"value":186,"toc":198},[187],[11,188,189,193,194,197],{},[190,191,192],"code",{},"readPixels"," 读不到内容不是 bug，是 ",[190,195,196],{},"preserveDrawingBuffer"," 默认关闭——帧提交后缓冲即被清空。",{"title":15,"searchDepth":16,"depth":17,"links":199},[],"2026-11-13","readPixels 读不到内容不是 bug，是 preserveDrawingBuffer 默认关闭——帧提交后缓冲即被清空。",{},"\u002Fnotes\u002F2026-11-14-2",{"description":201},"notes\u002F2026-11-14-2","i7xWqq2eNoU_seSbLQjqlB9gE51fM-PVLUEYCHBkOA4",1795783655677]