[{"data":1,"prerenderedAt":204},["ShallowReactive",2],{"notes-latest-1":3,"post:\u002Fposts\u002Fmisc\u002Fmechanical-keyboard-3":27,"surround:\u002Fposts\u002Fmisc\u002Fmechanical-keyboard-3":132,"notes-latest-3":139},[4],{"id":5,"title":6,"body":7,"createdAt":19,"description":13,"extension":20,"meta":21,"navigation":22,"path":23,"seo":24,"stem":25,"__hash__":26},"notes\u002Fnotes\u002F2026-11-14-1-2.md","2026 11 14 1 2",{"type":8,"value":9,"toc":14},"minimark",[10],[11,12,13],"p",{},"站点上线了「随笔」：支持一个文件多个随笔",{"title":15,"searchDepth":16,"depth":17,"links":18},"",2,3,[],"2026-11-17","md",{},true,"\u002Fnotes\u002F2026-11-14-1-2",{"description":13},"notes\u002F2026-11-14-1-2","hDP9fvaunHzVrZQ6QifuOtj9VrqbxlPb_52KE5wSjD0",{"id":28,"title":29,"author":30,"body":31,"categories":113,"comment":22,"cover":30,"createdAt":115,"description":35,"draft":116,"extension":20,"meta":117,"navigation":22,"path":122,"readingTime":123,"recommend":116,"seo":124,"series":30,"stem":125,"tags":126,"top":116,"topics":128,"updatedAt":30,"words":130,"__hash__":131},"posts\u002Fposts\u002Fmisc\u002Fmechanical-keyboard-3.md","机械键盘入坑记（三）",null,{"type":8,"value":32,"toc":105},[33,36,40,43,46,49,52,55,58,61,64,67,70,73,76,79,81,84,87,90,93,96,99,102],[11,34,35],{},"起因是和朋友聊到这个话题，聊完发现我们的做法完全不同，回来想想还是记录一下我的版本。",[37,38,39],"h2",{"id":39},"从一把青轴开始",[11,41,42],{},"机械键盘入坑半年，记录一下这段消费行为分析报告。第一把是常见的青轴，噼里啪啦一周之后被家里领导的抗议按停，换成了红轴，线性手感安静顺滑，从此世界和平。这把红轴陪我写了不少代码和博客，键程的确认感确实比薄膜键盘舒服。",[11,44,45],{},"键帽是第二个坑，原装 ABS 打油之后，换了 PBT 的，磨砂手感持久，透光的字根晚上看着很有氛围。配色挑了低调的深灰蓝，桌面观感立刻正经起来。",[37,47,48],{"id":48},"克制与总结",[11,50,51],{},"入坑半年的克制总结：轴体的世界还很大，静音轴、段落轴各有拥趸，客制化更是深不见底，我的结论是适合自己的就是终点，不再往前走了。这笔投入的实际收益不好量化，但每天敲击的手感提升是真实可感的，加上如今写东西的频率，平摊下来不算奢侈。",[11,53,54],{},"给同样想入坑的朋友两个建议：先试后买，实体店按一按，轴体手感这东西看测评永远隔一层；套件加键帽可以分开配，性价比比成品套装高。键盘是每天摸八小时的工具，值得认真选，但记得它是工具。",[37,56,57],{"id":57},"过程中的小心得",[11,59,60],{},"夜跑那阵子穿深色衣服，路过没有路灯的路段被司机按喇叭提醒，回想起来一阵后怕。后来买了反光背心，几十块钱买安心。",[11,62,63],{},"空调滤网两年没洗，风越来越小还带味道，拆开一看吓一跳。一小时清理完，制冷立刻给力。家用电器的保养周期，说明书上写的那些建议真不是随口说说。",[11,65,66],{},"新买的锅没开锅就上灶，第一条鱼皮粘得惨不忍睹。老老实实开了锅，热锅凉油，之后煎什么都利索。工具要有工具的仪式，这道理在厨房通用。",[37,68,69],{"id":69},"延伸几句",[11,71,72],{},"数字生活的定期整理值得当成季度例行：相册、文件、收藏夹、订阅列表，各花半小时。数字空间的整洁和房间的整洁是同一种东西，杂物少了，重要的东西才看得见。",[11,74,75],{},"数码消费这些年的原则越来越简单：为每天使用的东西买好的，为偶尔使用的东西买够用的。一天摸八小时的键盘和一年开三次的露营灯，预算分配应该差出一个数量级，反过来就是最常见的选择错误。",[11,77,78],{},"设备折腾到一定阶段会明白，所谓生产力工具的终极形态是“感觉不到它的存在”：不卡顿、不响、不打扰，专注力才回得来。参数表上的每一分兴奋，最后都要靠日常使用的安静来兑现。",[11,80,72],{},[37,82,83],{"id":83},"又想到一些",[11,85,86],{},"最后聊点感受：做技术这些年，越来越觉得最好的状态是既投入又抽离。投入是把事情做好，抽离是时不时跳出来看看方向对不对，两者缺一，要么辛苦没产出，要么轻松跑偏路。",[11,88,89],{},"写着写着想到，很多技术选择本质上都是在回答同一个问题：这个方案在出问题的时候是什么样子。不出问题的方案人人都写得出来，区分度全在故障时刻的表现。多想一层失败路径，很多纠结就自动有了答案。",[11,91,92],{},"这类经验在文档里通常只有一行字，背后的排查却是一整个下午。技术工作的大部分时间都花在这些不会写进简历的细节里，所以这些细节才更需要有人写出来，哪怕只是给未来某一天忘了的自己。",[11,94,95],{},"顺带聊聊方法论：遇到不熟悉的领域，我的习惯是先把最小闭环跑通，哪怕每一步都很粗糙。跑通之后再逐段替换成正经实现，过程中每一步都有可运行的版本。这个思路在工作和生活里都屡试不爽，比憋大招的成功率高得多。",[37,97,98],{"id":98},"小结",[11,100,101],{},"职业病之一是看什么都想拆步骤，这件事在我这里基本是个流程问题：目标、步骤、验证、复盘，一套下来居然还真管用。",[11,103,104],{},"记录完毕，方便以后自己回来翻。",{"title":15,"searchDepth":16,"depth":17,"links":106},[107,108,109,110,111,112],{"id":39,"depth":16,"text":39},{"id":48,"depth":16,"text":48},{"id":57,"depth":16,"text":57},{"id":69,"depth":16,"text":69},{"id":83,"depth":16,"text":83},{"id":98,"depth":16,"text":98},[114],"数码","2023-12-27",false,{"excerpt":118},{"type":8,"value":119},[120],[11,121,35],{},"\u002Fposts\u002Fmisc\u002Fmechanical-keyboard-3",377400,{"title":29,"description":35},"posts\u002Fmisc\u002Fmechanical-keyboard-3",[127,114],"机械键盘",[129],"misc",1258,"Qf3f1OwEDOXVR8V3yOSvYqRWjhrkSs8-LYBGvPzuyiI",{"prev":133,"next":136},{"path":134,"title":135},"\u002Fposts\u002Fmisc\u002Fmechanical-keyboard-2","机械键盘入坑记（二）",{"path":137,"title":138},"\u002Fposts\u002Fmisc\u002Fmonitor-upgrade","显示器升级的折腾史",[140,149,179],{"id":5,"title":6,"body":141,"createdAt":19,"description":13,"extension":20,"meta":147,"navigation":22,"path":23,"seo":148,"stem":25,"__hash__":26},{"type":8,"value":142,"toc":145},[143],[11,144,13],{},{"title":15,"searchDepth":16,"depth":17,"links":146},[],{},{"description":13},{"id":150,"title":151,"body":152,"createdAt":172,"description":173,"extension":20,"meta":174,"navigation":22,"path":175,"seo":176,"stem":177,"__hash__":178},"notes\u002Fnotes\u002F2026-11-14-1.md","2026 11 14 1",{"type":8,"value":153,"toc":170},[154],[11,155,156,157,161,162,169],{},"站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 ",[158,159,160],"strong",{},"Markdown","，写链接也不用到编辑器：",[163,164,168],"a",{"href":165,"rel":166},"https:\u002F\u002Fcontent.nuxt.com",[167],"nofollow","Nuxt Content","。",{"title":15,"searchDepth":16,"depth":17,"links":171},[],"2026-11-14","站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 Markdown，写链接也不用到编辑器：Nuxt Content。",{},"\u002Fnotes\u002F2026-11-14-1",{"description":173},"notes\u002F2026-11-14-1","LLJX_RKU7cgpT6aHw4DZWUZNQ_G_UzELWPKbksJvzfs",{"id":180,"title":181,"body":182,"createdAt":197,"description":198,"extension":20,"meta":199,"navigation":22,"path":200,"seo":201,"stem":202,"__hash__":203},"notes\u002Fnotes\u002F2026-11-14-2.md","2026 11 14 2",{"type":8,"value":183,"toc":195},[184],[11,185,186,190,191,194],{},[187,188,189],"code",{},"readPixels"," 读不到内容不是 bug，是 ",[187,192,193],{},"preserveDrawingBuffer"," 默认关闭——帧提交后缓冲即被清空。",{"title":15,"searchDepth":16,"depth":17,"links":196},[],"2026-11-13","readPixels 读不到内容不是 bug，是 preserveDrawingBuffer 默认关闭——帧提交后缓冲即被清空。",{},"\u002Fnotes\u002F2026-11-14-2",{"description":198},"notes\u002F2026-11-14-2","i7xWqq2eNoU_seSbLQjqlB9gE51fM-PVLUEYCHBkOA4",1795275207109]