[{"data":1,"prerenderedAt":204},["ShallowReactive",2],{"notes-latest-1":3,"post:\u002Fposts\u002Fmisc\u002Fmonitor-upgrade-4":27,"surround:\u002Fposts\u002Fmisc\u002Fmonitor-upgrade-4":132,"notes-latest-3":139},[4],{"id":5,"title":6,"body":7,"createdAt":19,"description":13,"extension":20,"meta":21,"navigation":22,"path":23,"seo":24,"stem":25,"__hash__":26},"notes\u002Fnotes\u002F2026-11-14-1-2.md","2026 11 14 1 2",{"type":8,"value":9,"toc":14},"minimark",[10],[11,12,13],"p",{},"站点上线了「随笔」：支持一个文件多个随笔",{"title":15,"searchDepth":16,"depth":17,"links":18},"",2,3,[],"2026-11-17","md",{},true,"\u002Fnotes\u002F2026-11-14-1-2",{"description":13},"notes\u002F2026-11-14-1-2","hDP9fvaunHzVrZQ6QifuOtj9VrqbxlPb_52KE5wSjD0",{"id":28,"title":29,"author":30,"body":31,"categories":113,"comment":22,"cover":30,"createdAt":115,"description":35,"draft":116,"extension":20,"meta":117,"navigation":22,"path":122,"readingTime":123,"recommend":116,"seo":124,"series":30,"stem":125,"tags":126,"top":116,"topics":128,"updatedAt":30,"words":130,"__hash__":131},"posts\u002Fposts\u002Fmisc\u002Fmonitor-upgrade-4.md","显示器升级的折腾史（四）",null,{"type":8,"value":32,"toc":105},[33,36,40,43,46,49,52,55,58,61,64,67,70,73,76,79,81,84,87,90,93,96,99,102],[11,34,35],{},"周末闲下来，想把这件事记一笔，没什么技术含量，就是觉得有点意思，不写下来可惜。",[37,38,39],"h2",{"id":39},"选型的纠结",[11,41,42],{},"显示器升级的折腾记一篇。选型纠结了两周，尺寸、分辨率、面板类型各有取舍：二十七寸四百价位到四千价位的跨度让人眼花，最后确认自己的核心需求是长时间码字的舒适度，于是锁定 IPS 面板、四K、二十七寸，色彩和文字锐利度对眼友好，刷新率反而妥协了一下。",[11,44,45],{},"到手之后最惊喜的不是参数是支架，可升降旋转的支架让颈椎的姿势自由度大幅提升，竖屏模式写代码看文档效率直接翻倍，这个当年觉得\"支架加钱不值\"的我，现在想回去摇醒。",[37,47,48],{"id":48},"使用调节",[11,50,51],{},"使用层面几个调节记录：亮度调到和环境光匹配，夜间开低蓝光模式，色温偏暖一点眼睛舒服很多；系统缩放按自己的视力调，别硬扛小字。桌子的高度也顺带整治了一遍，手肘自然下垂九十度，显示器上沿平视，这一套人体工学调整下来的整体收益，比换显示器本身还大。",[11,53,54],{},"总结：显示器的升级不是买一块屏幕，是给每天八小时的工位做一次体检。这篇里的选型逻辑和调节参数都写详细了，正在纠结的朋友可以直接抄。",[37,56,57],{"id":57},"两个小教训",[11,59,60],{},"剩菜以前是等凉透再进冰箱，被科普之后才知道要尽快冷藏，细菌繁殖的窗口期比想象中短。生活里很多想当然的习惯，较真起来都有另一套答案。",[11,62,63],{},"随手记两个小教训：阳台那盆绿萝浇得太勤，根都泡烂了，剪掉烂的部分重新扦插，现在改了策略，土干了再浇，反倒精神了不少。",[11,65,66],{},"煮饭水放多了，成品介于饭和粥之间。后来老老实实用量杯，或者直接看水位线，凭感觉这种事，在厨房里基本靠不住。",[37,68,69],{"id":69},"一点延伸",[11,71,72],{},"数码消费这些年的原则越来越简单：为每天使用的东西买好的，为偶尔使用的东西买够用的。一天摸八小时的键盘和一年开三次的露营灯，预算分配应该差出一个数量级，反过来就是最常见的选择错误。",[11,74,75],{},"设备折腾到一定阶段会明白，所谓生产力工具的终极形态是“感觉不到它的存在”：不卡顿、不响、不打扰，专注力才回得来。参数表上的每一分兴奋，最后都要靠日常使用的安静来兑现。",[11,77,78],{},"数字生活的定期整理值得当成季度例行：相册、文件、收藏夹、订阅列表，各花半小时。数字空间的整洁和房间的整洁是同一种东西，杂物少了，重要的东西才看得见。",[11,80,72],{},[37,82,83],{"id":83},"再补充几句",[11,85,86],{},"想到一个问题：为什么同样的事情，不同的人做出来差别那么大。后来觉得答案在于对边界的处理，正常路径人人会写，边界和异常的处理习惯才是拉开差距的地方。做事和写代码一样，细节的密度决定成品的质量。",[11,88,89],{},"写到这里顺便吐个槽，这类事情最难的部分往往不是技术本身，是说服别人相信它值得投入。方案再好，落不到排期上都是空谈，所以学会用数据的语言讲价值，算是这些年额外的必修课。",[11,91,92],{},"有时候会想，学一门新技术到底学到的是什么。语法和 API 会过时，真正的收获是它看问题的角度。多一门语言就多一副眼镜，同一副牌桌，能看到别人看不到的牌路，这是这么多年折腾下来最确定的回报。",[11,94,95],{},"记一个产生过的动摇：做到一半觉得这玩意儿是不是没什么意义。后来想通了，意义不是事情自带的，是你把它做完并沉淀下来之后长出来的。烂尾的才真的没意义，做完的最差也是一篇笔记。",[37,97,98],{"id":98},"写在最后",[11,100,101],{},"我把这件事当成一个小需求来管理，明确了目标和验收标准，中途改了两次方案，最后的效果自己挺满意。",[11,103,104],{},"这篇写得断断续续，总算收尾，下篇见。",{"title":15,"searchDepth":16,"depth":17,"links":106},[107,108,109,110,111,112],{"id":39,"depth":16,"text":39},{"id":48,"depth":16,"text":48},{"id":57,"depth":16,"text":57},{"id":69,"depth":16,"text":69},{"id":83,"depth":16,"text":83},{"id":98,"depth":16,"text":98},[114],"数码","2023-02-17",false,{"excerpt":118},{"type":8,"value":119},[120],[11,121,35],{},"\u002Fposts\u002Fmisc\u002Fmonitor-upgrade-4",377400,{"title":29,"description":35},"posts\u002Fmisc\u002Fmonitor-upgrade-4",[127,114],"显示器",[129],"misc",1258,"1VAyIIP-xr57cQaRz5jEXBJAkyXZq8X8yoEvrX4rh6E",{"prev":133,"next":136},{"path":134,"title":135},"\u002Fposts\u002Fmisc\u002Fmonitor-upgrade-3","显示器升级的折腾史（三）",{"path":137,"title":138},"\u002Fposts\u002Fmisc\u002Fpodcast-playlist","我的播客与歌单管理",[140,149,179],{"id":5,"title":6,"body":141,"createdAt":19,"description":13,"extension":20,"meta":147,"navigation":22,"path":23,"seo":148,"stem":25,"__hash__":26},{"type":8,"value":142,"toc":145},[143],[11,144,13],{},{"title":15,"searchDepth":16,"depth":17,"links":146},[],{},{"description":13},{"id":150,"title":151,"body":152,"createdAt":172,"description":173,"extension":20,"meta":174,"navigation":22,"path":175,"seo":176,"stem":177,"__hash__":178},"notes\u002Fnotes\u002F2026-11-14-1.md","2026 11 14 1",{"type":8,"value":153,"toc":170},[154],[11,155,156,157,161,162,169],{},"站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 ",[158,159,160],"strong",{},"Markdown","，写链接也不用到编辑器：",[163,164,168],"a",{"href":165,"rel":166},"https:\u002F\u002Fcontent.nuxt.com",[167],"nofollow","Nuxt Content","。",{"title":15,"searchDepth":16,"depth":17,"links":171},[],"2026-11-14","站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 Markdown，写链接也不用到编辑器：Nuxt Content。",{},"\u002Fnotes\u002F2026-11-14-1",{"description":173},"notes\u002F2026-11-14-1","LLJX_RKU7cgpT6aHw4DZWUZNQ_G_UzELWPKbksJvzfs",{"id":180,"title":181,"body":182,"createdAt":197,"description":198,"extension":20,"meta":199,"navigation":22,"path":200,"seo":201,"stem":202,"__hash__":203},"notes\u002Fnotes\u002F2026-11-14-2.md","2026 11 14 2",{"type":8,"value":183,"toc":195},[184],[11,185,186,190,191,194],{},[187,188,189],"code",{},"readPixels"," 读不到内容不是 bug，是 ",[187,192,193],{},"preserveDrawingBuffer"," 默认关闭——帧提交后缓冲即被清空。",{"title":15,"searchDepth":16,"depth":17,"links":196},[],"2026-11-13","readPixels 读不到内容不是 bug，是 preserveDrawingBuffer 默认关闭——帧提交后缓冲即被清空。",{},"\u002Fnotes\u002F2026-11-14-2",{"description":198},"notes\u002F2026-11-14-2","i7xWqq2eNoU_seSbLQjqlB9gE51fM-PVLUEYCHBkOA4",1795707445831]