[{"data":1,"prerenderedAt":208},["ShallowReactive",2],{"notes-latest-1":3,"post:\u002Fposts\u002Flife\u002Flate-night-canteen-2":27,"surround:\u002Fposts\u002Flife\u002Flate-night-canteen-2":136,"notes-latest-3":143},[4],{"id":5,"title":6,"body":7,"createdAt":19,"description":13,"extension":20,"meta":21,"navigation":22,"path":23,"seo":24,"stem":25,"__hash__":26},"notes\u002Fnotes\u002F2026-11-14-1-2.md","2026 11 14 1 2",{"type":8,"value":9,"toc":14},"minimark",[10],[11,12,13],"p",{},"站点上线了「随笔」：支持一个文件多个随笔",{"title":15,"searchDepth":16,"depth":17,"links":18},"",2,3,[],"2026-11-17","md",{},true,"\u002Fnotes\u002F2026-11-14-1-2",{"description":13},"notes\u002F2026-11-14-1-2","hDP9fvaunHzVrZQ6QifuOtj9VrqbxlPb_52KE5wSjD0",{"id":28,"title":29,"author":30,"body":31,"categories":116,"comment":22,"cover":30,"createdAt":118,"description":35,"draft":119,"extension":20,"meta":120,"navigation":22,"path":125,"readingTime":126,"recommend":119,"seo":127,"series":30,"stem":128,"tags":129,"top":119,"topics":132,"updatedAt":30,"words":134,"__hash__":135},"posts\u002Fposts\u002Flife\u002Flate-night-canteen-2.md","加班晚归后的深夜食堂（二）",null,{"type":8,"value":32,"toc":108},[33,36,40,43,46,49,52,55,58,61,64,67,70,73,76,79,82,84,87,90,93,96,99,102,105],[11,34,35],{},"又到周末，把这阵子的碎片想法归拢成一篇，写得随意一点。",[37,38,39],"h2",{"id":39},"楼下的那家小面馆",[11,41,42],{},"加班到十点半，地铁口楼下的面馆还亮着灯。老板认得我，不用开口，一碗牛肉面加个蛋，汤宽面硬，二十分钟端上来。店里没几个人，电视放着没人看的剧，筷子碰到碗的声音特别清楚。",[11,44,45],{},"我常想，这家店对我来说到底是吃饭的地方还是某种心理安慰。后来想明白了，加班的疲惫一半来自大脑持续运转后的空虚，而一碗热汤面正好是从工作模式切回生活模式的仪式，汤下肚的那一刻，那些没改完的 bug 就不属于今晚了。",[37,47,48],{"id":48},"深夜的观察",[11,50,51],{},"店里的常客还有代驾司机、酒吧下班的姑娘、跑外卖的小哥，大家互不打扰，又莫名地有一种同是晚归人的默契。偶尔老板娘会和熟客聊两句家长里短，声音不大，混在汤锅的咕嘟声里。",[11,53,54],{},"写到这里忽然想起来，这家店开了五年，我吃了五年，价格只涨过一次，五块钱。生活里很多这样的小店，不惊艳，但稳稳地在那里，像某个不太说话的老朋友。这篇没什么中心思想，就是今晚吃完面走回家的路上，忽然想把这件事记下来。",[37,56,57],{"id":57},"记下两点",[11,59,60],{},"空调滤网两年没洗，风越来越小还带味道，拆开一看吓一跳。一小时清理完，制冷立刻给力。家用电器的保养周期，说明书上写的那些建议真不是随口说说。",[11,62,63],{},"新买的锅没开锅就上灶，第一条鱼皮粘得惨不忍睹。老老实实开了锅，热锅凉油，之后煎什么都利索。工具要有工具的仪式，这道理在厨房通用。",[11,65,66],{},"出门忘带钥匙，蹲在门口等开锁师傅，等了一小时花了一百五。现在门口的暗格放了备用钥匙，出门摸一下口袋成了肌肉记忆。",[37,68,69],{"id":69},"多聊两句",[11,71,72],{},"写生活记录这几年有个体会：当时觉得不值得写的小事，事后回看反而是最鲜活的片段。反而是那些酝酿很久想认真写的“大主题”，多数烂在了草稿箱。所以现在我的原则是趁热写，先记下来，好不好以后再说。",[11,74,75],{},"生活里很多烦恼，拆开看其实是信息问题而不是命运问题：不知道怎么挑、不知道怎么做、不知道别人是怎么解决的。而信息问题基本都能靠学习和请教解决，这么一想，很多焦虑就有了着手点。",[11,77,78],{},"独居和成家各有各的修行，我现在的体会是无论哪种状态，把生活的基础盘打理好都是第一位的：睡眠、饮食、居住环境、几个说得上话的朋友。基础盘稳了，其他的变化来了都能接得住。",[11,80,81],{},"成年人的学习和学生时代最大的不同是反馈周期，没人给你打分，效果要几个月甚至几年后才显现。所以坚持的动力只能来自内部：记录对照、阶段复盘、给自己一点小奖励，这些机制比意志力可靠得多。",[11,83,72],{},[37,85,86],{"id":86},"继续聊聊",[11,88,89],{},"讲个题外话，做这类事情的时候最好留个记录的习惯，当时的判断依据比结果更珍贵。结果好可能只是运气好，把决策过程记下来，好运才可能被复制，坏运才可能被规避。",[11,91,92],{},"然后想说，承认不懂是这行的美德。这次遇到不懂的地方，老老实实补了两天的课，比硬着头皮往上糊的方案强太多。不懂装懂的代价从来不会消失，只是延期，还带利息。",[11,94,95],{},"平衡感很重要的一件事：投入和收益的比例。所有优化都值得先问一句，这件事的收益上限是多少，值多少投入。无限打磨一个低价值的东西是工程师最常见的温柔陷阱，包括我自己在内。",[11,97,98],{},"忍不住再夸一下记录的力量，上周刚整理的笔记，这次直接翻出来就用，十分钟解决了当时花一下午的问题。给自己留下的每一份笔记，都是寄给未来的快递，寄件人签收时才觉得真香。",[37,100,101],{"id":101},"最后",[11,103,104],{},"我给这事做了个简单的表格记录，朋友说我无药可救，但两个月的曲线摆在眼前，比嘴上的感觉可靠多了。",[11,106,107],{},"暂时记到这，下次接着说。",{"title":15,"searchDepth":16,"depth":17,"links":109},[110,111,112,113,114,115],{"id":39,"depth":16,"text":39},{"id":48,"depth":16,"text":48},{"id":57,"depth":16,"text":57},{"id":69,"depth":16,"text":69},{"id":86,"depth":16,"text":86},{"id":101,"depth":16,"text":101},[117],"生活","2023-05-24",false,{"excerpt":121},{"type":8,"value":122},[123],[11,124,35],{},"\u002Fposts\u002Flife\u002Flate-night-canteen-2",391800,{"title":29,"description":35},"posts\u002Flife\u002Flate-night-canteen-2",[130,131],"夜宵","随笔",[133],"life",1306,"qEBV3AbcMOTzyD46EBMXy8IgwVGGUCTHG1BzxfN4EXs",{"prev":137,"next":140},{"path":138,"title":139},"\u002Fposts\u002Flife\u002Flate-night-canteen","加班晚归后的深夜食堂",{"path":141,"title":142},"\u002Fposts\u002Flife\u002Flate-night-canteen-3","加班晚归后的深夜食堂（三）",[144,153,183],{"id":5,"title":6,"body":145,"createdAt":19,"description":13,"extension":20,"meta":151,"navigation":22,"path":23,"seo":152,"stem":25,"__hash__":26},{"type":8,"value":146,"toc":149},[147],[11,148,13],{},{"title":15,"searchDepth":16,"depth":17,"links":150},[],{},{"description":13},{"id":154,"title":155,"body":156,"createdAt":176,"description":177,"extension":20,"meta":178,"navigation":22,"path":179,"seo":180,"stem":181,"__hash__":182},"notes\u002Fnotes\u002F2026-11-14-1.md","2026 11 14 1",{"type":8,"value":157,"toc":174},[158],[11,159,160,161,165,166,173],{},"站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 ",[162,163,164],"strong",{},"Markdown","，写链接也不用到编辑器：",[167,168,172],"a",{"href":169,"rel":170},"https:\u002F\u002Fcontent.nuxt.com",[171],"nofollow","Nuxt Content","。",{"title":15,"searchDepth":16,"depth":17,"links":175},[],"2026-11-14","站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 Markdown，写链接也不用到编辑器：Nuxt Content。",{},"\u002Fnotes\u002F2026-11-14-1",{"description":177},"notes\u002F2026-11-14-1","LLJX_RKU7cgpT6aHw4DZWUZNQ_G_UzELWPKbksJvzfs",{"id":184,"title":185,"body":186,"createdAt":201,"description":202,"extension":20,"meta":203,"navigation":22,"path":204,"seo":205,"stem":206,"__hash__":207},"notes\u002Fnotes\u002F2026-11-14-2.md","2026 11 14 2",{"type":8,"value":187,"toc":199},[188],[11,189,190,194,195,198],{},[191,192,193],"code",{},"readPixels"," 读不到内容不是 bug，是 ",[191,196,197],{},"preserveDrawingBuffer"," 默认关闭——帧提交后缓冲即被清空。",{"title":15,"searchDepth":16,"depth":17,"links":200},[],"2026-11-13","readPixels 读不到内容不是 bug，是 preserveDrawingBuffer 默认关闭——帧提交后缓冲即被清空。",{},"\u002Fnotes\u002F2026-11-14-2",{"description":202},"notes\u002F2026-11-14-2","i7xWqq2eNoU_seSbLQjqlB9gE51fM-PVLUEYCHBkOA4",1795273156354]