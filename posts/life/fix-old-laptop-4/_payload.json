[{"data":1,"prerenderedAt":208},["ShallowReactive",2],{"notes-latest-1":3,"post:\u002Fposts\u002Flife\u002Ffix-old-laptop-4":27,"surround:\u002Fposts\u002Flife\u002Ffix-old-laptop-4":136,"notes-latest-3":143},[4],{"id":5,"title":6,"body":7,"createdAt":19,"description":13,"extension":20,"meta":21,"navigation":22,"path":23,"seo":24,"stem":25,"__hash__":26},"notes\u002Fnotes\u002F2026-11-14-1-2.md","2026 11 14 1 2",{"type":8,"value":9,"toc":14},"minimark",[10],[11,12,13],"p",{},"站点上线了「随笔」：支持一个文件多个随笔",{"title":15,"searchDepth":16,"depth":17,"links":18},"",2,3,[],"2026-11-17","md",{},true,"\u002Fnotes\u002F2026-11-14-1-2",{"description":13},"notes\u002F2026-11-14-1-2","hDP9fvaunHzVrZQ6QifuOtj9VrqbxlPb_52KE5wSjD0",{"id":28,"title":29,"author":30,"body":31,"categories":116,"comment":22,"cover":30,"createdAt":118,"description":35,"draft":119,"extension":20,"meta":120,"navigation":22,"path":125,"readingTime":126,"recommend":119,"seo":127,"series":30,"stem":128,"tags":129,"top":119,"topics":132,"updatedAt":30,"words":134,"__hash__":135},"posts\u002Fposts\u002Flife\u002Ffix-old-laptop-4.md","给老笔记本续命（四）",null,{"type":8,"value":32,"toc":108},[33,36,40,43,46,49,52,55,58,61,64,67,70,73,76,79,81,84,87,90,93,96,99,102,105],[11,34,35],{},"晚上洗完碗坐下来，忽然想写点什么，就写写这件小事。",[37,38,39],"h2",{"id":39},"检修过程",[11,41,42],{},"家里那台老笔记本服役七年，最近开机风扇的声音像起飞，卡得连网页都刷不动。本着不浪费的原则，周末拆开保养了一下：清灰、换硅脂、加内存、把机械硬盘换成固态，一套下来花了三百块不到。",[11,44,45],{},"拆机比想象中顺利，B 站找了个同型号的拆解视频跟着走，卡扣的地方拍了照片防止装回去时对不上。换固态之后开机从一分多钟变成十几秒，日常刷网页看视频完全够用，效果堪比换新机。",[37,47,48],{"id":48},"一点感悟",[11,50,51],{},"这种动手的乐趣很难跟人解释，撬开后盖那一瞬间和排查出疑难 bug 的快感是同一种，都是把一个说不清的问题变成几个明确的步骤。最后跑了个硬件检测全绿，老伙计又能再战几年。写给同样有旧设备的你：先别急着淘汰，很多\"卡到不能用\"其实只是灰和机械硬盘的问题，几十块的工具加一小时时间，可能有惊喜。",[37,53,54],{"id":54},"记下两点",[11,56,57],{},"跑步前偷懒不做热身，膝盖不舒服了整整一周。现在哪怕时间紧张，也留五分钟活动开，这个时间省不得。",[11,59,60],{},"咖啡粉磨太细，手冲出来又苦又涩还带杂味，一度怀疑是豆子的问题。调粗一格立刻正常，器材和参数的问题，别先怪豆子。",[11,62,63],{},"周末一口气睡到中午，起来反而头昏脑涨。生物钟这东西，补觉补不回来，规律比时长重要，这是身体反复教育我的。",[37,65,66],{"id":66},"多聊两句",[11,68,69],{},"写生活记录这几年有个体会：当时觉得不值得写的小事，事后回看反而是最鲜活的片段。反而是那些酝酿很久想认真写的“大主题”，多数烂在了草稿箱。所以现在我的原则是趁热写，先记下来，好不好以后再说。",[11,71,72],{},"生活里很多烦恼，拆开看其实是信息问题而不是命运问题：不知道怎么挑、不知道怎么做、不知道别人是怎么解决的。而信息问题基本都能靠学习和请教解决，这么一想，很多焦虑就有了着手点。",[11,74,75],{},"独居和成家各有各的修行，我现在的体会是无论哪种状态，把生活的基础盘打理好都是第一位的：睡眠、饮食、居住环境、几个说得上话的朋友。基础盘稳了，其他的变化来了都能接得住。",[11,77,78],{},"成年人的学习和学生时代最大的不同是反馈周期，没人给你打分，效果要几个月甚至几年后才显现。所以坚持的动力只能来自内部：记录对照、阶段复盘、给自己一点小奖励，这些机制比意志力可靠得多。",[11,80,69],{},[37,82,83],{"id":83},"继续聊聊",[11,85,86],{},"讲个题外话，做这类事情的时候最好留个记录的习惯，当时的判断依据比结果更珍贵。结果好可能只是运气好，把决策过程记下来，好运才可能被复制，坏运才可能被规避。",[11,88,89],{},"然后想说，承认不懂是这行的美德。这次遇到不懂的地方，老老实实补了两天的课，比硬着头皮往上糊的方案强太多。不懂装懂的代价从来不会消失，只是延期，还带利息。",[11,91,92],{},"平衡感很重要的一件事：投入和收益的比例。所有优化都值得先问一句，这件事的收益上限是多少，值多少投入。无限打磨一个低价值的东西是工程师最常见的温柔陷阱，包括我自己在内。",[11,94,95],{},"忍不住再夸一下记录的力量，上周刚整理的笔记，这次直接翻出来就用，十分钟解决了当时花一下午的问题。给自己留下的每一份笔记，都是寄给未来的快递，寄件人签收时才觉得真香。",[11,97,98],{},"最后聊点感受：做技术这些年，越来越觉得最好的状态是既投入又抽离。投入是把事情做好，抽离是时不时跳出来看看方向对不对，两者缺一，要么辛苦没产出，要么轻松跑偏路。",[37,100,101],{"id":101},"小结",[11,103,104],{},"整个过程我写成了 checklist，下次照着走一遍就行，果然顺利多了。重复出现的事情就该被固化成流程，工作里如此，生活里也是。",[11,106,107],{},"记录完毕，方便以后自己回来翻。",{"title":15,"searchDepth":16,"depth":17,"links":109},[110,111,112,113,114,115],{"id":39,"depth":16,"text":39},{"id":48,"depth":16,"text":48},{"id":54,"depth":16,"text":54},{"id":66,"depth":16,"text":66},{"id":83,"depth":16,"text":83},{"id":101,"depth":16,"text":101},[117],"生活","2022-07-09",false,{"excerpt":121},{"type":8,"value":122},[123],[11,124,35],{},"\u002Fposts\u002Flife\u002Ffix-old-laptop-4",388200,{"title":29,"description":35},"posts\u002Flife\u002Ffix-old-laptop-4",[130,131],"数码","动手",[133],"life",1294,"Mtp4zAbQ91hefN4Nujw8jymuXO3g8XB6g1qqDBLUYJs",{"prev":137,"next":140},{"path":138,"title":139},"\u002Fposts\u002Flife\u002Ffix-old-laptop-3","给老笔记本续命（三）",{"path":141,"title":142},"\u002Fposts\u002Flife\u002Fhometown-changes","回老家的见闻",[144,153,183],{"id":5,"title":6,"body":145,"createdAt":19,"description":13,"extension":20,"meta":151,"navigation":22,"path":23,"seo":152,"stem":25,"__hash__":26},{"type":8,"value":146,"toc":149},[147],[11,148,13],{},{"title":15,"searchDepth":16,"depth":17,"links":150},[],{},{"description":13},{"id":154,"title":155,"body":156,"createdAt":176,"description":177,"extension":20,"meta":178,"navigation":22,"path":179,"seo":180,"stem":181,"__hash__":182},"notes\u002Fnotes\u002F2026-11-14-1.md","2026 11 14 1",{"type":8,"value":157,"toc":174},[158],[11,159,160,161,165,166,173],{},"站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 ",[162,163,164],"strong",{},"Markdown","，写链接也不用到编辑器：",[167,168,172],"a",{"href":169,"rel":170},"https:\u002F\u002Fcontent.nuxt.com",[171],"nofollow","Nuxt Content","。",{"title":15,"searchDepth":16,"depth":17,"links":175},[],"2026-11-14","站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 Markdown，写链接也不用到编辑器：Nuxt Content。",{},"\u002Fnotes\u002F2026-11-14-1",{"description":177},"notes\u002F2026-11-14-1","LLJX_RKU7cgpT6aHw4DZWUZNQ_G_UzELWPKbksJvzfs",{"id":184,"title":185,"body":186,"createdAt":201,"description":202,"extension":20,"meta":203,"navigation":22,"path":204,"seo":205,"stem":206,"__hash__":207},"notes\u002Fnotes\u002F2026-11-14-2.md","2026 11 14 2",{"type":8,"value":187,"toc":199},[188],[11,189,190,194,195,198],{},[191,192,193],"code",{},"readPixels"," 读不到内容不是 bug，是 ",[191,196,197],{},"preserveDrawingBuffer"," 默认关闭——帧提交后缓冲即被清空。",{"title":15,"searchDepth":16,"depth":17,"links":200},[],"2026-11-13","readPixels 读不到内容不是 bug，是 preserveDrawingBuffer 默认关闭——帧提交后缓冲即被清空。",{},"\u002Fnotes\u002F2026-11-14-2",{"description":202},"notes\u002F2026-11-14-2","i7xWqq2eNoU_seSbLQjqlB9gE51fM-PVLUEYCHBkOA4",1795342434508]