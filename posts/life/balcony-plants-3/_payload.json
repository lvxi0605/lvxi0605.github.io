[{"data":1,"prerenderedAt":212},["ShallowReactive",2],{"notes-latest-1":3,"post:\u002Fposts\u002Flife\u002Fbalcony-plants-3":27,"surround:\u002Fposts\u002Flife\u002Fbalcony-plants-3":140,"notes-latest-3":147},[4],{"id":5,"title":6,"body":7,"createdAt":19,"description":13,"extension":20,"meta":21,"navigation":22,"path":23,"seo":24,"stem":25,"__hash__":26},"notes\u002Fnotes\u002F2026-11-14-1-2.md","2026 11 14 1 2",{"type":8,"value":9,"toc":14},"minimark",[10],[11,12,13],"p",{},"站点上线了「随笔」：支持一个文件多个随笔",{"title":15,"searchDepth":16,"depth":17,"links":18},"",2,3,[],"2026-11-17","md",{},true,"\u002Fnotes\u002F2026-11-14-1-2",{"description":13},"notes\u002F2026-11-14-1-2","hDP9fvaunHzVrZQ6QifuOtj9VrqbxlPb_52KE5wSjD0",{"id":28,"title":29,"author":30,"body":31,"categories":120,"comment":22,"cover":30,"createdAt":122,"description":35,"draft":123,"extension":20,"meta":124,"navigation":22,"path":129,"readingTime":130,"recommend":123,"seo":131,"series":30,"stem":132,"tags":133,"top":123,"topics":136,"updatedAt":30,"words":138,"__hash__":139},"posts\u002Fposts\u002Flife\u002Fbalcony-plants-3.md","阳台上的植物观察日记（三）",null,{"type":8,"value":32,"toc":112},[33,36,40,43,46,53,56,59,62,65,68,71,74,77,80,83,86,88,91,94,97,100,103,106,109],[11,34,35],{},"晚上洗完碗坐下来，忽然想写点什么，就写写这件小事。",[37,38,39],"h2",{"id":39},"这半年的阵容",[11,41,42],{},"阳台现在的阵容：两盆绿萝、一盆薄荷、三盆多肉、一株番茄，还有一把半死不活的迷迭香。半年下来总结出一条铁律，植物的大部分死因是浇水太勤而不是太懒，我爸第一次来我家看了一眼就说，你这绿萝是泡死的吧，当场社死。",[11,44,45],{},"开始记录之后发现植物其实很有规律：薄荷喜水疯长，一周不见就蹿一截，掐尖之后越来越茂盛；多肉恰恰相反，管得越少状态越好；番茄看着柔弱其实最皮实，就是需要晒足太阳，朝向比施肥重要。",[11,47,48],{},[49,50],"img",{"alt":51,"src":52},"阳台上的植物观察日记","\u002Fimg\u002F2.webp",[37,54,55],{"id":55},"慢下来的练习",[11,57,58],{},"养植物给我最大的收获是接受了\"慢\"这个概念。种下番茄苗到结出第一颗果子要两个多月，这中间急不得，能做的就是浇对水、给足光，然后等。这种确定性的等待在工作里反而很稀缺，工作里的事情大部分是急而不可控的。每天早上浇水的十分钟，算是给一天定的一个安静的起始页。顺手拍了几张照片放在这篇里，薄荷长势最好。",[37,60,61],{"id":61},"一点反思",[11,63,64],{},"机械键盘用了大半年没清，按键手感越来越肉，拔键帽一清理，底下灰积了一层。电子产品和房间一样，定期打扫手感完全不同。",[11,66,67],{},"冰箱塞得太满，冷风吹不到后排，最里面的菜悄悄坏掉才发现。留出空隙让空气流通，食物和代码里的缓存一样，堆太满就要出问题。",[11,69,70],{},"手机最近电量崩得快，一顿排查，关掉几个常年后台自启的应用，续航立刻回来。数码产品的衰退，很多时候不是硬件老了，是软件攒的债。",[37,72,73],{"id":73},"顺便一提",[11,75,76],{},"写生活记录这几年有个体会：当时觉得不值得写的小事，事后回看反而是最鲜活的片段。反而是那些酝酿很久想认真写的“大主题”，多数烂在了草稿箱。所以现在我的原则是趁热写，先记下来，好不好以后再说。",[11,78,79],{},"生活里很多烦恼，拆开看其实是信息问题而不是命运问题：不知道怎么挑、不知道怎么做、不知道别人是怎么解决的。而信息问题基本都能靠学习和请教解决，这么一想，很多焦虑就有了着手点。",[11,81,82],{},"独居和成家各有各的修行，我现在的体会是无论哪种状态，把生活的基础盘打理好都是第一位的：睡眠、饮食、居住环境、几个说得上话的朋友。基础盘稳了，其他的变化来了都能接得住。",[11,84,85],{},"成年人的学习和学生时代最大的不同是反馈周期，没人给你打分，效果要几个月甚至几年后才显现。所以坚持的动力只能来自内部：记录对照、阶段复盘、给自己一点小奖励，这些机制比意志力可靠得多。",[11,87,76],{},[37,89,90],{"id":90},"另外记几笔",[11,92,93],{},"忍不住再夸一下记录的力量，上周刚整理的笔记，这次直接翻出来就用，十分钟解决了当时花一下午的问题。给自己留下的每一份笔记，都是寄给未来的快递，寄件人签收时才觉得真香。",[11,95,96],{},"最后聊点感受：做技术这些年，越来越觉得最好的状态是既投入又抽离。投入是把事情做好，抽离是时不时跳出来看看方向对不对，两者缺一，要么辛苦没产出，要么轻松跑偏路。",[11,98,99],{},"写着写着想到，很多技术选择本质上都是在回答同一个问题：这个方案在出问题的时候是什么样子。不出问题的方案人人都写得出来，区分度全在故障时刻的表现。多想一层失败路径，很多纠结就自动有了答案。",[11,101,102],{},"这类经验在文档里通常只有一行字，背后的排查却是一整个下午。技术工作的大部分时间都花在这些不会写进简历的细节里，所以这些细节才更需要有人写出来，哪怕只是给未来某一天忘了的自己。",[37,104,105],{"id":105},"写在最后",[11,107,108],{},"我给这事做了个简单的表格记录，朋友说我无药可救，但两个月的曲线摆在眼前，比嘴上的感觉可靠多了。",[11,110,111],{},"大概就是这些，有不同做法欢迎评论区交流。",{"title":15,"searchDepth":16,"depth":17,"links":113},[114,115,116,117,118,119],{"id":39,"depth":16,"text":39},{"id":55,"depth":16,"text":55},{"id":61,"depth":16,"text":61},{"id":73,"depth":16,"text":73},{"id":90,"depth":16,"text":90},{"id":105,"depth":16,"text":105},[121],"生活","2023-11-26",false,{"excerpt":125},{"type":8,"value":126},[127],[11,128,35],{},"\u002Fposts\u002Flife\u002Fbalcony-plants-3",392700,{"title":29,"description":35},"posts\u002Flife\u002Fbalcony-plants-3",[134,135],"植物","阳台",[137],"life",1309,"CXJ4VImv2Wga2N-_M5nnZYFlzsVUY1ebuXFjDeOtcdo",{"prev":141,"next":144},{"path":142,"title":143},"\u002Fposts\u002Flife\u002Fbalcony-plants-2","阳台上的植物观察日记（二）",{"path":145,"title":146},"\u002Fposts\u002Flife\u002Fbook-essay","散文是最好的睡前读物",[148,157,187],{"id":5,"title":6,"body":149,"createdAt":19,"description":13,"extension":20,"meta":155,"navigation":22,"path":23,"seo":156,"stem":25,"__hash__":26},{"type":8,"value":150,"toc":153},[151],[11,152,13],{},{"title":15,"searchDepth":16,"depth":17,"links":154},[],{},{"description":13},{"id":158,"title":159,"body":160,"createdAt":180,"description":181,"extension":20,"meta":182,"navigation":22,"path":183,"seo":184,"stem":185,"__hash__":186},"notes\u002Fnotes\u002F2026-11-14-1.md","2026 11 14 1",{"type":8,"value":161,"toc":178},[162],[11,163,164,165,169,170,177],{},"站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 ",[166,167,168],"strong",{},"Markdown","，写链接也不用到编辑器：",[171,172,176],"a",{"href":173,"rel":174},"https:\u002F\u002Fcontent.nuxt.com",[175],"nofollow","Nuxt Content","。",{"title":15,"searchDepth":16,"depth":17,"links":179},[],"2026-11-14","站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 Markdown，写链接也不用到编辑器：Nuxt Content。",{},"\u002Fnotes\u002F2026-11-14-1",{"description":181},"notes\u002F2026-11-14-1","LLJX_RKU7cgpT6aHw4DZWUZNQ_G_UzELWPKbksJvzfs",{"id":188,"title":189,"body":190,"createdAt":205,"description":206,"extension":20,"meta":207,"navigation":22,"path":208,"seo":209,"stem":210,"__hash__":211},"notes\u002Fnotes\u002F2026-11-14-2.md","2026 11 14 2",{"type":8,"value":191,"toc":203},[192],[11,193,194,198,199,202],{},[195,196,197],"code",{},"readPixels"," 读不到内容不是 bug，是 ",[195,200,201],{},"preserveDrawingBuffer"," 默认关闭——帧提交后缓冲即被清空。",{"title":15,"searchDepth":16,"depth":17,"links":204},[],"2026-11-13","readPixels 读不到内容不是 bug，是 preserveDrawingBuffer 默认关闭——帧提交后缓冲即被清空。",{},"\u002Fnotes\u002F2026-11-14-2",{"description":206},"notes\u002F2026-11-14-2","i7xWqq2eNoU_seSbLQjqlB9gE51fM-PVLUEYCHBkOA4",1795278774430]