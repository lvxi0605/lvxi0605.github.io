[{"data":1,"prerenderedAt":205},["ShallowReactive",2],{"notes-latest-1":3,"post:\u002Fposts\u002Flife\u002Fnight-run-street-2":27,"surround:\u002Fposts\u002Flife\u002Fnight-run-street-2":133,"notes-latest-3":140},[4],{"id":5,"title":6,"body":7,"createdAt":19,"description":13,"extension":20,"meta":21,"navigation":22,"path":23,"seo":24,"stem":25,"__hash__":26},"notes\u002Fnotes\u002F2026-11-14-1-2.md","2026 11 14 1 2",{"type":8,"value":9,"toc":14},"minimark",[10],[11,12,13],"p",{},"站点上线了「随笔」：支持一个文件多个随笔",{"title":15,"searchDepth":16,"depth":17,"links":18},"",2,3,[],"2026-11-17","md",{},true,"\u002Fnotes\u002F2026-11-14-1-2",{"description":13},"notes\u002F2026-11-14-1-2","hDP9fvaunHzVrZQ6QifuOtj9VrqbxlPb_52KE5wSjD0",{"id":28,"title":29,"author":30,"body":31,"categories":113,"comment":22,"cover":30,"createdAt":115,"description":35,"draft":116,"extension":20,"meta":117,"navigation":22,"path":122,"readingTime":123,"recommend":116,"seo":124,"series":30,"stem":125,"tags":126,"top":116,"topics":129,"updatedAt":30,"words":131,"__hash__":132},"posts\u002Fposts\u002Flife\u002Fnight-run-street-2.md","夜跑时看到的这座城市（二）",null,{"type":8,"value":32,"toc":105},[33,36,40,43,46,49,52,55,58,61,64,67,70,73,76,79,81,84,87,90,93,96,99,102],[11,34,35],{},"最近生活里有些小变化，趁着晚上安静，写两句给自己看。",[37,38,39],"h2",{"id":39},"固定的路线",[11,41,42],{},"夜跑半年，路线固定成一条环线：小区出门沿河步道，过一座桥，穿过一个街心公园，再折回来，五公里出头。这条路线跑熟之后，城市在我这里从地图上的抽象线条变成了具体的场景序列：桥上能看到远处写字楼灯还亮着的窗口，公园里每晚七点半准时响起的广场舞音乐，河对岸夜市支摊的烟火。",[11,44,45],{},"跑者的视角和走路开车都不一样，速度刚好够看清又不至于走神，五公里里能看尽一座城市的傍晚到夜晚。",[37,47,48],{"id":48},"夜跑的众生",[11,50,51],{},"跑道上能认出不少熟面孔：穿荧光绿外套的大爷配速比我快、一对每天十点的情侣跑者、遛狗顺便慢跑的中年人。大家不说话，但擦肩时会互相点个头，这种陌生人之间的轻默契很微妙。有一次下小雨没停跑，路上只剩我一个，那种整条路被自己包场的感觉，既孤独又奢侈。跑步这件事给我的远不止体重的变化，这篇记下来，也算给这半年一个交代。",[37,53,54],{"id":54},"记下两点",[11,56,57],{},"跑步前偷懒不做热身，膝盖不舒服了整整一周。现在哪怕时间紧张，也留五分钟活动开，这个时间省不得。",[11,59,60],{},"咖啡粉磨太细，手冲出来又苦又涩还带杂味，一度怀疑是豆子的问题。调粗一格立刻正常，器材和参数的问题，别先怪豆子。",[11,62,63],{},"周末一口气睡到中午，起来反而头昏脑涨。生物钟这东西，补觉补不回来，规律比时长重要，这是身体反复教育我的。",[37,65,66],{"id":66},"多聊两句",[11,68,69],{},"写生活记录这几年有个体会：当时觉得不值得写的小事，事后回看反而是最鲜活的片段。反而是那些酝酿很久想认真写的“大主题”，多数烂在了草稿箱。所以现在我的原则是趁热写，先记下来，好不好以后再说。",[11,71,72],{},"生活里很多烦恼，拆开看其实是信息问题而不是命运问题：不知道怎么挑、不知道怎么做、不知道别人是怎么解决的。而信息问题基本都能靠学习和请教解决，这么一想，很多焦虑就有了着手点。",[11,74,75],{},"独居和成家各有各的修行，我现在的体会是无论哪种状态，把生活的基础盘打理好都是第一位的：睡眠、饮食、居住环境、几个说得上话的朋友。基础盘稳了，其他的变化来了都能接得住。",[11,77,78],{},"成年人的学习和学生时代最大的不同是反馈周期，没人给你打分，效果要几个月甚至几年后才显现。所以坚持的动力只能来自内部：记录对照、阶段复盘、给自己一点小奖励，这些机制比意志力可靠得多。",[11,80,69],{},[37,82,83],{"id":83},"继续聊聊",[11,85,86],{},"其实回看这些年踩的坑，大坑几乎都和贪快有关。快不是错，错的是想跳过必要步骤的快，地基没打牢盖得越快塌得越响。慢下来把该做的做扎实，反而是最快的路径，这话说了很多年，每次验证都对。",[11,88,89],{},"有个观察分享给大家：技术的成长曲线不是线性的，是一段平台加一次跃迁。平台期最磨人，感觉学了很多没进步，其实是在攒素材，攒够了某个契机一到就突飞猛进。所以在平台期别否定自己，那是跃迁的前奏。",[11,91,92],{},"再补充一个角度：做这些事情的时候，工具的顺滑度影响巨大。同样的活，称手的工具能让摩擦力小一半，这种差异日积月累就是人和人的差距。定期审视自己的工具链，删掉碍事的，补上趁手的，值得当成一个固定动作。",[11,94,95],{},"由这件事联想到阅读习惯：资料要看一手来源，译文和二手转述经常带着传播者的理解偏差，偏差叠几层之后和原意面目全非。多花十分钟读原文，省下的是未来几小时的排查，这笔账怎么算都划算。",[37,97,98],{"id":98},"写在最后",[11,100,101],{},"我给这事做了个简单的表格记录，朋友说我无药可救，但两个月的曲线摆在眼前，比嘴上的感觉可靠多了。",[11,103,104],{},"记录完毕，方便以后自己回来翻。",{"title":15,"searchDepth":16,"depth":17,"links":106},[107,108,109,110,111,112],{"id":39,"depth":16,"text":39},{"id":48,"depth":16,"text":48},{"id":54,"depth":16,"text":54},{"id":66,"depth":16,"text":66},{"id":83,"depth":16,"text":83},{"id":98,"depth":16,"text":98},[114],"生活","2024-12-02",false,{"excerpt":118},{"type":8,"value":119},[120],[11,121,35],{},"\u002Fposts\u002Flife\u002Fnight-run-street-2",386700,{"title":29,"description":35},"posts\u002Flife\u002Fnight-run-street-2",[127,128],"夜跑","城市",[130],"life",1289,"NvAiW9z9Upq__ArumCpx3QxBrL9DzVgKHo0GvQnS198",{"prev":134,"next":137},{"path":135,"title":136},"\u002Fposts\u002Flife\u002Fnight-run-street","夜跑时看到的这座城市",{"path":138,"title":139},"\u002Fposts\u002Flife\u002Fnight-run-street-3","夜跑时看到的这座城市（三）",[141,150,180],{"id":5,"title":6,"body":142,"createdAt":19,"description":13,"extension":20,"meta":148,"navigation":22,"path":23,"seo":149,"stem":25,"__hash__":26},{"type":8,"value":143,"toc":146},[144],[11,145,13],{},{"title":15,"searchDepth":16,"depth":17,"links":147},[],{},{"description":13},{"id":151,"title":152,"body":153,"createdAt":173,"description":174,"extension":20,"meta":175,"navigation":22,"path":176,"seo":177,"stem":178,"__hash__":179},"notes\u002Fnotes\u002F2026-11-14-1.md","2026 11 14 1",{"type":8,"value":154,"toc":171},[155],[11,156,157,158,162,163,170],{},"站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 ",[159,160,161],"strong",{},"Markdown","，写链接也不用到编辑器：",[164,165,169],"a",{"href":166,"rel":167},"https:\u002F\u002Fcontent.nuxt.com",[168],"nofollow","Nuxt Content","。",{"title":15,"searchDepth":16,"depth":17,"links":172},[],"2026-11-14","站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 Markdown，写链接也不用到编辑器：Nuxt Content。",{},"\u002Fnotes\u002F2026-11-14-1",{"description":174},"notes\u002F2026-11-14-1","LLJX_RKU7cgpT6aHw4DZWUZNQ_G_UzELWPKbksJvzfs",{"id":181,"title":182,"body":183,"createdAt":198,"description":199,"extension":20,"meta":200,"navigation":22,"path":201,"seo":202,"stem":203,"__hash__":204},"notes\u002Fnotes\u002F2026-11-14-2.md","2026 11 14 2",{"type":8,"value":184,"toc":196},[185],[11,186,187,191,192,195],{},[188,189,190],"code",{},"readPixels"," 读不到内容不是 bug，是 ",[188,193,194],{},"preserveDrawingBuffer"," 默认关闭——帧提交后缓冲即被清空。",{"title":15,"searchDepth":16,"depth":17,"links":197},[],"2026-11-13","readPixels 读不到内容不是 bug，是 preserveDrawingBuffer 默认关闭——帧提交后缓冲即被清空。",{},"\u002Fnotes\u002F2026-11-14-2",{"description":199},"notes\u002F2026-11-14-2","i7xWqq2eNoU_seSbLQjqlB9gE51fM-PVLUEYCHBkOA4",1795273157064]