[{"data":1,"prerenderedAt":203},["ShallowReactive",2],{"notes-latest-1":3,"post:\u002Fposts\u002Flife\u002Fnight-run-street-3":27,"surround:\u002Fposts\u002Flife\u002Fnight-run-street-3":131,"notes-latest-3":138},[4],{"id":5,"title":6,"body":7,"createdAt":19,"description":13,"extension":20,"meta":21,"navigation":22,"path":23,"seo":24,"stem":25,"__hash__":26},"notes\u002Fnotes\u002F2026-11-14-1-2.md","2026 11 14 1 2",{"type":8,"value":9,"toc":14},"minimark",[10],[11,12,13],"p",{},"站点上线了「随笔」：支持一个文件多个随笔",{"title":15,"searchDepth":16,"depth":17,"links":18},"",2,3,[],"2026-11-17","md",{},true,"\u002Fnotes\u002F2026-11-14-1-2",{"description":13},"notes\u002F2026-11-14-1-2","hDP9fvaunHzVrZQ6QifuOtj9VrqbxlPb_52KE5wSjD0",{"id":28,"title":29,"author":30,"body":31,"categories":111,"comment":22,"cover":30,"createdAt":113,"description":35,"draft":114,"extension":20,"meta":115,"navigation":22,"path":120,"readingTime":121,"recommend":114,"seo":122,"series":30,"stem":123,"tags":124,"top":114,"topics":127,"updatedAt":30,"words":129,"__hash__":130},"posts\u002Fposts\u002Flife\u002Fnight-run-street-3.md","夜跑时看到的这座城市（三）",null,{"type":8,"value":32,"toc":103},[33,36,40,43,46,49,52,55,58,61,64,67,70,73,76,79,82,85,88,91,94,97,100],[11,34,35],{},"这篇没有代码，纯记录生活，技术同学可以直接跳过，开玩笑的，看完也许有点别的收获。",[37,38,39],"h2",{"id":39},"固定的路线",[11,41,42],{},"夜跑半年，路线固定成一条环线：小区出门沿河步道，过一座桥，穿过一个街心公园，再折回来，五公里出头。这条路线跑熟之后，城市在我这里从地图上的抽象线条变成了具体的场景序列：桥上能看到远处写字楼灯还亮着的窗口，公园里每晚七点半准时响起的广场舞音乐，河对岸夜市支摊的烟火。",[11,44,45],{},"跑者的视角和走路开车都不一样，速度刚好够看清又不至于走神，五公里里能看尽一座城市的傍晚到夜晚。",[37,47,48],{"id":48},"夜跑的众生",[11,50,51],{},"跑道上能认出不少熟面孔：穿荧光绿外套的大爷配速比我快、一对每天十点的情侣跑者、遛狗顺便慢跑的中年人。大家不说话，但擦肩时会互相点个头，这种陌生人之间的轻默契很微妙。有一次下小雨没停跑，路上只剩我一个，那种整条路被自己包场的感觉，既孤独又奢侈。跑步这件事给我的远不止体重的变化，这篇记下来，也算给这半年一个交代。",[37,53,54],{"id":54},"记下两点",[11,56,57],{},"搬家时纸箱没标注，晚上要找充电器，十几个箱子翻到半夜。后来每个箱子外面用马克笔写清楚内容和房间，下次搬家的自己会感谢现在的自己。",[11,59,60],{},"机械键盘用了大半年没清，按键手感越来越肉，拔键帽一清理，底下灰积了一层。电子产品和房间一样，定期打扫手感完全不同。",[11,62,63],{},"冰箱塞得太满，冷风吹不到后排，最里面的菜悄悄坏掉才发现。留出空隙让空气流通，食物和代码里的缓存一样，堆太满就要出问题。",[37,65,66],{"id":66},"多聊两句",[11,68,69],{},"独居和成家各有各的修行，我现在的体会是无论哪种状态，把生活的基础盘打理好都是第一位的：睡眠、饮食、居住环境、几个说得上话的朋友。基础盘稳了，其他的变化来了都能接得住。",[11,71,72],{},"成年人的学习和学生时代最大的不同是反馈周期，没人给你打分，效果要几个月甚至几年后才显现。所以坚持的动力只能来自内部：记录对照、阶段复盘、给自己一点小奖励，这些机制比意志力可靠得多。",[11,74,75],{},"写生活记录这几年有个体会：当时觉得不值得写的小事，事后回看反而是最鲜活的片段。反而是那些酝酿很久想认真写的“大主题”，多数烂在了草稿箱。所以现在我的原则是趁热写，先记下来，好不好以后再说。",[11,77,78],{},"生活里很多烦恼，拆开看其实是信息问题而不是命运问题：不知道怎么挑、不知道怎么做、不知道别人是怎么解决的。而信息问题基本都能靠学习和请教解决，这么一想，很多焦虑就有了着手点。",[37,80,81],{"id":81},"继续聊聊",[11,83,84],{},"再补充一个角度：做这些事情的时候，工具的顺滑度影响巨大。同样的活，称手的工具能让摩擦力小一半，这种差异日积月累就是人和人的差距。定期审视自己的工具链，删掉碍事的，补上趁手的，值得当成一个固定动作。",[11,86,87],{},"由这件事联想到阅读习惯：资料要看一手来源，译文和二手转述经常带着传播者的理解偏差，偏差叠几层之后和原意面目全非。多花十分钟读原文，省下的是未来几小时的排查，这笔账怎么算都划算。",[11,89,90],{},"还有个感受越来越深：知识落地成文字的过程本身就是学习的一部分。很多自以为想清楚的东西，写出来才发现逻辑有洞。写作是最好的检验，这也是坚持写博客这么多年的理由之一，写不出来的就是还没学会的。",[11,92,93],{},"过程中也反复体会到取舍的本质：没有完美的方案，只有当下约束下最合适的方案。把约束写清楚，方案的选择题就变成了证明题，这也是为什么我习惯先列约束再谈方案，顺序反了全是无效争论。",[37,95,96],{"id":96},"写在最后",[11,98,99],{},"搞技术久了习惯找根因，生活里的很多问题其实也适用：先定位，再动手，别一上来就凭感觉乱试。",[11,101,102],{},"以上，一点心得，有说得不对的欢迎指正。",{"title":15,"searchDepth":16,"depth":17,"links":104},[105,106,107,108,109,110],{"id":39,"depth":16,"text":39},{"id":48,"depth":16,"text":48},{"id":54,"depth":16,"text":54},{"id":66,"depth":16,"text":66},{"id":81,"depth":16,"text":81},{"id":96,"depth":16,"text":96},[112],"生活","2022-10-19",false,{"excerpt":116},{"type":8,"value":117},[118],[11,119,35],{},"\u002Fposts\u002Flife\u002Fnight-run-street-3",372600,{"title":29,"description":35},"posts\u002Flife\u002Fnight-run-street-3",[125,126],"夜跑","城市",[128],"life",1242,"_CwZHVyat3Ise_6PHSk55iN0LJbocDbFBbV_VL9Jffk",{"prev":132,"next":135},{"path":133,"title":134},"\u002Fposts\u002Flife\u002Fnight-run-street-2","夜跑时看到的这座城市（二）",{"path":136,"title":137},"\u002Fposts\u002Flife\u002Fnight-run-street-4","夜跑时看到的这座城市（四）",[139,148,178],{"id":5,"title":6,"body":140,"createdAt":19,"description":13,"extension":20,"meta":146,"navigation":22,"path":23,"seo":147,"stem":25,"__hash__":26},{"type":8,"value":141,"toc":144},[142],[11,143,13],{},{"title":15,"searchDepth":16,"depth":17,"links":145},[],{},{"description":13},{"id":149,"title":150,"body":151,"createdAt":171,"description":172,"extension":20,"meta":173,"navigation":22,"path":174,"seo":175,"stem":176,"__hash__":177},"notes\u002Fnotes\u002F2026-11-14-1.md","2026 11 14 1",{"type":8,"value":152,"toc":169},[153],[11,154,155,156,160,161,168],{},"站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 ",[157,158,159],"strong",{},"Markdown","，写链接也不用到编辑器：",[162,163,167],"a",{"href":164,"rel":165},"https:\u002F\u002Fcontent.nuxt.com",[166],"nofollow","Nuxt Content","。",{"title":15,"searchDepth":16,"depth":17,"links":170},[],"2026-11-14","站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 Markdown，写链接也不用到编辑器：Nuxt Content。",{},"\u002Fnotes\u002F2026-11-14-1",{"description":172},"notes\u002F2026-11-14-1","LLJX_RKU7cgpT6aHw4DZWUZNQ_G_UzELWPKbksJvzfs",{"id":179,"title":180,"body":181,"createdAt":196,"description":197,"extension":20,"meta":198,"navigation":22,"path":199,"seo":200,"stem":201,"__hash__":202},"notes\u002Fnotes\u002F2026-11-14-2.md","2026 11 14 2",{"type":8,"value":182,"toc":194},[183],[11,184,185,189,190,193],{},[186,187,188],"code",{},"readPixels"," 读不到内容不是 bug，是 ",[186,191,192],{},"preserveDrawingBuffer"," 默认关闭——帧提交后缓冲即被清空。",{"title":15,"searchDepth":16,"depth":17,"links":195},[],"2026-11-13","readPixels 读不到内容不是 bug，是 preserveDrawingBuffer 默认关闭——帧提交后缓冲即被清空。",{},"\u002Fnotes\u002F2026-11-14-2",{"description":197},"notes\u002F2026-11-14-2","i7xWqq2eNoU_seSbLQjqlB9gE51fM-PVLUEYCHBkOA4",1795707444618]