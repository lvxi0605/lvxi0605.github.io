[{"data":1,"prerenderedAt":203},["ShallowReactive",2],{"notes-latest-1":3,"post:\u002Fposts\u002Flife\u002Fbook-psychology-2":27,"surround:\u002Fposts\u002Flife\u002Fbook-psychology-2":131,"notes-latest-3":138},[4],{"id":5,"title":6,"body":7,"createdAt":19,"description":13,"extension":20,"meta":21,"navigation":22,"path":23,"seo":24,"stem":25,"__hash__":26},"notes\u002Fnotes\u002F2026-11-14-1-2.md","2026 11 14 1 2",{"type":8,"value":9,"toc":14},"minimark",[10],[11,12,13],"p",{},"站点上线了「随笔」：支持一个文件多个随笔",{"title":15,"searchDepth":16,"depth":17,"links":18},"",2,3,[],"2026-11-17","md",{},true,"\u002Fnotes\u002F2026-11-14-1-2",{"description":13},"notes\u002F2026-11-14-1-2","hDP9fvaunHzVrZQ6QifuOtj9VrqbxlPb_52KE5wSjD0",{"id":28,"title":29,"author":30,"body":31,"categories":111,"comment":22,"cover":30,"createdAt":113,"description":35,"draft":114,"extension":20,"meta":115,"navigation":22,"path":120,"readingTime":121,"recommend":114,"seo":122,"series":30,"stem":123,"tags":124,"top":114,"topics":127,"updatedAt":30,"words":129,"__hash__":130},"posts\u002Fposts\u002Flife\u002Fbook-psychology-2.md","心理学入门读物推荐（二）",null,{"type":8,"value":32,"toc":103},[33,36,40,43,46,49,52,55,58,61,64,67,70,73,76,79,82,85,88,91,94,97,100],[11,34,35],{},"周末闲下来，想把这件事记一笔，没什么技术含量，就是觉得有点意思，不写下来可惜。",[37,38,39],"h2",{"id":39},"为什么读心理学",[11,41,42],{},"读心理学入门书的契机是那阵子状态不太好，容易焦虑，想找点方法。真正读进去之后发现，心理学给我的不只是情绪管理技巧，更是一套理解自己行为的框架：为什么拖延、为什么明知不对还反复做某件事、为什么和人沟通总在同一个点上卡壳，这些以前归因于性格的东西，很多有清晰的机制解释。",[11,44,45],{},"入门我踩过的坑是书没选对，畅销书里掺着大量伪心理学，看起来有道理但经不起推敲。后来学会先看作者背景和参考文献，才慢慢摸到靠谱的书单。",[37,47,48],{"id":48},"两本推荐",[11,50,51],{},"推荐两本亲测有效的：一本是讲认知偏差的，读完会对自己脑子里的自动反应多一分警惕，情绪上头时能有个暂停键；另一本是讲习惯养成的，把行为拆成触发、动作、奖励三段来设计，我用它重构了自己的睡前流程，比靠意志力靠谱太多。提醒一句，入门读物解决不了严重的问题，该求助专业人士时别硬扛，读书和就医是两回事。读完最大的变化是对自己宽容了一点，很多\"毛病\"其实是大脑的出厂设置，理解了就不那么自责了。",[37,53,54],{"id":54},"一点反思",[11,56,57],{},"剩菜以前是等凉透再进冰箱，被科普之后才知道要尽快冷藏，细菌繁殖的窗口期比想象中短。生活里很多想当然的习惯，较真起来都有另一套答案。",[11,59,60],{},"随手记两个小教训：阳台那盆绿萝浇得太勤，根都泡烂了，剪掉烂的部分重新扦插，现在改了策略，土干了再浇，反倒精神了不少。",[11,62,63],{},"煮饭水放多了，成品介于饭和粥之间。后来老老实实用量杯，或者直接看水位线，凭感觉这种事，在厨房里基本靠不住。",[37,65,66],{"id":66},"顺便一提",[11,68,69],{},"独居和成家各有各的修行，我现在的体会是无论哪种状态，把生活的基础盘打理好都是第一位的：睡眠、饮食、居住环境、几个说得上话的朋友。基础盘稳了，其他的变化来了都能接得住。",[11,71,72],{},"成年人的学习和学生时代最大的不同是反馈周期，没人给你打分，效果要几个月甚至几年后才显现。所以坚持的动力只能来自内部：记录对照、阶段复盘、给自己一点小奖励，这些机制比意志力可靠得多。",[11,74,75],{},"写生活记录这几年有个体会：当时觉得不值得写的小事，事后回看反而是最鲜活的片段。反而是那些酝酿很久想认真写的“大主题”，多数烂在了草稿箱。所以现在我的原则是趁热写，先记下来，好不好以后再说。",[11,77,78],{},"生活里很多烦恼，拆开看其实是信息问题而不是命运问题：不知道怎么挑、不知道怎么做、不知道别人是怎么解决的。而信息问题基本都能靠学习和请教解决，这么一想，很多焦虑就有了着手点。",[37,80,81],{"id":81},"另外记几笔",[11,83,84],{},"有时候会想，学一门新技术到底学到的是什么。语法和 API 会过时，真正的收获是它看问题的角度。多一门语言就多一副眼镜，同一副牌桌，能看到别人看不到的牌路，这是这么多年折腾下来最确定的回报。",[11,86,87],{},"记一个产生过的动摇：做到一半觉得这玩意儿是不是没什么意义。后来想通了，意义不是事情自带的，是你把它做完并沉淀下来之后长出来的。烂尾的才真的没意义，做完的最差也是一篇笔记。",[11,89,90],{},"顺便说说协作里的体会：这类事自己闷头做效率最高，但闷头做完往往返工最多。适度地提前同步，把方向先对齐，看似慢了半天，实际省掉的是几天的返工。沟通的时机比沟通的技巧更值得琢磨。",[11,92,93],{},"其实回看这些年踩的坑，大坑几乎都和贪快有关。快不是错，错的是想跳过必要步骤的快，地基没打牢盖得越快塌得越响。慢下来把该做的做扎实，反而是最快的路径，这话说了很多年，每次验证都对。",[37,95,96],{"id":96},"写在最后",[11,98,99],{},"我把这件事当成一个小需求来管理，明确了目标和验收标准，中途改了两次方案，最后的效果自己挺满意。",[11,101,102],{},"这篇就先这样，想到了什么再回来补。",{"title":15,"searchDepth":16,"depth":17,"links":104},[105,106,107,108,109,110],{"id":39,"depth":16,"text":39},{"id":48,"depth":16,"text":48},{"id":54,"depth":16,"text":54},{"id":66,"depth":16,"text":66},{"id":81,"depth":16,"text":81},{"id":96,"depth":16,"text":96},[112],"读书","2026-10-19",false,{"excerpt":116},{"type":8,"value":117},[118],[11,119,35],{},"\u002Fposts\u002Flife\u002Fbook-psychology-2",382500,{"title":29,"description":35},"posts\u002Flife\u002Fbook-psychology-2",[125,126],"心理学","书单",[128],"life",1275,"rq7LFyDE0PNHw9ud8spPjf4ULfHgaS3CetYiFeYA6Xo",{"prev":132,"next":135},{"path":133,"title":134},"\u002Fposts\u002Flife\u002Fbook-psychology","心理学入门读物推荐",{"path":136,"title":137},"\u002Fposts\u002Flife\u002Fbook-psychology-3","心理学入门读物推荐（三）",[139,148,178],{"id":5,"title":6,"body":140,"createdAt":19,"description":13,"extension":20,"meta":146,"navigation":22,"path":23,"seo":147,"stem":25,"__hash__":26},{"type":8,"value":141,"toc":144},[142],[11,143,13],{},{"title":15,"searchDepth":16,"depth":17,"links":145},[],{},{"description":13},{"id":149,"title":150,"body":151,"createdAt":171,"description":172,"extension":20,"meta":173,"navigation":22,"path":174,"seo":175,"stem":176,"__hash__":177},"notes\u002Fnotes\u002F2026-11-14-1.md","2026 11 14 1",{"type":8,"value":152,"toc":169},[153],[11,154,155,156,160,161,168],{},"站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 ",[157,158,159],"strong",{},"Markdown","，写链接也不用到编辑器：",[162,163,167],"a",{"href":164,"rel":165},"https:\u002F\u002Fcontent.nuxt.com",[166],"nofollow","Nuxt Content","。",{"title":15,"searchDepth":16,"depth":17,"links":170},[],"2026-11-14","站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 Markdown，写链接也不用到编辑器：Nuxt Content。",{},"\u002Fnotes\u002F2026-11-14-1",{"description":172},"notes\u002F2026-11-14-1","LLJX_RKU7cgpT6aHw4DZWUZNQ_G_UzELWPKbksJvzfs",{"id":179,"title":180,"body":181,"createdAt":196,"description":197,"extension":20,"meta":198,"navigation":22,"path":199,"seo":200,"stem":201,"__hash__":202},"notes\u002Fnotes\u002F2026-11-14-2.md","2026 11 14 2",{"type":8,"value":182,"toc":194},[183],[11,184,185,189,190,193],{},[186,187,188],"code",{},"readPixels"," 读不到内容不是 bug，是 ",[186,191,192],{},"preserveDrawingBuffer"," 默认关闭——帧提交后缓冲即被清空。",{"title":15,"searchDepth":16,"depth":17,"links":195},[],"2026-11-13","readPixels 读不到内容不是 bug，是 preserveDrawingBuffer 默认关闭——帧提交后缓冲即被清空。",{},"\u002Fnotes\u002F2026-11-14-2",{"description":197},"notes\u002F2026-11-14-2","i7xWqq2eNoU_seSbLQjqlB9gE51fM-PVLUEYCHBkOA4",1795275923685]