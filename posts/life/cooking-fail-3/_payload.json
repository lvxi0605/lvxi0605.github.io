[{"data":1,"prerenderedAt":209},["ShallowReactive",2],{"notes-latest-1":3,"post:\u002Fposts\u002Flife\u002Fcooking-fail-3":27,"surround:\u002Fposts\u002Flife\u002Fcooking-fail-3":137,"notes-latest-3":144},[4],{"id":5,"title":6,"body":7,"createdAt":19,"description":13,"extension":20,"meta":21,"navigation":22,"path":23,"seo":24,"stem":25,"__hash__":26},"notes\u002Fnotes\u002F2026-11-14-1-2.md","2026 11 14 1 2",{"type":8,"value":9,"toc":14},"minimark",[10],[11,12,13],"p",{},"站点上线了「随笔」：支持一个文件多个随笔",{"title":15,"searchDepth":16,"depth":17,"links":18},"",2,3,[],"2026-11-17","md",{},true,"\u002Fnotes\u002F2026-11-14-1-2",{"description":13},"notes\u002F2026-11-14-1-2","hDP9fvaunHzVrZQ6QifuOtj9VrqbxlPb_52KE5wSjD0",{"id":28,"title":29,"author":30,"body":31,"categories":117,"comment":22,"cover":30,"createdAt":119,"description":35,"draft":120,"extension":20,"meta":121,"navigation":22,"path":126,"readingTime":127,"recommend":120,"seo":128,"series":30,"stem":129,"tags":130,"top":120,"topics":133,"updatedAt":30,"words":135,"__hash__":136},"posts\u002Fposts\u002Flife\u002Fcooking-fail-3.md","做饭翻车实录三则（三）",null,{"type":8,"value":32,"toc":109},[33,36,41,44,47,50,53,56,59,62,65,68,71,74,77,80,83,85,88,91,94,97,100,103,106],[11,34,35],{},"周末闲下来，想把这件事记一笔，没什么技术含量，就是觉得有点意思，不写下来可惜。",[37,38,40],"h2",{"id":39},"翻车一糖盐之争","翻车一：糖盐之争",[11,42,43],{},"第一则，把盐当成糖放进了红烧肉。当时在做别的事，调料盒随手一拿，出锅尝了一口就明白了，一锅肉咸得离谱，兑水救不回来，最后加土豆加豆腐硬是吃完了。教训是调料盒上贴了标签，看似多此一举，实际救过我好几次。",[11,45,46],{},"第二则，油炸忘了控制油温，下锅的鸡翅外面糊了里面还是生的。拿着温度计复测之后才发现，油温这个东西，用眼睛看泡沫真的不准。",[37,48,49],{"id":49},"翻车三与总结",[11,51,52],{},"第三则最离谱，蒸鸡蛋羹忘了盖保鲜膜，水汽滴进去，出来一个月球表面。后来学乖了，盖膜扎孔中火蒸，嫩得像布丁。",[11,54,55],{},"把三次翻车写出来其实想说一件事：做饭和写代码太像了，都是流程加参数，翻车都有明确的根因，复现一次基本就根治了。现在的我翻车率大幅下降，家里领导评价\"从不敢恭维到可以入口\"，这个进步曲线我非常满意。",[37,57,58],{"id":58},"过程中的小心得",[11,60,61],{},"新买的锅没开锅就上灶，第一条鱼皮粘得惨不忍睹。老老实实开了锅，热锅凉油，之后煎什么都利索。工具要有工具的仪式，这道理在厨房通用。",[11,63,64],{},"出门忘带钥匙，蹲在门口等开锁师傅，等了一小时花了一百五。现在门口的暗格放了备用钥匙，出门摸一下口袋成了肌肉记忆。",[11,66,67],{},"健身房年卡办完去了一次半，钱花得毫无水花。后来改成按次买，反而每周都去。消费习惯这件事，沉没成本越高越不想动，适合别人的不一定适合自己。",[37,69,70],{"id":70},"延伸几句",[11,72,73],{},"独居和成家各有各的修行，我现在的体会是无论哪种状态，把生活的基础盘打理好都是第一位的：睡眠、饮食、居住环境、几个说得上话的朋友。基础盘稳了，其他的变化来了都能接得住。",[11,75,76],{},"成年人的学习和学生时代最大的不同是反馈周期，没人给你打分，效果要几个月甚至几年后才显现。所以坚持的动力只能来自内部：记录对照、阶段复盘、给自己一点小奖励，这些机制比意志力可靠得多。",[11,78,79],{},"写生活记录这几年有个体会：当时觉得不值得写的小事，事后回看反而是最鲜活的片段。反而是那些酝酿很久想认真写的“大主题”，多数烂在了草稿箱。所以现在我的原则是趁热写，先记下来，好不好以后再说。",[11,81,82],{},"生活里很多烦恼，拆开看其实是信息问题而不是命运问题：不知道怎么挑、不知道怎么做、不知道别人是怎么解决的。而信息问题基本都能靠学习和请教解决，这么一想，很多焦虑就有了着手点。",[11,84,73],{},[37,86,87],{"id":87},"又想到一些",[11,89,90],{},"另外觉得这件事里有个普遍适用的规律：复杂度不会消失，只会转移。你省掉的每一步设计，最后都会在排查、扩容或者交接的某个时刻加倍还回来。所谓好的方案，不过是把复杂度放到了值得的位置。",[11,92,93],{},"回顾这个过程，最大的教训其实是克制。可选项永远比需要的多，每个新方案看起来都比现状好一点，但都加上之后，系统就成了没人看得懂的拼贴画。做减法的判断比做加法的胆子更值钱。",[11,95,96],{},"这种事急不来，和锻炼身体是一个道理：练一天没变化，练三个月身体自己会说话。技术积累也是这样，每天一点，回过头看的时候差距已经拉开了，只是身在其中感觉不到而已。",[11,98,99],{},"想到一个问题：为什么同样的事情，不同的人做出来差别那么大。后来觉得答案在于对边界的处理，正常路径人人会写，边界和异常的处理习惯才是拉开差距的地方。做事和写代码一样，细节的密度决定成品的质量。",[37,101,102],{"id":102},"最后",[11,104,105],{},"我把这件事当成一个小需求来管理，明确了目标和验收标准，中途改了两次方案，最后的效果自己挺满意。",[11,107,108],{},"记录完毕，方便以后自己回来翻。",{"title":15,"searchDepth":16,"depth":17,"links":110},[111,112,113,114,115,116],{"id":39,"depth":16,"text":40},{"id":49,"depth":16,"text":49},{"id":58,"depth":16,"text":58},{"id":70,"depth":16,"text":70},{"id":87,"depth":16,"text":87},{"id":102,"depth":16,"text":102},[118],"生活","2024-07-14",false,{"excerpt":122},{"type":8,"value":123},[124],[11,125,35],{},"\u002Fposts\u002Flife\u002Fcooking-fail-3",383700,{"title":29,"description":35},"posts\u002Flife\u002Fcooking-fail-3",[131,132],"做饭","翻车",[134],"life",1279,"ot4UGTym3AuyXOjAyb0H8-3-1DhsooaDHfkifQEgVhE",{"prev":138,"next":141},{"path":139,"title":140},"\u002Fposts\u002Flife\u002Fcooking-fail-2","做饭翻车实录三则（二）",{"path":142,"title":143},"\u002Fposts\u002Flife\u002Ffix-old-laptop","给老笔记本续命",[145,154,184],{"id":5,"title":6,"body":146,"createdAt":19,"description":13,"extension":20,"meta":152,"navigation":22,"path":23,"seo":153,"stem":25,"__hash__":26},{"type":8,"value":147,"toc":150},[148],[11,149,13],{},{"title":15,"searchDepth":16,"depth":17,"links":151},[],{},{"description":13},{"id":155,"title":156,"body":157,"createdAt":177,"description":178,"extension":20,"meta":179,"navigation":22,"path":180,"seo":181,"stem":182,"__hash__":183},"notes\u002Fnotes\u002F2026-11-14-1.md","2026 11 14 1",{"type":8,"value":158,"toc":175},[159],[11,160,161,162,166,167,174],{},"站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 ",[163,164,165],"strong",{},"Markdown","，写链接也不用到编辑器：",[168,169,173],"a",{"href":170,"rel":171},"https:\u002F\u002Fcontent.nuxt.com",[172],"nofollow","Nuxt Content","。",{"title":15,"searchDepth":16,"depth":17,"links":176},[],"2026-11-14","站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 Markdown，写链接也不用到编辑器：Nuxt Content。",{},"\u002Fnotes\u002F2026-11-14-1",{"description":178},"notes\u002F2026-11-14-1","LLJX_RKU7cgpT6aHw4DZWUZNQ_G_UzELWPKbksJvzfs",{"id":185,"title":186,"body":187,"createdAt":202,"description":203,"extension":20,"meta":204,"navigation":22,"path":205,"seo":206,"stem":207,"__hash__":208},"notes\u002Fnotes\u002F2026-11-14-2.md","2026 11 14 2",{"type":8,"value":188,"toc":200},[189],[11,190,191,195,196,199],{},[192,193,194],"code",{},"readPixels"," 读不到内容不是 bug，是 ",[192,197,198],{},"preserveDrawingBuffer"," 默认关闭——帧提交后缓冲即被清空。",{"title":15,"searchDepth":16,"depth":17,"links":201},[],"2026-11-13","readPixels 读不到内容不是 bug，是 preserveDrawingBuffer 默认关闭——帧提交后缓冲即被清空。",{},"\u002Fnotes\u002F2026-11-14-2",{"description":203},"notes\u002F2026-11-14-2","i7xWqq2eNoU_seSbLQjqlB9gE51fM-PVLUEYCHBkOA4",1795304801271]