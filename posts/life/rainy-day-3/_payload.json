[{"data":1,"prerenderedAt":206},["ShallowReactive",2],{"notes-latest-1":3,"post:\u002Fposts\u002Flife\u002Frainy-day-3":27,"surround:\u002Fposts\u002Flife\u002Frainy-day-3":134,"notes-latest-3":141},[4],{"id":5,"title":6,"body":7,"createdAt":19,"description":13,"extension":20,"meta":21,"navigation":22,"path":23,"seo":24,"stem":25,"__hash__":26},"notes\u002Fnotes\u002F2026-11-14-1-2.md","2026 11 14 1 2",{"type":8,"value":9,"toc":14},"minimark",[10],[11,12,13],"p",{},"站点上线了「随笔」：支持一个文件多个随笔",{"title":15,"searchDepth":16,"depth":17,"links":18},"",2,3,[],"2026-11-17","md",{},true,"\u002Fnotes\u002F2026-11-14-1-2",{"description":13},"notes\u002F2026-11-14-1-2","hDP9fvaunHzVrZQ6QifuOtj9VrqbxlPb_52KE5wSjD0",{"id":28,"title":29,"author":30,"body":31,"categories":114,"comment":22,"cover":30,"createdAt":116,"description":35,"draft":117,"extension":20,"meta":118,"navigation":22,"path":123,"readingTime":124,"recommend":117,"seo":125,"series":30,"stem":126,"tags":127,"top":117,"topics":130,"updatedAt":30,"words":132,"__hash__":133},"posts\u002Fposts\u002Flife\u002Frainy-day-3.md","台风天居家记（三）",null,{"type":8,"value":32,"toc":106},[33,36,40,43,46,49,52,55,58,61,64,67,70,73,76,79,82,85,88,91,94,97,100,103],[11,34,35],{},"最近生活里有些小变化，趁着晚上安静，写两句给自己看。",[37,38,39],"h2",{"id":39},"风声里的白天",[11,41,42],{},"台风预警级别升高的那天下午，单位提前放假。回家的路上风已经开始不讲道理，伞打不住，索性收了淋着走。到家第一件事是把阳台的植物全部搬进客厅，花盆挪好位置，窗户缝用胶带贴了米字，这套流程熟得让人悲哀，也熟得让人安心。",[11,44,45],{},"台风天的居家有个特别之处：所有事情都获得了正当的慢下来的理由。泡一壶茶看书，看两页就走神听一会儿风，也不觉得浪费。平时觉得\"应该去做\"的事情统统按下了暂停键，只剩下\"想做什么\"。",[37,47,48],{"id":48},"停下来的价值",[11,50,51],{},"晚上停电了两个小时，手机玩到没电，全家点着蜡烛聊了很久的天，这种对话在通电的晚上发生概率为零。风停之后第二天出门，路上断了几根树枝，环卫工人在清早已经在忙了。",[11,53,54],{},"这场台风让我想通一件事：强制停下来对现代人是一种稀有资源，平时靠自律根本停不下来，大自然的强制力反而帮了忙。这篇写在风停的晚上，窗外已经安静，但那种慢下来的劲儿我想多留几天。",[37,56,57],{"id":57},"两个小教训",[11,59,60],{},"花了半个小时找手机，最后发现它在冰箱里，旁边是牛奶。那天之后我认真审视了自己的疲劳程度，人不是机器，续航是有数的。",[11,62,63],{},"剩菜以前是等凉透再进冰箱，被科普之后才知道要尽快冷藏，细菌繁殖的窗口期比想象中短。生活里很多想当然的习惯，较真起来都有另一套答案。",[11,65,66],{},"随手记两个小教训：阳台那盆绿萝浇得太勤，根都泡烂了，剪掉烂的部分重新扦插，现在改了策略，土干了再浇，反倒精神了不少。",[37,68,69],{"id":69},"一点延伸",[11,71,72],{},"写生活记录这几年有个体会：当时觉得不值得写的小事，事后回看反而是最鲜活的片段。反而是那些酝酿很久想认真写的“大主题”，多数烂在了草稿箱。所以现在我的原则是趁热写，先记下来，好不好以后再说。",[11,74,75],{},"生活里很多烦恼，拆开看其实是信息问题而不是命运问题：不知道怎么挑、不知道怎么做、不知道别人是怎么解决的。而信息问题基本都能靠学习和请教解决，这么一想，很多焦虑就有了着手点。",[11,77,78],{},"独居和成家各有各的修行，我现在的体会是无论哪种状态，把生活的基础盘打理好都是第一位的：睡眠、饮食、居住环境、几个说得上话的朋友。基础盘稳了，其他的变化来了都能接得住。",[11,80,81],{},"成年人的学习和学生时代最大的不同是反馈周期，没人给你打分，效果要几个月甚至几年后才显现。所以坚持的动力只能来自内部：记录对照、阶段复盘、给自己一点小奖励，这些机制比意志力可靠得多。",[37,83,84],{"id":84},"再补充几句",[11,86,87],{},"有时候会想，学一门新技术到底学到的是什么。语法和 API 会过时，真正的收获是它看问题的角度。多一门语言就多一副眼镜，同一副牌桌，能看到别人看不到的牌路，这是这么多年折腾下来最确定的回报。",[11,89,90],{},"记一个产生过的动摇：做到一半觉得这玩意儿是不是没什么意义。后来想通了，意义不是事情自带的，是你把它做完并沉淀下来之后长出来的。烂尾的才真的没意义，做完的最差也是一篇笔记。",[11,92,93],{},"顺便说说协作里的体会：这类事自己闷头做效率最高，但闷头做完往往返工最多。适度地提前同步，把方向先对齐，看似慢了半天，实际省掉的是几天的返工。沟通的时机比沟通的技巧更值得琢磨。",[11,95,96],{},"其实回看这些年踩的坑，大坑几乎都和贪快有关。快不是错，错的是想跳过必要步骤的快，地基没打牢盖得越快塌得越响。慢下来把该做的做扎实，反而是最快的路径，这话说了很多年，每次验证都对。",[37,98,99],{"id":99},"小结",[11,101,102],{},"整个过程我写成了 checklist，下次照着走一遍就行，果然顺利多了。重复出现的事情就该被固化成流程，工作里如此，生活里也是。",[11,104,105],{},"就写到这吧，锅里还炖着东西，得去看一眼。",{"title":15,"searchDepth":16,"depth":17,"links":107},[108,109,110,111,112,113],{"id":39,"depth":16,"text":39},{"id":48,"depth":16,"text":48},{"id":57,"depth":16,"text":57},{"id":69,"depth":16,"text":69},{"id":84,"depth":16,"text":84},{"id":99,"depth":16,"text":99},[115],"生活","2023-02-09",false,{"excerpt":119},{"type":8,"value":120},[121],[11,122,35],{},"\u002Fposts\u002Flife\u002Frainy-day-3",373800,{"title":29,"description":35},"posts\u002Flife\u002Frainy-day-3",[128,129],"台风","居家",[131],"life",1246,"oblfo1EV1R6Y8kb_9gLEl1oepkH7JR5_TZWXlihGJm0",{"prev":135,"next":138},{"path":136,"title":137},"\u002Fposts\u002Flife\u002Frainy-day-2","台风天居家记（二）",{"path":139,"title":140},"\u002Fposts\u002Flife\u002Frainy-day-4","台风天居家记（四）",[142,151,181],{"id":5,"title":6,"body":143,"createdAt":19,"description":13,"extension":20,"meta":149,"navigation":22,"path":23,"seo":150,"stem":25,"__hash__":26},{"type":8,"value":144,"toc":147},[145],[11,146,13],{},{"title":15,"searchDepth":16,"depth":17,"links":148},[],{},{"description":13},{"id":152,"title":153,"body":154,"createdAt":174,"description":175,"extension":20,"meta":176,"navigation":22,"path":177,"seo":178,"stem":179,"__hash__":180},"notes\u002Fnotes\u002F2026-11-14-1.md","2026 11 14 1",{"type":8,"value":155,"toc":172},[156],[11,157,158,159,163,164,171],{},"站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 ",[160,161,162],"strong",{},"Markdown","，写链接也不用到编辑器：",[165,166,170],"a",{"href":167,"rel":168},"https:\u002F\u002Fcontent.nuxt.com",[169],"nofollow","Nuxt Content","。",{"title":15,"searchDepth":16,"depth":17,"links":173},[],"2026-11-14","站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 Markdown，写链接也不用到编辑器：Nuxt Content。",{},"\u002Fnotes\u002F2026-11-14-1",{"description":175},"notes\u002F2026-11-14-1","LLJX_RKU7cgpT6aHw4DZWUZNQ_G_UzELWPKbksJvzfs",{"id":182,"title":183,"body":184,"createdAt":199,"description":200,"extension":20,"meta":201,"navigation":22,"path":202,"seo":203,"stem":204,"__hash__":205},"notes\u002Fnotes\u002F2026-11-14-2.md","2026 11 14 2",{"type":8,"value":185,"toc":197},[186],[11,187,188,192,193,196],{},[189,190,191],"code",{},"readPixels"," 读不到内容不是 bug，是 ",[189,194,195],{},"preserveDrawingBuffer"," 默认关闭——帧提交后缓冲即被清空。",{"title":15,"searchDepth":16,"depth":17,"links":198},[],"2026-11-13","readPixels 读不到内容不是 bug，是 preserveDrawingBuffer 默认关闭——帧提交后缓冲即被清空。",{},"\u002Fnotes\u002F2026-11-14-2",{"description":200},"notes\u002F2026-11-14-2","i7xWqq2eNoU_seSbLQjqlB9gE51fM-PVLUEYCHBkOA4",1795348514689]