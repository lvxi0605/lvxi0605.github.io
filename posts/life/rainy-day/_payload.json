[{"data":1,"prerenderedAt":208},["ShallowReactive",2],{"notes-latest-1":3,"post:\u002Fposts\u002Flife\u002Frainy-day":27,"surround:\u002Fposts\u002Flife\u002Frainy-day":136,"notes-latest-3":143},[4],{"id":5,"title":6,"body":7,"createdAt":19,"description":13,"extension":20,"meta":21,"navigation":22,"path":23,"seo":24,"stem":25,"__hash__":26},"notes\u002Fnotes\u002F2026-11-14-1-2.md","2026 11 14 1 2",{"type":8,"value":9,"toc":14},"minimark",[10],[11,12,13],"p",{},"站点上线了「随笔」：支持一个文件多个随笔",{"title":15,"searchDepth":16,"depth":17,"links":18},"",2,3,[],"2026-11-17","md",{},true,"\u002Fnotes\u002F2026-11-14-1-2",{"description":13},"notes\u002F2026-11-14-1-2","hDP9fvaunHzVrZQ6QifuOtj9VrqbxlPb_52KE5wSjD0",{"id":28,"title":29,"author":30,"body":31,"categories":116,"comment":22,"cover":30,"createdAt":118,"description":35,"draft":119,"extension":20,"meta":120,"navigation":22,"path":125,"readingTime":126,"recommend":119,"seo":127,"series":30,"stem":128,"tags":129,"top":119,"topics":132,"updatedAt":30,"words":134,"__hash__":135},"posts\u002Fposts\u002Flife\u002Frainy-day.md","台风天居家记",null,{"type":8,"value":32,"toc":108},[33,36,40,43,46,49,52,55,58,61,64,67,70,73,76,79,82,84,87,90,93,96,99,102,105],[11,34,35],{},"晚上洗完碗坐下来，忽然想写点什么，就写写这件小事。",[37,38,39],"h2",{"id":39},"风声里的白天",[11,41,42],{},"台风预警级别升高的那天下午，单位提前放假。回家的路上风已经开始不讲道理，伞打不住，索性收了淋着走。到家第一件事是把阳台的植物全部搬进客厅，花盆挪好位置，窗户缝用胶带贴了米字，这套流程熟得让人悲哀，也熟得让人安心。",[11,44,45],{},"台风天的居家有个特别之处：所有事情都获得了正当的慢下来的理由。泡一壶茶看书，看两页就走神听一会儿风，也不觉得浪费。平时觉得\"应该去做\"的事情统统按下了暂停键，只剩下\"想做什么\"。",[37,47,48],{"id":48},"停下来的价值",[11,50,51],{},"晚上停电了两个小时，手机玩到没电，全家点着蜡烛聊了很久的天，这种对话在通电的晚上发生概率为零。风停之后第二天出门，路上断了几根树枝，环卫工人在清早已经在忙了。",[11,53,54],{},"这场台风让我想通一件事：强制停下来对现代人是一种稀有资源，平时靠自律根本停不下来，大自然的强制力反而帮了忙。这篇写在风停的晚上，窗外已经安静，但那种慢下来的劲儿我想多留几天。",[37,56,57],{"id":57},"两个小教训",[11,59,60],{},"出门忘带钥匙，蹲在门口等开锁师傅，等了一小时花了一百五。现在门口的暗格放了备用钥匙，出门摸一下口袋成了肌肉记忆。",[11,62,63],{},"健身房年卡办完去了一次半，钱花得毫无水花。后来改成按次买，反而每周都去。消费习惯这件事，沉没成本越高越不想动，适合别人的不一定适合自己。",[11,65,66],{},"加湿器开一整夜，窗台上全是水汽，墙角都有点返潮。买了个湿度计才知道，舒服的湿度是个区间，不是越大越好，很多事都是这个道理。",[37,68,69],{"id":69},"一点延伸",[11,71,72],{},"写生活记录这几年有个体会：当时觉得不值得写的小事，事后回看反而是最鲜活的片段。反而是那些酝酿很久想认真写的“大主题”，多数烂在了草稿箱。所以现在我的原则是趁热写，先记下来，好不好以后再说。",[11,74,75],{},"生活里很多烦恼，拆开看其实是信息问题而不是命运问题：不知道怎么挑、不知道怎么做、不知道别人是怎么解决的。而信息问题基本都能靠学习和请教解决，这么一想，很多焦虑就有了着手点。",[11,77,78],{},"独居和成家各有各的修行，我现在的体会是无论哪种状态，把生活的基础盘打理好都是第一位的：睡眠、饮食、居住环境、几个说得上话的朋友。基础盘稳了，其他的变化来了都能接得住。",[11,80,81],{},"成年人的学习和学生时代最大的不同是反馈周期，没人给你打分，效果要几个月甚至几年后才显现。所以坚持的动力只能来自内部：记录对照、阶段复盘、给自己一点小奖励，这些机制比意志力可靠得多。",[11,83,72],{},[37,85,86],{"id":86},"再补充几句",[11,88,89],{},"回顾这个过程，最大的教训其实是克制。可选项永远比需要的多，每个新方案看起来都比现状好一点，但都加上之后，系统就成了没人看得懂的拼贴画。做减法的判断比做加法的胆子更值钱。",[11,91,92],{},"这种事急不来，和锻炼身体是一个道理：练一天没变化，练三个月身体自己会说话。技术积累也是这样，每天一点，回过头看的时候差距已经拉开了，只是身在其中感觉不到而已。",[11,94,95],{},"想到一个问题：为什么同样的事情，不同的人做出来差别那么大。后来觉得答案在于对边界的处理，正常路径人人会写，边界和异常的处理习惯才是拉开差距的地方。做事和写代码一样，细节的密度决定成品的质量。",[11,97,98],{},"写到这里顺便吐个槽，这类事情最难的部分往往不是技术本身，是说服别人相信它值得投入。方案再好，落不到排期上都是空谈，所以学会用数据的语言讲价值，算是这些年额外的必修课。",[37,100,101],{"id":101},"小结",[11,103,104],{},"同事听说我周末在干这个，一脸问号。其实思路和排查问题差不多，提出猜想，做实验，看结果，一样一样的。",[11,106,107],{},"先记到这里，后面有新的进展再来补充。",{"title":15,"searchDepth":16,"depth":17,"links":109},[110,111,112,113,114,115],{"id":39,"depth":16,"text":39},{"id":48,"depth":16,"text":48},{"id":57,"depth":16,"text":57},{"id":69,"depth":16,"text":69},{"id":86,"depth":16,"text":86},{"id":101,"depth":16,"text":101},[117],"生活","2023-08-05",false,{"excerpt":121},{"type":8,"value":122},[123],[11,124,35],{},"\u002Fposts\u002Flife\u002Frainy-day",395700,{"title":29,"description":35},"posts\u002Flife\u002Frainy-day",[130,131],"台风","居家",[133],"life",1319,"WFDhS5vbxAiV8vA2F0TxPDbOgpqoIzDl_-nWlbv85p4",{"prev":137,"next":140},{"path":138,"title":139},"\u002Fposts\u002Flife\u002Fold-stuff-3","整理旧物翻出的回忆（三）",{"path":141,"title":142},"\u002Fposts\u002Flife\u002Frainy-day-2","台风天居家记（二）",[144,153,183],{"id":5,"title":6,"body":145,"createdAt":19,"description":13,"extension":20,"meta":151,"navigation":22,"path":23,"seo":152,"stem":25,"__hash__":26},{"type":8,"value":146,"toc":149},[147],[11,148,13],{},{"title":15,"searchDepth":16,"depth":17,"links":150},[],{},{"description":13},{"id":154,"title":155,"body":156,"createdAt":176,"description":177,"extension":20,"meta":178,"navigation":22,"path":179,"seo":180,"stem":181,"__hash__":182},"notes\u002Fnotes\u002F2026-11-14-1.md","2026 11 14 1",{"type":8,"value":157,"toc":174},[158],[11,159,160,161,165,166,173],{},"站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 ",[162,163,164],"strong",{},"Markdown","，写链接也不用到编辑器：",[167,168,172],"a",{"href":169,"rel":170},"https:\u002F\u002Fcontent.nuxt.com",[171],"nofollow","Nuxt Content","。",{"title":15,"searchDepth":16,"depth":17,"links":175},[],"2026-11-14","站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 Markdown，写链接也不用到编辑器：Nuxt Content。",{},"\u002Fnotes\u002F2026-11-14-1",{"description":177},"notes\u002F2026-11-14-1","LLJX_RKU7cgpT6aHw4DZWUZNQ_G_UzELWPKbksJvzfs",{"id":184,"title":185,"body":186,"createdAt":201,"description":202,"extension":20,"meta":203,"navigation":22,"path":204,"seo":205,"stem":206,"__hash__":207},"notes\u002Fnotes\u002F2026-11-14-2.md","2026 11 14 2",{"type":8,"value":187,"toc":199},[188],[11,189,190,194,195,198],{},[191,192,193],"code",{},"readPixels"," 读不到内容不是 bug，是 ",[191,196,197],{},"preserveDrawingBuffer"," 默认关闭——帧提交后缓冲即被清空。",{"title":15,"searchDepth":16,"depth":17,"links":200},[],"2026-11-13","readPixels 读不到内容不是 bug，是 preserveDrawingBuffer 默认关闭——帧提交后缓冲即被清空。",{},"\u002Fnotes\u002F2026-11-14-2",{"description":202},"notes\u002F2026-11-14-2","i7xWqq2eNoU_seSbLQjqlB9gE51fM-PVLUEYCHBkOA4",1795316740500]