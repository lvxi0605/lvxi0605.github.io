[{"data":1,"prerenderedAt":205},["ShallowReactive",2],{"notes-latest-1":3,"post:\u002Fposts\u002Flife\u002Fbook-three-body-3":27,"surround:\u002Fposts\u002Flife\u002Fbook-three-body-3":133,"notes-latest-3":140},[4],{"id":5,"title":6,"body":7,"createdAt":19,"description":13,"extension":20,"meta":21,"navigation":22,"path":23,"seo":24,"stem":25,"__hash__":26},"notes\u002Fnotes\u002F2026-11-14-1-2.md","2026 11 14 1 2",{"type":8,"value":9,"toc":14},"minimark",[10],[11,12,13],"p",{},"站点上线了「随笔」：支持一个文件多个随笔",{"title":15,"searchDepth":16,"depth":17,"links":18},"",2,3,[],"2026-11-17","md",{},true,"\u002Fnotes\u002F2026-11-14-1-2",{"description":13},"notes\u002F2026-11-14-1-2","hDP9fvaunHzVrZQ6QifuOtj9VrqbxlPb_52KE5wSjD0",{"id":28,"title":29,"author":30,"body":31,"categories":113,"comment":22,"cover":30,"createdAt":115,"description":35,"draft":116,"extension":20,"meta":117,"navigation":22,"path":122,"readingTime":123,"recommend":116,"seo":124,"series":30,"stem":125,"tags":126,"top":116,"topics":129,"updatedAt":30,"words":131,"__hash__":132},"posts\u002Fposts\u002Flife\u002Fbook-three-body-3.md","重读三体的一些新感受（三）",null,{"type":8,"value":32,"toc":105},[33,36,40,43,46,49,52,55,58,61,64,67,70,73,76,79,81,84,87,90,93,96,99,102],[11,34,35],{},"起因是和朋友聊到这个话题，聊完发现我们的做法完全不同，回来想想还是记录一下我的版本。",[37,38,39],"h2",{"id":39},"十年后的重读",[11,41,42],{},"第一次读《三体》是大学宿舍里熬了两个通宵，当时的震撼全在想象力上：黑暗森林、降维打击、面壁计划，每一个设定都足够新鲜。十年后重读，震撼点完全变了，这次打动我的是那些人性的细节：章北海的隐忍、罗辑从玩世不恭到肩负一切的转变、云天明送的星星。",[11,44,45],{},"工作之后再读，还多了一层职业视角，水滴攻击人类舰队那段的降维碾压，读起来竟然有点像老系统遭遇技术代差的新架构，落后不是不努力，是范式变了。",[37,47,48],{"id":48},"常读常新的书",[11,50,51],{},"重读还让我注意到年轻时完全略过的部分，大史这个人物，十年前读只觉得是个有料的配角，这次读发现他是全书的锚，所有飘在空中的宏大叙事，都靠这个接地气的警察拉回人间。好书就是这样，读者的阅历长一截，书就多长出一截。这次重读用了三周，比第一次慢多了，但值。下一篇打算重读《三体》之外的大刘短篇集，据说又是完全不同的口味。",[37,53,54],{"id":54},"过程中的小心得",[11,56,57],{},"咖啡粉磨太细，手冲出来又苦又涩还带杂味，一度怀疑是豆子的问题。调粗一格立刻正常，器材和参数的问题，别先怪豆子。",[11,59,60],{},"周末一口气睡到中午，起来反而头昏脑涨。生物钟这东西，补觉补不回来，规律比时长重要，这是身体反复教育我的。",[11,62,63],{},"搬家时纸箱没标注，晚上要找充电器，十几个箱子翻到半夜。后来每个箱子外面用马克笔写清楚内容和房间，下次搬家的自己会感谢现在的自己。",[37,65,66],{"id":66},"延伸几句",[11,68,69],{},"独居和成家各有各的修行，我现在的体会是无论哪种状态，把生活的基础盘打理好都是第一位的：睡眠、饮食、居住环境、几个说得上话的朋友。基础盘稳了，其他的变化来了都能接得住。",[11,71,72],{},"成年人的学习和学生时代最大的不同是反馈周期，没人给你打分，效果要几个月甚至几年后才显现。所以坚持的动力只能来自内部：记录对照、阶段复盘、给自己一点小奖励，这些机制比意志力可靠得多。",[11,74,75],{},"写生活记录这几年有个体会：当时觉得不值得写的小事，事后回看反而是最鲜活的片段。反而是那些酝酿很久想认真写的“大主题”，多数烂在了草稿箱。所以现在我的原则是趁热写，先记下来，好不好以后再说。",[11,77,78],{},"生活里很多烦恼，拆开看其实是信息问题而不是命运问题：不知道怎么挑、不知道怎么做、不知道别人是怎么解决的。而信息问题基本都能靠学习和请教解决，这么一想，很多焦虑就有了着手点。",[11,80,69],{},[37,82,83],{"id":83},"又想到一些",[11,85,86],{},"讲个题外话，做这类事情的时候最好留个记录的习惯，当时的判断依据比结果更珍贵。结果好可能只是运气好，把决策过程记下来，好运才可能被复制，坏运才可能被规避。",[11,88,89],{},"然后想说，承认不懂是这行的美德。这次遇到不懂的地方，老老实实补了两天的课，比硬着头皮往上糊的方案强太多。不懂装懂的代价从来不会消失，只是延期，还带利息。",[11,91,92],{},"平衡感很重要的一件事：投入和收益的比例。所有优化都值得先问一句，这件事的收益上限是多少，值多少投入。无限打磨一个低价值的东西是工程师最常见的温柔陷阱，包括我自己在内。",[11,94,95],{},"忍不住再夸一下记录的力量，上周刚整理的笔记，这次直接翻出来就用，十分钟解决了当时花一下午的问题。给自己留下的每一份笔记，都是寄给未来的快递，寄件人签收时才觉得真香。",[37,97,98],{"id":98},"写在最后",[11,100,101],{},"我把这件事当成一个小需求来管理，明确了目标和验收标准，中途改了两次方案，最后的效果自己挺满意。",[11,103,104],{},"今天的记录就到这里，晚安。",{"title":15,"searchDepth":16,"depth":17,"links":106},[107,108,109,110,111,112],{"id":39,"depth":16,"text":39},{"id":48,"depth":16,"text":48},{"id":54,"depth":16,"text":54},{"id":66,"depth":16,"text":66},{"id":83,"depth":16,"text":83},{"id":98,"depth":16,"text":98},[114],"读书","2026-09-10",false,{"excerpt":118},{"type":8,"value":119},[120],[11,121,35],{},"\u002Fposts\u002Flife\u002Fbook-three-body-3",381300,{"title":29,"description":35},"posts\u002Flife\u002Fbook-three-body-3",[127,128],"三体","科幻",[130],"life",1271,"A58gnhTN1eWVRK2ehWBmTvxXZVrsfCU2ALWZ8VB8Bg0",{"prev":134,"next":137},{"path":135,"title":136},"\u002Fposts\u002Flife\u002Fbook-three-body-2","重读三体的一些新感受（二）",{"path":138,"title":139},"\u002Fposts\u002Flife\u002Fbook-three-body-4","重读三体的一些新感受（四）",[141,150,180],{"id":5,"title":6,"body":142,"createdAt":19,"description":13,"extension":20,"meta":148,"navigation":22,"path":23,"seo":149,"stem":25,"__hash__":26},{"type":8,"value":143,"toc":146},[144],[11,145,13],{},{"title":15,"searchDepth":16,"depth":17,"links":147},[],{},{"description":13},{"id":151,"title":152,"body":153,"createdAt":173,"description":174,"extension":20,"meta":175,"navigation":22,"path":176,"seo":177,"stem":178,"__hash__":179},"notes\u002Fnotes\u002F2026-11-14-1.md","2026 11 14 1",{"type":8,"value":154,"toc":171},[155],[11,156,157,158,162,163,170],{},"站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 ",[159,160,161],"strong",{},"Markdown","，写链接也不用到编辑器：",[164,165,169],"a",{"href":166,"rel":167},"https:\u002F\u002Fcontent.nuxt.com",[168],"nofollow","Nuxt Content","。",{"title":15,"searchDepth":16,"depth":17,"links":172},[],"2026-11-14","站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 Markdown，写链接也不用到编辑器：Nuxt Content。",{},"\u002Fnotes\u002F2026-11-14-1",{"description":174},"notes\u002F2026-11-14-1","LLJX_RKU7cgpT6aHw4DZWUZNQ_G_UzELWPKbksJvzfs",{"id":181,"title":182,"body":183,"createdAt":198,"description":199,"extension":20,"meta":200,"navigation":22,"path":201,"seo":202,"stem":203,"__hash__":204},"notes\u002Fnotes\u002F2026-11-14-2.md","2026 11 14 2",{"type":8,"value":184,"toc":196},[185],[11,186,187,191,192,195],{},[188,189,190],"code",{},"readPixels"," 读不到内容不是 bug，是 ",[188,193,194],{},"preserveDrawingBuffer"," 默认关闭——帧提交后缓冲即被清空。",{"title":15,"searchDepth":16,"depth":17,"links":197},[],"2026-11-13","readPixels 读不到内容不是 bug，是 preserveDrawingBuffer 默认关闭——帧提交后缓冲即被清空。",{},"\u002Fnotes\u002F2026-11-14-2",{"description":199},"notes\u002F2026-11-14-2","i7xWqq2eNoU_seSbLQjqlB9gE51fM-PVLUEYCHBkOA4",1795274507208]