[{"data":1,"prerenderedAt":214},["ShallowReactive",2],{"notes-latest-1":3,"post:\u002Fposts\u002Flife\u002Flate-night-canteen":27,"surround:\u002Fposts\u002Flife\u002Flate-night-canteen":142,"notes-latest-3":149},[4],{"id":5,"title":6,"body":7,"createdAt":19,"description":13,"extension":20,"meta":21,"navigation":22,"path":23,"seo":24,"stem":25,"__hash__":26},"notes\u002Fnotes\u002F2026-11-14-1-2.md","2026 11 14 1 2",{"type":8,"value":9,"toc":14},"minimark",[10],[11,12,13],"p",{},"站点上线了「随笔」：支持一个文件多个随笔",{"title":15,"searchDepth":16,"depth":17,"links":18},"",2,3,[],"2026-11-17","md",{},true,"\u002Fnotes\u002F2026-11-14-1-2",{"description":13},"notes\u002F2026-11-14-1-2","hDP9fvaunHzVrZQ6QifuOtj9VrqbxlPb_52KE5wSjD0",{"id":28,"title":29,"author":30,"body":31,"categories":122,"comment":22,"cover":30,"createdAt":124,"description":35,"draft":125,"extension":20,"meta":126,"navigation":22,"path":131,"readingTime":132,"recommend":125,"seo":133,"series":30,"stem":134,"tags":135,"top":125,"topics":138,"updatedAt":30,"words":140,"__hash__":141},"posts\u002Fposts\u002Flife\u002Flate-night-canteen.md","加班晚归后的深夜食堂",null,{"type":8,"value":32,"toc":114},[33,36,40,43,46,52,55,58,61,64,67,70,73,76,79,82,85,88,90,93,96,99,102,105,108,111],[11,34,35],{},"这篇没有代码，纯记录生活，技术同学可以直接跳过，开玩笑的，看完也许有点别的收获。",[37,38,39],"h2",{"id":39},"楼下的那家小面馆",[11,41,42],{},"加班到十点半，地铁口楼下的面馆还亮着灯。老板认得我，不用开口，一碗牛肉面加个蛋，汤宽面硬，二十分钟端上来。店里没几个人，电视放着没人看的剧，筷子碰到碗的声音特别清楚。",[11,44,45],{},"我常想，这家店对我来说到底是吃饭的地方还是某种心理安慰。后来想明白了，加班的疲惫一半来自大脑持续运转后的空虚，而一碗热汤面正好是从工作模式切回生活模式的仪式，汤下肚的那一刻，那些没改完的 bug 就不属于今晚了。",[11,47,48],{},[49,50],"img",{"alt":29,"src":51},"\u002Fimg\u002F1.jpg",[37,53,54],{"id":54},"深夜的观察",[11,56,57],{},"店里的常客还有代驾司机、酒吧下班的姑娘、跑外卖的小哥，大家互不打扰，又莫名地有一种同是晚归人的默契。偶尔老板娘会和熟客聊两句家长里短，声音不大，混在汤锅的咕嘟声里。",[11,59,60],{},"写到这里忽然想起来，这家店开了五年，我吃了五年，价格只涨过一次，五块钱。生活里很多这样的小店，不惊艳，但稳稳地在那里，像某个不太说话的老朋友。这篇没什么中心思想，就是今晚吃完面走回家的路上，忽然想把这件事记下来。",[37,62,63],{"id":63},"记下两点",[11,65,66],{},"买椅子只看了颜值，腰托形同虚设，坐两小时腰就开始抗议。人体工学这几个字，是拿腰疼换来的教训，越久坐越得信。",[11,68,69],{},"给花换盆的时机不对，大夏天动的土，缓了半个月才缓过来，叶子黄了一半。换盆要赶在春秋，园艺上的讲究背后都是植物的生理规律。",[11,71,72],{},"夜跑那阵子穿深色衣服，路过没有路灯的路段被司机按喇叭提醒，回想起来一阵后怕。后来买了反光背心，几十块钱买安心。",[37,74,75],{"id":75},"多聊两句",[11,77,78],{},"独居和成家各有各的修行，我现在的体会是无论哪种状态，把生活的基础盘打理好都是第一位的：睡眠、饮食、居住环境、几个说得上话的朋友。基础盘稳了，其他的变化来了都能接得住。",[11,80,81],{},"成年人的学习和学生时代最大的不同是反馈周期，没人给你打分，效果要几个月甚至几年后才显现。所以坚持的动力只能来自内部：记录对照、阶段复盘、给自己一点小奖励，这些机制比意志力可靠得多。",[11,83,84],{},"写生活记录这几年有个体会：当时觉得不值得写的小事，事后回看反而是最鲜活的片段。反而是那些酝酿很久想认真写的“大主题”，多数烂在了草稿箱。所以现在我的原则是趁热写，先记下来，好不好以后再说。",[11,86,87],{},"生活里很多烦恼，拆开看其实是信息问题而不是命运问题：不知道怎么挑、不知道怎么做、不知道别人是怎么解决的。而信息问题基本都能靠学习和请教解决，这么一想，很多焦虑就有了着手点。",[11,89,78],{},[37,91,92],{"id":92},"继续聊聊",[11,94,95],{},"想想还是补一段：任何习惯的养成都绕不开启动成本，最有效的办法是把启动成本降到接近零。想跑就把鞋放门口，想写就把文档开着置顶，环境准备到位了，行动只是顺水推舟。",[11,97,98],{},"从更高的视角看，这类问题都有一个共同结构：短期收益和长期收益打架。短期的诱惑总是具体而生动，长期的回报抽象而遥远，赢家通常是那些把长期目标拆成短期可感的小奖励的人。",[11,100,101],{},"讲个题外话，做这类事情的时候最好留个记录的习惯，当时的判断依据比结果更珍贵。结果好可能只是运气好，把决策过程记下来，好运才可能被复制，坏运才可能被规避。",[11,103,104],{},"然后想说，承认不懂是这行的美德。这次遇到不懂的地方，老老实实补了两天的课，比硬着头皮往上糊的方案强太多。不懂装懂的代价从来不会消失，只是延期，还带利息。",[37,106,107],{"id":107},"最后",[11,109,110],{},"职业病之一是看什么都想拆步骤，这件事在我这里基本是个流程问题：目标、步骤、验证、复盘，一套下来居然还真管用。",[11,112,113],{},"如果你也遇到类似的情况，评论区聊聊。",{"title":15,"searchDepth":16,"depth":17,"links":115},[116,117,118,119,120,121],{"id":39,"depth":16,"text":39},{"id":54,"depth":16,"text":54},{"id":63,"depth":16,"text":63},{"id":75,"depth":16,"text":75},{"id":92,"depth":16,"text":92},{"id":107,"depth":16,"text":107},[123],"生活","2023-11-17",false,{"excerpt":127},{"type":8,"value":128},[129],[11,130,35],{},"\u002Fposts\u002Flife\u002Flate-night-canteen",391500,{"title":29,"description":35},"posts\u002Flife\u002Flate-night-canteen",[136,137],"夜宵","随笔",[139],"life",1305,"tY9dsoG00LDhqPtYQMDej2WwxDibPfH6SwZg57IOnGk",{"prev":143,"next":146},{"path":144,"title":145},"\u002Fposts\u002Flife\u002Fhometown-changes-4","回老家的见闻（四）",{"path":147,"title":148},"\u002Fposts\u002Flife\u002Flate-night-canteen-2","加班晚归后的深夜食堂（二）",[150,159,189],{"id":5,"title":6,"body":151,"createdAt":19,"description":13,"extension":20,"meta":157,"navigation":22,"path":23,"seo":158,"stem":25,"__hash__":26},{"type":8,"value":152,"toc":155},[153],[11,154,13],{},{"title":15,"searchDepth":16,"depth":17,"links":156},[],{},{"description":13},{"id":160,"title":161,"body":162,"createdAt":182,"description":183,"extension":20,"meta":184,"navigation":22,"path":185,"seo":186,"stem":187,"__hash__":188},"notes\u002Fnotes\u002F2026-11-14-1.md","2026 11 14 1",{"type":8,"value":163,"toc":180},[164],[11,165,166,167,171,172,179],{},"站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 ",[168,169,170],"strong",{},"Markdown","，写链接也不用到编辑器：",[173,174,178],"a",{"href":175,"rel":176},"https:\u002F\u002Fcontent.nuxt.com",[177],"nofollow","Nuxt Content","。",{"title":15,"searchDepth":16,"depth":17,"links":181},[],"2026-11-14","站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 Markdown，写链接也不用到编辑器：Nuxt Content。",{},"\u002Fnotes\u002F2026-11-14-1",{"description":183},"notes\u002F2026-11-14-1","LLJX_RKU7cgpT6aHw4DZWUZNQ_G_UzELWPKbksJvzfs",{"id":190,"title":191,"body":192,"createdAt":207,"description":208,"extension":20,"meta":209,"navigation":22,"path":210,"seo":211,"stem":212,"__hash__":213},"notes\u002Fnotes\u002F2026-11-14-2.md","2026 11 14 2",{"type":8,"value":193,"toc":205},[194],[11,195,196,200,201,204],{},[197,198,199],"code",{},"readPixels"," 读不到内容不是 bug，是 ",[197,202,203],{},"preserveDrawingBuffer"," 默认关闭——帧提交后缓冲即被清空。",{"title":15,"searchDepth":16,"depth":17,"links":206},[],"2026-11-13","readPixels 读不到内容不是 bug，是 preserveDrawingBuffer 默认关闭——帧提交后缓冲即被清空。",{},"\u002Fnotes\u002F2026-11-14-2",{"description":208},"notes\u002F2026-11-14-2","i7xWqq2eNoU_seSbLQjqlB9gE51fM-PVLUEYCHBkOA4",1795707444261]