[{"data":1,"prerenderedAt":205},["ShallowReactive",2],{"notes-latest-1":3,"post:\u002Fposts\u002Flife\u002Fnew-year-plan":27,"surround:\u002Fposts\u002Flife\u002Fnew-year-plan":133,"notes-latest-3":140},[4],{"id":5,"title":6,"body":7,"createdAt":19,"description":13,"extension":20,"meta":21,"navigation":22,"path":23,"seo":24,"stem":25,"__hash__":26},"notes\u002Fnotes\u002F2026-11-14-1-2.md","2026 11 14 1 2",{"type":8,"value":9,"toc":14},"minimark",[10],[11,12,13],"p",{},"站点上线了「随笔」：支持一个文件多个随笔",{"title":15,"searchDepth":16,"depth":17,"links":18},"",2,3,[],"2026-11-17","md",{},true,"\u002Fnotes\u002F2026-11-14-1-2",{"description":13},"notes\u002F2026-11-14-1-2","hDP9fvaunHzVrZQ6QifuOtj9VrqbxlPb_52KE5wSjD0",{"id":28,"title":29,"author":30,"body":31,"categories":113,"comment":22,"cover":30,"createdAt":115,"description":35,"draft":116,"extension":20,"meta":117,"navigation":22,"path":122,"readingTime":123,"recommend":116,"seo":124,"series":30,"stem":125,"tags":126,"top":116,"topics":129,"updatedAt":30,"words":131,"__hash__":132},"posts\u002Fposts\u002Flife\u002Fnew-year-plan.md","新年计划要怎么定才不会荒废",null,{"type":8,"value":32,"toc":105},[33,36,40,43,46,49,52,55,58,61,64,67,70,73,76,79,81,84,87,90,93,96,99,102],[11,34,35],{},"天气不错的一个周末，出去走了走，回来顺手把当天的感受记下来。",[37,38,39],"h2",{"id":39},"往年计划的坟场",[11,41,42],{},"翻开往年的新年计划，十有八九是坟场：读完二十本书、瘦十斤、学一门新语言，写得热血沸腾，十一月开始盘点时场面惨烈。复盘了几年的失败，原因基本一致：目标太多、太模糊、没有可执行的路径，本质是许愿而不是计划。",[11,44,45],{},"今年的计划吸取了教训，只定了三条，每条都改写成行为而不是结果：每周跑步三次、每月写两篇文章、每天睡前读半小时书。行为是可以今天就开始的，结果是明天才开始焦虑的。",[37,47,48],{"id":48},"让计划自己运转",[11,50,51],{},"另外几个用起来不错的机制：打卡表贴在显眼处，视觉压力比意志力可靠；允许每月两次的豁免额度，断了不弃，第二周重新开始就行；季度复盘一次，删掉不合适的，追加新想到的。三个月过去，跑步和写作基本稳住了，读书偶尔断档但在豁免额度内。这篇不是教你怎么做计划，是写给明年一月翻开这篇的自己：喂，方法依然有效，继续。",[37,53,54],{"id":54},"记下两点",[11,56,57],{},"搬家时纸箱没标注，晚上要找充电器，十几个箱子翻到半夜。后来每个箱子外面用马克笔写清楚内容和房间，下次搬家的自己会感谢现在的自己。",[11,59,60],{},"机械键盘用了大半年没清，按键手感越来越肉，拔键帽一清理，底下灰积了一层。电子产品和房间一样，定期打扫手感完全不同。",[11,62,63],{},"冰箱塞得太满，冷风吹不到后排，最里面的菜悄悄坏掉才发现。留出空隙让空气流通，食物和代码里的缓存一样，堆太满就要出问题。",[37,65,66],{"id":66},"多聊两句",[11,68,69],{},"独居和成家各有各的修行，我现在的体会是无论哪种状态，把生活的基础盘打理好都是第一位的：睡眠、饮食、居住环境、几个说得上话的朋友。基础盘稳了，其他的变化来了都能接得住。",[11,71,72],{},"成年人的学习和学生时代最大的不同是反馈周期，没人给你打分，效果要几个月甚至几年后才显现。所以坚持的动力只能来自内部：记录对照、阶段复盘、给自己一点小奖励，这些机制比意志力可靠得多。",[11,74,75],{},"写生活记录这几年有个体会：当时觉得不值得写的小事，事后回看反而是最鲜活的片段。反而是那些酝酿很久想认真写的“大主题”，多数烂在了草稿箱。所以现在我的原则是趁热写，先记下来，好不好以后再说。",[11,77,78],{},"生活里很多烦恼，拆开看其实是信息问题而不是命运问题：不知道怎么挑、不知道怎么做、不知道别人是怎么解决的。而信息问题基本都能靠学习和请教解决，这么一想，很多焦虑就有了着手点。",[11,80,69],{},[37,82,83],{"id":83},"继续聊聊",[11,85,86],{},"这种事急不来，和锻炼身体是一个道理：练一天没变化，练三个月身体自己会说话。技术积累也是这样，每天一点，回过头看的时候差距已经拉开了，只是身在其中感觉不到而已。",[11,88,89],{},"想到一个问题：为什么同样的事情，不同的人做出来差别那么大。后来觉得答案在于对边界的处理，正常路径人人会写，边界和异常的处理习惯才是拉开差距的地方。做事和写代码一样，细节的密度决定成品的质量。",[11,91,92],{},"写到这里顺便吐个槽，这类事情最难的部分往往不是技术本身，是说服别人相信它值得投入。方案再好，落不到排期上都是空谈，所以学会用数据的语言讲价值，算是这些年额外的必修课。",[11,94,95],{},"有时候会想，学一门新技术到底学到的是什么。语法和 API 会过时，真正的收获是它看问题的角度。多一门语言就多一副眼镜，同一副牌桌，能看到别人看不到的牌路，这是这么多年折腾下来最确定的回报。",[37,97,98],{"id":98},"最后",[11,100,101],{},"我把这件事当成一个小需求来管理，明确了目标和验收标准，中途改了两次方案，最后的效果自己挺满意。",[11,103,104],{},"以上，一点心得，有说得不对的欢迎指正。",{"title":15,"searchDepth":16,"depth":17,"links":106},[107,108,109,110,111,112],{"id":39,"depth":16,"text":39},{"id":48,"depth":16,"text":48},{"id":54,"depth":16,"text":54},{"id":66,"depth":16,"text":66},{"id":83,"depth":16,"text":83},{"id":98,"depth":16,"text":98},[114],"生活","2024-01-30",false,{"excerpt":118},{"type":8,"value":119},[120],[11,121,35],{},"\u002Fposts\u002Flife\u002Fnew-year-plan",384900,{"title":29,"description":35},"posts\u002Flife\u002Fnew-year-plan",[127,128],"计划","随笔",[130],"life",1283,"3j0LOQ9wCsFKa7fzspHWDOMB5D7Ts3DoHdHb2fPwiyI",{"prev":134,"next":137},{"path":135,"title":136},"\u002Fposts\u002Flife\u002Fmoving-day-4","搬家的断舍离练习（四）",{"path":138,"title":139},"\u002Fposts\u002Flife\u002Fnew-year-plan-2","新年计划要怎么定才不会荒废（二）",[141,150,180],{"id":5,"title":6,"body":142,"createdAt":19,"description":13,"extension":20,"meta":148,"navigation":22,"path":23,"seo":149,"stem":25,"__hash__":26},{"type":8,"value":143,"toc":146},[144],[11,145,13],{},{"title":15,"searchDepth":16,"depth":17,"links":147},[],{},{"description":13},{"id":151,"title":152,"body":153,"createdAt":173,"description":174,"extension":20,"meta":175,"navigation":22,"path":176,"seo":177,"stem":178,"__hash__":179},"notes\u002Fnotes\u002F2026-11-14-1.md","2026 11 14 1",{"type":8,"value":154,"toc":171},[155],[11,156,157,158,162,163,170],{},"站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 ",[159,160,161],"strong",{},"Markdown","，写链接也不用到编辑器：",[164,165,169],"a",{"href":166,"rel":167},"https:\u002F\u002Fcontent.nuxt.com",[168],"nofollow","Nuxt Content","。",{"title":15,"searchDepth":16,"depth":17,"links":172},[],"2026-11-14","站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 Markdown，写链接也不用到编辑器：Nuxt Content。",{},"\u002Fnotes\u002F2026-11-14-1",{"description":174},"notes\u002F2026-11-14-1","LLJX_RKU7cgpT6aHw4DZWUZNQ_G_UzELWPKbksJvzfs",{"id":181,"title":182,"body":183,"createdAt":198,"description":199,"extension":20,"meta":200,"navigation":22,"path":201,"seo":202,"stem":203,"__hash__":204},"notes\u002Fnotes\u002F2026-11-14-2.md","2026 11 14 2",{"type":8,"value":184,"toc":196},[185],[11,186,187,191,192,195],{},[188,189,190],"code",{},"readPixels"," 读不到内容不是 bug，是 ",[188,193,194],{},"preserveDrawingBuffer"," 默认关闭——帧提交后缓冲即被清空。",{"title":15,"searchDepth":16,"depth":17,"links":197},[],"2026-11-13","readPixels 读不到内容不是 bug，是 preserveDrawingBuffer 默认关闭——帧提交后缓冲即被清空。",{},"\u002Fnotes\u002F2026-11-14-2",{"description":199},"notes\u002F2026-11-14-2","i7xWqq2eNoU_seSbLQjqlB9gE51fM-PVLUEYCHBkOA4",1795278776653]