[{"data":1,"prerenderedAt":210},["ShallowReactive",2],{"notes-latest-1":3,"post:\u002Fposts\u002Flife\u002Fbook-science-3":27,"surround:\u002Fposts\u002Flife\u002Fbook-science-3":138,"notes-latest-3":145},[4],{"id":5,"title":6,"body":7,"createdAt":19,"description":13,"extension":20,"meta":21,"navigation":22,"path":23,"seo":24,"stem":25,"__hash__":26},"notes\u002Fnotes\u002F2026-11-14-1-2.md","2026 11 14 1 2",{"type":8,"value":9,"toc":14},"minimark",[10],[11,12,13],"p",{},"站点上线了「随笔」：支持一个文件多个随笔",{"title":15,"searchDepth":16,"depth":17,"links":18},"",2,3,[],"2026-11-17","md",{},true,"\u002Fnotes\u002F2026-11-14-1-2",{"description":13},"notes\u002F2026-11-14-1-2","hDP9fvaunHzVrZQ6QifuOtj9VrqbxlPb_52KE5wSjD0",{"id":28,"title":29,"author":30,"body":31,"categories":118,"comment":22,"cover":30,"createdAt":120,"description":35,"draft":121,"extension":20,"meta":122,"navigation":22,"path":127,"readingTime":128,"recommend":121,"seo":129,"series":30,"stem":130,"tags":131,"top":121,"topics":134,"updatedAt":30,"words":136,"__hash__":137},"posts\u002Fposts\u002Flife\u002Fbook-science-3.md","科普读物的快乐（三）",null,{"type":8,"value":32,"toc":110},[33,36,40,43,46,53,56,59,62,65,68,71,74,77,80,83,86,89,92,95,98,101,104,107],[11,34,35],{},"这篇没有代码，纯记录生活，技术同学可以直接跳过，开玩笑的，看完也许有点别的收获。",[37,38,39],"h2",{"id":39},"成年人的科普窗口",[11,41,42],{},"工作之后理科知识的主要来源变成了科普读物，这个渠道比想象中优质。好的科普作者有种特殊能力，把艰深的理论讲出剧情的张力：读宇宙学的那本，从测量星光讲到宇宙膨胀，一路像侦探小说一样层层递进；讲微生物的那本更绝，把肠道菌群写成了一座永不歇业的化工厂。",[11,44,45],{},"科普读到深处还有个附加乐趣，能看到科学史上的争论和反复，那些结论是怎么被质疑、验证、推翻再重建的。了解这个过程之后，对\"科学\"两个字的理解会完全不同，它不是标准答案的集合，是一种持续自我修正的方法。",[11,47,48],{},[49,50],"img",{"alt":51,"src":52},"科普读物的快乐","\u002Fimg\u002F4.webp",[37,54,55],{"id":55},"和技术工作的联系",[11,57,58],{},"和技术工作对照着读也常有惊喜，计算机的很多设计思想在自然科学里都有原型：缓存思想在生物的新陈代谢里到处都是，分布式冗余在生态系统里是基本操作。跨界阅读的收益不是立竿见影的，但某个深夜写方案的时候，某个自然界的类比会突然冒出来，把卡住的地方捅破。这篇推几本最近读完的，书单放评论区，睡觉前的替代品还有睡前刷手机，换成科普读物，一个月后你自己看差别。",[37,60,61],{"id":61},"过程中的小心得",[11,63,64],{},"买椅子只看了颜值，腰托形同虚设，坐两小时腰就开始抗议。人体工学这几个字，是拿腰疼换来的教训，越久坐越得信。",[11,66,67],{},"给花换盆的时机不对，大夏天动的土，缓了半个月才缓过来，叶子黄了一半。换盆要赶在春秋，园艺上的讲究背后都是植物的生理规律。",[11,69,70],{},"夜跑那阵子穿深色衣服，路过没有路灯的路段被司机按喇叭提醒，回想起来一阵后怕。后来买了反光背心，几十块钱买安心。",[37,72,73],{"id":73},"延伸几句",[11,75,76],{},"独居和成家各有各的修行，我现在的体会是无论哪种状态，把生活的基础盘打理好都是第一位的：睡眠、饮食、居住环境、几个说得上话的朋友。基础盘稳了，其他的变化来了都能接得住。",[11,78,79],{},"成年人的学习和学生时代最大的不同是反馈周期，没人给你打分，效果要几个月甚至几年后才显现。所以坚持的动力只能来自内部：记录对照、阶段复盘、给自己一点小奖励，这些机制比意志力可靠得多。",[11,81,82],{},"写生活记录这几年有个体会：当时觉得不值得写的小事，事后回看反而是最鲜活的片段。反而是那些酝酿很久想认真写的“大主题”，多数烂在了草稿箱。所以现在我的原则是趁热写，先记下来，好不好以后再说。",[11,84,85],{},"生活里很多烦恼，拆开看其实是信息问题而不是命运问题：不知道怎么挑、不知道怎么做、不知道别人是怎么解决的。而信息问题基本都能靠学习和请教解决，这么一想，很多焦虑就有了着手点。",[37,87,88],{"id":88},"又想到一些",[11,90,91],{},"还有个感受越来越深：知识落地成文字的过程本身就是学习的一部分。很多自以为想清楚的东西，写出来才发现逻辑有洞。写作是最好的检验，这也是坚持写博客这么多年的理由之一，写不出来的就是还没学会的。",[11,93,94],{},"过程中也反复体会到取舍的本质：没有完美的方案，只有当下约束下最合适的方案。把约束写清楚，方案的选择题就变成了证明题，这也是为什么我习惯先列约束再谈方案，顺序反了全是无效争论。",[11,96,97],{},"想想还是补一段：任何习惯的养成都绕不开启动成本，最有效的办法是把启动成本降到接近零。想跑就把鞋放门口，想写就把文档开着置顶，环境准备到位了，行动只是顺水推舟。",[11,99,100],{},"从更高的视角看，这类问题都有一个共同结构：短期收益和长期收益打架。短期的诱惑总是具体而生动，长期的回报抽象而遥远，赢家通常是那些把长期目标拆成短期可感的小奖励的人。",[37,102,103],{"id":103},"最后",[11,105,106],{},"职业病之一是看什么都想拆步骤，这件事在我这里基本是个流程问题：目标、步骤、验证、复盘，一套下来居然还真管用。",[11,108,109],{},"这篇就写到这，希望对你有点参考价值。",{"title":15,"searchDepth":16,"depth":17,"links":111},[112,113,114,115,116,117],{"id":39,"depth":16,"text":39},{"id":55,"depth":16,"text":55},{"id":61,"depth":16,"text":61},{"id":73,"depth":16,"text":73},{"id":88,"depth":16,"text":88},{"id":103,"depth":16,"text":103},[119],"读书","2023-09-01",false,{"excerpt":123},{"type":8,"value":124},[125],[11,126,35],{},"\u002Fposts\u002Flife\u002Fbook-science-3",387000,{"title":29,"description":35},"posts\u002Flife\u002Fbook-science-3",[132,133],"科普","书单",[135],"life",1290,"3dhJ2t9tBp47Bw0CoaXqBTdnDs9CcjuNVaq5mSIJy_k",{"prev":139,"next":142},{"path":140,"title":141},"\u002Fposts\u002Flife\u002Fbook-science-2","科普读物的快乐（二）",{"path":143,"title":144},"\u002Fposts\u002Flife\u002Fbook-science-4","科普读物的快乐（四）",[146,155,185],{"id":5,"title":6,"body":147,"createdAt":19,"description":13,"extension":20,"meta":153,"navigation":22,"path":23,"seo":154,"stem":25,"__hash__":26},{"type":8,"value":148,"toc":151},[149],[11,150,13],{},{"title":15,"searchDepth":16,"depth":17,"links":152},[],{},{"description":13},{"id":156,"title":157,"body":158,"createdAt":178,"description":179,"extension":20,"meta":180,"navigation":22,"path":181,"seo":182,"stem":183,"__hash__":184},"notes\u002Fnotes\u002F2026-11-14-1.md","2026 11 14 1",{"type":8,"value":159,"toc":176},[160],[11,161,162,163,167,168,175],{},"站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 ",[164,165,166],"strong",{},"Markdown","，写链接也不用到编辑器：",[169,170,174],"a",{"href":171,"rel":172},"https:\u002F\u002Fcontent.nuxt.com",[173],"nofollow","Nuxt Content","。",{"title":15,"searchDepth":16,"depth":17,"links":177},[],"2026-11-14","站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 Markdown，写链接也不用到编辑器：Nuxt Content。",{},"\u002Fnotes\u002F2026-11-14-1",{"description":179},"notes\u002F2026-11-14-1","LLJX_RKU7cgpT6aHw4DZWUZNQ_G_UzELWPKbksJvzfs",{"id":186,"title":187,"body":188,"createdAt":203,"description":204,"extension":20,"meta":205,"navigation":22,"path":206,"seo":207,"stem":208,"__hash__":209},"notes\u002Fnotes\u002F2026-11-14-2.md","2026 11 14 2",{"type":8,"value":189,"toc":201},[190],[11,191,192,196,197,200],{},[193,194,195],"code",{},"readPixels"," 读不到内容不是 bug，是 ",[193,198,199],{},"preserveDrawingBuffer"," 默认关闭——帧提交后缓冲即被清空。",{"title":15,"searchDepth":16,"depth":17,"links":202},[],"2026-11-13","readPixels 读不到内容不是 bug，是 preserveDrawingBuffer 默认关闭——帧提交后缓冲即被清空。",{},"\u002Fnotes\u002F2026-11-14-2",{"description":204},"notes\u002F2026-11-14-2","i7xWqq2eNoU_seSbLQjqlB9gE51fM-PVLUEYCHBkOA4",1795309545733]