[{"data":1,"prerenderedAt":209},["ShallowReactive",2],{"notes-latest-1":3,"post:\u002Fposts\u002Flife\u002Fbook-science":27,"surround:\u002Fposts\u002Flife\u002Fbook-science":137,"notes-latest-3":144},[4],{"id":5,"title":6,"body":7,"createdAt":19,"description":13,"extension":20,"meta":21,"navigation":22,"path":23,"seo":24,"stem":25,"__hash__":26},"notes\u002Fnotes\u002F2026-11-14-1-2.md","2026 11 14 1 2",{"type":8,"value":9,"toc":14},"minimark",[10],[11,12,13],"p",{},"站点上线了「随笔」：支持一个文件多个随笔",{"title":15,"searchDepth":16,"depth":17,"links":18},"",2,3,[],"2026-11-17","md",{},true,"\u002Fnotes\u002F2026-11-14-1-2",{"description":13},"notes\u002F2026-11-14-1-2","hDP9fvaunHzVrZQ6QifuOtj9VrqbxlPb_52KE5wSjD0",{"id":28,"title":29,"author":30,"body":31,"categories":117,"comment":22,"cover":30,"createdAt":119,"description":35,"draft":120,"extension":20,"meta":121,"navigation":22,"path":126,"readingTime":127,"recommend":120,"seo":128,"series":30,"stem":129,"tags":130,"top":120,"topics":133,"updatedAt":30,"words":135,"__hash__":136},"posts\u002Fposts\u002Flife\u002Fbook-science.md","科普读物的快乐",null,{"type":8,"value":32,"toc":109},[33,36,40,43,46,52,55,58,61,64,67,70,73,76,79,82,85,88,91,94,97,100,103,106],[11,34,35],{},"周末闲下来，想把这件事记一笔，没什么技术含量，就是觉得有点意思，不写下来可惜。",[37,38,39],"h2",{"id":39},"成年人的科普窗口",[11,41,42],{},"工作之后理科知识的主要来源变成了科普读物，这个渠道比想象中优质。好的科普作者有种特殊能力，把艰深的理论讲出剧情的张力：读宇宙学的那本，从测量星光讲到宇宙膨胀，一路像侦探小说一样层层递进；讲微生物的那本更绝，把肠道菌群写成了一座永不歇业的化工厂。",[11,44,45],{},"科普读到深处还有个附加乐趣，能看到科学史上的争论和反复，那些结论是怎么被质疑、验证、推翻再重建的。了解这个过程之后，对\"科学\"两个字的理解会完全不同，它不是标准答案的集合，是一种持续自我修正的方法。",[11,47,48],{},[49,50],"img",{"alt":29,"src":51},"\u002Fimg\u002F4.webp",[37,53,54],{"id":54},"和技术工作的联系",[11,56,57],{},"和技术工作对照着读也常有惊喜，计算机的很多设计思想在自然科学里都有原型：缓存思想在生物的新陈代谢里到处都是，分布式冗余在生态系统里是基本操作。跨界阅读的收益不是立竿见影的，但某个深夜写方案的时候，某个自然界的类比会突然冒出来，把卡住的地方捅破。这篇推几本最近读完的，书单放评论区，睡觉前的替代品还有睡前刷手机，换成科普读物，一个月后你自己看差别。",[37,59,60],{"id":60},"过程中的小心得",[11,62,63],{},"咖啡粉磨太细，手冲出来又苦又涩还带杂味，一度怀疑是豆子的问题。调粗一格立刻正常，器材和参数的问题，别先怪豆子。",[11,65,66],{},"周末一口气睡到中午，起来反而头昏脑涨。生物钟这东西，补觉补不回来，规律比时长重要，这是身体反复教育我的。",[11,68,69],{},"搬家时纸箱没标注，晚上要找充电器，十几个箱子翻到半夜。后来每个箱子外面用马克笔写清楚内容和房间，下次搬家的自己会感谢现在的自己。",[37,71,72],{"id":72},"延伸几句",[11,74,75],{},"独居和成家各有各的修行，我现在的体会是无论哪种状态，把生活的基础盘打理好都是第一位的：睡眠、饮食、居住环境、几个说得上话的朋友。基础盘稳了，其他的变化来了都能接得住。",[11,77,78],{},"成年人的学习和学生时代最大的不同是反馈周期，没人给你打分，效果要几个月甚至几年后才显现。所以坚持的动力只能来自内部：记录对照、阶段复盘、给自己一点小奖励，这些机制比意志力可靠得多。",[11,80,81],{},"写生活记录这几年有个体会：当时觉得不值得写的小事，事后回看反而是最鲜活的片段。反而是那些酝酿很久想认真写的“大主题”，多数烂在了草稿箱。所以现在我的原则是趁热写，先记下来，好不好以后再说。",[11,83,84],{},"生活里很多烦恼，拆开看其实是信息问题而不是命运问题：不知道怎么挑、不知道怎么做、不知道别人是怎么解决的。而信息问题基本都能靠学习和请教解决，这么一想，很多焦虑就有了着手点。",[37,86,87],{"id":87},"又想到一些",[11,89,90],{},"其实回看这些年踩的坑，大坑几乎都和贪快有关。快不是错，错的是想跳过必要步骤的快，地基没打牢盖得越快塌得越响。慢下来把该做的做扎实，反而是最快的路径，这话说了很多年，每次验证都对。",[11,92,93],{},"有个观察分享给大家：技术的成长曲线不是线性的，是一段平台加一次跃迁。平台期最磨人，感觉学了很多没进步，其实是在攒素材，攒够了某个契机一到就突飞猛进。所以在平台期别否定自己，那是跃迁的前奏。",[11,95,96],{},"再补充一个角度：做这些事情的时候，工具的顺滑度影响巨大。同样的活，称手的工具能让摩擦力小一半，这种差异日积月累就是人和人的差距。定期审视自己的工具链，删掉碍事的，补上趁手的，值得当成一个固定动作。",[11,98,99],{},"由这件事联想到阅读习惯：资料要看一手来源，译文和二手转述经常带着传播者的理解偏差，偏差叠几层之后和原意面目全非。多花十分钟读原文，省下的是未来几小时的排查，这笔账怎么算都划算。",[37,101,102],{"id":102},"最后",[11,104,105],{},"这事让我想起灰度发布的思路，任何改变都别一次到位，小范围试试，没问题再推广，生活里同样适用。",[11,107,108],{},"今天的记录就到这里，晚安。",{"title":15,"searchDepth":16,"depth":17,"links":110},[111,112,113,114,115,116],{"id":39,"depth":16,"text":39},{"id":54,"depth":16,"text":54},{"id":60,"depth":16,"text":60},{"id":72,"depth":16,"text":72},{"id":87,"depth":16,"text":87},{"id":102,"depth":16,"text":102},[118],"读书","2023-03-09",false,{"excerpt":122},{"type":8,"value":123},[124],[11,125,35],{},"\u002Fposts\u002Flife\u002Fbook-science",390000,{"title":29,"description":35},"posts\u002Flife\u002Fbook-science",[131,132],"科普","书单",[134],"life",1300,"IHuV2VC8a8PJayjE03U2gNlmkm0nTT9qITB0zDfSRCE",{"prev":138,"next":141},{"path":139,"title":140},"\u002Fposts\u002Flife\u002Fbook-psychology-4","心理学入门读物推荐（四）",{"path":142,"title":143},"\u002Fposts\u002Flife\u002Fbook-science-2","科普读物的快乐（二）",[145,154,184],{"id":5,"title":6,"body":146,"createdAt":19,"description":13,"extension":20,"meta":152,"navigation":22,"path":23,"seo":153,"stem":25,"__hash__":26},{"type":8,"value":147,"toc":150},[148],[11,149,13],{},{"title":15,"searchDepth":16,"depth":17,"links":151},[],{},{"description":13},{"id":155,"title":156,"body":157,"createdAt":177,"description":178,"extension":20,"meta":179,"navigation":22,"path":180,"seo":181,"stem":182,"__hash__":183},"notes\u002Fnotes\u002F2026-11-14-1.md","2026 11 14 1",{"type":8,"value":158,"toc":175},[159],[11,160,161,162,166,167,174],{},"站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 ",[163,164,165],"strong",{},"Markdown","，写链接也不用到编辑器：",[168,169,173],"a",{"href":170,"rel":171},"https:\u002F\u002Fcontent.nuxt.com",[172],"nofollow","Nuxt Content","。",{"title":15,"searchDepth":16,"depth":17,"links":176},[],"2026-11-14","站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 Markdown，写链接也不用到编辑器：Nuxt Content。",{},"\u002Fnotes\u002F2026-11-14-1",{"description":178},"notes\u002F2026-11-14-1","LLJX_RKU7cgpT6aHw4DZWUZNQ_G_UzELWPKbksJvzfs",{"id":185,"title":186,"body":187,"createdAt":202,"description":203,"extension":20,"meta":204,"navigation":22,"path":205,"seo":206,"stem":207,"__hash__":208},"notes\u002Fnotes\u002F2026-11-14-2.md","2026 11 14 2",{"type":8,"value":188,"toc":200},[189],[11,190,191,195,196,199],{},[192,193,194],"code",{},"readPixels"," 读不到内容不是 bug，是 ",[192,197,198],{},"preserveDrawingBuffer"," 默认关闭——帧提交后缓冲即被清空。",{"title":15,"searchDepth":16,"depth":17,"links":201},[],"2026-11-13","readPixels 读不到内容不是 bug，是 preserveDrawingBuffer 默认关闭——帧提交后缓冲即被清空。",{},"\u002Fnotes\u002F2026-11-14-2",{"description":203},"notes\u002F2026-11-14-2","i7xWqq2eNoU_seSbLQjqlB9gE51fM-PVLUEYCHBkOA4",1795783651586]