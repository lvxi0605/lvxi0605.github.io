[{"data":1,"prerenderedAt":211},["ShallowReactive",2],{"notes-latest-1":3,"post:\u002Fposts\u002Flife\u002Fbalcony-plants":27,"surround:\u002Fposts\u002Flife\u002Fbalcony-plants":139,"notes-latest-3":146},[4],{"id":5,"title":6,"body":7,"createdAt":19,"description":13,"extension":20,"meta":21,"navigation":22,"path":23,"seo":24,"stem":25,"__hash__":26},"notes\u002Fnotes\u002F2026-11-14-1-2.md","2026 11 14 1 2",{"type":8,"value":9,"toc":14},"minimark",[10],[11,12,13],"p",{},"站点上线了「随笔」：支持一个文件多个随笔",{"title":15,"searchDepth":16,"depth":17,"links":18},"",2,3,[],"2026-11-17","md",{},true,"\u002Fnotes\u002F2026-11-14-1-2",{"description":13},"notes\u002F2026-11-14-1-2","hDP9fvaunHzVrZQ6QifuOtj9VrqbxlPb_52KE5wSjD0",{"id":28,"title":29,"author":30,"body":31,"categories":119,"comment":22,"cover":30,"createdAt":121,"description":35,"draft":122,"extension":20,"meta":123,"navigation":22,"path":128,"readingTime":129,"recommend":122,"seo":130,"series":30,"stem":131,"tags":132,"top":122,"topics":135,"updatedAt":30,"words":137,"__hash__":138},"posts\u002Fposts\u002Flife\u002Fbalcony-plants.md","阳台上的植物观察日记",null,{"type":8,"value":32,"toc":111},[33,36,40,43,46,52,55,58,61,64,67,70,73,76,79,82,85,87,90,93,96,99,102,105,108],[11,34,35],{},"最近节奏慢了一些，多了点观察生活的时间，这篇就是这么来的。",[37,38,39],"h2",{"id":39},"这半年的阵容",[11,41,42],{},"阳台现在的阵容：两盆绿萝、一盆薄荷、三盆多肉、一株番茄，还有一把半死不活的迷迭香。半年下来总结出一条铁律，植物的大部分死因是浇水太勤而不是太懒，我爸第一次来我家看了一眼就说，你这绿萝是泡死的吧，当场社死。",[11,44,45],{},"开始记录之后发现植物其实很有规律：薄荷喜水疯长，一周不见就蹿一截，掐尖之后越来越茂盛；多肉恰恰相反，管得越少状态越好；番茄看着柔弱其实最皮实，就是需要晒足太阳，朝向比施肥重要。",[11,47,48],{},[49,50],"img",{"alt":29,"src":51},"\u002Fimg\u002F2.webp",[37,53,54],{"id":54},"慢下来的练习",[11,56,57],{},"养植物给我最大的收获是接受了\"慢\"这个概念。种下番茄苗到结出第一颗果子要两个多月，这中间急不得，能做的就是浇对水、给足光，然后等。这种确定性的等待在工作里反而很稀缺，工作里的事情大部分是急而不可控的。每天早上浇水的十分钟，算是给一天定的一个安静的起始页。顺手拍了几张照片放在这篇里，薄荷长势最好。",[37,59,60],{"id":60},"一点反思",[11,62,63],{},"随手记两个小教训：阳台那盆绿萝浇得太勤，根都泡烂了，剪掉烂的部分重新扦插，现在改了策略，土干了再浇，反倒精神了不少。",[11,65,66],{},"煮饭水放多了，成品介于饭和粥之间。后来老老实实用量杯，或者直接看水位线，凭感觉这种事，在厨房里基本靠不住。",[11,68,69],{},"跑步前偷懒不做热身，膝盖不舒服了整整一周。现在哪怕时间紧张，也留五分钟活动开，这个时间省不得。",[37,71,72],{"id":72},"顺便一提",[11,74,75],{},"写生活记录这几年有个体会：当时觉得不值得写的小事，事后回看反而是最鲜活的片段。反而是那些酝酿很久想认真写的“大主题”，多数烂在了草稿箱。所以现在我的原则是趁热写，先记下来，好不好以后再说。",[11,77,78],{},"生活里很多烦恼，拆开看其实是信息问题而不是命运问题：不知道怎么挑、不知道怎么做、不知道别人是怎么解决的。而信息问题基本都能靠学习和请教解决，这么一想，很多焦虑就有了着手点。",[11,80,81],{},"独居和成家各有各的修行，我现在的体会是无论哪种状态，把生活的基础盘打理好都是第一位的：睡眠、饮食、居住环境、几个说得上话的朋友。基础盘稳了，其他的变化来了都能接得住。",[11,83,84],{},"成年人的学习和学生时代最大的不同是反馈周期，没人给你打分，效果要几个月甚至几年后才显现。所以坚持的动力只能来自内部：记录对照、阶段复盘、给自己一点小奖励，这些机制比意志力可靠得多。",[11,86,75],{},[37,88,89],{"id":89},"另外记几笔",[11,91,92],{},"从更高的视角看，这类问题都有一个共同结构：短期收益和长期收益打架。短期的诱惑总是具体而生动，长期的回报抽象而遥远，赢家通常是那些把长期目标拆成短期可感的小奖励的人。",[11,94,95],{},"讲个题外话，做这类事情的时候最好留个记录的习惯，当时的判断依据比结果更珍贵。结果好可能只是运气好，把决策过程记下来，好运才可能被复制，坏运才可能被规避。",[11,97,98],{},"然后想说，承认不懂是这行的美德。这次遇到不懂的地方，老老实实补了两天的课，比硬着头皮往上糊的方案强太多。不懂装懂的代价从来不会消失，只是延期，还带利息。",[11,100,101],{},"平衡感很重要的一件事：投入和收益的比例。所有优化都值得先问一句，这件事的收益上限是多少，值多少投入。无限打磨一个低价值的东西是工程师最常见的温柔陷阱，包括我自己在内。",[37,103,104],{"id":104},"写在最后",[11,106,107],{},"整个过程我写成了 checklist，下次照着走一遍就行，果然顺利多了。重复出现的事情就该被固化成流程，工作里如此，生活里也是。",[11,109,110],{},"这篇就先这样，想到了什么再回来补。",{"title":15,"searchDepth":16,"depth":17,"links":112},[113,114,115,116,117,118],{"id":39,"depth":16,"text":39},{"id":54,"depth":16,"text":54},{"id":60,"depth":16,"text":60},{"id":72,"depth":16,"text":72},{"id":89,"depth":16,"text":89},{"id":104,"depth":16,"text":104},[120],"生活","2022-07-23",false,{"excerpt":124},{"type":8,"value":125},[126],[11,127,35],{},"\u002Fposts\u002Flife\u002Fbalcony-plants",381600,{"title":29,"description":35},"posts\u002Flife\u002Fbalcony-plants",[133,134],"植物","阳台",[136],"life",1272,"FVY29mBsIEsGzxlZ6IOhsy_yiXU3wk-G_2CsCkTPMg8",{"prev":140,"next":143},{"path":141,"title":142},"\u002Fposts\u002Fjvm\u002Fjvm-memory-area-6","JVM 运行时内存区域梳理（六）",{"path":144,"title":145},"\u002Fposts\u002Flife\u002Fbalcony-plants-2","阳台上的植物观察日记（二）",[147,156,186],{"id":5,"title":6,"body":148,"createdAt":19,"description":13,"extension":20,"meta":154,"navigation":22,"path":23,"seo":155,"stem":25,"__hash__":26},{"type":8,"value":149,"toc":152},[150],[11,151,13],{},{"title":15,"searchDepth":16,"depth":17,"links":153},[],{},{"description":13},{"id":157,"title":158,"body":159,"createdAt":179,"description":180,"extension":20,"meta":181,"navigation":22,"path":182,"seo":183,"stem":184,"__hash__":185},"notes\u002Fnotes\u002F2026-11-14-1.md","2026 11 14 1",{"type":8,"value":160,"toc":177},[161],[11,162,163,164,168,169,176],{},"站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 ",[165,166,167],"strong",{},"Markdown","，写链接也不用到编辑器：",[170,171,175],"a",{"href":172,"rel":173},"https:\u002F\u002Fcontent.nuxt.com",[174],"nofollow","Nuxt Content","。",{"title":15,"searchDepth":16,"depth":17,"links":178},[],"2026-11-14","站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 Markdown，写链接也不用到编辑器：Nuxt Content。",{},"\u002Fnotes\u002F2026-11-14-1",{"description":180},"notes\u002F2026-11-14-1","LLJX_RKU7cgpT6aHw4DZWUZNQ_G_UzELWPKbksJvzfs",{"id":187,"title":188,"body":189,"createdAt":204,"description":205,"extension":20,"meta":206,"navigation":22,"path":207,"seo":208,"stem":209,"__hash__":210},"notes\u002Fnotes\u002F2026-11-14-2.md","2026 11 14 2",{"type":8,"value":190,"toc":202},[191],[11,192,193,197,198,201],{},[194,195,196],"code",{},"readPixels"," 读不到内容不是 bug，是 ",[194,199,200],{},"preserveDrawingBuffer"," 默认关闭——帧提交后缓冲即被清空。",{"title":15,"searchDepth":16,"depth":17,"links":203},[],"2026-11-13","readPixels 读不到内容不是 bug，是 preserveDrawingBuffer 默认关闭——帧提交后缓冲即被清空。",{},"\u002Fnotes\u002F2026-11-14-2",{"description":205},"notes\u002F2026-11-14-2","i7xWqq2eNoU_seSbLQjqlB9gE51fM-PVLUEYCHBkOA4",1795274115343]