[{"data":1,"prerenderedAt":213},["ShallowReactive",2],{"notes-latest-1":3,"post:\u002Fposts\u002Flife\u002Flate-night-canteen-3":27,"surround:\u002Fposts\u002Flife\u002Flate-night-canteen-3":141,"notes-latest-3":148},[4],{"id":5,"title":6,"body":7,"createdAt":19,"description":13,"extension":20,"meta":21,"navigation":22,"path":23,"seo":24,"stem":25,"__hash__":26},"notes\u002Fnotes\u002F2026-11-14-1-2.md","2026 11 14 1 2",{"type":8,"value":9,"toc":14},"minimark",[10],[11,12,13],"p",{},"站点上线了「随笔」：支持一个文件多个随笔",{"title":15,"searchDepth":16,"depth":17,"links":18},"",2,3,[],"2026-11-17","md",{},true,"\u002Fnotes\u002F2026-11-14-1-2",{"description":13},"notes\u002F2026-11-14-1-2","hDP9fvaunHzVrZQ6QifuOtj9VrqbxlPb_52KE5wSjD0",{"id":28,"title":29,"author":30,"body":31,"categories":121,"comment":22,"cover":30,"createdAt":123,"description":35,"draft":124,"extension":20,"meta":125,"navigation":22,"path":130,"readingTime":131,"recommend":124,"seo":132,"series":30,"stem":133,"tags":134,"top":124,"topics":137,"updatedAt":30,"words":139,"__hash__":140},"posts\u002Fposts\u002Flife\u002Flate-night-canteen-3.md","加班晚归后的深夜食堂（三）",null,{"type":8,"value":32,"toc":113},[33,36,40,43,46,53,56,59,62,65,68,71,74,77,80,83,86,89,92,95,98,101,104,107,110],[11,34,35],{},"天气不错的一个周末，出去走了走，回来顺手把当天的感受记下来。",[37,38,39],"h2",{"id":39},"楼下的那家小面馆",[11,41,42],{},"加班到十点半，地铁口楼下的面馆还亮着灯。老板认得我，不用开口，一碗牛肉面加个蛋，汤宽面硬，二十分钟端上来。店里没几个人，电视放着没人看的剧，筷子碰到碗的声音特别清楚。",[11,44,45],{},"我常想，这家店对我来说到底是吃饭的地方还是某种心理安慰。后来想明白了，加班的疲惫一半来自大脑持续运转后的空虚，而一碗热汤面正好是从工作模式切回生活模式的仪式，汤下肚的那一刻，那些没改完的 bug 就不属于今晚了。",[11,47,48],{},[49,50],"img",{"alt":51,"src":52},"加班晚归后的深夜食堂","\u002Fimg\u002F1.jpg",[37,54,55],{"id":55},"深夜的观察",[11,57,58],{},"店里的常客还有代驾司机、酒吧下班的姑娘、跑外卖的小哥，大家互不打扰，又莫名地有一种同是晚归人的默契。偶尔老板娘会和熟客聊两句家长里短，声音不大，混在汤锅的咕嘟声里。",[11,60,61],{},"写到这里忽然想起来，这家店开了五年，我吃了五年，价格只涨过一次，五块钱。生活里很多这样的小店，不惊艳，但稳稳地在那里，像某个不太说话的老朋友。这篇没什么中心思想，就是今晚吃完面走回家的路上，忽然想把这件事记下来。",[37,63,64],{"id":64},"记下两点",[11,66,67],{},"健身房年卡办完去了一次半，钱花得毫无水花。后来改成按次买，反而每周都去。消费习惯这件事，沉没成本越高越不想动，适合别人的不一定适合自己。",[11,69,70],{},"加湿器开一整夜，窗台上全是水汽，墙角都有点返潮。买了个湿度计才知道，舒服的湿度是个区间，不是越大越好，很多事都是这个道理。",[11,72,73],{},"桌面充电线缠成一团，剪也剪不开理也理不清。十块钱的理线器加几个标签贴，一次到位。这种小钱花出去，回报率出奇地高。",[37,75,76],{"id":76},"多聊两句",[11,78,79],{},"独居和成家各有各的修行，我现在的体会是无论哪种状态，把生活的基础盘打理好都是第一位的：睡眠、饮食、居住环境、几个说得上话的朋友。基础盘稳了，其他的变化来了都能接得住。",[11,81,82],{},"成年人的学习和学生时代最大的不同是反馈周期，没人给你打分，效果要几个月甚至几年后才显现。所以坚持的动力只能来自内部：记录对照、阶段复盘、给自己一点小奖励，这些机制比意志力可靠得多。",[11,84,85],{},"写生活记录这几年有个体会：当时觉得不值得写的小事，事后回看反而是最鲜活的片段。反而是那些酝酿很久想认真写的“大主题”，多数烂在了草稿箱。所以现在我的原则是趁热写，先记下来，好不好以后再说。",[11,87,88],{},"生活里很多烦恼，拆开看其实是信息问题而不是命运问题：不知道怎么挑、不知道怎么做、不知道别人是怎么解决的。而信息问题基本都能靠学习和请教解决，这么一想，很多焦虑就有了着手点。",[37,90,91],{"id":91},"继续聊聊",[11,93,94],{},"平衡感很重要的一件事：投入和收益的比例。所有优化都值得先问一句，这件事的收益上限是多少，值多少投入。无限打磨一个低价值的东西是工程师最常见的温柔陷阱，包括我自己在内。",[11,96,97],{},"忍不住再夸一下记录的力量，上周刚整理的笔记，这次直接翻出来就用，十分钟解决了当时花一下午的问题。给自己留下的每一份笔记，都是寄给未来的快递，寄件人签收时才觉得真香。",[11,99,100],{},"最后聊点感受：做技术这些年，越来越觉得最好的状态是既投入又抽离。投入是把事情做好，抽离是时不时跳出来看看方向对不对，两者缺一，要么辛苦没产出，要么轻松跑偏路。",[11,102,103],{},"写着写着想到，很多技术选择本质上都是在回答同一个问题：这个方案在出问题的时候是什么样子。不出问题的方案人人都写得出来，区分度全在故障时刻的表现。多想一层失败路径，很多纠结就自动有了答案。",[37,105,106],{"id":106},"最后",[11,108,109],{},"搞技术久了习惯找根因，生活里的很多问题其实也适用：先定位，再动手，别一上来就凭感觉乱试。",[11,111,112],{},"今天的记录就到这里，晚安。",{"title":15,"searchDepth":16,"depth":17,"links":114},[115,116,117,118,119,120],{"id":39,"depth":16,"text":39},{"id":55,"depth":16,"text":55},{"id":64,"depth":16,"text":64},{"id":76,"depth":16,"text":76},{"id":91,"depth":16,"text":91},{"id":106,"depth":16,"text":106},[122],"生活","2022-11-07",false,{"excerpt":126},{"type":8,"value":127},[128],[11,129,35],{},"\u002Fposts\u002Flife\u002Flate-night-canteen-3",374100,{"title":29,"description":35},"posts\u002Flife\u002Flate-night-canteen-3",[135,136],"夜宵","随笔",[138],"life",1247,"QPAURqYdPLXRHwv3ycULgqLAxEjrF3GwVFg1KdDR1GY",{"prev":142,"next":145},{"path":143,"title":144},"\u002Fposts\u002Flife\u002Flate-night-canteen-2","加班晚归后的深夜食堂（二）",{"path":146,"title":147},"\u002Fposts\u002Flife\u002Flate-night-canteen-4","加班晚归后的深夜食堂（四）",[149,158,188],{"id":5,"title":6,"body":150,"createdAt":19,"description":13,"extension":20,"meta":156,"navigation":22,"path":23,"seo":157,"stem":25,"__hash__":26},{"type":8,"value":151,"toc":154},[152],[11,153,13],{},{"title":15,"searchDepth":16,"depth":17,"links":155},[],{},{"description":13},{"id":159,"title":160,"body":161,"createdAt":181,"description":182,"extension":20,"meta":183,"navigation":22,"path":184,"seo":185,"stem":186,"__hash__":187},"notes\u002Fnotes\u002F2026-11-14-1.md","2026 11 14 1",{"type":8,"value":162,"toc":179},[163],[11,164,165,166,170,171,178],{},"站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 ",[167,168,169],"strong",{},"Markdown","，写链接也不用到编辑器：",[172,173,177],"a",{"href":174,"rel":175},"https:\u002F\u002Fcontent.nuxt.com",[176],"nofollow","Nuxt Content","。",{"title":15,"searchDepth":16,"depth":17,"links":180},[],"2026-11-14","站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 Markdown，写链接也不用到编辑器：Nuxt Content。",{},"\u002Fnotes\u002F2026-11-14-1",{"description":182},"notes\u002F2026-11-14-1","LLJX_RKU7cgpT6aHw4DZWUZNQ_G_UzELWPKbksJvzfs",{"id":189,"title":190,"body":191,"createdAt":206,"description":207,"extension":20,"meta":208,"navigation":22,"path":209,"seo":210,"stem":211,"__hash__":212},"notes\u002Fnotes\u002F2026-11-14-2.md","2026 11 14 2",{"type":8,"value":192,"toc":204},[193],[11,194,195,199,200,203],{},[196,197,198],"code",{},"readPixels"," 读不到内容不是 bug，是 ",[196,201,202],{},"preserveDrawingBuffer"," 默认关闭——帧提交后缓冲即被清空。",{"title":15,"searchDepth":16,"depth":17,"links":205},[],"2026-11-13","readPixels 读不到内容不是 bug，是 preserveDrawingBuffer 默认关闭——帧提交后缓冲即被清空。",{},"\u002Fnotes\u002F2026-11-14-2",{"description":207},"notes\u002F2026-11-14-2","i7xWqq2eNoU_seSbLQjqlB9gE51fM-PVLUEYCHBkOA4",1795274117002]