[{"data":1,"prerenderedAt":209},["ShallowReactive",2],{"notes-latest-1":3,"post:\u002Fposts\u002Flife\u002Fcooking-fail":27,"surround:\u002Fposts\u002Flife\u002Fcooking-fail":137,"notes-latest-3":144},[4],{"id":5,"title":6,"body":7,"createdAt":19,"description":13,"extension":20,"meta":21,"navigation":22,"path":23,"seo":24,"stem":25,"__hash__":26},"notes\u002Fnotes\u002F2026-11-14-1-2.md","2026 11 14 1 2",{"type":8,"value":9,"toc":14},"minimark",[10],[11,12,13],"p",{},"站点上线了「随笔」：支持一个文件多个随笔",{"title":15,"searchDepth":16,"depth":17,"links":18},"",2,3,[],"2026-11-17","md",{},true,"\u002Fnotes\u002F2026-11-14-1-2",{"description":13},"notes\u002F2026-11-14-1-2","hDP9fvaunHzVrZQ6QifuOtj9VrqbxlPb_52KE5wSjD0",{"id":28,"title":29,"author":30,"body":31,"categories":117,"comment":22,"cover":30,"createdAt":119,"description":35,"draft":120,"extension":20,"meta":121,"navigation":22,"path":126,"readingTime":127,"recommend":120,"seo":128,"series":30,"stem":129,"tags":130,"top":120,"topics":133,"updatedAt":30,"words":135,"__hash__":136},"posts\u002Fposts\u002Flife\u002Fcooking-fail.md","做饭翻车实录三则",null,{"type":8,"value":32,"toc":109},[33,36,41,44,47,50,53,56,59,62,65,68,71,74,77,80,83,85,88,91,94,97,100,103,106],[11,34,35],{},"起因是和朋友聊到这个话题，聊完发现我们的做法完全不同，回来想想还是记录一下我的版本。",[37,38,40],"h2",{"id":39},"翻车一糖盐之争","翻车一：糖盐之争",[11,42,43],{},"第一则，把盐当成糖放进了红烧肉。当时在做别的事，调料盒随手一拿，出锅尝了一口就明白了，一锅肉咸得离谱，兑水救不回来，最后加土豆加豆腐硬是吃完了。教训是调料盒上贴了标签，看似多此一举，实际救过我好几次。",[11,45,46],{},"第二则，油炸忘了控制油温，下锅的鸡翅外面糊了里面还是生的。拿着温度计复测之后才发现，油温这个东西，用眼睛看泡沫真的不准。",[37,48,49],{"id":49},"翻车三与总结",[11,51,52],{},"第三则最离谱，蒸鸡蛋羹忘了盖保鲜膜，水汽滴进去，出来一个月球表面。后来学乖了，盖膜扎孔中火蒸，嫩得像布丁。",[11,54,55],{},"把三次翻车写出来其实想说一件事：做饭和写代码太像了，都是流程加参数，翻车都有明确的根因，复现一次基本就根治了。现在的我翻车率大幅下降，家里领导评价\"从不敢恭维到可以入口\"，这个进步曲线我非常满意。",[37,57,58],{"id":58},"过程中的小心得",[11,60,61],{},"冰箱塞得太满，冷风吹不到后排，最里面的菜悄悄坏掉才发现。留出空隙让空气流通，食物和代码里的缓存一样，堆太满就要出问题。",[11,63,64],{},"手机最近电量崩得快，一顿排查，关掉几个常年后台自启的应用，续航立刻回来。数码产品的衰退，很多时候不是硬件老了，是软件攒的债。",[11,66,67],{},"买椅子只看了颜值，腰托形同虚设，坐两小时腰就开始抗议。人体工学这几个字，是拿腰疼换来的教训，越久坐越得信。",[37,69,70],{"id":70},"延伸几句",[11,72,73],{},"独居和成家各有各的修行，我现在的体会是无论哪种状态，把生活的基础盘打理好都是第一位的：睡眠、饮食、居住环境、几个说得上话的朋友。基础盘稳了，其他的变化来了都能接得住。",[11,75,76],{},"成年人的学习和学生时代最大的不同是反馈周期，没人给你打分，效果要几个月甚至几年后才显现。所以坚持的动力只能来自内部：记录对照、阶段复盘、给自己一点小奖励，这些机制比意志力可靠得多。",[11,78,79],{},"写生活记录这几年有个体会：当时觉得不值得写的小事，事后回看反而是最鲜活的片段。反而是那些酝酿很久想认真写的“大主题”，多数烂在了草稿箱。所以现在我的原则是趁热写，先记下来，好不好以后再说。",[11,81,82],{},"生活里很多烦恼，拆开看其实是信息问题而不是命运问题：不知道怎么挑、不知道怎么做、不知道别人是怎么解决的。而信息问题基本都能靠学习和请教解决，这么一想，很多焦虑就有了着手点。",[11,84,73],{},[37,86,87],{"id":87},"又想到一些",[11,89,90],{},"最后聊点感受：做技术这些年，越来越觉得最好的状态是既投入又抽离。投入是把事情做好，抽离是时不时跳出来看看方向对不对，两者缺一，要么辛苦没产出，要么轻松跑偏路。",[11,92,93],{},"写着写着想到，很多技术选择本质上都是在回答同一个问题：这个方案在出问题的时候是什么样子。不出问题的方案人人都写得出来，区分度全在故障时刻的表现。多想一层失败路径，很多纠结就自动有了答案。",[11,95,96],{},"这类经验在文档里通常只有一行字，背后的排查却是一整个下午。技术工作的大部分时间都花在这些不会写进简历的细节里，所以这些细节才更需要有人写出来，哪怕只是给未来某一天忘了的自己。",[11,98,99],{},"顺带聊聊方法论：遇到不熟悉的领域，我的习惯是先把最小闭环跑通，哪怕每一步都很粗糙。跑通之后再逐段替换成正经实现，过程中每一步都有可运行的版本。这个思路在工作和生活里都屡试不爽，比憋大招的成功率高得多。",[37,101,102],{"id":102},"最后",[11,104,105],{},"搞技术久了习惯找根因，生活里的很多问题其实也适用：先定位，再动手，别一上来就凭感觉乱试。",[11,107,108],{},"剩下的想起来再记，这篇到此为止。",{"title":15,"searchDepth":16,"depth":17,"links":110},[111,112,113,114,115,116],{"id":39,"depth":16,"text":40},{"id":49,"depth":16,"text":49},{"id":58,"depth":16,"text":58},{"id":70,"depth":16,"text":70},{"id":87,"depth":16,"text":87},{"id":102,"depth":16,"text":102},[118],"生活","2025-05-04",false,{"excerpt":122},{"type":8,"value":123},[124],[11,125,35],{},"\u002Fposts\u002Flife\u002Fcooking-fail",384600,{"title":29,"description":35},"posts\u002Flife\u002Fcooking-fail",[131,132],"做饭","翻车",[134],"life",1282,"Pufm10uhwe14H69_grQZOvaVXCCnPWJrQI1mfOXbRXU",{"prev":138,"next":141},{"path":139,"title":140},"\u002Fposts\u002Flife\u002Fchildhood-games-4","小时候我们都玩过什么（四）",{"path":142,"title":143},"\u002Fposts\u002Flife\u002Fcooking-fail-2","做饭翻车实录三则（二）",[145,154,184],{"id":5,"title":6,"body":146,"createdAt":19,"description":13,"extension":20,"meta":152,"navigation":22,"path":23,"seo":153,"stem":25,"__hash__":26},{"type":8,"value":147,"toc":150},[148],[11,149,13],{},{"title":15,"searchDepth":16,"depth":17,"links":151},[],{},{"description":13},{"id":155,"title":156,"body":157,"createdAt":177,"description":178,"extension":20,"meta":179,"navigation":22,"path":180,"seo":181,"stem":182,"__hash__":183},"notes\u002Fnotes\u002F2026-11-14-1.md","2026 11 14 1",{"type":8,"value":158,"toc":175},[159],[11,160,161,162,166,167,174],{},"站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 ",[163,164,165],"strong",{},"Markdown","，写链接也不用到编辑器：",[168,169,173],"a",{"href":170,"rel":171},"https:\u002F\u002Fcontent.nuxt.com",[172],"nofollow","Nuxt Content","。",{"title":15,"searchDepth":16,"depth":17,"links":176},[],"2026-11-14","站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 Markdown，写链接也不用到编辑器：Nuxt Content。",{},"\u002Fnotes\u002F2026-11-14-1",{"description":178},"notes\u002F2026-11-14-1","LLJX_RKU7cgpT6aHw4DZWUZNQ_G_UzELWPKbksJvzfs",{"id":185,"title":186,"body":187,"createdAt":202,"description":203,"extension":20,"meta":204,"navigation":22,"path":205,"seo":206,"stem":207,"__hash__":208},"notes\u002Fnotes\u002F2026-11-14-2.md","2026 11 14 2",{"type":8,"value":188,"toc":200},[189],[11,190,191,195,196,199],{},[192,193,194],"code",{},"readPixels"," 读不到内容不是 bug，是 ",[192,197,198],{},"preserveDrawingBuffer"," 默认关闭——帧提交后缓冲即被清空。",{"title":15,"searchDepth":16,"depth":17,"links":201},[],"2026-11-13","readPixels 读不到内容不是 bug，是 preserveDrawingBuffer 默认关闭——帧提交后缓冲即被清空。",{},"\u002Fnotes\u002F2026-11-14-2",{"description":203},"notes\u002F2026-11-14-2","i7xWqq2eNoU_seSbLQjqlB9gE51fM-PVLUEYCHBkOA4",1795303395805]