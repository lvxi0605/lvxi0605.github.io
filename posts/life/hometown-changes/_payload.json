[{"data":1,"prerenderedAt":215},["ShallowReactive",2],{"notes-latest-1":3,"post:\u002Fposts\u002Flife\u002Fhometown-changes":27,"surround:\u002Fposts\u002Flife\u002Fhometown-changes":143,"notes-latest-3":150},[4],{"id":5,"title":6,"body":7,"createdAt":19,"description":13,"extension":20,"meta":21,"navigation":22,"path":23,"seo":24,"stem":25,"__hash__":26},"notes\u002Fnotes\u002F2026-11-14-1-2.md","2026 11 14 1 2",{"type":8,"value":9,"toc":14},"minimark",[10],[11,12,13],"p",{},"站点上线了「随笔」：支持一个文件多个随笔",{"title":15,"searchDepth":16,"depth":17,"links":18},"",2,3,[],"2026-11-17","md",{},true,"\u002Fnotes\u002F2026-11-14-1-2",{"description":13},"notes\u002F2026-11-14-1-2","hDP9fvaunHzVrZQ6QifuOtj9VrqbxlPb_52KE5wSjD0",{"id":28,"title":29,"author":30,"body":31,"categories":123,"comment":22,"cover":30,"createdAt":125,"description":35,"draft":126,"extension":20,"meta":127,"navigation":22,"path":132,"readingTime":133,"recommend":126,"seo":134,"series":30,"stem":135,"tags":136,"top":126,"topics":139,"updatedAt":30,"words":141,"__hash__":142},"posts\u002Fposts\u002Flife\u002Fhometown-changes.md","回老家的见闻",null,{"type":8,"value":32,"toc":115},[33,36,41,44,47,53,56,59,62,65,68,71,74,77,80,83,86,89,91,94,97,100,103,106,109,112],[11,34,35],{},"天气不错的一个周末，出去走了走，回来顺手把当天的感受记下来。",[37,38,40],"h2",{"id":39},"路是新的人是旧的","路是新的，人是旧的",[11,42,43],{},"国庆回老家，发现镇上通了新的柏油路，导航都来不及更新的那种新。小时候觉得特别长的那条上学路，开车两分钟就走完了，路两边的店铺换了一轮，但理发店还开着，老板的发型和二十年前一样，也是某种意义上的业务稳定。",[11,45,46],{},"亲戚家的小孩在饭桌上讨论大学志愿，问我软件工程怎么样。我讲了讲这行的好处和最近的变化，讲完自己都有点恍惚，当年我选这个专业的时候，对\"软件工程师\"这五个字的想象和现在完全是两个行业了。",[11,48,49],{},[50,51],"img",{"alt":29,"src":52},"\u002Fimg\u002F3.webp",[37,54,55],{"id":55},"一些没变的东西",[11,57,58],{},"有些东西倒是一点没变。清早的菜市场还是那个声音密度，家里那条狗换了三代但见我的态度一样，外婆灶台上那口汤锅永远在火上。在城市待久了，回去的几天作息会自动切换到日出而作，睡得早起得早，脸色都好一些。",[11,60,61],{},"返程的高铁上看着窗外往后跑，忽然觉得老家和城市的区别其实是时间流速的区别，一个按季度过，一个按周度过。一年回去两三次，每次都在提醒我，还有一种节奏存在着。",[37,63,64],{"id":64},"过程中的小心得",[11,66,67],{},"煮饭水放多了，成品介于饭和粥之间。后来老老实实用量杯，或者直接看水位线，凭感觉这种事，在厨房里基本靠不住。",[11,69,70],{},"跑步前偷懒不做热身，膝盖不舒服了整整一周。现在哪怕时间紧张，也留五分钟活动开，这个时间省不得。",[11,72,73],{},"咖啡粉磨太细，手冲出来又苦又涩还带杂味，一度怀疑是豆子的问题。调粗一格立刻正常，器材和参数的问题，别先怪豆子。",[37,75,76],{"id":76},"延伸几句",[11,78,79],{},"独居和成家各有各的修行，我现在的体会是无论哪种状态，把生活的基础盘打理好都是第一位的：睡眠、饮食、居住环境、几个说得上话的朋友。基础盘稳了，其他的变化来了都能接得住。",[11,81,82],{},"成年人的学习和学生时代最大的不同是反馈周期，没人给你打分，效果要几个月甚至几年后才显现。所以坚持的动力只能来自内部：记录对照、阶段复盘、给自己一点小奖励，这些机制比意志力可靠得多。",[11,84,85],{},"写生活记录这几年有个体会：当时觉得不值得写的小事，事后回看反而是最鲜活的片段。反而是那些酝酿很久想认真写的“大主题”，多数烂在了草稿箱。所以现在我的原则是趁热写，先记下来，好不好以后再说。",[11,87,88],{},"生活里很多烦恼，拆开看其实是信息问题而不是命运问题：不知道怎么挑、不知道怎么做、不知道别人是怎么解决的。而信息问题基本都能靠学习和请教解决，这么一想，很多焦虑就有了着手点。",[11,90,79],{},[37,92,93],{"id":93},"又想到一些",[11,95,96],{},"另外觉得这件事里有个普遍适用的规律：复杂度不会消失，只会转移。你省掉的每一步设计，最后都会在排查、扩容或者交接的某个时刻加倍还回来。所谓好的方案，不过是把复杂度放到了值得的位置。",[11,98,99],{},"回顾这个过程，最大的教训其实是克制。可选项永远比需要的多，每个新方案看起来都比现状好一点，但都加上之后，系统就成了没人看得懂的拼贴画。做减法的判断比做加法的胆子更值钱。",[11,101,102],{},"这种事急不来，和锻炼身体是一个道理：练一天没变化，练三个月身体自己会说话。技术积累也是这样，每天一点，回过头看的时候差距已经拉开了，只是身在其中感觉不到而已。",[11,104,105],{},"想到一个问题：为什么同样的事情，不同的人做出来差别那么大。后来觉得答案在于对边界的处理，正常路径人人会写，边界和异常的处理习惯才是拉开差距的地方。做事和写代码一样，细节的密度决定成品的质量。",[37,107,108],{"id":108},"写在最后",[11,110,111],{},"这事让我想起灰度发布的思路，任何改变都别一次到位，小范围试试，没问题再推广，生活里同样适用。",[11,113,114],{},"暂时记到这，下次接着说。",{"title":15,"searchDepth":16,"depth":17,"links":116},[117,118,119,120,121,122],{"id":39,"depth":16,"text":40},{"id":55,"depth":16,"text":55},{"id":64,"depth":16,"text":64},{"id":76,"depth":16,"text":76},{"id":93,"depth":16,"text":93},{"id":108,"depth":16,"text":108},[124],"生活","2024-07-28",false,{"excerpt":128},{"type":8,"value":129},[130],[11,131,35],{},"\u002Fposts\u002Flife\u002Fhometown-changes",392100,{"title":29,"description":35},"posts\u002Flife\u002Fhometown-changes",[137,138],"老家","随笔",[140],"life",1307,"DlWwF8qpROxw7zwBNuJXEkm7-xUmoXwaW9HpZaLdMiE",{"prev":144,"next":147},{"path":145,"title":146},"\u002Fposts\u002Flife\u002Ffix-old-laptop-4","给老笔记本续命（四）",{"path":148,"title":149},"\u002Fposts\u002Flife\u002Fhometown-changes-2","回老家的见闻（二）",[151,160,190],{"id":5,"title":6,"body":152,"createdAt":19,"description":13,"extension":20,"meta":158,"navigation":22,"path":23,"seo":159,"stem":25,"__hash__":26},{"type":8,"value":153,"toc":156},[154],[11,155,13],{},{"title":15,"searchDepth":16,"depth":17,"links":157},[],{},{"description":13},{"id":161,"title":162,"body":163,"createdAt":183,"description":184,"extension":20,"meta":185,"navigation":22,"path":186,"seo":187,"stem":188,"__hash__":189},"notes\u002Fnotes\u002F2026-11-14-1.md","2026 11 14 1",{"type":8,"value":164,"toc":181},[165],[11,166,167,168,172,173,180],{},"站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 ",[169,170,171],"strong",{},"Markdown","，写链接也不用到编辑器：",[174,175,179],"a",{"href":176,"rel":177},"https:\u002F\u002Fcontent.nuxt.com",[178],"nofollow","Nuxt Content","。",{"title":15,"searchDepth":16,"depth":17,"links":182},[],"2026-11-14","站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 Markdown，写链接也不用到编辑器：Nuxt Content。",{},"\u002Fnotes\u002F2026-11-14-1",{"description":184},"notes\u002F2026-11-14-1","LLJX_RKU7cgpT6aHw4DZWUZNQ_G_UzELWPKbksJvzfs",{"id":191,"title":192,"body":193,"createdAt":208,"description":209,"extension":20,"meta":210,"navigation":22,"path":211,"seo":212,"stem":213,"__hash__":214},"notes\u002Fnotes\u002F2026-11-14-2.md","2026 11 14 2",{"type":8,"value":194,"toc":206},[195],[11,196,197,201,202,205],{},[198,199,200],"code",{},"readPixels"," 读不到内容不是 bug，是 ",[198,203,204],{},"preserveDrawingBuffer"," 默认关闭——帧提交后缓冲即被清空。",{"title":15,"searchDepth":16,"depth":17,"links":207},[],"2026-11-13","readPixels 读不到内容不是 bug，是 preserveDrawingBuffer 默认关闭——帧提交后缓冲即被清空。",{},"\u002Fnotes\u002F2026-11-14-2",{"description":209},"notes\u002F2026-11-14-2","i7xWqq2eNoU_seSbLQjqlB9gE51fM-PVLUEYCHBkOA4",1795275925467]