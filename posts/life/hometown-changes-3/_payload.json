[{"data":1,"prerenderedAt":214},["ShallowReactive",2],{"notes-latest-1":3,"post:\u002Fposts\u002Flife\u002Fhometown-changes-3":27,"surround:\u002Fposts\u002Flife\u002Fhometown-changes-3":142,"notes-latest-3":149},[4],{"id":5,"title":6,"body":7,"createdAt":19,"description":13,"extension":20,"meta":21,"navigation":22,"path":23,"seo":24,"stem":25,"__hash__":26},"notes\u002Fnotes\u002F2026-11-14-1-2.md","2026 11 14 1 2",{"type":8,"value":9,"toc":14},"minimark",[10],[11,12,13],"p",{},"站点上线了「随笔」：支持一个文件多个随笔",{"title":15,"searchDepth":16,"depth":17,"links":18},"",2,3,[],"2026-11-17","md",{},true,"\u002Fnotes\u002F2026-11-14-1-2",{"description":13},"notes\u002F2026-11-14-1-2","hDP9fvaunHzVrZQ6QifuOtj9VrqbxlPb_52KE5wSjD0",{"id":28,"title":29,"author":30,"body":31,"categories":122,"comment":22,"cover":30,"createdAt":124,"description":35,"draft":125,"extension":20,"meta":126,"navigation":22,"path":131,"readingTime":132,"recommend":125,"seo":133,"series":30,"stem":134,"tags":135,"top":125,"topics":138,"updatedAt":30,"words":140,"__hash__":141},"posts\u002Fposts\u002Flife\u002Fhometown-changes-3.md","回老家的见闻（三）",null,{"type":8,"value":32,"toc":114},[33,36,41,44,47,54,57,60,63,66,69,72,75,78,81,84,87,90,93,96,99,102,105,108,111],[11,34,35],{},"有些事不记下来，过阵子就忘了当时的感受，只剩下干巴巴的结论，所以还是趁热记一下。",[37,38,40],"h2",{"id":39},"路是新的人是旧的","路是新的，人是旧的",[11,42,43],{},"国庆回老家，发现镇上通了新的柏油路，导航都来不及更新的那种新。小时候觉得特别长的那条上学路，开车两分钟就走完了，路两边的店铺换了一轮，但理发店还开着，老板的发型和二十年前一样，也是某种意义上的业务稳定。",[11,45,46],{},"亲戚家的小孩在饭桌上讨论大学志愿，问我软件工程怎么样。我讲了讲这行的好处和最近的变化，讲完自己都有点恍惚，当年我选这个专业的时候，对\"软件工程师\"这五个字的想象和现在完全是两个行业了。",[11,48,49],{},[50,51],"img",{"alt":52,"src":53},"回老家的见闻","\u002Fimg\u002F3.webp",[37,55,56],{"id":56},"一些没变的东西",[11,58,59],{},"有些东西倒是一点没变。清早的菜市场还是那个声音密度，家里那条狗换了三代但见我的态度一样，外婆灶台上那口汤锅永远在火上。在城市待久了，回去的几天作息会自动切换到日出而作，睡得早起得早，脸色都好一些。",[11,61,62],{},"返程的高铁上看着窗外往后跑，忽然觉得老家和城市的区别其实是时间流速的区别，一个按季度过，一个按周度过。一年回去两三次，每次都在提醒我，还有一种节奏存在着。",[37,64,65],{"id":65},"过程中的小心得",[11,67,68],{},"冰箱塞得太满，冷风吹不到后排，最里面的菜悄悄坏掉才发现。留出空隙让空气流通，食物和代码里的缓存一样，堆太满就要出问题。",[11,70,71],{},"手机最近电量崩得快，一顿排查，关掉几个常年后台自启的应用，续航立刻回来。数码产品的衰退，很多时候不是硬件老了，是软件攒的债。",[11,73,74],{},"买椅子只看了颜值，腰托形同虚设，坐两小时腰就开始抗议。人体工学这几个字，是拿腰疼换来的教训，越久坐越得信。",[37,76,77],{"id":77},"延伸几句",[11,79,80],{},"独居和成家各有各的修行，我现在的体会是无论哪种状态，把生活的基础盘打理好都是第一位的：睡眠、饮食、居住环境、几个说得上话的朋友。基础盘稳了，其他的变化来了都能接得住。",[11,82,83],{},"成年人的学习和学生时代最大的不同是反馈周期，没人给你打分，效果要几个月甚至几年后才显现。所以坚持的动力只能来自内部：记录对照、阶段复盘、给自己一点小奖励，这些机制比意志力可靠得多。",[11,85,86],{},"写生活记录这几年有个体会：当时觉得不值得写的小事，事后回看反而是最鲜活的片段。反而是那些酝酿很久想认真写的“大主题”，多数烂在了草稿箱。所以现在我的原则是趁热写，先记下来，好不好以后再说。",[11,88,89],{},"生活里很多烦恼，拆开看其实是信息问题而不是命运问题：不知道怎么挑、不知道怎么做、不知道别人是怎么解决的。而信息问题基本都能靠学习和请教解决，这么一想，很多焦虑就有了着手点。",[37,91,92],{"id":92},"又想到一些",[11,94,95],{},"写到这里顺便吐个槽，这类事情最难的部分往往不是技术本身，是说服别人相信它值得投入。方案再好，落不到排期上都是空谈，所以学会用数据的语言讲价值，算是这些年额外的必修课。",[11,97,98],{},"有时候会想，学一门新技术到底学到的是什么。语法和 API 会过时，真正的收获是它看问题的角度。多一门语言就多一副眼镜，同一副牌桌，能看到别人看不到的牌路，这是这么多年折腾下来最确定的回报。",[11,100,101],{},"记一个产生过的动摇：做到一半觉得这玩意儿是不是没什么意义。后来想通了，意义不是事情自带的，是你把它做完并沉淀下来之后长出来的。烂尾的才真的没意义，做完的最差也是一篇笔记。",[11,103,104],{},"顺便说说协作里的体会：这类事自己闷头做效率最高，但闷头做完往往返工最多。适度地提前同步，把方向先对齐，看似慢了半天，实际省掉的是几天的返工。沟通的时机比沟通的技巧更值得琢磨。",[37,106,107],{"id":107},"写在最后",[11,109,110],{},"职业病之一是看什么都想拆步骤，这件事在我这里基本是个流程问题：目标、步骤、验证、复盘，一套下来居然还真管用。",[11,112,113],{},"剩下的想起来再记，这篇到此为止。",{"title":15,"searchDepth":16,"depth":17,"links":115},[116,117,118,119,120,121],{"id":39,"depth":16,"text":40},{"id":56,"depth":16,"text":56},{"id":65,"depth":16,"text":65},{"id":77,"depth":16,"text":77},{"id":92,"depth":16,"text":92},{"id":107,"depth":16,"text":107},[123],"生活","2024-07-03",false,{"excerpt":127},{"type":8,"value":128},[129],[11,130,35],{},"\u002Fposts\u002Flife\u002Fhometown-changes-3",380400,{"title":29,"description":35},"posts\u002Flife\u002Fhometown-changes-3",[136,137],"老家","随笔",[139],"life",1268,"y5j1nCdShDQPWkd57tt0H2oUnGsNmBGSpebI69SQNI8",{"prev":143,"next":146},{"path":144,"title":145},"\u002Fposts\u002Flife\u002Fhometown-changes-2","回老家的见闻（二）",{"path":147,"title":148},"\u002Fposts\u002Flife\u002Fhometown-changes-4","回老家的见闻（四）",[150,159,189],{"id":5,"title":6,"body":151,"createdAt":19,"description":13,"extension":20,"meta":157,"navigation":22,"path":23,"seo":158,"stem":25,"__hash__":26},{"type":8,"value":152,"toc":155},[153],[11,154,13],{},{"title":15,"searchDepth":16,"depth":17,"links":156},[],{},{"description":13},{"id":160,"title":161,"body":162,"createdAt":182,"description":183,"extension":20,"meta":184,"navigation":22,"path":185,"seo":186,"stem":187,"__hash__":188},"notes\u002Fnotes\u002F2026-11-14-1.md","2026 11 14 1",{"type":8,"value":163,"toc":180},[164],[11,165,166,167,171,172,179],{},"站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 ",[168,169,170],"strong",{},"Markdown","，写链接也不用到编辑器：",[173,174,178],"a",{"href":175,"rel":176},"https:\u002F\u002Fcontent.nuxt.com",[177],"nofollow","Nuxt Content","。",{"title":15,"searchDepth":16,"depth":17,"links":181},[],"2026-11-14","站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 Markdown，写链接也不用到编辑器：Nuxt Content。",{},"\u002Fnotes\u002F2026-11-14-1",{"description":183},"notes\u002F2026-11-14-1","LLJX_RKU7cgpT6aHw4DZWUZNQ_G_UzELWPKbksJvzfs",{"id":190,"title":191,"body":192,"createdAt":207,"description":208,"extension":20,"meta":209,"navigation":22,"path":210,"seo":211,"stem":212,"__hash__":213},"notes\u002Fnotes\u002F2026-11-14-2.md","2026 11 14 2",{"type":8,"value":193,"toc":205},[194],[11,195,196,200,201,204],{},[197,198,199],"code",{},"readPixels"," 读不到内容不是 bug，是 ",[197,202,203],{},"preserveDrawingBuffer"," 默认关闭——帧提交后缓冲即被清空。",{"title":15,"searchDepth":16,"depth":17,"links":206},[],"2026-11-13","readPixels 读不到内容不是 bug，是 preserveDrawingBuffer 默认关闭——帧提交后缓冲即被清空。",{},"\u002Fnotes\u002F2026-11-14-2",{"description":208},"notes\u002F2026-11-14-2","i7xWqq2eNoU_seSbLQjqlB9gE51fM-PVLUEYCHBkOA4",1795707444099]