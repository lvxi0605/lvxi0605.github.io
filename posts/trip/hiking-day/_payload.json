[{"data":1,"prerenderedAt":213},["ShallowReactive",2],{"notes-latest-1":3,"post:\u002Fposts\u002Ftrip\u002Fhiking-day":27,"surround:\u002Fposts\u002Ftrip\u002Fhiking-day":141,"notes-latest-3":148},[4],{"id":5,"title":6,"body":7,"createdAt":19,"description":13,"extension":20,"meta":21,"navigation":22,"path":23,"seo":24,"stem":25,"__hash__":26},"notes\u002Fnotes\u002F2026-11-14-1-2.md","2026 11 14 1 2",{"type":8,"value":9,"toc":14},"minimark",[10],[11,12,13],"p",{},"站点上线了「随笔」：支持一个文件多个随笔",{"title":15,"searchDepth":16,"depth":17,"links":18},"",2,3,[],"2026-11-17","md",{},true,"\u002Fnotes\u002F2026-11-14-1-2",{"description":13},"notes\u002F2026-11-14-1-2","hDP9fvaunHzVrZQ6QifuOtj9VrqbxlPb_52KE5wSjD0",{"id":28,"title":29,"author":30,"body":31,"categories":121,"comment":22,"cover":30,"createdAt":123,"description":35,"draft":124,"extension":20,"meta":125,"navigation":22,"path":130,"readingTime":131,"recommend":124,"seo":132,"series":30,"stem":133,"tags":134,"top":124,"topics":137,"updatedAt":30,"words":139,"__hash__":140},"posts\u002Fposts\u002Ftrip\u002Fhiking-day.md","周末爬山的正确打开方式",null,{"type":8,"value":32,"toc":113},[33,36,40,43,46,52,55,58,61,64,67,70,73,76,79,82,85,87,89,92,95,98,101,104,107,110],[11,34,35],{},"最近生活里有些小变化，趁着晚上安静，写两句给自己看。",[37,38,39],"h2",{"id":39},"这次走的路线",[11,41,42],{},"这次选的路线是城郊一条成熟的野径，全程七八公里，累计爬升六百米，对中级新手友好。出发前做足了功课：轨迹下载好、天气确认两遍、水带三升。事实证明准备是有价值的，半路遇到没带够水的队伍蹭掉了我们半升备用水。",[11,44,45],{},"爬山的节奏我摸索出的心得是：前三分之一刻意压速度，心率控制在能正常说话的程度；中段匀速，小步频省力；最后一段看状态冲刺。这套节奏下，全程不喘成狗，风景反而看得更仔细。",[11,47,48],{},[49,50],"img",{"alt":29,"src":51},"\u002Fimg\u002F5.webp",[37,53,54],{"id":54},"山顶与下撤",[11,56,57],{},"山顶的风光值回全部体力，能见度好的时候能看到远处的城市轮廓，平时仰视的写字楼从山上看下去小得像积木。在山顶吃了带来的三明治，饱腹感的排序瞬间被重新定义。",[11,59,60],{},"下山比上山伤膝盖，这点必须强调：身体重心后坐，小步走，或者干脆侧身下。回家泡了个热水澡，第二天的小腿酸胀在预期之内。爬山这项运动的最大好处是强度和风景可以兼得，跑步是纯付出，爬山是付出加奖赏，对意志力一般的人友好太多。下个月的目标是同一条线提速半小时，先记录在这里。",[37,62,63],{"id":63},"两个小教训",[11,65,66],{},"给花换盆的时机不对，大夏天动的土，缓了半个月才缓过来，叶子黄了一半。换盆要赶在春秋，园艺上的讲究背后都是植物的生理规律。",[11,68,69],{},"夜跑那阵子穿深色衣服，路过没有路灯的路段被司机按喇叭提醒，回想起来一阵后怕。后来买了反光背心，几十块钱买安心。",[11,71,72],{},"空调滤网两年没洗，风越来越小还带味道，拆开一看吓一跳。一小时清理完，制冷立刻给力。家用电器的保养周期，说明书上写的那些建议真不是随口说说。",[37,74,75],{"id":75},"一点延伸",[11,77,78],{},"短途游其实被低估了。两天一晚的去处，交通时间短、准备成本低、恢复期短，一年能来七八次。相比之下一年一次的长途旅行，准备工作量和身心消耗都大，反而更容易在期待中变形。",[11,80,81],{},"旅行花销里性价比最低的往往是“便利”：景区门口的餐饮、酒店楼下的纪念品、临时起意的打车。提前做一小时功课，同样的预算体验能差出一倍，省下的钱够再出发一次。",[11,83,84],{},"出行这些年攒下来的一条核心经验：行程安排的松紧度决定旅行质量。把每天塞满的行程，回来记住的只有赶路；留白半天随便走走，反而最容易撞见计划外的惊喜。旅行是去生活的，不是去打卡的。",[11,86,78],{},[11,88,81],{},[37,90,91],{"id":91},"再补充几句",[11,93,94],{},"过程中也反复体会到取舍的本质：没有完美的方案，只有当下约束下最合适的方案。把约束写清楚，方案的选择题就变成了证明题，这也是为什么我习惯先列约束再谈方案，顺序反了全是无效争论。",[11,96,97],{},"想想还是补一段：任何习惯的养成都绕不开启动成本，最有效的办法是把启动成本降到接近零。想跑就把鞋放门口，想写就把文档开着置顶，环境准备到位了，行动只是顺水推舟。",[11,99,100],{},"从更高的视角看，这类问题都有一个共同结构：短期收益和长期收益打架。短期的诱惑总是具体而生动，长期的回报抽象而遥远，赢家通常是那些把长期目标拆成短期可感的小奖励的人。",[11,102,103],{},"讲个题外话，做这类事情的时候最好留个记录的习惯，当时的判断依据比结果更珍贵。结果好可能只是运气好，把决策过程记下来，好运才可能被复制，坏运才可能被规避。",[37,105,106],{"id":106},"小结",[11,108,109],{},"我给这事做了个简单的表格记录，朋友说我无药可救，但两个月的曲线摆在眼前，比嘴上的感觉可靠多了。",[11,111,112],{},"这篇就先这样，想到了什么再回来补。",{"title":15,"searchDepth":16,"depth":17,"links":114},[115,116,117,118,119,120],{"id":39,"depth":16,"text":39},{"id":54,"depth":16,"text":54},{"id":63,"depth":16,"text":63},{"id":75,"depth":16,"text":75},{"id":91,"depth":16,"text":91},{"id":106,"depth":16,"text":106},[122],"旅行","2023-05-13",false,{"excerpt":126},{"type":8,"value":127},[128],[11,129,35],{},"\u002Fposts\u002Ftrip\u002Fhiking-day",392400,{"title":29,"description":35},"posts\u002Ftrip\u002Fhiking-day",[135,136],"爬山","周末",[138],"trip",1308,"CunWLDi_1o698lQeHf97kqKoHqM71obqwRrPPAjsoUY",{"prev":142,"next":145},{"path":143,"title":144},"\u002Fposts\u002Ftrip\u002Fancient-town-4","古镇游避坑与真香指南（四）",{"path":146,"title":147},"\u002Fposts\u002Ftrip\u002Fhiking-day-2","周末爬山的正确打开方式（二）",[149,158,188],{"id":5,"title":6,"body":150,"createdAt":19,"description":13,"extension":20,"meta":156,"navigation":22,"path":23,"seo":157,"stem":25,"__hash__":26},{"type":8,"value":151,"toc":154},[152],[11,153,13],{},{"title":15,"searchDepth":16,"depth":17,"links":155},[],{},{"description":13},{"id":159,"title":160,"body":161,"createdAt":181,"description":182,"extension":20,"meta":183,"navigation":22,"path":184,"seo":185,"stem":186,"__hash__":187},"notes\u002Fnotes\u002F2026-11-14-1.md","2026 11 14 1",{"type":8,"value":162,"toc":179},[163],[11,164,165,166,170,171,178],{},"站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 ",[167,168,169],"strong",{},"Markdown","，写链接也不用到编辑器：",[172,173,177],"a",{"href":174,"rel":175},"https:\u002F\u002Fcontent.nuxt.com",[176],"nofollow","Nuxt Content","。",{"title":15,"searchDepth":16,"depth":17,"links":180},[],"2026-11-14","站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 Markdown，写链接也不用到编辑器：Nuxt Content。",{},"\u002Fnotes\u002F2026-11-14-1",{"description":182},"notes\u002F2026-11-14-1","LLJX_RKU7cgpT6aHw4DZWUZNQ_G_UzELWPKbksJvzfs",{"id":189,"title":190,"body":191,"createdAt":206,"description":207,"extension":20,"meta":208,"navigation":22,"path":209,"seo":210,"stem":211,"__hash__":212},"notes\u002Fnotes\u002F2026-11-14-2.md","2026 11 14 2",{"type":8,"value":192,"toc":204},[193],[11,194,195,199,200,203],{},[196,197,198],"code",{},"readPixels"," 读不到内容不是 bug，是 ",[196,201,202],{},"preserveDrawingBuffer"," 默认关闭——帧提交后缓冲即被清空。",{"title":15,"searchDepth":16,"depth":17,"links":205},[],"2026-11-13","readPixels 读不到内容不是 bug，是 preserveDrawingBuffer 默认关闭——帧提交后缓冲即被清空。",{},"\u002Fnotes\u002F2026-11-14-2",{"description":207},"notes\u002F2026-11-14-2","i7xWqq2eNoU_seSbLQjqlB9gE51fM-PVLUEYCHBkOA4",1795303405681]