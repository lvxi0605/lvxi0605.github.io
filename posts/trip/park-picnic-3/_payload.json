[{"data":1,"prerenderedAt":214},["ShallowReactive",2],{"notes-latest-1":3,"post:\u002Fposts\u002Ftrip\u002Fpark-picnic-3":27,"surround:\u002Fposts\u002Ftrip\u002Fpark-picnic-3":142,"notes-latest-3":149},[4],{"id":5,"title":6,"body":7,"createdAt":19,"description":13,"extension":20,"meta":21,"navigation":22,"path":23,"seo":24,"stem":25,"__hash__":26},"notes\u002Fnotes\u002F2026-11-14-1-2.md","2026 11 14 1 2",{"type":8,"value":9,"toc":14},"minimark",[10],[11,12,13],"p",{},"站点上线了「随笔」：支持一个文件多个随笔",{"title":15,"searchDepth":16,"depth":17,"links":18},"",2,3,[],"2026-11-17","md",{},true,"\u002Fnotes\u002F2026-11-14-1-2",{"description":13},"notes\u002F2026-11-14-1-2","hDP9fvaunHzVrZQ6QifuOtj9VrqbxlPb_52KE5wSjD0",{"id":28,"title":29,"author":30,"body":31,"categories":122,"comment":22,"cover":30,"createdAt":124,"description":35,"draft":125,"extension":20,"meta":126,"navigation":22,"path":131,"readingTime":132,"recommend":125,"seo":133,"series":30,"stem":134,"tags":135,"top":125,"topics":138,"updatedAt":30,"words":140,"__hash__":141},"posts\u002Fposts\u002Ftrip\u002Fpark-picnic-3.md","公园野餐的装备清单（三）",null,{"type":8,"value":32,"toc":114},[33,36,40,43,46,53,56,59,62,65,68,71,74,77,80,83,86,88,90,93,96,99,102,105,108,111],[11,34,35],{},"起因是和朋友聊到这个话题，聊完发现我们的做法完全不同，回来想想还是记录一下我的版本。",[37,38,39],"h2",{"id":39},"装备清单",[11,41,42],{},"春天野餐的装备清单整理一篇，纯实用向：一张防潮垫是核心装备，选带防水底的；餐具走轻量路线，一次性餐具愧对好风景，带一套轻便的；食物提前在家备好，三明治、卤味、水果切盒，现场只需要摆盘；饮品保温壶装茶或咖啡，冰袋给饮料降温。",[11,44,45],{},"还有一个容易被忽略的重要角色：垃圾袋，多带两个，走的时候把现场恢复原样，野餐的体面包含善后。",[11,47,48],{},[49,50],"img",{"alt":51,"src":52},"公园野餐的装备清单","\u002Fimg\u002F2.webp",[37,54,55],{"id":55},"选址与时机",[11,57,58],{},"选址的学问：树荫配草坪是标配，注意头顶有没有结果实的树，掉下来砸盘子不算浪漫；离洗手间和停车场的距离要平衡；背风的位置食物不容易沾沙。时机上春天选上午十点前或下午三点后，阳光斜下来拍照自带滤镜。",[11,60,61],{},"这次野餐最成功的决策是带了一副扑克和一台拍立得，下午的时光在牌局和照片冲印的等待里过得飞快。野餐的本质不是吃，是把一个普通周末过出度假感的低成本方案，这篇清单收藏好，下个春天直接抄作业。",[37,63,64],{"id":64},"记下两点",[11,66,67],{},"冰箱塞得太满，冷风吹不到后排，最里面的菜悄悄坏掉才发现。留出空隙让空气流通，食物和代码里的缓存一样，堆太满就要出问题。",[11,69,70],{},"手机最近电量崩得快，一顿排查，关掉几个常年后台自启的应用，续航立刻回来。数码产品的衰退，很多时候不是硬件老了，是软件攒的债。",[11,72,73],{},"买椅子只看了颜值，腰托形同虚设，坐两小时腰就开始抗议。人体工学这几个字，是拿腰疼换来的教训，越久坐越得信。",[37,75,76],{"id":76},"多聊两句",[11,78,79],{},"出行这些年攒下来的一条核心经验：行程安排的松紧度决定旅行质量。把每天塞满的行程，回来记住的只有赶路；留白半天随便走走，反而最容易撞见计划外的惊喜。旅行是去生活的，不是去打卡的。",[11,81,82],{},"短途游其实被低估了。两天一晚的去处，交通时间短、准备成本低、恢复期短，一年能来七八次。相比之下一年一次的长途旅行，准备工作量和身心消耗都大，反而更容易在期待中变形。",[11,84,85],{},"旅行花销里性价比最低的往往是“便利”：景区门口的餐饮、酒店楼下的纪念品、临时起意的打车。提前做一小时功课，同样的预算体验能差出一倍，省下的钱够再出发一次。",[11,87,79],{},[11,89,82],{},[37,91,92],{"id":92},"继续聊聊",[11,94,95],{},"平衡感很重要的一件事：投入和收益的比例。所有优化都值得先问一句，这件事的收益上限是多少，值多少投入。无限打磨一个低价值的东西是工程师最常见的温柔陷阱，包括我自己在内。",[11,97,98],{},"忍不住再夸一下记录的力量，上周刚整理的笔记，这次直接翻出来就用，十分钟解决了当时花一下午的问题。给自己留下的每一份笔记，都是寄给未来的快递，寄件人签收时才觉得真香。",[11,100,101],{},"最后聊点感受：做技术这些年，越来越觉得最好的状态是既投入又抽离。投入是把事情做好，抽离是时不时跳出来看看方向对不对，两者缺一，要么辛苦没产出，要么轻松跑偏路。",[11,103,104],{},"写着写着想到，很多技术选择本质上都是在回答同一个问题：这个方案在出问题的时候是什么样子。不出问题的方案人人都写得出来，区分度全在故障时刻的表现。多想一层失败路径，很多纠结就自动有了答案。",[37,106,107],{"id":107},"最后",[11,109,110],{},"搞技术久了习惯找根因，生活里的很多问题其实也适用：先定位，再动手，别一上来就凭感觉乱试。",[11,112,113],{},"如果你也遇到类似的情况，评论区聊聊。",{"title":15,"searchDepth":16,"depth":17,"links":115},[116,117,118,119,120,121],{"id":39,"depth":16,"text":39},{"id":55,"depth":16,"text":55},{"id":64,"depth":16,"text":64},{"id":76,"depth":16,"text":76},{"id":92,"depth":16,"text":92},{"id":107,"depth":16,"text":107},[123],"旅行","2023-08-02",false,{"excerpt":127},{"type":8,"value":128},[129],[11,130,35],{},"\u002Fposts\u002Ftrip\u002Fpark-picnic-3",384900,{"title":29,"description":35},"posts\u002Ftrip\u002Fpark-picnic-3",[136,137],"野餐","公园",[139],"trip",1283,"omUEN_lnqRyhJHJpX2wVc1LMaNlso7sMZmuYOQhs4M4",{"prev":143,"next":146},{"path":144,"title":145},"\u002Fposts\u002Ftrip\u002Fpark-picnic-2","公园野餐的装备清单（二）",{"path":147,"title":148},"\u002Fposts\u002Ftrip\u002Fpark-picnic-4","公园野餐的装备清单（四）",[150,159,189],{"id":5,"title":6,"body":151,"createdAt":19,"description":13,"extension":20,"meta":157,"navigation":22,"path":23,"seo":158,"stem":25,"__hash__":26},{"type":8,"value":152,"toc":155},[153],[11,154,13],{},{"title":15,"searchDepth":16,"depth":17,"links":156},[],{},{"description":13},{"id":160,"title":161,"body":162,"createdAt":182,"description":183,"extension":20,"meta":184,"navigation":22,"path":185,"seo":186,"stem":187,"__hash__":188},"notes\u002Fnotes\u002F2026-11-14-1.md","2026 11 14 1",{"type":8,"value":163,"toc":180},[164],[11,165,166,167,171,172,179],{},"站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 ",[168,169,170],"strong",{},"Markdown","，写链接也不用到编辑器：",[173,174,178],"a",{"href":175,"rel":176},"https:\u002F\u002Fcontent.nuxt.com",[177],"nofollow","Nuxt Content","。",{"title":15,"searchDepth":16,"depth":17,"links":181},[],"2026-11-14","站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 Markdown，写链接也不用到编辑器：Nuxt Content。",{},"\u002Fnotes\u002F2026-11-14-1",{"description":183},"notes\u002F2026-11-14-1","LLJX_RKU7cgpT6aHw4DZWUZNQ_G_UzELWPKbksJvzfs",{"id":190,"title":191,"body":192,"createdAt":207,"description":208,"extension":20,"meta":209,"navigation":22,"path":210,"seo":211,"stem":212,"__hash__":213},"notes\u002Fnotes\u002F2026-11-14-2.md","2026 11 14 2",{"type":8,"value":193,"toc":205},[194],[11,195,196,200,201,204],{},[197,198,199],"code",{},"readPixels"," 读不到内容不是 bug，是 ",[197,202,203],{},"preserveDrawingBuffer"," 默认关闭——帧提交后缓冲即被清空。",{"title":15,"searchDepth":16,"depth":17,"links":206},[],"2026-11-13","readPixels 读不到内容不是 bug，是 preserveDrawingBuffer 默认关闭——帧提交后缓冲即被清空。",{},"\u002Fnotes\u002F2026-11-14-2",{"description":208},"notes\u002F2026-11-14-2","i7xWqq2eNoU_seSbLQjqlB9gE51fM-PVLUEYCHBkOA4",1795278783710]