[{"data":1,"prerenderedAt":205},["ShallowReactive",2],{"notes-latest-1":3,"post:\u002Fposts\u002Ftrip\u002Fold-street-4":27,"surround:\u002Fposts\u002Ftrip\u002Fold-street-4":133,"notes-latest-3":140},[4],{"id":5,"title":6,"body":7,"createdAt":19,"description":13,"extension":20,"meta":21,"navigation":22,"path":23,"seo":24,"stem":25,"__hash__":26},"notes\u002Fnotes\u002F2026-11-14-1-2.md","2026 11 14 1 2",{"type":8,"value":9,"toc":14},"minimark",[10],[11,12,13],"p",{},"站点上线了「随笔」：支持一个文件多个随笔",{"title":15,"searchDepth":16,"depth":17,"links":18},"",2,3,[],"2026-11-17","md",{},true,"\u002Fnotes\u002F2026-11-14-1-2",{"description":13},"notes\u002F2026-11-14-1-2","hDP9fvaunHzVrZQ6QifuOtj9VrqbxlPb_52KE5wSjD0",{"id":28,"title":29,"author":30,"body":31,"categories":113,"comment":22,"cover":30,"createdAt":115,"description":35,"draft":116,"extension":20,"meta":117,"navigation":22,"path":122,"readingTime":123,"recommend":116,"seo":124,"series":30,"stem":125,"tags":126,"top":116,"topics":129,"updatedAt":30,"words":131,"__hash__":132},"posts\u002Fposts\u002Ftrip\u002Fold-street-4.md","老街慢慢走的半天（四）",null,{"type":8,"value":32,"toc":105},[33,36,40,43,46,49,52,55,58,61,64,67,70,73,76,79,81,84,87,90,93,96,99,102],[11,34,35],{},"有些事不记下来，过阵子就忘了当时的感受，只剩下干巴巴的结论，所以还是趁热记一下。",[37,38,39],"h2",{"id":39},"避开商业化的部分",[11,41,42],{},"这次去的这条老街商业化了七成，但剩下三成足够看：尽头拐进去的巷子里，晾衣绳横在头顶，墙根蹲着打盹的猫，理发店的转灯还是手动拨的。商业化区域和居民区往往一条巷子之隔，人流像被 cutoff 一样突然安静下来，这是逛老街最重要的技巧，多拐一个弯。",[11,44,45],{},"吃的东西集中在街口，往里走价格逐渐回归真实。一碗当地传统的糖水铺在巷子深处，老板娘说这条街她生活了四十年，看着铺面从修理铺变成奶茶店，又变成文创店。",[37,47,48],{"id":48},"慢走的意义",[11,50,51],{},"半天时间没安排任何目的地，走到哪算哪，累了就找地方坐。这种无目的的漫步有个专门的名字叫 citywalk，听着时髦，本质就是我们小时候的压马路。但成年人的压马路确实需要点仪式感才能实施，不然总想着手机里的未读消息。",[11,53,54],{},"拍了几十张照片，最满意的不是那些精修的门面，是巷子里晾晒的被子和斑驳的墙。这些照片整理的时候发现一个规律：好看的照片基本都是没有游客入镜的，所以你懂的，再拐一个弯。",[37,56,57],{"id":57},"一点反思",[11,59,60],{},"夜跑那阵子穿深色衣服，路过没有路灯的路段被司机按喇叭提醒，回想起来一阵后怕。后来买了反光背心，几十块钱买安心。",[11,62,63],{},"空调滤网两年没洗，风越来越小还带味道，拆开一看吓一跳。一小时清理完，制冷立刻给力。家用电器的保养周期，说明书上写的那些建议真不是随口说说。",[11,65,66],{},"新买的锅没开锅就上灶，第一条鱼皮粘得惨不忍睹。老老实实开了锅，热锅凉油，之后煎什么都利索。工具要有工具的仪式，这道理在厨房通用。",[37,68,69],{"id":69},"顺便一提",[11,71,72],{},"旅行花销里性价比最低的往往是“便利”：景区门口的餐饮、酒店楼下的纪念品、临时起意的打车。提前做一小时功课，同样的预算体验能差出一倍，省下的钱够再出发一次。",[11,74,75],{},"出行这些年攒下来的一条核心经验：行程安排的松紧度决定旅行质量。把每天塞满的行程，回来记住的只有赶路；留白半天随便走走，反而最容易撞见计划外的惊喜。旅行是去生活的，不是去打卡的。",[11,77,78],{},"短途游其实被低估了。两天一晚的去处，交通时间短、准备成本低、恢复期短，一年能来七八次。相比之下一年一次的长途旅行，准备工作量和身心消耗都大，反而更容易在期待中变形。",[11,80,72],{},[37,82,83],{"id":83},"另外记几笔",[11,85,86],{},"有时候会想，学一门新技术到底学到的是什么。语法和 API 会过时，真正的收获是它看问题的角度。多一门语言就多一副眼镜，同一副牌桌，能看到别人看不到的牌路，这是这么多年折腾下来最确定的回报。",[11,88,89],{},"记一个产生过的动摇：做到一半觉得这玩意儿是不是没什么意义。后来想通了，意义不是事情自带的，是你把它做完并沉淀下来之后长出来的。烂尾的才真的没意义，做完的最差也是一篇笔记。",[11,91,92],{},"顺便说说协作里的体会：这类事自己闷头做效率最高，但闷头做完往往返工最多。适度地提前同步，把方向先对齐，看似慢了半天，实际省掉的是几天的返工。沟通的时机比沟通的技巧更值得琢磨。",[11,94,95],{},"其实回看这些年踩的坑，大坑几乎都和贪快有关。快不是错，错的是想跳过必要步骤的快，地基没打牢盖得越快塌得越响。慢下来把该做的做扎实，反而是最快的路径，这话说了很多年，每次验证都对。",[37,97,98],{"id":98},"最后",[11,100,101],{},"搞技术久了习惯找根因，生活里的很多问题其实也适用：先定位，再动手，别一上来就凭感觉乱试。",[11,103,104],{},"这篇写得断断续续，总算收尾，下篇见。",{"title":15,"searchDepth":16,"depth":17,"links":106},[107,108,109,110,111,112],{"id":39,"depth":16,"text":39},{"id":48,"depth":16,"text":48},{"id":57,"depth":16,"text":57},{"id":69,"depth":16,"text":69},{"id":83,"depth":16,"text":83},{"id":98,"depth":16,"text":98},[114],"旅行","2025-08-09",false,{"excerpt":118},{"type":8,"value":119},[120],[11,121,35],{},"\u002Fposts\u002Ftrip\u002Fold-street-4",371700,{"title":29,"description":35},"posts\u002Ftrip\u002Fold-street-4",[127,128],"老街","citywalk",[130],"trip",1239,"czN8NRwgcXvDTD8FNMJ3scBl0bAIbK3yMjkA38JovAM",{"prev":134,"next":137},{"path":135,"title":136},"\u002Fposts\u002Ftrip\u002Fold-street-3","老街慢慢走的半天（三）",{"path":138,"title":139},"\u002Fposts\u002Ftrip\u002Fpark-picnic","公园野餐的装备清单",[141,150,180],{"id":5,"title":6,"body":142,"createdAt":19,"description":13,"extension":20,"meta":148,"navigation":22,"path":23,"seo":149,"stem":25,"__hash__":26},{"type":8,"value":143,"toc":146},[144],[11,145,13],{},{"title":15,"searchDepth":16,"depth":17,"links":147},[],{},{"description":13},{"id":151,"title":152,"body":153,"createdAt":173,"description":174,"extension":20,"meta":175,"navigation":22,"path":176,"seo":177,"stem":178,"__hash__":179},"notes\u002Fnotes\u002F2026-11-14-1.md","2026 11 14 1",{"type":8,"value":154,"toc":171},[155],[11,156,157,158,162,163,170],{},"站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 ",[159,160,161],"strong",{},"Markdown","，写链接也不用到编辑器：",[164,165,169],"a",{"href":166,"rel":167},"https:\u002F\u002Fcontent.nuxt.com",[168],"nofollow","Nuxt Content","。",{"title":15,"searchDepth":16,"depth":17,"links":172},[],"2026-11-14","站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 Markdown，写链接也不用到编辑器：Nuxt Content。",{},"\u002Fnotes\u002F2026-11-14-1",{"description":174},"notes\u002F2026-11-14-1","LLJX_RKU7cgpT6aHw4DZWUZNQ_G_UzELWPKbksJvzfs",{"id":181,"title":182,"body":183,"createdAt":198,"description":199,"extension":20,"meta":200,"navigation":22,"path":201,"seo":202,"stem":203,"__hash__":204},"notes\u002Fnotes\u002F2026-11-14-2.md","2026 11 14 2",{"type":8,"value":184,"toc":196},[185],[11,186,187,191,192,195],{},[188,189,190],"code",{},"readPixels"," 读不到内容不是 bug，是 ",[188,193,194],{},"preserveDrawingBuffer"," 默认关闭——帧提交后缓冲即被清空。",{"title":15,"searchDepth":16,"depth":17,"links":197},[],"2026-11-13","readPixels 读不到内容不是 bug，是 preserveDrawingBuffer 默认关闭——帧提交后缓冲即被清空。",{},"\u002Fnotes\u002F2026-11-14-2",{"description":199},"notes\u002F2026-11-14-2","i7xWqq2eNoU_seSbLQjqlB9gE51fM-PVLUEYCHBkOA4",1795333672419]