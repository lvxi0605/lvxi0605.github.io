[{"data":1,"prerenderedAt":214},["ShallowReactive",2],{"notes-latest-1":3,"post:\u002Fposts\u002Ftrip\u002Fhiking-day-3":27,"surround:\u002Fposts\u002Ftrip\u002Fhiking-day-3":142,"notes-latest-3":149},[4],{"id":5,"title":6,"body":7,"createdAt":19,"description":13,"extension":20,"meta":21,"navigation":22,"path":23,"seo":24,"stem":25,"__hash__":26},"notes\u002Fnotes\u002F2026-11-14-1-2.md","2026 11 14 1 2",{"type":8,"value":9,"toc":14},"minimark",[10],[11,12,13],"p",{},"站点上线了「随笔」：支持一个文件多个随笔",{"title":15,"searchDepth":16,"depth":17,"links":18},"",2,3,[],"2026-11-17","md",{},true,"\u002Fnotes\u002F2026-11-14-1-2",{"description":13},"notes\u002F2026-11-14-1-2","hDP9fvaunHzVrZQ6QifuOtj9VrqbxlPb_52KE5wSjD0",{"id":28,"title":29,"author":30,"body":31,"categories":122,"comment":22,"cover":30,"createdAt":124,"description":35,"draft":125,"extension":20,"meta":126,"navigation":22,"path":131,"readingTime":132,"recommend":125,"seo":133,"series":30,"stem":134,"tags":135,"top":125,"topics":138,"updatedAt":30,"words":140,"__hash__":141},"posts\u002Fposts\u002Ftrip\u002Fhiking-day-3.md","周末爬山的正确打开方式（三）",null,{"type":8,"value":32,"toc":114},[33,36,40,43,46,53,56,59,62,65,68,71,74,77,80,83,86,88,90,93,96,99,102,105,108,111],[11,34,35],{},"又到周末，把这阵子的碎片想法归拢成一篇，写得随意一点。",[37,38,39],"h2",{"id":39},"这次走的路线",[11,41,42],{},"这次选的路线是城郊一条成熟的野径，全程七八公里，累计爬升六百米，对中级新手友好。出发前做足了功课：轨迹下载好、天气确认两遍、水带三升。事实证明准备是有价值的，半路遇到没带够水的队伍蹭掉了我们半升备用水。",[11,44,45],{},"爬山的节奏我摸索出的心得是：前三分之一刻意压速度，心率控制在能正常说话的程度；中段匀速，小步频省力；最后一段看状态冲刺。这套节奏下，全程不喘成狗，风景反而看得更仔细。",[11,47,48],{},[49,50],"img",{"alt":51,"src":52},"周末爬山的正确打开方式","\u002Fimg\u002F5.webp",[37,54,55],{"id":55},"山顶与下撤",[11,57,58],{},"山顶的风光值回全部体力，能见度好的时候能看到远处的城市轮廓，平时仰视的写字楼从山上看下去小得像积木。在山顶吃了带来的三明治，饱腹感的排序瞬间被重新定义。",[11,60,61],{},"下山比上山伤膝盖，这点必须强调：身体重心后坐，小步走，或者干脆侧身下。回家泡了个热水澡，第二天的小腿酸胀在预期之内。爬山这项运动的最大好处是强度和风景可以兼得，跑步是纯付出，爬山是付出加奖赏，对意志力一般的人友好太多。下个月的目标是同一条线提速半小时，先记录在这里。",[37,63,64],{"id":64},"两个小教训",[11,66,67],{},"加湿器开一整夜，窗台上全是水汽，墙角都有点返潮。买了个湿度计才知道，舒服的湿度是个区间，不是越大越好，很多事都是这个道理。",[11,69,70],{},"桌面充电线缠成一团，剪也剪不开理也理不清。十块钱的理线器加几个标签贴，一次到位。这种小钱花出去，回报率出奇地高。",[11,72,73],{},"保温杯里闷了一晚上的茶，苦到怀疑人生。茶水分离的杯子买回来之后，每一泡都恰到好处，工具选对，体验立刻不同。",[37,75,76],{"id":76},"一点延伸",[11,78,79],{},"旅行花销里性价比最低的往往是“便利”：景区门口的餐饮、酒店楼下的纪念品、临时起意的打车。提前做一小时功课，同样的预算体验能差出一倍，省下的钱够再出发一次。",[11,81,82],{},"出行这些年攒下来的一条核心经验：行程安排的松紧度决定旅行质量。把每天塞满的行程，回来记住的只有赶路；留白半天随便走走，反而最容易撞见计划外的惊喜。旅行是去生活的，不是去打卡的。",[11,84,85],{},"短途游其实被低估了。两天一晚的去处，交通时间短、准备成本低、恢复期短，一年能来七八次。相比之下一年一次的长途旅行，准备工作量和身心消耗都大，反而更容易在期待中变形。",[11,87,79],{},[11,89,82],{},[37,91,92],{"id":92},"再补充几句",[11,94,95],{},"然后想说，承认不懂是这行的美德。这次遇到不懂的地方，老老实实补了两天的课，比硬着头皮往上糊的方案强太多。不懂装懂的代价从来不会消失，只是延期，还带利息。",[11,97,98],{},"平衡感很重要的一件事：投入和收益的比例。所有优化都值得先问一句，这件事的收益上限是多少，值多少投入。无限打磨一个低价值的东西是工程师最常见的温柔陷阱，包括我自己在内。",[11,100,101],{},"忍不住再夸一下记录的力量，上周刚整理的笔记，这次直接翻出来就用，十分钟解决了当时花一下午的问题。给自己留下的每一份笔记，都是寄给未来的快递，寄件人签收时才觉得真香。",[11,103,104],{},"最后聊点感受：做技术这些年，越来越觉得最好的状态是既投入又抽离。投入是把事情做好，抽离是时不时跳出来看看方向对不对，两者缺一，要么辛苦没产出，要么轻松跑偏路。",[37,106,107],{"id":107},"小结",[11,109,110],{},"折腾完顺手写了几行代码做了个统计，理工科思维的反应就是这样，朋友都笑我，但确实好用了。",[11,112,113],{},"大概就是这些，有不同做法欢迎评论区交流。",{"title":15,"searchDepth":16,"depth":17,"links":115},[116,117,118,119,120,121],{"id":39,"depth":16,"text":39},{"id":55,"depth":16,"text":55},{"id":64,"depth":16,"text":64},{"id":76,"depth":16,"text":76},{"id":92,"depth":16,"text":92},{"id":107,"depth":16,"text":107},[123],"旅行","2025-05-03",false,{"excerpt":127},{"type":8,"value":128},[129],[11,130,35],{},"\u002Fposts\u002Ftrip\u002Fhiking-day-3",387900,{"title":29,"description":35},"posts\u002Ftrip\u002Fhiking-day-3",[136,137],"爬山","周末",[139],"trip",1293,"P21l5Wcnv0s_uEbYKEHftbZ_KRg1zP8NQgXBMzUtadE",{"prev":143,"next":146},{"path":144,"title":145},"\u002Fposts\u002Ftrip\u002Fhiking-day-2","周末爬山的正确打开方式（二）",{"path":147,"title":148},"\u002Fposts\u002Ftrip\u002Fhiking-day-4","周末爬山的正确打开方式（四）",[150,159,189],{"id":5,"title":6,"body":151,"createdAt":19,"description":13,"extension":20,"meta":157,"navigation":22,"path":23,"seo":158,"stem":25,"__hash__":26},{"type":8,"value":152,"toc":155},[153],[11,154,13],{},{"title":15,"searchDepth":16,"depth":17,"links":156},[],{},{"description":13},{"id":160,"title":161,"body":162,"createdAt":182,"description":183,"extension":20,"meta":184,"navigation":22,"path":185,"seo":186,"stem":187,"__hash__":188},"notes\u002Fnotes\u002F2026-11-14-1.md","2026 11 14 1",{"type":8,"value":163,"toc":180},[164],[11,165,166,167,171,172,179],{},"站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 ",[168,169,170],"strong",{},"Markdown","，写链接也不用到编辑器：",[173,174,178],"a",{"href":175,"rel":176},"https:\u002F\u002Fcontent.nuxt.com",[177],"nofollow","Nuxt Content","。",{"title":15,"searchDepth":16,"depth":17,"links":181},[],"2026-11-14","站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 Markdown，写链接也不用到编辑器：Nuxt Content。",{},"\u002Fnotes\u002F2026-11-14-1",{"description":183},"notes\u002F2026-11-14-1","LLJX_RKU7cgpT6aHw4DZWUZNQ_G_UzELWPKbksJvzfs",{"id":190,"title":191,"body":192,"createdAt":207,"description":208,"extension":20,"meta":209,"navigation":22,"path":210,"seo":211,"stem":212,"__hash__":213},"notes\u002Fnotes\u002F2026-11-14-2.md","2026 11 14 2",{"type":8,"value":193,"toc":205},[194],[11,195,196,200,201,204],{},[197,198,199],"code",{},"readPixels"," 读不到内容不是 bug，是 ",[197,202,203],{},"preserveDrawingBuffer"," 默认关闭——帧提交后缓冲即被清空。",{"title":15,"searchDepth":16,"depth":17,"links":206},[],"2026-11-13","readPixels 读不到内容不是 bug，是 preserveDrawingBuffer 默认关闭——帧提交后缓冲即被清空。",{},"\u002Fnotes\u002F2026-11-14-2",{"description":208},"notes\u002F2026-11-14-2","i7xWqq2eNoU_seSbLQjqlB9gE51fM-PVLUEYCHBkOA4",1795273166481]