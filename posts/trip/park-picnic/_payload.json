[{"data":1,"prerenderedAt":213},["ShallowReactive",2],{"notes-latest-1":3,"post:\u002Fposts\u002Ftrip\u002Fpark-picnic":27,"surround:\u002Fposts\u002Ftrip\u002Fpark-picnic":141,"notes-latest-3":148},[4],{"id":5,"title":6,"body":7,"createdAt":19,"description":13,"extension":20,"meta":21,"navigation":22,"path":23,"seo":24,"stem":25,"__hash__":26},"notes\u002Fnotes\u002F2026-11-14-1-2.md","2026 11 14 1 2",{"type":8,"value":9,"toc":14},"minimark",[10],[11,12,13],"p",{},"站点上线了「随笔」：支持一个文件多个随笔",{"title":15,"searchDepth":16,"depth":17,"links":18},"",2,3,[],"2026-11-17","md",{},true,"\u002Fnotes\u002F2026-11-14-1-2",{"description":13},"notes\u002F2026-11-14-1-2","hDP9fvaunHzVrZQ6QifuOtj9VrqbxlPb_52KE5wSjD0",{"id":28,"title":29,"author":30,"body":31,"categories":121,"comment":22,"cover":30,"createdAt":123,"description":35,"draft":124,"extension":20,"meta":125,"navigation":22,"path":130,"readingTime":131,"recommend":124,"seo":132,"series":30,"stem":133,"tags":134,"top":124,"topics":137,"updatedAt":30,"words":139,"__hash__":140},"posts\u002Fposts\u002Ftrip\u002Fpark-picnic.md","公园野餐的装备清单",null,{"type":8,"value":32,"toc":113},[33,36,40,43,46,52,55,58,61,64,67,70,73,76,79,82,85,87,89,92,95,98,101,104,107,110],[11,34,35],{},"有些事不记下来，过阵子就忘了当时的感受，只剩下干巴巴的结论，所以还是趁热记一下。",[37,38,39],"h2",{"id":39},"装备清单",[11,41,42],{},"春天野餐的装备清单整理一篇，纯实用向：一张防潮垫是核心装备，选带防水底的；餐具走轻量路线，一次性餐具愧对好风景，带一套轻便的；食物提前在家备好，三明治、卤味、水果切盒，现场只需要摆盘；饮品保温壶装茶或咖啡，冰袋给饮料降温。",[11,44,45],{},"还有一个容易被忽略的重要角色：垃圾袋，多带两个，走的时候把现场恢复原样，野餐的体面包含善后。",[11,47,48],{},[49,50],"img",{"alt":29,"src":51},"\u002Fimg\u002F2.webp",[37,53,54],{"id":54},"选址与时机",[11,56,57],{},"选址的学问：树荫配草坪是标配，注意头顶有没有结果实的树，掉下来砸盘子不算浪漫；离洗手间和停车场的距离要平衡；背风的位置食物不容易沾沙。时机上春天选上午十点前或下午三点后，阳光斜下来拍照自带滤镜。",[11,59,60],{},"这次野餐最成功的决策是带了一副扑克和一台拍立得，下午的时光在牌局和照片冲印的等待里过得飞快。野餐的本质不是吃，是把一个普通周末过出度假感的低成本方案，这篇清单收藏好，下个春天直接抄作业。",[37,62,63],{"id":63},"记下两点",[11,65,66],{},"煮饭水放多了，成品介于饭和粥之间。后来老老实实用量杯，或者直接看水位线，凭感觉这种事，在厨房里基本靠不住。",[11,68,69],{},"跑步前偷懒不做热身，膝盖不舒服了整整一周。现在哪怕时间紧张，也留五分钟活动开，这个时间省不得。",[11,71,72],{},"咖啡粉磨太细，手冲出来又苦又涩还带杂味，一度怀疑是豆子的问题。调粗一格立刻正常，器材和参数的问题，别先怪豆子。",[37,74,75],{"id":75},"多聊两句",[11,77,78],{},"旅行花销里性价比最低的往往是“便利”：景区门口的餐饮、酒店楼下的纪念品、临时起意的打车。提前做一小时功课，同样的预算体验能差出一倍，省下的钱够再出发一次。",[11,80,81],{},"出行这些年攒下来的一条核心经验：行程安排的松紧度决定旅行质量。把每天塞满的行程，回来记住的只有赶路；留白半天随便走走，反而最容易撞见计划外的惊喜。旅行是去生活的，不是去打卡的。",[11,83,84],{},"短途游其实被低估了。两天一晚的去处，交通时间短、准备成本低、恢复期短，一年能来七八次。相比之下一年一次的长途旅行，准备工作量和身心消耗都大，反而更容易在期待中变形。",[11,86,78],{},[11,88,81],{},[37,90,91],{"id":91},"继续聊聊",[11,93,94],{},"想想还是补一段：任何习惯的养成都绕不开启动成本，最有效的办法是把启动成本降到接近零。想跑就把鞋放门口，想写就把文档开着置顶，环境准备到位了，行动只是顺水推舟。",[11,96,97],{},"从更高的视角看，这类问题都有一个共同结构：短期收益和长期收益打架。短期的诱惑总是具体而生动，长期的回报抽象而遥远，赢家通常是那些把长期目标拆成短期可感的小奖励的人。",[11,99,100],{},"讲个题外话，做这类事情的时候最好留个记录的习惯，当时的判断依据比结果更珍贵。结果好可能只是运气好，把决策过程记下来，好运才可能被复制，坏运才可能被规避。",[11,102,103],{},"然后想说，承认不懂是这行的美德。这次遇到不懂的地方，老老实实补了两天的课，比硬着头皮往上糊的方案强太多。不懂装懂的代价从来不会消失，只是延期，还带利息。",[37,105,106],{"id":106},"最后",[11,108,109],{},"职业病之一是看什么都想拆步骤，这件事在我这里基本是个流程问题：目标、步骤、验证、复盘，一套下来居然还真管用。",[11,111,112],{},"记录完毕，方便以后自己回来翻。",{"title":15,"searchDepth":16,"depth":17,"links":114},[115,116,117,118,119,120],{"id":39,"depth":16,"text":39},{"id":54,"depth":16,"text":54},{"id":63,"depth":16,"text":63},{"id":75,"depth":16,"text":75},{"id":91,"depth":16,"text":91},{"id":106,"depth":16,"text":106},[122],"旅行","2023-11-17",false,{"excerpt":126},{"type":8,"value":127},[128],[11,129,35],{},"\u002Fposts\u002Ftrip\u002Fpark-picnic",372600,{"title":29,"description":35},"posts\u002Ftrip\u002Fpark-picnic",[135,136],"野餐","公园",[138],"trip",1242,"j-iXv7fGznUDzVVc7fJh-dT21ZClqTRHowoJqvJXRJo",{"prev":142,"next":145},{"path":143,"title":144},"\u002Fposts\u002Ftrip\u002Fold-street-4","老街慢慢走的半天（四）",{"path":146,"title":147},"\u002Fposts\u002Ftrip\u002Fpark-picnic-2","公园野餐的装备清单（二）",[149,158,188],{"id":5,"title":6,"body":150,"createdAt":19,"description":13,"extension":20,"meta":156,"navigation":22,"path":23,"seo":157,"stem":25,"__hash__":26},{"type":8,"value":151,"toc":154},[152],[11,153,13],{},{"title":15,"searchDepth":16,"depth":17,"links":155},[],{},{"description":13},{"id":159,"title":160,"body":161,"createdAt":181,"description":182,"extension":20,"meta":183,"navigation":22,"path":184,"seo":185,"stem":186,"__hash__":187},"notes\u002Fnotes\u002F2026-11-14-1.md","2026 11 14 1",{"type":8,"value":162,"toc":179},[163],[11,164,165,166,170,171,178],{},"站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 ",[167,168,169],"strong",{},"Markdown","，写链接也不用到编辑器：",[172,173,177],"a",{"href":174,"rel":175},"https:\u002F\u002Fcontent.nuxt.com",[176],"nofollow","Nuxt Content","。",{"title":15,"searchDepth":16,"depth":17,"links":180},[],"2026-11-14","站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 Markdown，写链接也不用到编辑器：Nuxt Content。",{},"\u002Fnotes\u002F2026-11-14-1",{"description":182},"notes\u002F2026-11-14-1","LLJX_RKU7cgpT6aHw4DZWUZNQ_G_UzELWPKbksJvzfs",{"id":189,"title":190,"body":191,"createdAt":206,"description":207,"extension":20,"meta":208,"navigation":22,"path":209,"seo":210,"stem":211,"__hash__":212},"notes\u002Fnotes\u002F2026-11-14-2.md","2026 11 14 2",{"type":8,"value":192,"toc":204},[193],[11,194,195,199,200,203],{},[196,197,198],"code",{},"readPixels"," 读不到内容不是 bug，是 ",[196,201,202],{},"preserveDrawingBuffer"," 默认关闭——帧提交后缓冲即被清空。",{"title":15,"searchDepth":16,"depth":17,"links":205},[],"2026-11-13","readPixels 读不到内容不是 bug，是 preserveDrawingBuffer 默认关闭——帧提交后缓冲即被清空。",{},"\u002Fnotes\u002F2026-11-14-2",{"description":207},"notes\u002F2026-11-14-2","i7xWqq2eNoU_seSbLQjqlB9gE51fM-PVLUEYCHBkOA4",1795274515444]