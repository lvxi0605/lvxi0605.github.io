[{"data":1,"prerenderedAt":204},["ShallowReactive",2],{"notes-latest-1":3,"post:\u002Fposts\u002Ftrip\u002Fancient-town":27,"surround:\u002Fposts\u002Ftrip\u002Fancient-town":132,"notes-latest-3":139},[4],{"id":5,"title":6,"body":7,"createdAt":19,"description":13,"extension":20,"meta":21,"navigation":22,"path":23,"seo":24,"stem":25,"__hash__":26},"notes\u002Fnotes\u002F2026-11-14-1-2.md","2026 11 14 1 2",{"type":8,"value":9,"toc":14},"minimark",[10],[11,12,13],"p",{},"站点上线了「随笔」：支持一个文件多个随笔",{"title":15,"searchDepth":16,"depth":17,"links":18},"",2,3,[],"2026-11-17","md",{},true,"\u002Fnotes\u002F2026-11-14-1-2",{"description":13},"notes\u002F2026-11-14-1-2","hDP9fvaunHzVrZQ6QifuOtj9VrqbxlPb_52KE5wSjD0",{"id":28,"title":29,"author":30,"body":31,"categories":113,"comment":22,"cover":30,"createdAt":115,"description":35,"draft":116,"extension":20,"meta":117,"navigation":22,"path":122,"readingTime":123,"recommend":116,"seo":124,"series":30,"stem":125,"tags":126,"top":116,"topics":128,"updatedAt":30,"words":130,"__hash__":131},"posts\u002Fposts\u002Ftrip\u002Fancient-town.md","古镇游避坑与真香指南",null,{"type":8,"value":32,"toc":105},[33,36,40,43,46,49,52,55,58,61,64,67,70,73,76,79,81,84,87,90,93,96,99,102],[11,34,35],{},"生活流水账一篇，主要是写给自己看的，也欢迎偶然点进来的你随便翻翻。",[37,38,39],"h2",{"id":39},"先泼冷水",[11,41,42],{},"古镇游的口碑两极分化，我先泼冷水：同质化的商业街、全国统一的鱿鱼和臭豆腐、晚上八点后百灯齐亮的酒吧街，这些确实是大部分古镇的现状。如果冲着这些去，预期落差一定巨大，因为任何一条城市步行街都能提供同款体验。",[11,44,45],{},"古镇真正值得看的是那些还没被改造的部分：老宅子的木雕砖雕、还在使用的水井、本地人保留的生活习惯。这些需要提前做功课，甚至需要一点运气。",[37,47,48],{"id":48},"真香的部分",[11,50,51],{},"这次住的民宿是一栋改造过的老宅，房东是本地人，晚上泡了茶拉着我们讲了两个小时这条街的往事，哪个码头当年最繁华、哪座桥的名字由来、他家老宅在特殊年代被怎么保下来的。这些口述的历史，是任何攻略里都查不到的。",[11,53,54],{},"早起六点也是古镇的正确打开方式，炊烟、挑担的菜农、猫占着石板路晒太阳，那是属于居民而不是游客的时段。总结成一句话：古镇游的快乐和你的攻略深度成正比，走马观花是自找失望，做足功课是意外惊喜。",[37,56,57],{"id":57},"两个小教训",[11,59,60],{},"加湿器开一整夜，窗台上全是水汽，墙角都有点返潮。买了个湿度计才知道，舒服的湿度是个区间，不是越大越好，很多事都是这个道理。",[11,62,63],{},"桌面充电线缠成一团，剪也剪不开理也理不清。十块钱的理线器加几个标签贴，一次到位。这种小钱花出去，回报率出奇地高。",[11,65,66],{},"保温杯里闷了一晚上的茶，苦到怀疑人生。茶水分离的杯子买回来之后，每一泡都恰到好处，工具选对，体验立刻不同。",[37,68,69],{"id":69},"一点延伸",[11,71,72],{},"出行这些年攒下来的一条核心经验：行程安排的松紧度决定旅行质量。把每天塞满的行程，回来记住的只有赶路；留白半天随便走走，反而最容易撞见计划外的惊喜。旅行是去生活的，不是去打卡的。",[11,74,75],{},"短途游其实被低估了。两天一晚的去处，交通时间短、准备成本低、恢复期短，一年能来七八次。相比之下一年一次的长途旅行，准备工作量和身心消耗都大，反而更容易在期待中变形。",[11,77,78],{},"旅行花销里性价比最低的往往是“便利”：景区门口的餐饮、酒店楼下的纪念品、临时起意的打车。提前做一小时功课，同样的预算体验能差出一倍，省下的钱够再出发一次。",[11,80,72],{},[37,82,83],{"id":83},"再补充几句",[11,85,86],{},"有个观察分享给大家：技术的成长曲线不是线性的，是一段平台加一次跃迁。平台期最磨人，感觉学了很多没进步，其实是在攒素材，攒够了某个契机一到就突飞猛进。所以在平台期别否定自己，那是跃迁的前奏。",[11,88,89],{},"再补充一个角度：做这些事情的时候，工具的顺滑度影响巨大。同样的活，称手的工具能让摩擦力小一半，这种差异日积月累就是人和人的差距。定期审视自己的工具链，删掉碍事的，补上趁手的，值得当成一个固定动作。",[11,91,92],{},"由这件事联想到阅读习惯：资料要看一手来源，译文和二手转述经常带着传播者的理解偏差，偏差叠几层之后和原意面目全非。多花十分钟读原文，省下的是未来几小时的排查，这笔账怎么算都划算。",[11,94,95],{},"还有个感受越来越深：知识落地成文字的过程本身就是学习的一部分。很多自以为想清楚的东西，写出来才发现逻辑有洞。写作是最好的检验，这也是坚持写博客这么多年的理由之一，写不出来的就是还没学会的。",[37,97,98],{"id":98},"写在最后",[11,100,101],{},"同事听说我周末在干这个，一脸问号。其实思路和排查问题差不多，提出猜想，做实验，看结果，一样一样的。",[11,103,104],{},"大概就是这些，有不同做法欢迎评论区交流。",{"title":15,"searchDepth":16,"depth":17,"links":106},[107,108,109,110,111,112],{"id":39,"depth":16,"text":39},{"id":48,"depth":16,"text":48},{"id":57,"depth":16,"text":57},{"id":69,"depth":16,"text":69},{"id":83,"depth":16,"text":83},{"id":98,"depth":16,"text":98},[114],"旅行","2026-03-04",false,{"excerpt":118},{"type":8,"value":119},[120],[11,121,35],{},"\u002Fposts\u002Ftrip\u002Fancient-town",373800,{"title":29,"description":35},"posts\u002Ftrip\u002Fancient-town",[127,114],"古镇",[129],"trip",1246,"mXYxXBMbk60JMOLZNfU5HPYSgZev6bwsU_hv2IlT1vM",{"prev":133,"next":136},{"path":134,"title":135},"\u002Fposts\u002Ftools\u002Fpacket-capture-6","用抓包定位线上问题（六）",{"path":137,"title":138},"\u002Fposts\u002Ftrip\u002Fancient-town-2","古镇游避坑与真香指南（二）",[140,149,179],{"id":5,"title":6,"body":141,"createdAt":19,"description":13,"extension":20,"meta":147,"navigation":22,"path":23,"seo":148,"stem":25,"__hash__":26},{"type":8,"value":142,"toc":145},[143],[11,144,13],{},{"title":15,"searchDepth":16,"depth":17,"links":146},[],{},{"description":13},{"id":150,"title":151,"body":152,"createdAt":172,"description":173,"extension":20,"meta":174,"navigation":22,"path":175,"seo":176,"stem":177,"__hash__":178},"notes\u002Fnotes\u002F2026-11-14-1.md","2026 11 14 1",{"type":8,"value":153,"toc":170},[154],[11,155,156,157,161,162,169],{},"站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 ",[158,159,160],"strong",{},"Markdown","，写链接也不用到编辑器：",[163,164,168],"a",{"href":165,"rel":166},"https:\u002F\u002Fcontent.nuxt.com",[167],"nofollow","Nuxt Content","。",{"title":15,"searchDepth":16,"depth":17,"links":171},[],"2026-11-14","站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 Markdown，写链接也不用到编辑器：Nuxt Content。",{},"\u002Fnotes\u002F2026-11-14-1",{"description":173},"notes\u002F2026-11-14-1","LLJX_RKU7cgpT6aHw4DZWUZNQ_G_UzELWPKbksJvzfs",{"id":180,"title":181,"body":182,"createdAt":197,"description":198,"extension":20,"meta":199,"navigation":22,"path":200,"seo":201,"stem":202,"__hash__":203},"notes\u002Fnotes\u002F2026-11-14-2.md","2026 11 14 2",{"type":8,"value":183,"toc":195},[184],[11,185,186,190,191,194],{},[187,188,189],"code",{},"readPixels"," 读不到内容不是 bug，是 ",[187,192,193],{},"preserveDrawingBuffer"," 默认关闭——帧提交后缓冲即被清空。",{"title":15,"searchDepth":16,"depth":17,"links":196},[],"2026-11-13","readPixels 读不到内容不是 bug，是 preserveDrawingBuffer 默认关闭——帧提交后缓冲即被清空。",{},"\u002Fnotes\u002F2026-11-14-2",{"description":198},"notes\u002F2026-11-14-2","i7xWqq2eNoU_seSbLQjqlB9gE51fM-PVLUEYCHBkOA4",1795274514946]