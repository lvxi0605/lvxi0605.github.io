[{"data":1,"prerenderedAt":204},["ShallowReactive",2],{"notes-latest-1":3,"post:\u002Fposts\u002Ftrip\u002Fmuseum-day-3":27,"surround:\u002Fposts\u002Ftrip\u002Fmuseum-day-3":132,"notes-latest-3":139},[4],{"id":5,"title":6,"body":7,"createdAt":19,"description":13,"extension":20,"meta":21,"navigation":22,"path":23,"seo":24,"stem":25,"__hash__":26},"notes\u002Fnotes\u002F2026-11-14-1-2.md","2026 11 14 1 2",{"type":8,"value":9,"toc":14},"minimark",[10],[11,12,13],"p",{},"站点上线了「随笔」：支持一个文件多个随笔",{"title":15,"searchDepth":16,"depth":17,"links":18},"",2,3,[],"2026-11-17","md",{},true,"\u002Fnotes\u002F2026-11-14-1-2",{"description":13},"notes\u002F2026-11-14-1-2","hDP9fvaunHzVrZQ6QifuOtj9VrqbxlPb_52KE5wSjD0",{"id":28,"title":29,"author":30,"body":31,"categories":112,"comment":22,"cover":30,"createdAt":114,"description":35,"draft":115,"extension":20,"meta":116,"navigation":22,"path":121,"readingTime":122,"recommend":115,"seo":123,"series":30,"stem":124,"tags":125,"top":115,"topics":128,"updatedAt":30,"words":130,"__hash__":131},"posts\u002Fposts\u002Ftrip\u002Fmuseum-day-3.md","逛博物馆的一点心得（三）",null,{"type":8,"value":32,"toc":104},[33,36,40,43,46,49,52,55,58,61,64,67,70,73,76,78,80,83,86,89,92,95,98,101],[11,34,35],{},"天气不错的一个周末，出去走了走，回来顺手把当天的感受记下来。",[37,38,39],"h2",{"id":39},"别贪多",[11,41,42],{},"以前逛博物馆的失败经验：一进门挨个展柜看过去，两小时后走到出口，脑子里什么都没留下，腿倒是废了。后来学乖了，一次只看一个主题展，或者只挑十件重点展品认真看，剩下的随缘。博物馆是吃不下的，它值得反复来。",[11,44,45],{},"租讲解器或者蹭免费讲解真的不一样，同一件青铜器，知道铭文讲了什么之后，它就从一个绿疙瘩变成了一件有故事的器物。时间允许的话，先看半小时纪录片再进场，观感直接翻倍。",[37,47,48],{"id":48},"错峰与周边",[11,50,51],{},"实用技巧几条：工作日下午人最少，周末十点前也还行，十一点后就是人从众；大包寄存，轻装上阵；出口处的文创店值得逛，漂亮的冰箱贴是这场文化消费的实体存档。馆里的咖啡馆也别错过，坐在落地窗前歇脚的时候，那种时间被拉长的感觉，是逛博物馆的隐藏福利。这篇写在这次刷完特展的晚上，下个展已经排上日程了。",[37,53,54],{"id":54},"记下两点",[11,56,57],{},"煮饭水放多了，成品介于饭和粥之间。后来老老实实用量杯，或者直接看水位线，凭感觉这种事，在厨房里基本靠不住。",[11,59,60],{},"跑步前偷懒不做热身，膝盖不舒服了整整一周。现在哪怕时间紧张，也留五分钟活动开，这个时间省不得。",[11,62,63],{},"咖啡粉磨太细，手冲出来又苦又涩还带杂味，一度怀疑是豆子的问题。调粗一格立刻正常，器材和参数的问题，别先怪豆子。",[37,65,66],{"id":66},"多聊两句",[11,68,69],{},"短途游其实被低估了。两天一晚的去处，交通时间短、准备成本低、恢复期短，一年能来七八次。相比之下一年一次的长途旅行，准备工作量和身心消耗都大，反而更容易在期待中变形。",[11,71,72],{},"旅行花销里性价比最低的往往是“便利”：景区门口的餐饮、酒店楼下的纪念品、临时起意的打车。提前做一小时功课，同样的预算体验能差出一倍，省下的钱够再出发一次。",[11,74,75],{},"出行这些年攒下来的一条核心经验：行程安排的松紧度决定旅行质量。把每天塞满的行程，回来记住的只有赶路；留白半天随便走走，反而最容易撞见计划外的惊喜。旅行是去生活的，不是去打卡的。",[11,77,69],{},[11,79,72],{},[37,81,82],{"id":82},"继续聊聊",[11,84,85],{},"这类经验在文档里通常只有一行字，背后的排查却是一整个下午。技术工作的大部分时间都花在这些不会写进简历的细节里，所以这些细节才更需要有人写出来，哪怕只是给未来某一天忘了的自己。",[11,87,88],{},"顺带聊聊方法论：遇到不熟悉的领域，我的习惯是先把最小闭环跑通，哪怕每一步都很粗糙。跑通之后再逐段替换成正经实现，过程中每一步都有可运行的版本。这个思路在工作和生活里都屡试不爽，比憋大招的成功率高得多。",[11,90,91],{},"另外觉得这件事里有个普遍适用的规律：复杂度不会消失，只会转移。你省掉的每一步设计，最后都会在排查、扩容或者交接的某个时刻加倍还回来。所谓好的方案，不过是把复杂度放到了值得的位置。",[11,93,94],{},"回顾这个过程，最大的教训其实是克制。可选项永远比需要的多，每个新方案看起来都比现状好一点，但都加上之后，系统就成了没人看得懂的拼贴画。做减法的判断比做加法的胆子更值钱。",[37,96,97],{"id":97},"写在最后",[11,99,100],{},"这事让我想起灰度发布的思路，任何改变都别一次到位，小范围试试，没问题再推广，生活里同样适用。",[11,102,103],{},"记录完毕，方便以后自己回来翻。",{"title":15,"searchDepth":16,"depth":17,"links":105},[106,107,108,109,110,111],{"id":39,"depth":16,"text":39},{"id":48,"depth":16,"text":48},{"id":54,"depth":16,"text":54},{"id":66,"depth":16,"text":66},{"id":82,"depth":16,"text":82},{"id":97,"depth":16,"text":97},[113],"旅行","2023-09-23",false,{"excerpt":117},{"type":8,"value":118},[119],[11,120,35],{},"\u002Fposts\u002Ftrip\u002Fmuseum-day-3",371100,{"title":29,"description":35},"posts\u002Ftrip\u002Fmuseum-day-3",[126,127],"博物馆","周末",[129],"trip",1237,"WCuxt2Dh-HRgrHNMl2gsCIJvErziI3Kd_M7v_lXcy7w",{"prev":133,"next":136},{"path":134,"title":135},"\u002Fposts\u002Ftrip\u002Fmuseum-day-2","逛博物馆的一点心得（二）",{"path":137,"title":138},"\u002Fposts\u002Ftrip\u002Fold-street","老街慢慢走的半天",[140,149,179],{"id":5,"title":6,"body":141,"createdAt":19,"description":13,"extension":20,"meta":147,"navigation":22,"path":23,"seo":148,"stem":25,"__hash__":26},{"type":8,"value":142,"toc":145},[143],[11,144,13],{},{"title":15,"searchDepth":16,"depth":17,"links":146},[],{},{"description":13},{"id":150,"title":151,"body":152,"createdAt":172,"description":173,"extension":20,"meta":174,"navigation":22,"path":175,"seo":176,"stem":177,"__hash__":178},"notes\u002Fnotes\u002F2026-11-14-1.md","2026 11 14 1",{"type":8,"value":153,"toc":170},[154],[11,155,156,157,161,162,169],{},"站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 ",[158,159,160],"strong",{},"Markdown","，写链接也不用到编辑器：",[163,164,168],"a",{"href":165,"rel":166},"https:\u002F\u002Fcontent.nuxt.com",[167],"nofollow","Nuxt Content","。",{"title":15,"searchDepth":16,"depth":17,"links":171},[],"2026-11-14","站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 Markdown，写链接也不用到编辑器：Nuxt Content。",{},"\u002Fnotes\u002F2026-11-14-1",{"description":173},"notes\u002F2026-11-14-1","LLJX_RKU7cgpT6aHw4DZWUZNQ_G_UzELWPKbksJvzfs",{"id":180,"title":181,"body":182,"createdAt":197,"description":198,"extension":20,"meta":199,"navigation":22,"path":200,"seo":201,"stem":202,"__hash__":203},"notes\u002Fnotes\u002F2026-11-14-2.md","2026 11 14 2",{"type":8,"value":183,"toc":195},[184],[11,185,186,190,191,194],{},[187,188,189],"code",{},"readPixels"," 读不到内容不是 bug，是 ",[187,192,193],{},"preserveDrawingBuffer"," 默认关闭——帧提交后缓冲即被清空。",{"title":15,"searchDepth":16,"depth":17,"links":196},[],"2026-11-13","readPixels 读不到内容不是 bug，是 preserveDrawingBuffer 默认关闭——帧提交后缓冲即被清空。",{},"\u002Fnotes\u002F2026-11-14-2",{"description":198},"notes\u002F2026-11-14-2","i7xWqq2eNoU_seSbLQjqlB9gE51fM-PVLUEYCHBkOA4",1795303405773]