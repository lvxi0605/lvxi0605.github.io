[{"data":1,"prerenderedAt":205},["ShallowReactive",2],{"notes-latest-1":3,"post:\u002Fposts\u002Ftrip\u002Fhiking-day-4":27,"surround:\u002Fposts\u002Ftrip\u002Fhiking-day-4":133,"notes-latest-3":140},[4],{"id":5,"title":6,"body":7,"createdAt":19,"description":13,"extension":20,"meta":21,"navigation":22,"path":23,"seo":24,"stem":25,"__hash__":26},"notes\u002Fnotes\u002F2026-11-14-1-2.md","2026 11 14 1 2",{"type":8,"value":9,"toc":14},"minimark",[10],[11,12,13],"p",{},"站点上线了「随笔」：支持一个文件多个随笔",{"title":15,"searchDepth":16,"depth":17,"links":18},"",2,3,[],"2026-11-17","md",{},true,"\u002Fnotes\u002F2026-11-14-1-2",{"description":13},"notes\u002F2026-11-14-1-2","hDP9fvaunHzVrZQ6QifuOtj9VrqbxlPb_52KE5wSjD0",{"id":28,"title":29,"author":30,"body":31,"categories":113,"comment":22,"cover":30,"createdAt":115,"description":35,"draft":116,"extension":20,"meta":117,"navigation":22,"path":122,"readingTime":123,"recommend":116,"seo":124,"series":30,"stem":125,"tags":126,"top":116,"topics":129,"updatedAt":30,"words":131,"__hash__":132},"posts\u002Fposts\u002Ftrip\u002Fhiking-day-4.md","周末爬山的正确打开方式（四）",null,{"type":8,"value":32,"toc":105},[33,36,40,43,46,49,52,55,58,61,64,67,70,73,76,79,81,84,87,90,93,96,99,102],[11,34,35],{},"天气不错的一个周末，出去走了走，回来顺手把当天的感受记下来。",[37,38,39],"h2",{"id":39},"这次走的路线",[11,41,42],{},"这次选的路线是城郊一条成熟的野径，全程七八公里，累计爬升六百米，对中级新手友好。出发前做足了功课：轨迹下载好、天气确认两遍、水带三升。事实证明准备是有价值的，半路遇到没带够水的队伍蹭掉了我们半升备用水。",[11,44,45],{},"爬山的节奏我摸索出的心得是：前三分之一刻意压速度，心率控制在能正常说话的程度；中段匀速，小步频省力；最后一段看状态冲刺。这套节奏下，全程不喘成狗，风景反而看得更仔细。",[37,47,48],{"id":48},"山顶与下撤",[11,50,51],{},"山顶的风光值回全部体力，能见度好的时候能看到远处的城市轮廓，平时仰视的写字楼从山上看下去小得像积木。在山顶吃了带来的三明治，饱腹感的排序瞬间被重新定义。",[11,53,54],{},"下山比上山伤膝盖，这点必须强调：身体重心后坐，小步走，或者干脆侧身下。回家泡了个热水澡，第二天的小腿酸胀在预期之内。爬山这项运动的最大好处是强度和风景可以兼得，跑步是纯付出，爬山是付出加奖赏，对意志力一般的人友好太多。下个月的目标是同一条线提速半小时，先记录在这里。",[37,56,57],{"id":57},"两个小教训",[11,59,60],{},"下雨天骑车上班，一个转弯摔了，人没大事，裤子毁了，手机屏幕裂了道纹。从那之后雨天一律地铁，通勤的意义是到达，不是冒险。",[11,62,63],{},"花了半个小时找手机，最后发现它在冰箱里，旁边是牛奶。那天之后我认真审视了自己的疲劳程度，人不是机器，续航是有数的。",[11,65,66],{},"剩菜以前是等凉透再进冰箱，被科普之后才知道要尽快冷藏，细菌繁殖的窗口期比想象中短。生活里很多想当然的习惯，较真起来都有另一套答案。",[37,68,69],{"id":69},"一点延伸",[11,71,72],{},"短途游其实被低估了。两天一晚的去处，交通时间短、准备成本低、恢复期短，一年能来七八次。相比之下一年一次的长途旅行，准备工作量和身心消耗都大，反而更容易在期待中变形。",[11,74,75],{},"旅行花销里性价比最低的往往是“便利”：景区门口的餐饮、酒店楼下的纪念品、临时起意的打车。提前做一小时功课，同样的预算体验能差出一倍，省下的钱够再出发一次。",[11,77,78],{},"出行这些年攒下来的一条核心经验：行程安排的松紧度决定旅行质量。把每天塞满的行程，回来记住的只有赶路；留白半天随便走走，反而最容易撞见计划外的惊喜。旅行是去生活的，不是去打卡的。",[11,80,72],{},[37,82,83],{"id":83},"再补充几句",[11,85,86],{},"忍不住再夸一下记录的力量，上周刚整理的笔记，这次直接翻出来就用，十分钟解决了当时花一下午的问题。给自己留下的每一份笔记，都是寄给未来的快递，寄件人签收时才觉得真香。",[11,88,89],{},"最后聊点感受：做技术这些年，越来越觉得最好的状态是既投入又抽离。投入是把事情做好，抽离是时不时跳出来看看方向对不对，两者缺一，要么辛苦没产出，要么轻松跑偏路。",[11,91,92],{},"写着写着想到，很多技术选择本质上都是在回答同一个问题：这个方案在出问题的时候是什么样子。不出问题的方案人人都写得出来，区分度全在故障时刻的表现。多想一层失败路径，很多纠结就自动有了答案。",[11,94,95],{},"这类经验在文档里通常只有一行字，背后的排查却是一整个下午。技术工作的大部分时间都花在这些不会写进简历的细节里，所以这些细节才更需要有人写出来，哪怕只是给未来某一天忘了的自己。",[37,97,98],{"id":98},"小结",[11,100,101],{},"我把这件事当成一个小需求来管理，明确了目标和验收标准，中途改了两次方案，最后的效果自己挺满意。",[11,103,104],{},"就写到这吧，锅里还炖着东西，得去看一眼。",{"title":15,"searchDepth":16,"depth":17,"links":106},[107,108,109,110,111,112],{"id":39,"depth":16,"text":39},{"id":48,"depth":16,"text":48},{"id":57,"depth":16,"text":57},{"id":69,"depth":16,"text":69},{"id":83,"depth":16,"text":83},{"id":98,"depth":16,"text":98},[114],"旅行","2025-02-16",false,{"excerpt":118},{"type":8,"value":119},[120],[11,121,35],{},"\u002Fposts\u002Ftrip\u002Fhiking-day-4",373200,{"title":29,"description":35},"posts\u002Ftrip\u002Fhiking-day-4",[127,128],"爬山","周末",[130],"trip",1244,"XLhfgLAaWpsdRZiEaMedLZk44qckW40xP1DIVdr7ulQ",{"prev":134,"next":137},{"path":135,"title":136},"\u002Fposts\u002Ftrip\u002Fhiking-day-3","周末爬山的正确打开方式（三）",{"path":138,"title":139},"\u002Fposts\u002Ftrip\u002Fmuseum-day","逛博物馆的一点心得",[141,150,180],{"id":5,"title":6,"body":142,"createdAt":19,"description":13,"extension":20,"meta":148,"navigation":22,"path":23,"seo":149,"stem":25,"__hash__":26},{"type":8,"value":143,"toc":146},[144],[11,145,13],{},{"title":15,"searchDepth":16,"depth":17,"links":147},[],{},{"description":13},{"id":151,"title":152,"body":153,"createdAt":173,"description":174,"extension":20,"meta":175,"navigation":22,"path":176,"seo":177,"stem":178,"__hash__":179},"notes\u002Fnotes\u002F2026-11-14-1.md","2026 11 14 1",{"type":8,"value":154,"toc":171},[155],[11,156,157,158,162,163,170],{},"站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 ",[159,160,161],"strong",{},"Markdown","，写链接也不用到编辑器：",[164,165,169],"a",{"href":166,"rel":167},"https:\u002F\u002Fcontent.nuxt.com",[168],"nofollow","Nuxt Content","。",{"title":15,"searchDepth":16,"depth":17,"links":172},[],"2026-11-14","站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 Markdown，写链接也不用到编辑器：Nuxt Content。",{},"\u002Fnotes\u002F2026-11-14-1",{"description":174},"notes\u002F2026-11-14-1","LLJX_RKU7cgpT6aHw4DZWUZNQ_G_UzELWPKbksJvzfs",{"id":181,"title":182,"body":183,"createdAt":198,"description":199,"extension":20,"meta":200,"navigation":22,"path":201,"seo":202,"stem":203,"__hash__":204},"notes\u002Fnotes\u002F2026-11-14-2.md","2026 11 14 2",{"type":8,"value":184,"toc":196},[185],[11,186,187,191,192,195],{},[188,189,190],"code",{},"readPixels"," 读不到内容不是 bug，是 ",[188,193,194],{},"preserveDrawingBuffer"," 默认关闭——帧提交后缓冲即被清空。",{"title":15,"searchDepth":16,"depth":17,"links":197},[],"2026-11-13","readPixels 读不到内容不是 bug，是 preserveDrawingBuffer 默认关闭——帧提交后缓冲即被清空。",{},"\u002Fnotes\u002F2026-11-14-2",{"description":199},"notes\u002F2026-11-14-2","i7xWqq2eNoU_seSbLQjqlB9gE51fM-PVLUEYCHBkOA4",1795348524084]