[{"data":1,"prerenderedAt":204},["ShallowReactive",2],{"notes-latest-1":3,"post:\u002Fposts\u002Ftrip\u002Fseaside-weekend-4":27,"surround:\u002Fposts\u002Ftrip\u002Fseaside-weekend-4":132,"notes-latest-3":139},[4],{"id":5,"title":6,"body":7,"createdAt":19,"description":13,"extension":20,"meta":21,"navigation":22,"path":23,"seo":24,"stem":25,"__hash__":26},"notes\u002Fnotes\u002F2026-11-14-1-2.md","2026 11 14 1 2",{"type":8,"value":9,"toc":14},"minimark",[10],[11,12,13],"p",{},"站点上线了「随笔」：支持一个文件多个随笔",{"title":15,"searchDepth":16,"depth":17,"links":18},"",2,3,[],"2026-11-17","md",{},true,"\u002Fnotes\u002F2026-11-14-1-2",{"description":13},"notes\u002F2026-11-14-1-2","hDP9fvaunHzVrZQ6QifuOtj9VrqbxlPb_52KE5wSjD0",{"id":28,"title":29,"author":30,"body":31,"categories":112,"comment":22,"cover":30,"createdAt":114,"description":35,"draft":115,"extension":20,"meta":116,"navigation":22,"path":121,"readingTime":122,"recommend":115,"seo":123,"series":30,"stem":124,"tags":125,"top":115,"topics":128,"updatedAt":30,"words":130,"__hash__":131},"posts\u002Fposts\u002Ftrip\u002Fseaside-weekend-4.md","两天一晚的海边行程（四）",null,{"type":8,"value":32,"toc":104},[33,36,40,43,46,49,52,55,58,61,64,67,70,73,76,78,80,83,86,89,92,95,98,101],[11,34,35],{},"最近节奏慢了一些，多了点观察生活的时间，这篇就是这么来的。",[37,38,39],"h2",{"id":39},"行程怎么安排",[11,41,42],{},"两天一晚的海边短途游，行程安排的经验值：第一天下午到，先去酒店放行李再出门，日落前一小时的滩涂光线最美；晚餐吃本地的海鲜大排档，点菜原则是只点当天的鲜货，问老板今天什么好就吃什么；第二天早起看日出，中午退房前再在沙滩上耗一会儿，下午返程。",[11,44,45],{},"这个节奏松紧合适，既不赶也不至于无聊。海边的行程千万别排满，看海这件事本身就该占据主要时间，发呆是正经事。",[37,47,48],{"id":48},"装备与花销",[11,50,51],{},"装备清单值得一记：防晒是刚需，海边的紫外线反射强度比市区狠得多；拖鞋泳衣速干巾；驱蚊液看季节。花销大头其实不是吃住是时间，两天时间成本换来的放松效果远超两倍的一日游。回程车上翻照片，夕阳把每个人的轮廓都描了金边，这种照片不需要修图。海边回来后的那周，睡眠质量都好了不少，这大概是最实在的疗效。下一次短途已经预定，去山里泡温泉，秋冬的保留节目。",[37,53,54],{"id":54},"过程中的小心得",[11,56,57],{},"保温杯里闷了一晚上的茶，苦到怀疑人生。茶水分离的杯子买回来之后，每一泡都恰到好处，工具选对，体验立刻不同。",[11,59,60],{},"下雨天骑车上班，一个转弯摔了，人没大事，裤子毁了，手机屏幕裂了道纹。从那之后雨天一律地铁，通勤的意义是到达，不是冒险。",[11,62,63],{},"花了半个小时找手机，最后发现它在冰箱里，旁边是牛奶。那天之后我认真审视了自己的疲劳程度，人不是机器，续航是有数的。",[37,65,66],{"id":66},"延伸几句",[11,68,69],{},"短途游其实被低估了。两天一晚的去处，交通时间短、准备成本低、恢复期短，一年能来七八次。相比之下一年一次的长途旅行，准备工作量和身心消耗都大，反而更容易在期待中变形。",[11,71,72],{},"旅行花销里性价比最低的往往是“便利”：景区门口的餐饮、酒店楼下的纪念品、临时起意的打车。提前做一小时功课，同样的预算体验能差出一倍，省下的钱够再出发一次。",[11,74,75],{},"出行这些年攒下来的一条核心经验：行程安排的松紧度决定旅行质量。把每天塞满的行程，回来记住的只有赶路；留白半天随便走走，反而最容易撞见计划外的惊喜。旅行是去生活的，不是去打卡的。",[11,77,69],{},[11,79,72],{},[37,81,82],{"id":82},"又想到一些",[11,84,85],{},"再补充一个角度：做这些事情的时候，工具的顺滑度影响巨大。同样的活，称手的工具能让摩擦力小一半，这种差异日积月累就是人和人的差距。定期审视自己的工具链，删掉碍事的，补上趁手的，值得当成一个固定动作。",[11,87,88],{},"由这件事联想到阅读习惯：资料要看一手来源，译文和二手转述经常带着传播者的理解偏差，偏差叠几层之后和原意面目全非。多花十分钟读原文，省下的是未来几小时的排查，这笔账怎么算都划算。",[11,90,91],{},"还有个感受越来越深：知识落地成文字的过程本身就是学习的一部分。很多自以为想清楚的东西，写出来才发现逻辑有洞。写作是最好的检验，这也是坚持写博客这么多年的理由之一，写不出来的就是还没学会的。",[11,93,94],{},"过程中也反复体会到取舍的本质：没有完美的方案，只有当下约束下最合适的方案。把约束写清楚，方案的选择题就变成了证明题，这也是为什么我习惯先列约束再谈方案，顺序反了全是无效争论。",[37,96,97],{"id":97},"小结",[11,99,100],{},"同事听说我周末在干这个，一脸问号。其实思路和排查问题差不多，提出猜想，做实验，看结果，一样一样的。",[11,102,103],{},"如果你也遇到类似的情况，评论区聊聊。",{"title":15,"searchDepth":16,"depth":17,"links":105},[106,107,108,109,110,111],{"id":39,"depth":16,"text":39},{"id":48,"depth":16,"text":48},{"id":54,"depth":16,"text":54},{"id":66,"depth":16,"text":66},{"id":82,"depth":16,"text":82},{"id":97,"depth":16,"text":97},[113],"旅行","2024-12-07",false,{"excerpt":117},{"type":8,"value":118},[119],[11,120,35],{},"\u002Fposts\u002Ftrip\u002Fseaside-weekend-4",383100,{"title":29,"description":35},"posts\u002Ftrip\u002Fseaside-weekend-4",[126,127],"海边","短途",[129],"trip",1277,"58V60tmHekj0igv6KLVOXxhBJdDtRZWKwoY0EGfd2Pc",{"prev":133,"next":136},{"path":134,"title":135},"\u002Fposts\u002Ftrip\u002Fseaside-weekend-3","两天一晚的海边行程（三）",{"path":137,"title":138},"\u002Fposts\u002F测试4","测试页面4",[140,149,179],{"id":5,"title":6,"body":141,"createdAt":19,"description":13,"extension":20,"meta":147,"navigation":22,"path":23,"seo":148,"stem":25,"__hash__":26},{"type":8,"value":142,"toc":145},[143],[11,144,13],{},{"title":15,"searchDepth":16,"depth":17,"links":146},[],{},{"description":13},{"id":150,"title":151,"body":152,"createdAt":172,"description":173,"extension":20,"meta":174,"navigation":22,"path":175,"seo":176,"stem":177,"__hash__":178},"notes\u002Fnotes\u002F2026-11-14-1.md","2026 11 14 1",{"type":8,"value":153,"toc":170},[154],[11,155,156,157,161,162,169],{},"站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 ",[158,159,160],"strong",{},"Markdown","，写链接也不用到编辑器：",[163,164,168],"a",{"href":165,"rel":166},"https:\u002F\u002Fcontent.nuxt.com",[167],"nofollow","Nuxt Content","。",{"title":15,"searchDepth":16,"depth":17,"links":171},[],"2026-11-14","站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 Markdown，写链接也不用到编辑器：Nuxt Content。",{},"\u002Fnotes\u002F2026-11-14-1",{"description":173},"notes\u002F2026-11-14-1","LLJX_RKU7cgpT6aHw4DZWUZNQ_G_UzELWPKbksJvzfs",{"id":180,"title":181,"body":182,"createdAt":197,"description":198,"extension":20,"meta":199,"navigation":22,"path":200,"seo":201,"stem":202,"__hash__":203},"notes\u002Fnotes\u002F2026-11-14-2.md","2026 11 14 2",{"type":8,"value":183,"toc":195},[184],[11,185,186,190,191,194],{},[187,188,189],"code",{},"readPixels"," 读不到内容不是 bug，是 ",[187,192,193],{},"preserveDrawingBuffer"," 默认关闭——帧提交后缓冲即被清空。",{"title":15,"searchDepth":16,"depth":17,"links":196},[],"2026-11-13","readPixels 读不到内容不是 bug，是 preserveDrawingBuffer 默认关闭——帧提交后缓冲即被清空。",{},"\u002Fnotes\u002F2026-11-14-2",{"description":198},"notes\u002F2026-11-14-2","i7xWqq2eNoU_seSbLQjqlB9gE51fM-PVLUEYCHBkOA4",1795333672729]