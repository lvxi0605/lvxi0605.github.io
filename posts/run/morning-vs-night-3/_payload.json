[{"data":1,"prerenderedAt":207},["ShallowReactive",2],{"notes-latest-1":3,"post:\u002Fposts\u002Frun\u002Fmorning-vs-night-3":27,"surround:\u002Fposts\u002Frun\u002Fmorning-vs-night-3":135,"notes-latest-3":142},[4],{"id":5,"title":6,"body":7,"createdAt":19,"description":13,"extension":20,"meta":21,"navigation":22,"path":23,"seo":24,"stem":25,"__hash__":26},"notes\u002Fnotes\u002F2026-11-14-1-2.md","2026 11 14 1 2",{"type":8,"value":9,"toc":14},"minimark",[10],[11,12,13],"p",{},"站点上线了「随笔」：支持一个文件多个随笔",{"title":15,"searchDepth":16,"depth":17,"links":18},"",2,3,[],"2026-11-17","md",{},true,"\u002Fnotes\u002F2026-11-14-1-2",{"description":13},"notes\u002F2026-11-14-1-2","hDP9fvaunHzVrZQ6QifuOtj9VrqbxlPb_52KE5wSjD0",{"id":28,"title":29,"author":30,"body":31,"categories":115,"comment":22,"cover":30,"createdAt":117,"description":35,"draft":118,"extension":20,"meta":119,"navigation":22,"path":124,"readingTime":125,"recommend":118,"seo":126,"series":30,"stem":127,"tags":128,"top":118,"topics":131,"updatedAt":30,"words":133,"__hash__":134},"posts\u002Fposts\u002Frun\u002Fmorning-vs-night-3.md","晨跑和夜跑我都试过了（三）",null,{"type":8,"value":32,"toc":107},[33,36,40,43,46,49,52,55,58,61,64,67,70,73,76,79,81,83,86,89,92,95,98,101,104],[11,34,35],{},"周末闲下来，想把这件事记一笔，没什么技术含量，就是觉得有点意思，不写下来可惜。",[37,38,39],"h2",{"id":39},"两种时段的体验",[11,41,42],{},"晨跑和夜跑各跑了几个月，体验完全不同。晨跑的对手是床和低温，但跑完的收益巨大：一整天的精神状态在线，晚上睡眠质量变好，而且清晨的街道有种刚出厂的干净感，空气凉得发甜。夜跑的优势是身体已经完全热开，配速普遍比晨跑快，缺点是容易拖延，加班晚归的借口太多了。",[11,44,45],{},"我的结论是两者都可以，关键是稳定。时段换来换去最伤节奏，身体喜欢规律，固定一个时段坚持四周，习惯的摩擦力就消失了。",[37,47,48],{"id":48},"我的选择",[11,50,51],{},"我现在固定在早上跑，理由很功利：晚上的时间不可控，加班、聚会、临时有事，任何一样都能吞掉跑步时段；而早上六点半的时间属于我，没有竞争者。为了让早起无痛一点，我把跑鞋放在床边，前一晚衣服配好，闹钟响了穿上就走，把决策环节压到最少。",[11,53,54],{},"冬天晨跑要多穿一层，出门那五分钟是全天最冷的五分钟，跑起来之后就是热身自带的功能了。如果你也在纠结时段，别纠结了，今天几点有空就几点跑，先跑起来，时段是后话。",[37,56,57],{"id":57},"过程中的小心得",[11,59,60],{},"剩菜以前是等凉透再进冰箱，被科普之后才知道要尽快冷藏，细菌繁殖的窗口期比想象中短。生活里很多想当然的习惯，较真起来都有另一套答案。",[11,62,63],{},"随手记两个小教训：阳台那盆绿萝浇得太勤，根都泡烂了，剪掉烂的部分重新扦插，现在改了策略，土干了再浇，反倒精神了不少。",[11,65,66],{},"煮饭水放多了，成品介于饭和粥之间。后来老老实实用量杯，或者直接看水位线，凭感觉这种事，在厨房里基本靠不住。",[37,68,69],{"id":69},"延伸几句",[11,71,72],{},"跑步的社交属性值得善用但不强求，约跑能治拖延，独跑能清理思绪，两种模式交替着来最好。跑团不必进，但一两个能约的跑友值得交，天气不好的周六早上，有人等你是最好的闹钟。",[11,74,75],{},"数据记录对跑步的坚持帮助很大，但看什么数据有讲究：月跑量和静息心率是两条值得长期看的曲线，配速反而不必天天盯。进步是缓慢的，用月为单位衡量，心态会好很多。",[11,77,78],{},"跑步这两年最大的心得是尊重身体：状态好多跑一点，状态差少跑一点，把它当成一项长期事业而不是每一段的表演。刻意维持连续打卡的执念，往往是伤病的起点。",[11,80,72],{},[11,82,75],{},[37,84,85],{"id":85},"又想到一些",[11,87,88],{},"写到这里顺便吐个槽，这类事情最难的部分往往不是技术本身，是说服别人相信它值得投入。方案再好，落不到排期上都是空谈，所以学会用数据的语言讲价值，算是这些年额外的必修课。",[11,90,91],{},"有时候会想，学一门新技术到底学到的是什么。语法和 API 会过时，真正的收获是它看问题的角度。多一门语言就多一副眼镜，同一副牌桌，能看到别人看不到的牌路，这是这么多年折腾下来最确定的回报。",[11,93,94],{},"记一个产生过的动摇：做到一半觉得这玩意儿是不是没什么意义。后来想通了，意义不是事情自带的，是你把它做完并沉淀下来之后长出来的。烂尾的才真的没意义，做完的最差也是一篇笔记。",[11,96,97],{},"顺便说说协作里的体会：这类事自己闷头做效率最高，但闷头做完往往返工最多。适度地提前同步，把方向先对齐，看似慢了半天，实际省掉的是几天的返工。沟通的时机比沟通的技巧更值得琢磨。",[37,99,100],{"id":100},"写在最后",[11,102,103],{},"职业病之一是看什么都想拆步骤，这件事在我这里基本是个流程问题：目标、步骤、验证、复盘，一套下来居然还真管用。",[11,105,106],{},"暂时记到这，下次接着说。",{"title":15,"searchDepth":16,"depth":17,"links":108},[109,110,111,112,113,114],{"id":39,"depth":16,"text":39},{"id":48,"depth":16,"text":48},{"id":57,"depth":16,"text":57},{"id":69,"depth":16,"text":69},{"id":85,"depth":16,"text":85},{"id":100,"depth":16,"text":100},[116],"跑步","2024-03-31",false,{"excerpt":120},{"type":8,"value":121},[122],[11,123,35],{},"\u002Fposts\u002Frun\u002Fmorning-vs-night-3",386400,{"title":29,"description":35},"posts\u002Frun\u002Fmorning-vs-night-3",[129,130],"晨跑","夜跑",[132],"run",1288,"M2dKGX6Lx0_soKdKQTDAywM_Jfa36-2Fs5nOVJodcLk",{"prev":136,"next":139},{"path":137,"title":138},"\u002Fposts\u002Frun\u002Fmorning-vs-night-2","晨跑和夜跑我都试过了（二）",{"path":140,"title":141},"\u002Fposts\u002Frun\u002Frunning-gear","跑步装备的投入优先级",[143,152,182],{"id":5,"title":6,"body":144,"createdAt":19,"description":13,"extension":20,"meta":150,"navigation":22,"path":23,"seo":151,"stem":25,"__hash__":26},{"type":8,"value":145,"toc":148},[146],[11,147,13],{},{"title":15,"searchDepth":16,"depth":17,"links":149},[],{},{"description":13},{"id":153,"title":154,"body":155,"createdAt":175,"description":176,"extension":20,"meta":177,"navigation":22,"path":178,"seo":179,"stem":180,"__hash__":181},"notes\u002Fnotes\u002F2026-11-14-1.md","2026 11 14 1",{"type":8,"value":156,"toc":173},[157],[11,158,159,160,164,165,172],{},"站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 ",[161,162,163],"strong",{},"Markdown","，写链接也不用到编辑器：",[166,167,171],"a",{"href":168,"rel":169},"https:\u002F\u002Fcontent.nuxt.com",[170],"nofollow","Nuxt Content","。",{"title":15,"searchDepth":16,"depth":17,"links":174},[],"2026-11-14","站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 Markdown，写链接也不用到编辑器：Nuxt Content。",{},"\u002Fnotes\u002F2026-11-14-1",{"description":176},"notes\u002F2026-11-14-1","LLJX_RKU7cgpT6aHw4DZWUZNQ_G_UzELWPKbksJvzfs",{"id":183,"title":184,"body":185,"createdAt":200,"description":201,"extension":20,"meta":202,"navigation":22,"path":203,"seo":204,"stem":205,"__hash__":206},"notes\u002Fnotes\u002F2026-11-14-2.md","2026 11 14 2",{"type":8,"value":186,"toc":198},[187],[11,188,189,193,194,197],{},[190,191,192],"code",{},"readPixels"," 读不到内容不是 bug，是 ",[190,195,196],{},"preserveDrawingBuffer"," 默认关闭——帧提交后缓冲即被清空。",{"title":15,"searchDepth":16,"depth":17,"links":199},[],"2026-11-13","readPixels 读不到内容不是 bug，是 preserveDrawingBuffer 默认关闭——帧提交后缓冲即被清空。",{},"\u002Fnotes\u002F2026-11-14-2",{"description":201},"notes\u002F2026-11-14-2","i7xWqq2eNoU_seSbLQjqlB9gE51fM-PVLUEYCHBkOA4",1795783658675]