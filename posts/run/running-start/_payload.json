[{"data":1,"prerenderedAt":208},["ShallowReactive",2],{"notes-latest-1":3,"post:\u002Fposts\u002Frun\u002Frunning-start":27,"surround:\u002Fposts\u002Frun\u002Frunning-start":136,"notes-latest-3":143},[4],{"id":5,"title":6,"body":7,"createdAt":19,"description":13,"extension":20,"meta":21,"navigation":22,"path":23,"seo":24,"stem":25,"__hash__":26},"notes\u002Fnotes\u002F2026-11-14-1-2.md","2026 11 14 1 2",{"type":8,"value":9,"toc":14},"minimark",[10],[11,12,13],"p",{},"站点上线了「随笔」：支持一个文件多个随笔",{"title":15,"searchDepth":16,"depth":17,"links":18},"",2,3,[],"2026-11-17","md",{},true,"\u002Fnotes\u002F2026-11-14-1-2",{"description":13},"notes\u002F2026-11-14-1-2","hDP9fvaunHzVrZQ6QifuOtj9VrqbxlPb_52KE5wSjD0",{"id":28,"title":29,"author":30,"body":31,"categories":117,"comment":22,"cover":30,"createdAt":119,"description":35,"draft":120,"extension":20,"meta":121,"navigation":22,"path":126,"readingTime":127,"recommend":120,"seo":128,"series":30,"stem":129,"tags":130,"top":120,"topics":132,"updatedAt":30,"words":134,"__hash__":135},"posts\u002Fposts\u002Frun\u002Frunning-start.md","跑步入门这一年",null,{"type":8,"value":32,"toc":108},[33,36,40,43,46,49,52,55,58,61,64,67,70,73,76,79,82,84,87,90,93,96,99,102,105],[11,34,35],{},"最近节奏慢了一些，多了点观察生活的时间，这篇就是这么来的。",[37,38,39],"h2",{"id":39},"从两公里开始",[11,41,42],{},"一年前的我跑八百米都要做心理建设，现在五公里已经成为日常。回头看这一年，最关键的转折是入门阶段把目标定得足够低：第一个月只要求出门，跑走结合两公里，配速难看就难看，先把出门这个动作变成习惯。",[11,44,45],{},"很多人跑步半途而废不是因为懒，是上来就猛跑，第二天浑身酸痛，第三天心理阴影。跑步的入门应该是无痛的，微微出汗、第二天无不适的强度，坚持四周之后身体自己会想要更多。",[37,47,48],{"id":48},"装备与伤病",[11,50,51],{},"装备上一双合适的跑鞋是唯一值得投资的项目，去实体店测一下脚型和落地方式再买，别网购跟风。运动手表次之，心率数据帮你控制强度。伤病预防三件套：跑前动态热身、跑后拉伸、跑量每周增幅不超一成，这三条是我用膝盖不舒服一周换来的教训，写下来避免再犯。",[37,53,54],{"id":54},"一年后的变化",[11,56,57],{},"一年后的变化：体重降了六公斤，静息心率从七十几降到六十出头，最意外的是情绪稳定性明显变好，焦虑的阈值提高了不少。跑步教会我的事是渐进，所有进步都发生在不出头、不受伤的日常积累里。这篇写给想开始又犹豫的朋友：今晚换鞋，出门，慢到不会累的速度，剩下的交给时间。",[37,59,60],{"id":60},"一点反思",[11,62,63],{},"手机最近电量崩得快，一顿排查，关掉几个常年后台自启的应用，续航立刻回来。数码产品的衰退，很多时候不是硬件老了，是软件攒的债。",[11,65,66],{},"买椅子只看了颜值，腰托形同虚设，坐两小时腰就开始抗议。人体工学这几个字，是拿腰疼换来的教训，越久坐越得信。",[11,68,69],{},"给花换盆的时机不对，大夏天动的土，缓了半个月才缓过来，叶子黄了一半。换盆要赶在春秋，园艺上的讲究背后都是植物的生理规律。",[37,71,72],{"id":72},"顺便一提",[11,74,75],{},"跑步的社交属性值得善用但不强求，约跑能治拖延，独跑能清理思绪，两种模式交替着来最好。跑团不必进，但一两个能约的跑友值得交，天气不好的周六早上，有人等你是最好的闹钟。",[11,77,78],{},"数据记录对跑步的坚持帮助很大，但看什么数据有讲究：月跑量和静息心率是两条值得长期看的曲线，配速反而不必天天盯。进步是缓慢的，用月为单位衡量，心态会好很多。",[11,80,81],{},"跑步这两年最大的心得是尊重身体：状态好多跑一点，状态差少跑一点，把它当成一项长期事业而不是每一段的表演。刻意维持连续打卡的执念，往往是伤病的起点。",[11,83,75],{},[37,85,86],{"id":86},"另外记几笔",[11,88,89],{},"忍不住再夸一下记录的力量，上周刚整理的笔记，这次直接翻出来就用，十分钟解决了当时花一下午的问题。给自己留下的每一份笔记，都是寄给未来的快递，寄件人签收时才觉得真香。",[11,91,92],{},"最后聊点感受：做技术这些年，越来越觉得最好的状态是既投入又抽离。投入是把事情做好，抽离是时不时跳出来看看方向对不对，两者缺一，要么辛苦没产出，要么轻松跑偏路。",[11,94,95],{},"写着写着想到，很多技术选择本质上都是在回答同一个问题：这个方案在出问题的时候是什么样子。不出问题的方案人人都写得出来，区分度全在故障时刻的表现。多想一层失败路径，很多纠结就自动有了答案。",[11,97,98],{},"这类经验在文档里通常只有一行字，背后的排查却是一整个下午。技术工作的大部分时间都花在这些不会写进简历的细节里，所以这些细节才更需要有人写出来，哪怕只是给未来某一天忘了的自己。",[37,100,101],{"id":101},"小结",[11,103,104],{},"折腾完顺手写了几行代码做了个统计，理工科思维的反应就是这样，朋友都笑我，但确实好用了。",[11,106,107],{},"就写到这吧，锅里还炖着东西，得去看一眼。",{"title":15,"searchDepth":16,"depth":17,"links":109},[110,111,112,113,114,115,116],{"id":39,"depth":16,"text":39},{"id":48,"depth":16,"text":48},{"id":54,"depth":16,"text":54},{"id":60,"depth":16,"text":60},{"id":72,"depth":16,"text":72},{"id":86,"depth":16,"text":86},{"id":101,"depth":16,"text":101},[118],"跑步","2023-12-15",false,{"excerpt":122},{"type":8,"value":123},[124],[11,125,35],{},"\u002Fposts\u002Frun\u002Frunning-start",376500,{"title":29,"description":35},"posts\u002Frun\u002Frunning-start",[118,131],"入门",[133],"run",1255,"zjvKM9z90KMCXZTbMDnnTTkSTHfLoGV6uywnoUxCmQw",{"prev":137,"next":140},{"path":138,"title":139},"\u002Fposts\u002Frun\u002Frunning-injury-4","那次跑步受伤的复盘（四）",{"path":141,"title":142},"\u002Fposts\u002Frun\u002Frunning-start-2","跑步入门这一年（二）",[144,153,183],{"id":5,"title":6,"body":145,"createdAt":19,"description":13,"extension":20,"meta":151,"navigation":22,"path":23,"seo":152,"stem":25,"__hash__":26},{"type":8,"value":146,"toc":149},[147],[11,148,13],{},{"title":15,"searchDepth":16,"depth":17,"links":150},[],{},{"description":13},{"id":154,"title":155,"body":156,"createdAt":176,"description":177,"extension":20,"meta":178,"navigation":22,"path":179,"seo":180,"stem":181,"__hash__":182},"notes\u002Fnotes\u002F2026-11-14-1.md","2026 11 14 1",{"type":8,"value":157,"toc":174},[158],[11,159,160,161,165,166,173],{},"站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 ",[162,163,164],"strong",{},"Markdown","，写链接也不用到编辑器：",[167,168,172],"a",{"href":169,"rel":170},"https:\u002F\u002Fcontent.nuxt.com",[171],"nofollow","Nuxt Content","。",{"title":15,"searchDepth":16,"depth":17,"links":175},[],"2026-11-14","站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 Markdown，写链接也不用到编辑器：Nuxt Content。",{},"\u002Fnotes\u002F2026-11-14-1",{"description":177},"notes\u002F2026-11-14-1","LLJX_RKU7cgpT6aHw4DZWUZNQ_G_UzELWPKbksJvzfs",{"id":184,"title":185,"body":186,"createdAt":201,"description":202,"extension":20,"meta":203,"navigation":22,"path":204,"seo":205,"stem":206,"__hash__":207},"notes\u002Fnotes\u002F2026-11-14-2.md","2026 11 14 2",{"type":8,"value":187,"toc":199},[188],[11,189,190,194,195,198],{},[191,192,193],"code",{},"readPixels"," 读不到内容不是 bug，是 ",[191,196,197],{},"preserveDrawingBuffer"," 默认关闭——帧提交后缓冲即被清空。",{"title":15,"searchDepth":16,"depth":17,"links":200},[],"2026-11-13","readPixels 读不到内容不是 bug，是 preserveDrawingBuffer 默认关闭——帧提交后缓冲即被清空。",{},"\u002Fnotes\u002F2026-11-14-2",{"description":202},"notes\u002F2026-11-14-2","i7xWqq2eNoU_seSbLQjqlB9gE51fM-PVLUEYCHBkOA4",1795274123112]