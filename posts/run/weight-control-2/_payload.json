[{"data":1,"prerenderedAt":207},["ShallowReactive",2],{"notes-latest-1":3,"post:\u002Fposts\u002Frun\u002Fweight-control-2":27,"surround:\u002Fposts\u002Frun\u002Fweight-control-2":135,"notes-latest-3":142},[4],{"id":5,"title":6,"body":7,"createdAt":19,"description":13,"extension":20,"meta":21,"navigation":22,"path":23,"seo":24,"stem":25,"__hash__":26},"notes\u002Fnotes\u002F2026-11-14-1-2.md","2026 11 14 1 2",{"type":8,"value":9,"toc":14},"minimark",[10],[11,12,13],"p",{},"站点上线了「随笔」：支持一个文件多个随笔",{"title":15,"searchDepth":16,"depth":17,"links":18},"",2,3,[],"2026-11-17","md",{},true,"\u002Fnotes\u002F2026-11-14-1-2",{"description":13},"notes\u002F2026-11-14-1-2","hDP9fvaunHzVrZQ6QifuOtj9VrqbxlPb_52KE5wSjD0",{"id":28,"title":29,"author":30,"body":31,"categories":115,"comment":22,"cover":30,"createdAt":117,"description":35,"draft":118,"extension":20,"meta":119,"navigation":22,"path":124,"readingTime":125,"recommend":118,"seo":126,"series":30,"stem":127,"tags":128,"top":118,"topics":131,"updatedAt":30,"words":133,"__hash__":134},"posts\u002Fposts\u002Frun\u002Fweight-control-2.md","体重管理的实话实说（二）",null,{"type":8,"value":32,"toc":107},[33,36,40,43,46,49,52,55,58,61,64,67,70,73,76,79,81,83,86,89,92,95,98,101,104],[11,34,35],{},"这篇没有代码，纯记录生活，技术同学可以直接跳过，开玩笑的，看完也许有点别的收获。",[37,38,39],"h2",{"id":39},"数据说话",[11,41,42],{},"体重从最高点降了九公斤，用了八个月，这篇实话实说地复盘。方法没有任何新鲜感：饮食做加减法，运动做乘法。加法是蛋白质和蔬菜的量，减法是含糖饮料和夜宵，乘法是每周三到四次的运动。八个月平均每个月一公斤出头，慢，但一条平滑下降的曲线，没有反弹。",[11,44,45],{},"期间踩过的坑也真实：头一个月不掉秤的怀疑期、平台期一个月纹丝不动的绝望期、节假日反弹两公斤的挫败期。这些坑每个减过肥的人都会遇到，区别只是有没有提前知道它们存在。",[37,47,48],{"id":48},"心态和方法",[11,50,51],{},"心态上最大的转变是从\"减肥\"换成\"管理\"：前者有个终点，到了终点就放飞；后者是个持续状态，允许波动但趋势向下。工具上家里放了体重秤，每天固定时间称，数据记进表格，看月均而不是单日。饮食上我的一个实操心得是先改变环境再改变行为：家里不放碳酸饮料，零食收进难拿的柜子，想吃水果就摆在茶几最显眼的位置。",[11,53,54],{},"九公斤的收获不只是体重秤上的数字，是体检报告上的几个箭头归位，和爬五层楼不再喘的轻松。这篇不是励志文，是一份可复制的方法记录，慢就是快。",[37,56,57],{"id":57},"一点反思",[11,59,60],{},"桌面充电线缠成一团，剪也剪不开理也理不清。十块钱的理线器加几个标签贴，一次到位。这种小钱花出去，回报率出奇地高。",[11,62,63],{},"保温杯里闷了一晚上的茶，苦到怀疑人生。茶水分离的杯子买回来之后，每一泡都恰到好处，工具选对，体验立刻不同。",[11,65,66],{},"下雨天骑车上班，一个转弯摔了，人没大事，裤子毁了，手机屏幕裂了道纹。从那之后雨天一律地铁，通勤的意义是到达，不是冒险。",[37,68,69],{"id":69},"顺便一提",[11,71,72],{},"数据记录对跑步的坚持帮助很大，但看什么数据有讲究：月跑量和静息心率是两条值得长期看的曲线，配速反而不必天天盯。进步是缓慢的，用月为单位衡量，心态会好很多。",[11,74,75],{},"跑步这两年最大的心得是尊重身体：状态好多跑一点，状态差少跑一点，把它当成一项长期事业而不是每一段的表演。刻意维持连续打卡的执念，往往是伤病的起点。",[11,77,78],{},"跑步的社交属性值得善用但不强求，约跑能治拖延，独跑能清理思绪，两种模式交替着来最好。跑团不必进，但一两个能约的跑友值得交，天气不好的周六早上，有人等你是最好的闹钟。",[11,80,72],{},[11,82,75],{},[37,84,85],{"id":85},"另外记几笔",[11,87,88],{},"然后想说，承认不懂是这行的美德。这次遇到不懂的地方，老老实实补了两天的课，比硬着头皮往上糊的方案强太多。不懂装懂的代价从来不会消失，只是延期，还带利息。",[11,90,91],{},"平衡感很重要的一件事：投入和收益的比例。所有优化都值得先问一句，这件事的收益上限是多少，值多少投入。无限打磨一个低价值的东西是工程师最常见的温柔陷阱，包括我自己在内。",[11,93,94],{},"忍不住再夸一下记录的力量，上周刚整理的笔记，这次直接翻出来就用，十分钟解决了当时花一下午的问题。给自己留下的每一份笔记，都是寄给未来的快递，寄件人签收时才觉得真香。",[11,96,97],{},"最后聊点感受：做技术这些年，越来越觉得最好的状态是既投入又抽离。投入是把事情做好，抽离是时不时跳出来看看方向对不对，两者缺一，要么辛苦没产出，要么轻松跑偏路。",[37,99,100],{"id":100},"写在最后",[11,102,103],{},"职业病之一是看什么都想拆步骤，这件事在我这里基本是个流程问题：目标、步骤、验证、复盘，一套下来居然还真管用。",[11,105,106],{},"写完舒坦了，收工。",{"title":15,"searchDepth":16,"depth":17,"links":108},[109,110,111,112,113,114],{"id":39,"depth":16,"text":39},{"id":48,"depth":16,"text":48},{"id":57,"depth":16,"text":57},{"id":69,"depth":16,"text":69},{"id":85,"depth":16,"text":85},{"id":100,"depth":16,"text":100},[116],"跑步","2023-10-23",false,{"excerpt":120},{"type":8,"value":121},[122],[11,123,35],{},"\u002Fposts\u002Frun\u002Fweight-control-2",383100,{"title":29,"description":35},"posts\u002Frun\u002Fweight-control-2",[129,130],"体重","健康",[132],"run",1277,"0a2Up2gqq5mTVRNOGPXfp5OcOiUIOWk8hVxSajkA3Gg",{"prev":136,"next":139},{"path":137,"title":138},"\u002Fposts\u002Frun\u002Fweight-control","体重管理的实话实说",{"path":140,"title":141},"\u002Fposts\u002Frun\u002Fweight-control-3","体重管理的实话实说（三）",[143,152,182],{"id":5,"title":6,"body":144,"createdAt":19,"description":13,"extension":20,"meta":150,"navigation":22,"path":23,"seo":151,"stem":25,"__hash__":26},{"type":8,"value":145,"toc":148},[146],[11,147,13],{},{"title":15,"searchDepth":16,"depth":17,"links":149},[],{},{"description":13},{"id":153,"title":154,"body":155,"createdAt":175,"description":176,"extension":20,"meta":177,"navigation":22,"path":178,"seo":179,"stem":180,"__hash__":181},"notes\u002Fnotes\u002F2026-11-14-1.md","2026 11 14 1",{"type":8,"value":156,"toc":173},[157],[11,158,159,160,164,165,172],{},"站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 ",[161,162,163],"strong",{},"Markdown","，写链接也不用到编辑器：",[166,167,171],"a",{"href":168,"rel":169},"https:\u002F\u002Fcontent.nuxt.com",[170],"nofollow","Nuxt Content","。",{"title":15,"searchDepth":16,"depth":17,"links":174},[],"2026-11-14","站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 Markdown，写链接也不用到编辑器：Nuxt Content。",{},"\u002Fnotes\u002F2026-11-14-1",{"description":176},"notes\u002F2026-11-14-1","LLJX_RKU7cgpT6aHw4DZWUZNQ_G_UzELWPKbksJvzfs",{"id":183,"title":184,"body":185,"createdAt":200,"description":201,"extension":20,"meta":202,"navigation":22,"path":203,"seo":204,"stem":205,"__hash__":206},"notes\u002Fnotes\u002F2026-11-14-2.md","2026 11 14 2",{"type":8,"value":186,"toc":198},[187],[11,188,189,193,194,197],{},[190,191,192],"code",{},"readPixels"," 读不到内容不是 bug，是 ",[190,195,196],{},"preserveDrawingBuffer"," 默认关闭——帧提交后缓冲即被清空。",{"title":15,"searchDepth":16,"depth":17,"links":199},[],"2026-11-13","readPixels 读不到内容不是 bug，是 preserveDrawingBuffer 默认关闭——帧提交后缓冲即被清空。",{},"\u002Fnotes\u002F2026-11-14-2",{"description":201},"notes\u002F2026-11-14-2","i7xWqq2eNoU_seSbLQjqlB9gE51fM-PVLUEYCHBkOA4",1795783659174]