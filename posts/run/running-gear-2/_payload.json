[{"data":1,"prerenderedAt":206},["ShallowReactive",2],{"notes-latest-1":3,"post:\u002Fposts\u002Frun\u002Frunning-gear-2":27,"surround:\u002Fposts\u002Frun\u002Frunning-gear-2":134,"notes-latest-3":141},[4],{"id":5,"title":6,"body":7,"createdAt":19,"description":13,"extension":20,"meta":21,"navigation":22,"path":23,"seo":24,"stem":25,"__hash__":26},"notes\u002Fnotes\u002F2026-11-14-1-2.md","2026 11 14 1 2",{"type":8,"value":9,"toc":14},"minimark",[10],[11,12,13],"p",{},"站点上线了「随笔」：支持一个文件多个随笔",{"title":15,"searchDepth":16,"depth":17,"links":18},"",2,3,[],"2026-11-17","md",{},true,"\u002Fnotes\u002F2026-11-14-1-2",{"description":13},"notes\u002F2026-11-14-1-2","hDP9fvaunHzVrZQ6QifuOtj9VrqbxlPb_52KE5wSjD0",{"id":28,"title":29,"author":30,"body":31,"categories":115,"comment":22,"cover":30,"createdAt":117,"description":35,"draft":118,"extension":20,"meta":119,"navigation":22,"path":124,"readingTime":125,"recommend":118,"seo":126,"series":30,"stem":127,"tags":128,"top":118,"topics":130,"updatedAt":30,"words":132,"__hash__":133},"posts\u002Fposts\u002Frun\u002Frunning-gear-2.md","跑步装备的投入优先级（二）",null,{"type":8,"value":32,"toc":107},[33,36,40,43,46,49,52,55,58,61,64,67,70,73,76,79,81,83,86,89,92,95,98,101,104],[11,34,35],{},"周末闲下来，想把这件事记一笔，没什么技术含量，就是觉得有点意思，不写下来可惜。",[37,38,39],"h2",{"id":39},"钱花在刀刃上",[11,41,42],{},"跑步装备的投入优先级，跑龄两年的排序心得：第一梯队是一双合适的跑鞋，它直接决定膝盖的寿命，按脚型选，预算充足但别追新款；第二梯队是一块能测心率的运动手表，强度控制全靠它，入门款就够；第三梯队是速干衣物，纯棉 T 恤跑五公里湿透之后贴在身上的感觉会让你当场下单。",[11,44,45],{},"除了这三个，其他都可以缓买。压缩裤、筋膜枪、碳板鞋，都是锦上添花，先跑够一百公里再考虑。",[37,47,48],{"id":48},"容易被高估和低估的",[11,50,51],{},"容易被高估的装备是各种监测配件，数据看太多反而焦虑，跑步的原始快乐在于动起来本身；容易被低估的是一双好的运动袜，它对水泡的预防作用立竿见影，几十块的东西值得买好的。还有一个零成本装备值得强调：路线规划，把跑步路线提前定好，红绿灯少、照明好、有补给点，体验完全不同。",[11,53,54],{},"总结成一句：跑步这项运动的美妙之处在于门槛低，装备的边际收益递减很快，先积累跑量，装备需求会自己浮现出来。",[37,56,57],{"id":57},"两个小教训",[11,59,60],{},"咖啡粉磨太细，手冲出来又苦又涩还带杂味，一度怀疑是豆子的问题。调粗一格立刻正常，器材和参数的问题，别先怪豆子。",[11,62,63],{},"周末一口气睡到中午，起来反而头昏脑涨。生物钟这东西，补觉补不回来，规律比时长重要，这是身体反复教育我的。",[11,65,66],{},"搬家时纸箱没标注，晚上要找充电器，十几个箱子翻到半夜。后来每个箱子外面用马克笔写清楚内容和房间，下次搬家的自己会感谢现在的自己。",[37,68,69],{"id":69},"一点延伸",[11,71,72],{},"跑步的社交属性值得善用但不强求，约跑能治拖延，独跑能清理思绪，两种模式交替着来最好。跑团不必进，但一两个能约的跑友值得交，天气不好的周六早上，有人等你是最好的闹钟。",[11,74,75],{},"数据记录对跑步的坚持帮助很大，但看什么数据有讲究：月跑量和静息心率是两条值得长期看的曲线，配速反而不必天天盯。进步是缓慢的，用月为单位衡量，心态会好很多。",[11,77,78],{},"跑步这两年最大的心得是尊重身体：状态好多跑一点，状态差少跑一点，把它当成一项长期事业而不是每一段的表演。刻意维持连续打卡的执念，往往是伤病的起点。",[11,80,72],{},[11,82,75],{},[37,84,85],{"id":85},"再补充几句",[11,87,88],{},"顺便说说协作里的体会：这类事自己闷头做效率最高，但闷头做完往往返工最多。适度地提前同步，把方向先对齐，看似慢了半天，实际省掉的是几天的返工。沟通的时机比沟通的技巧更值得琢磨。",[11,90,91],{},"其实回看这些年踩的坑，大坑几乎都和贪快有关。快不是错，错的是想跳过必要步骤的快，地基没打牢盖得越快塌得越响。慢下来把该做的做扎实，反而是最快的路径，这话说了很多年，每次验证都对。",[11,93,94],{},"有个观察分享给大家：技术的成长曲线不是线性的，是一段平台加一次跃迁。平台期最磨人，感觉学了很多没进步，其实是在攒素材，攒够了某个契机一到就突飞猛进。所以在平台期别否定自己，那是跃迁的前奏。",[11,96,97],{},"再补充一个角度：做这些事情的时候，工具的顺滑度影响巨大。同样的活，称手的工具能让摩擦力小一半，这种差异日积月累就是人和人的差距。定期审视自己的工具链，删掉碍事的，补上趁手的，值得当成一个固定动作。",[37,99,100],{"id":100},"最后",[11,102,103],{},"搞技术久了习惯找根因，生活里的很多问题其实也适用：先定位，再动手，别一上来就凭感觉乱试。",[11,105,106],{},"差不多了，剩下的细节等用到的时候再展开写。",{"title":15,"searchDepth":16,"depth":17,"links":108},[109,110,111,112,113,114],{"id":39,"depth":16,"text":39},{"id":48,"depth":16,"text":48},{"id":57,"depth":16,"text":57},{"id":69,"depth":16,"text":69},{"id":85,"depth":16,"text":85},{"id":100,"depth":16,"text":100},[116],"跑步","2023-11-05",false,{"excerpt":120},{"type":8,"value":121},[122],[11,123,35],{},"\u002Fposts\u002Frun\u002Frunning-gear-2",386100,{"title":29,"description":35},"posts\u002Frun\u002Frunning-gear-2",[116,129],"装备",[131],"run",1287,"nOuhJ3RaJQperQWnycYr6o_t9pWjf46xFBnR5TyhWOM",{"prev":135,"next":138},{"path":136,"title":137},"\u002Fposts\u002Frun\u002Frunning-gear","跑步装备的投入优先级",{"path":139,"title":140},"\u002Fposts\u002Frun\u002Frunning-gear-3","跑步装备的投入优先级（三）",[142,151,181],{"id":5,"title":6,"body":143,"createdAt":19,"description":13,"extension":20,"meta":149,"navigation":22,"path":23,"seo":150,"stem":25,"__hash__":26},{"type":8,"value":144,"toc":147},[145],[11,146,13],{},{"title":15,"searchDepth":16,"depth":17,"links":148},[],{},{"description":13},{"id":152,"title":153,"body":154,"createdAt":174,"description":175,"extension":20,"meta":176,"navigation":22,"path":177,"seo":178,"stem":179,"__hash__":180},"notes\u002Fnotes\u002F2026-11-14-1.md","2026 11 14 1",{"type":8,"value":155,"toc":172},[156],[11,157,158,159,163,164,171],{},"站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 ",[160,161,162],"strong",{},"Markdown","，写链接也不用到编辑器：",[165,166,170],"a",{"href":167,"rel":168},"https:\u002F\u002Fcontent.nuxt.com",[169],"nofollow","Nuxt Content","。",{"title":15,"searchDepth":16,"depth":17,"links":173},[],"2026-11-14","站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 Markdown，写链接也不用到编辑器：Nuxt Content。",{},"\u002Fnotes\u002F2026-11-14-1",{"description":175},"notes\u002F2026-11-14-1","LLJX_RKU7cgpT6aHw4DZWUZNQ_G_UzELWPKbksJvzfs",{"id":182,"title":183,"body":184,"createdAt":199,"description":200,"extension":20,"meta":201,"navigation":22,"path":202,"seo":203,"stem":204,"__hash__":205},"notes\u002Fnotes\u002F2026-11-14-2.md","2026 11 14 2",{"type":8,"value":185,"toc":197},[186],[11,187,188,192,193,196],{},[189,190,191],"code",{},"readPixels"," 读不到内容不是 bug，是 ",[189,194,195],{},"preserveDrawingBuffer"," 默认关闭——帧提交后缓冲即被清空。",{"title":15,"searchDepth":16,"depth":17,"links":198},[],"2026-11-13","readPixels 读不到内容不是 bug，是 preserveDrawingBuffer 默认关闭——帧提交后缓冲即被清空。",{},"\u002Fnotes\u002F2026-11-14-2",{"description":200},"notes\u002F2026-11-14-2","i7xWqq2eNoU_seSbLQjqlB9gE51fM-PVLUEYCHBkOA4",1795333668391]