[{"data":1,"prerenderedAt":207},["ShallowReactive",2],{"notes-latest-1":3,"post:\u002Fposts\u002Frun\u002Fweight-control":27,"surround:\u002Fposts\u002Frun\u002Fweight-control":135,"notes-latest-3":142},[4],{"id":5,"title":6,"body":7,"createdAt":19,"description":13,"extension":20,"meta":21,"navigation":22,"path":23,"seo":24,"stem":25,"__hash__":26},"notes\u002Fnotes\u002F2026-11-14-1-2.md","2026 11 14 1 2",{"type":8,"value":9,"toc":14},"minimark",[10],[11,12,13],"p",{},"站点上线了「随笔」：支持一个文件多个随笔",{"title":15,"searchDepth":16,"depth":17,"links":18},"",2,3,[],"2026-11-17","md",{},true,"\u002Fnotes\u002F2026-11-14-1-2",{"description":13},"notes\u002F2026-11-14-1-2","hDP9fvaunHzVrZQ6QifuOtj9VrqbxlPb_52KE5wSjD0",{"id":28,"title":29,"author":30,"body":31,"categories":115,"comment":22,"cover":30,"createdAt":117,"description":35,"draft":118,"extension":20,"meta":119,"navigation":22,"path":124,"readingTime":125,"recommend":118,"seo":126,"series":30,"stem":127,"tags":128,"top":118,"topics":131,"updatedAt":30,"words":133,"__hash__":134},"posts\u002Fposts\u002Frun\u002Fweight-control.md","体重管理的实话实说",null,{"type":8,"value":32,"toc":107},[33,36,40,43,46,49,52,55,58,61,64,67,70,73,76,79,81,83,86,89,92,95,98,101,104],[11,34,35],{},"最近生活里有些小变化，趁着晚上安静，写两句给自己看。",[37,38,39],"h2",{"id":39},"数据说话",[11,41,42],{},"体重从最高点降了九公斤，用了八个月，这篇实话实说地复盘。方法没有任何新鲜感：饮食做加减法，运动做乘法。加法是蛋白质和蔬菜的量，减法是含糖饮料和夜宵，乘法是每周三到四次的运动。八个月平均每个月一公斤出头，慢，但一条平滑下降的曲线，没有反弹。",[11,44,45],{},"期间踩过的坑也真实：头一个月不掉秤的怀疑期、平台期一个月纹丝不动的绝望期、节假日反弹两公斤的挫败期。这些坑每个减过肥的人都会遇到，区别只是有没有提前知道它们存在。",[37,47,48],{"id":48},"心态和方法",[11,50,51],{},"心态上最大的转变是从\"减肥\"换成\"管理\"：前者有个终点，到了终点就放飞；后者是个持续状态，允许波动但趋势向下。工具上家里放了体重秤，每天固定时间称，数据记进表格，看月均而不是单日。饮食上我的一个实操心得是先改变环境再改变行为：家里不放碳酸饮料，零食收进难拿的柜子，想吃水果就摆在茶几最显眼的位置。",[11,53,54],{},"九公斤的收获不只是体重秤上的数字，是体检报告上的几个箭头归位，和爬五层楼不再喘的轻松。这篇不是励志文，是一份可复制的方法记录，慢就是快。",[37,56,57],{"id":57},"一点反思",[11,59,60],{},"出门忘带钥匙，蹲在门口等开锁师傅，等了一小时花了一百五。现在门口的暗格放了备用钥匙，出门摸一下口袋成了肌肉记忆。",[11,62,63],{},"健身房年卡办完去了一次半，钱花得毫无水花。后来改成按次买，反而每周都去。消费习惯这件事，沉没成本越高越不想动，适合别人的不一定适合自己。",[11,65,66],{},"加湿器开一整夜，窗台上全是水汽，墙角都有点返潮。买了个湿度计才知道，舒服的湿度是个区间，不是越大越好，很多事都是这个道理。",[37,68,69],{"id":69},"顺便一提",[11,71,72],{},"跑步这两年最大的心得是尊重身体：状态好多跑一点，状态差少跑一点，把它当成一项长期事业而不是每一段的表演。刻意维持连续打卡的执念，往往是伤病的起点。",[11,74,75],{},"跑步的社交属性值得善用但不强求，约跑能治拖延，独跑能清理思绪，两种模式交替着来最好。跑团不必进，但一两个能约的跑友值得交，天气不好的周六早上，有人等你是最好的闹钟。",[11,77,78],{},"数据记录对跑步的坚持帮助很大，但看什么数据有讲究：月跑量和静息心率是两条值得长期看的曲线，配速反而不必天天盯。进步是缓慢的，用月为单位衡量，心态会好很多。",[11,80,72],{},[11,82,75],{},[37,84,85],{"id":85},"另外记几笔",[11,87,88],{},"从更高的视角看，这类问题都有一个共同结构：短期收益和长期收益打架。短期的诱惑总是具体而生动，长期的回报抽象而遥远，赢家通常是那些把长期目标拆成短期可感的小奖励的人。",[11,90,91],{},"讲个题外话，做这类事情的时候最好留个记录的习惯，当时的判断依据比结果更珍贵。结果好可能只是运气好，把决策过程记下来，好运才可能被复制，坏运才可能被规避。",[11,93,94],{},"然后想说，承认不懂是这行的美德。这次遇到不懂的地方，老老实实补了两天的课，比硬着头皮往上糊的方案强太多。不懂装懂的代价从来不会消失，只是延期，还带利息。",[11,96,97],{},"平衡感很重要的一件事：投入和收益的比例。所有优化都值得先问一句，这件事的收益上限是多少，值多少投入。无限打磨一个低价值的东西是工程师最常见的温柔陷阱，包括我自己在内。",[37,99,100],{"id":100},"写在最后",[11,102,103],{},"整个过程我写成了 checklist，下次照着走一遍就行，果然顺利多了。重复出现的事情就该被固化成流程，工作里如此，生活里也是。",[11,105,106],{},"差不多了，剩下的细节等用到的时候再展开写。",{"title":15,"searchDepth":16,"depth":17,"links":108},[109,110,111,112,113,114],{"id":39,"depth":16,"text":39},{"id":48,"depth":16,"text":48},{"id":57,"depth":16,"text":57},{"id":69,"depth":16,"text":69},{"id":85,"depth":16,"text":85},{"id":100,"depth":16,"text":100},[116],"跑步","2024-12-01",false,{"excerpt":120},{"type":8,"value":121},[122],[11,123,35],{},"\u002Fposts\u002Frun\u002Fweight-control",390000,{"title":29,"description":35},"posts\u002Frun\u002Fweight-control",[129,130],"体重","健康",[132],"run",1300,"1sQ_JuHpZ65jCD_O7Va6ic-N9CqhW-EPdc_aihVMdrE",{"prev":136,"next":139},{"path":137,"title":138},"\u002Fposts\u002Frun\u002Frunning-start-4","跑步入门这一年（四）",{"path":140,"title":141},"\u002Fposts\u002Frun\u002Fweight-control-2","体重管理的实话实说（二）",[143,152,182],{"id":5,"title":6,"body":144,"createdAt":19,"description":13,"extension":20,"meta":150,"navigation":22,"path":23,"seo":151,"stem":25,"__hash__":26},{"type":8,"value":145,"toc":148},[146],[11,147,13],{},{"title":15,"searchDepth":16,"depth":17,"links":149},[],{},{"description":13},{"id":153,"title":154,"body":155,"createdAt":175,"description":176,"extension":20,"meta":177,"navigation":22,"path":178,"seo":179,"stem":180,"__hash__":181},"notes\u002Fnotes\u002F2026-11-14-1.md","2026 11 14 1",{"type":8,"value":156,"toc":173},[157],[11,158,159,160,164,165,172],{},"站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 ",[161,162,163],"strong",{},"Markdown","，写链接也不用到编辑器：",[166,167,171],"a",{"href":168,"rel":169},"https:\u002F\u002Fcontent.nuxt.com",[170],"nofollow","Nuxt Content","。",{"title":15,"searchDepth":16,"depth":17,"links":174},[],"2026-11-14","站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 Markdown，写链接也不用到编辑器：Nuxt Content。",{},"\u002Fnotes\u002F2026-11-14-1",{"description":176},"notes\u002F2026-11-14-1","LLJX_RKU7cgpT6aHw4DZWUZNQ_G_UzELWPKbksJvzfs",{"id":183,"title":184,"body":185,"createdAt":200,"description":201,"extension":20,"meta":202,"navigation":22,"path":203,"seo":204,"stem":205,"__hash__":206},"notes\u002Fnotes\u002F2026-11-14-2.md","2026 11 14 2",{"type":8,"value":186,"toc":198},[187],[11,188,189,193,194,197],{},[190,191,192],"code",{},"readPixels"," 读不到内容不是 bug，是 ",[190,195,196],{},"preserveDrawingBuffer"," 默认关闭——帧提交后缓冲即被清空。",{"title":15,"searchDepth":16,"depth":17,"links":199},[],"2026-11-13","readPixels 读不到内容不是 bug，是 preserveDrawingBuffer 默认关闭——帧提交后缓冲即被清空。",{},"\u002Fnotes\u002F2026-11-14-2",{"description":201},"notes\u002F2026-11-14-2","i7xWqq2eNoU_seSbLQjqlB9gE51fM-PVLUEYCHBkOA4",1795309553452]