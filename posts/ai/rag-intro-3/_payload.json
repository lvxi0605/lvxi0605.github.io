[{"data":1,"prerenderedAt":205},["ShallowReactive",2],{"notes-latest-1":3,"post:\u002Fposts\u002Fai\u002Frag-intro-3":27,"surround:\u002Fposts\u002Fai\u002Frag-intro-3":133,"notes-latest-3":140},[4],{"id":5,"title":6,"body":7,"createdAt":19,"description":13,"extension":20,"meta":21,"navigation":22,"path":23,"seo":24,"stem":25,"__hash__":26},"notes\u002Fnotes\u002F2026-11-14-1-2.md","2026 11 14 1 2",{"type":8,"value":9,"toc":14},"minimark",[10],[11,12,13],"p",{},"站点上线了「随笔」：支持一个文件多个随笔",{"title":15,"searchDepth":16,"depth":17,"links":18},"",2,3,[],"2026-11-17","md",{},true,"\u002Fnotes\u002F2026-11-14-1-2",{"description":13},"notes\u002F2026-11-14-1-2","hDP9fvaunHzVrZQ6QifuOtj9VrqbxlPb_52KE5wSjD0",{"id":28,"title":29,"author":30,"body":31,"categories":113,"comment":22,"cover":30,"createdAt":115,"description":35,"draft":116,"extension":20,"meta":117,"navigation":22,"path":122,"readingTime":123,"recommend":116,"seo":124,"series":30,"stem":125,"tags":126,"top":116,"topics":129,"updatedAt":30,"words":131,"__hash__":132},"posts\u002Fposts\u002Fai\u002Frag-intro-3.md","RAG 入门：让模型回答你的私货（三）",null,{"type":8,"value":32,"toc":105},[33,36,41,44,47,50,53,56,59,62,65,68,71,74,77,79,81,84,87,90,93,96,99,102],[11,34,35],{},"这是一篇偏流水账的记录，重点不在结论，在过程和当时的判断依据，看官自行取用。",[37,38,40],"h2",{"id":39},"为什么要-rag","为什么要 RAG",[11,42,43],{},"模型不知道你的内部文档，直接问要么不知道要么瞎编。RAG 的思路是把资料切块、向量化存进向量库，提问时先检索出相关片段，拼进 prompt 让模型基于这些片段回答。它把知识问题转化为检索问题，资料更新不用重新训练，还能在回答里附引用，可信度和可验证性都好很多。",[11,45,46],{},"跑通最小 RAG 不复杂：文档解析、分块、embedding、向量库检索、拼 prompt、生成。难度都在细节里。",[37,48,49],{"id":49},"效果卡在哪",[11,51,52],{},"实际搭过之后会发现效果好坏大头不在模型，在检索质量。分块的大小和重叠影响召回的粒度，表格和代码块的切分要有特殊处理，混合检索（关键词加向量）通常比纯向量强，rerank 模型对候选重排能明显提升相关度。评估要早建：准备一批标准问答对，每次调参跑一遍看命中率，凭感觉调 RAG 等于盲修。一句话总结，RAG 是个检索工程，模型只是最后的加工环节。",[37,54,55],{"id":55},"记两个小问题",[11,57,58],{},"前端拿 Long 类型的 id 显示成了另一个数，JS 的 Number 精度上限就到 2 的 53 次方。序列化时把 Long 转 String，这是前后端协作里经典的暗坑，吃过一次亏就会记一辈子。",[11,60,61],{},"定时任务上线后时间全不对，cron 是按服务器时区算的，容器里又是 UTC。统一时区这种事，应该在基础设施层一次做对，而不是每个应用各自打补丁。",[11,63,64],{},"分页参数没做上限校验，被前端误传了个 pageSize 一万，数据库当场趴下。所有来自外部的参数都不可信，这句话说了十年，依然每年有人用事故重新验证一遍。",[37,66,67],{"id":67},"顺便一提",[11,69,70],{},"成本和延迟是工程侧永远要面对的两个约束。该用小模型的不用大模型，该缓存的不重复推理，该批量的不逐条调。这些朴素的工程手段在 AI 时代依然全部适用，反而因为调用的单价更高，优化收益也更明显。",[11,72,73],{},"这一两年接触 AI 应用的整体感受：模型能力迭代太快，今天精心调的方案可能下个月就有更好的替代。所以架构上要把模型调用层做成可替换的，业务逻辑和模型细节之间留出隔离层，这可能是当下做 AI 应用最重要的一个设计决策。",[11,75,76],{},"评估是 AI 应用和传统应用最不一样的环节。传统功能对就是对错就是错，AI 输出是概率分布，需要一个评测集和量化指标来回答“效果好不好”。没有评测的 AI 功能迭代全靠感觉，感觉这个东西在团队协作里基本不可用。",[11,78,70],{},[11,80,73],{},[37,82,83],{"id":83},"另外记几笔",[11,85,86],{},"由这件事联想到阅读习惯：资料要看一手来源，译文和二手转述经常带着传播者的理解偏差，偏差叠几层之后和原意面目全非。多花十分钟读原文，省下的是未来几小时的排查，这笔账怎么算都划算。",[11,88,89],{},"还有个感受越来越深：知识落地成文字的过程本身就是学习的一部分。很多自以为想清楚的东西，写出来才发现逻辑有洞。写作是最好的检验，这也是坚持写博客这么多年的理由之一，写不出来的就是还没学会的。",[11,91,92],{},"过程中也反复体会到取舍的本质：没有完美的方案，只有当下约束下最合适的方案。把约束写清楚，方案的选择题就变成了证明题，这也是为什么我习惯先列约束再谈方案，顺序反了全是无效争论。",[11,94,95],{},"想想还是补一段：任何习惯的养成都绕不开启动成本，最有效的办法是把启动成本降到接近零。想跑就把鞋放门口，想写就把文档开着置顶，环境准备到位了，行动只是顺水推舟。",[37,97,98],{"id":98},"小结",[11,100,101],{},"写完这篇正好十一点，窗外安静下来，这种时候码字效率出奇地高，就是第二天起床靠毅力。",[11,103,104],{},"先记到这里，后面有新的进展再来补充。",{"title":15,"searchDepth":16,"depth":17,"links":106},[107,108,109,110,111,112],{"id":39,"depth":16,"text":40},{"id":49,"depth":16,"text":49},{"id":55,"depth":16,"text":55},{"id":67,"depth":16,"text":67},{"id":83,"depth":16,"text":83},{"id":98,"depth":16,"text":98},[114],"AI","2024-11-30",false,{"excerpt":118},{"type":8,"value":119},[120],[11,121,35],{},"\u002Fposts\u002Fai\u002Frag-intro-3",407100,{"title":29,"description":35},"posts\u002Fai\u002Frag-intro-3",[127,128],"RAG","检索",[130],"ai",1357,"w7wrbDCooKmPEen8P4z6YlRYH9MNE9qlu_moRsRqwSg",{"prev":134,"next":137},{"path":135,"title":136},"\u002Fposts\u002Fai\u002Frag-intro-2","RAG 入门：让模型回答你的私货（二）",{"path":138,"title":139},"\u002Fposts\u002Fai\u002Frag-intro-4","RAG 入门：让模型回答你的私货（四）",[141,150,180],{"id":5,"title":6,"body":142,"createdAt":19,"description":13,"extension":20,"meta":148,"navigation":22,"path":23,"seo":149,"stem":25,"__hash__":26},{"type":8,"value":143,"toc":146},[144],[11,145,13],{},{"title":15,"searchDepth":16,"depth":17,"links":147},[],{},{"description":13},{"id":151,"title":152,"body":153,"createdAt":173,"description":174,"extension":20,"meta":175,"navigation":22,"path":176,"seo":177,"stem":178,"__hash__":179},"notes\u002Fnotes\u002F2026-11-14-1.md","2026 11 14 1",{"type":8,"value":154,"toc":171},[155],[11,156,157,158,162,163,170],{},"站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 ",[159,160,161],"strong",{},"Markdown","，写链接也不用到编辑器：",[164,165,169],"a",{"href":166,"rel":167},"https:\u002F\u002Fcontent.nuxt.com",[168],"nofollow","Nuxt Content","。",{"title":15,"searchDepth":16,"depth":17,"links":172},[],"2026-11-14","站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 Markdown，写链接也不用到编辑器：Nuxt Content。",{},"\u002Fnotes\u002F2026-11-14-1",{"description":174},"notes\u002F2026-11-14-1","LLJX_RKU7cgpT6aHw4DZWUZNQ_G_UzELWPKbksJvzfs",{"id":181,"title":182,"body":183,"createdAt":198,"description":199,"extension":20,"meta":200,"navigation":22,"path":201,"seo":202,"stem":203,"__hash__":204},"notes\u002Fnotes\u002F2026-11-14-2.md","2026 11 14 2",{"type":8,"value":184,"toc":196},[185],[11,186,187,191,192,195],{},[188,189,190],"code",{},"readPixels"," 读不到内容不是 bug，是 ",[188,193,194],{},"preserveDrawingBuffer"," 默认关闭——帧提交后缓冲即被清空。",{"title":15,"searchDepth":16,"depth":17,"links":197},[],"2026-11-13","readPixels 读不到内容不是 bug，是 preserveDrawingBuffer 默认关闭——帧提交后缓冲即被清空。",{},"\u002Fnotes\u002F2026-11-14-2",{"description":199},"notes\u002F2026-11-14-2","i7xWqq2eNoU_seSbLQjqlB9gE51fM-PVLUEYCHBkOA4",1795348498165]