[{"data":1,"prerenderedAt":202},["ShallowReactive",2],{"notes-latest-1":3,"post:\u002Fposts\u002Fai\u002Fllm-integration-6":27,"surround:\u002Fposts\u002Fai\u002Fllm-integration-6":130,"notes-latest-3":137},[4],{"id":5,"title":6,"body":7,"createdAt":19,"description":13,"extension":20,"meta":21,"navigation":22,"path":23,"seo":24,"stem":25,"__hash__":26},"notes\u002Fnotes\u002F2026-11-14-1-2.md","2026 11 14 1 2",{"type":8,"value":9,"toc":14},"minimark",[10],[11,12,13],"p",{},"站点上线了「随笔」：支持一个文件多个随笔",{"title":15,"searchDepth":16,"depth":17,"links":18},"",2,3,[],"2026-11-17","md",{},true,"\u002Fnotes\u002F2026-11-14-1-2",{"description":13},"notes\u002F2026-11-14-1-2","hDP9fvaunHzVrZQ6QifuOtj9VrqbxlPb_52KE5wSjD0",{"id":28,"title":29,"author":30,"body":31,"categories":110,"comment":22,"cover":30,"createdAt":112,"description":35,"draft":113,"extension":20,"meta":114,"navigation":22,"path":119,"readingTime":120,"recommend":113,"seo":121,"series":30,"stem":122,"tags":123,"top":113,"topics":126,"updatedAt":30,"words":128,"__hash__":129},"posts\u002Fposts\u002Fai\u002Fllm-integration-6.md","给老系统接入大模型的实践记录（六）",null,{"type":8,"value":32,"toc":102},[33,36,40,43,46,49,52,55,58,61,64,67,70,73,76,78,81,84,87,90,93,96,99],[11,34,35],{},"周五晚上泡了杯茶，把这阵子零散的笔记归拢成这一篇，也算是给这周收个尾。",[37,38,39],"h2",{"id":39},"从最小场景切入",[11,41,42],{},"给一个跑了多年的 Java 系统接入大模型，我没有上来就规划大方案，而是挑了一个最不伤筋动骨的场景：工单的自动分类和摘要。接入方式就是标准的 API 调用，服务端包一层客户端，处理超时、重试和降级，模型不可用时整个链路回退到人工流程，业务零感知。",[11,44,45],{},"这个最小闭环跑通之后，再逐步加场景，每加一个都先评估三件事：输入输出是否可结构化、错误的容忍度多少、有没有人工兜底。评估过不了的场景再吸引人也不做。",[37,47,48],{"id":48},"工程上的几个要点",[11,50,51],{},"工程上几个要点：prompt 当代码管理，版本化、评审、可回滚；输出用结构化格式约定，校验失败就重试或降级，不要裸解析；敏感数据脱敏后再出境；成本监控从第一天就做，token 单价乘调用量，账单的增长速度经常超出预期。总体感受是，接入本身不难，难的是把模型的不确定性装进传统系统的确定性框架里，这层设计才是工作量所在。",[37,53,54],{"id":54},"顺手记两个坑",[11,56,57],{},"HTTPS 证书配完，桌面浏览器都正常，部分安卓机型握手失败。是证书链不完整，中间证书没部署。证书工具会提示，但前提是你出问题之前主动去验证一次。",[11,59,60],{},"接手老代码，方法级 synchronized 把远程调用也包了进去，整个接口的吞吐被锁死。缩小锁范围只保护共享变量，性能立刻回来。锁的粒度，永远值得多看一眼。",[11,62,63],{},"jstat 看 GC 一切正常，但接口就是偶发抖动，最后发现宿主机在用 swap。禁掉 swap 加上内存预留，抖动消失。应用层之外，操作系统层面的问题也要纳入视野。",[37,65,66],{"id":66},"一点延伸",[11,68,69],{},"评估是 AI 应用和传统应用最不一样的环节。传统功能对就是对错就是错，AI 输出是概率分布，需要一个评测集和量化指标来回答“效果好不好”。没有评测的 AI 功能迭代全靠感觉，感觉这个东西在团队协作里基本不可用。",[11,71,72],{},"成本和延迟是工程侧永远要面对的两个约束。该用小模型的不用大模型，该缓存的不重复推理，该批量的不逐条调。这些朴素的工程手段在 AI 时代依然全部适用，反而因为调用的单价更高，优化收益也更明显。",[11,74,75],{},"这一两年接触 AI 应用的整体感受：模型能力迭代太快，今天精心调的方案可能下个月就有更好的替代。所以架构上要把模型调用层做成可替换的，业务逻辑和模型细节之间留出隔离层，这可能是当下做 AI 应用最重要的一个设计决策。",[11,77,69],{},[37,79,80],{"id":80},"再补充几句",[11,82,83],{},"顺便说说协作里的体会：这类事自己闷头做效率最高，但闷头做完往往返工最多。适度地提前同步，把方向先对齐，看似慢了半天，实际省掉的是几天的返工。沟通的时机比沟通的技巧更值得琢磨。",[11,85,86],{},"其实回看这些年踩的坑，大坑几乎都和贪快有关。快不是错，错的是想跳过必要步骤的快，地基没打牢盖得越快塌得越响。慢下来把该做的做扎实，反而是最快的路径，这话说了很多年，每次验证都对。",[11,88,89],{},"有个观察分享给大家：技术的成长曲线不是线性的，是一段平台加一次跃迁。平台期最磨人，感觉学了很多没进步，其实是在攒素材，攒够了某个契机一到就突飞猛进。所以在平台期别否定自己，那是跃迁的前奏。",[11,91,92],{},"再补充一个角度：做这些事情的时候，工具的顺滑度影响巨大。同样的活，称手的工具能让摩擦力小一半，这种差异日积月累就是人和人的差距。定期审视自己的工具链，删掉碍事的，补上趁手的，值得当成一个固定动作。",[37,94,95],{"id":95},"写在最后",[11,97,98],{},"昨晚整理书架翻出大学的数据结构课本，页边写满了字，写这篇的时候还翻出来对了两个细节。",[11,100,101],{},"就写到这吧，锅里还炖着东西，得去看一眼。",{"title":15,"searchDepth":16,"depth":17,"links":103},[104,105,106,107,108,109],{"id":39,"depth":16,"text":39},{"id":48,"depth":16,"text":48},{"id":54,"depth":16,"text":54},{"id":66,"depth":16,"text":66},{"id":80,"depth":16,"text":80},{"id":95,"depth":16,"text":95},[111],"AI","2025-02-07",false,{"excerpt":115},{"type":8,"value":116},[117],[11,118,35],{},"\u002Fposts\u002Fai\u002Fllm-integration-6",390300,{"title":29,"description":35},"posts\u002Fai\u002Fllm-integration-6",[124,125],"大模型","LLM",[127],"ai",1301,"OzLthdIohBDshPDiUgFfA0k1jYvEHWG5LRUEmqr0IFk",{"prev":131,"next":134},{"path":132,"title":133},"\u002Fposts\u002Fai\u002Fllm-integration-5","给老系统接入大模型的实践记录（五）",{"path":135,"title":136},"\u002Fposts\u002Fai\u002Fprompt-craft","写 prompt 的一点心得",[138,147,177],{"id":5,"title":6,"body":139,"createdAt":19,"description":13,"extension":20,"meta":145,"navigation":22,"path":23,"seo":146,"stem":25,"__hash__":26},{"type":8,"value":140,"toc":143},[141],[11,142,13],{},{"title":15,"searchDepth":16,"depth":17,"links":144},[],{},{"description":13},{"id":148,"title":149,"body":150,"createdAt":170,"description":171,"extension":20,"meta":172,"navigation":22,"path":173,"seo":174,"stem":175,"__hash__":176},"notes\u002Fnotes\u002F2026-11-14-1.md","2026 11 14 1",{"type":8,"value":151,"toc":168},[152],[11,153,154,155,159,160,167],{},"站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 ",[156,157,158],"strong",{},"Markdown","，写链接也不用到编辑器：",[161,162,166],"a",{"href":163,"rel":164},"https:\u002F\u002Fcontent.nuxt.com",[165],"nofollow","Nuxt Content","。",{"title":15,"searchDepth":16,"depth":17,"links":169},[],"2026-11-14","站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 Markdown，写链接也不用到编辑器：Nuxt Content。",{},"\u002Fnotes\u002F2026-11-14-1",{"description":171},"notes\u002F2026-11-14-1","LLJX_RKU7cgpT6aHw4DZWUZNQ_G_UzELWPKbksJvzfs",{"id":178,"title":179,"body":180,"createdAt":195,"description":196,"extension":20,"meta":197,"navigation":22,"path":198,"seo":199,"stem":200,"__hash__":201},"notes\u002Fnotes\u002F2026-11-14-2.md","2026 11 14 2",{"type":8,"value":181,"toc":193},[182],[11,183,184,188,189,192],{},[185,186,187],"code",{},"readPixels"," 读不到内容不是 bug，是 ",[185,190,191],{},"preserveDrawingBuffer"," 默认关闭——帧提交后缓冲即被清空。",{"title":15,"searchDepth":16,"depth":17,"links":194},[],"2026-11-13","readPixels 读不到内容不是 bug，是 preserveDrawingBuffer 默认关闭——帧提交后缓冲即被清空。",{},"\u002Fnotes\u002F2026-11-14-2",{"description":196},"notes\u002F2026-11-14-2","i7xWqq2eNoU_seSbLQjqlB9gE51fM-PVLUEYCHBkOA4",1795304788180]