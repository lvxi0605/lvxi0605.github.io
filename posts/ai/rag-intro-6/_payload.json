[{"data":1,"prerenderedAt":205},["ShallowReactive",2],{"notes-latest-1":3,"post:\u002Fposts\u002Fai\u002Frag-intro-6":27,"surround:\u002Fposts\u002Fai\u002Frag-intro-6":133,"notes-latest-3":140},[4],{"id":5,"title":6,"body":7,"createdAt":19,"description":13,"extension":20,"meta":21,"navigation":22,"path":23,"seo":24,"stem":25,"__hash__":26},"notes\u002Fnotes\u002F2026-11-14-1-2.md","2026 11 14 1 2",{"type":8,"value":9,"toc":14},"minimark",[10],[11,12,13],"p",{},"站点上线了「随笔」：支持一个文件多个随笔",{"title":15,"searchDepth":16,"depth":17,"links":18},"",2,3,[],"2026-11-17","md",{},true,"\u002Fnotes\u002F2026-11-14-1-2",{"description":13},"notes\u002F2026-11-14-1-2","hDP9fvaunHzVrZQ6QifuOtj9VrqbxlPb_52KE5wSjD0",{"id":28,"title":29,"author":30,"body":31,"categories":113,"comment":22,"cover":30,"createdAt":115,"description":35,"draft":116,"extension":20,"meta":117,"navigation":22,"path":122,"readingTime":123,"recommend":116,"seo":124,"series":30,"stem":125,"tags":126,"top":116,"topics":129,"updatedAt":30,"words":131,"__hash__":132},"posts\u002Fposts\u002Fai\u002Frag-intro-6.md","RAG 入门：让模型回答你的私货（六）",null,{"type":8,"value":32,"toc":105},[33,36,41,44,47,50,53,56,59,62,65,68,71,74,77,79,81,84,87,90,93,96,99,102],[11,34,35],{},"这篇整理一下最近在弄的东西，前后拖了些时间，趁记性还在赶紧写下来，免得过阵子细节全忘。",[37,38,40],"h2",{"id":39},"为什么要-rag","为什么要 RAG",[11,42,43],{},"模型不知道你的内部文档，直接问要么不知道要么瞎编。RAG 的思路是把资料切块、向量化存进向量库，提问时先检索出相关片段，拼进 prompt 让模型基于这些片段回答。它把知识问题转化为检索问题，资料更新不用重新训练，还能在回答里附引用，可信度和可验证性都好很多。",[11,45,46],{},"跑通最小 RAG 不复杂：文档解析、分块、embedding、向量库检索、拼 prompt、生成。难度都在细节里。",[37,48,49],{"id":49},"效果卡在哪",[11,51,52],{},"实际搭过之后会发现效果好坏大头不在模型，在检索质量。分块的大小和重叠影响召回的粒度，表格和代码块的切分要有特殊处理，混合检索（关键词加向量）通常比纯向量强，rerank 模型对候选重排能明显提升相关度。评估要早建：准备一批标准问答对，每次调参跑一遍看命中率，凭感觉调 RAG 等于盲修。一句话总结，RAG 是个检索工程，模型只是最后的加工环节。",[37,54,55],{"id":55},"记两个小问题",[11,57,58],{},"遇到过消息重复消费，原因是网络抖动触发重试，业务库里多了脏数据。消费端加幂等表之后彻底解决，结论很简单：所有 MQ 的幂等都得消费端自己做，寄希望于恰好一次是不现实的。",[11,60,61],{},"接口偶发超时，压测环境复现不了，后来发现是连接池的 maxPoolSize 用了默认值，高峰期全在等连接。调大之后看监控，等待队列直接归零，这种参数还是得按自己的流量压一遍。",[11,63,64],{},"镜像优化前是 1.2G，换 alpine 基础镜像加上多阶段构建，砍到两百兆以内，拉取时间肉眼可见地降下来。构建上下文里别把无关文件拷进去，.dockerignore 值得认真配一次。",[37,66,67],{"id":67},"顺便一提",[11,69,70],{},"成本和延迟是工程侧永远要面对的两个约束。该用小模型的不用大模型，该缓存的不重复推理，该批量的不逐条调。这些朴素的工程手段在 AI 时代依然全部适用，反而因为调用的单价更高，优化收益也更明显。",[11,72,73],{},"这一两年接触 AI 应用的整体感受：模型能力迭代太快，今天精心调的方案可能下个月就有更好的替代。所以架构上要把模型调用层做成可替换的，业务逻辑和模型细节之间留出隔离层，这可能是当下做 AI 应用最重要的一个设计决策。",[11,75,76],{},"评估是 AI 应用和传统应用最不一样的环节。传统功能对就是对错就是错，AI 输出是概率分布，需要一个评测集和量化指标来回答“效果好不好”。没有评测的 AI 功能迭代全靠感觉，感觉这个东西在团队协作里基本不可用。",[11,78,70],{},[11,80,73],{},[37,82,83],{"id":83},"另外记几笔",[11,85,86],{},"然后想说，承认不懂是这行的美德。这次遇到不懂的地方，老老实实补了两天的课，比硬着头皮往上糊的方案强太多。不懂装懂的代价从来不会消失，只是延期，还带利息。",[11,88,89],{},"平衡感很重要的一件事：投入和收益的比例。所有优化都值得先问一句，这件事的收益上限是多少，值多少投入。无限打磨一个低价值的东西是工程师最常见的温柔陷阱，包括我自己在内。",[11,91,92],{},"忍不住再夸一下记录的力量，上周刚整理的笔记，这次直接翻出来就用，十分钟解决了当时花一下午的问题。给自己留下的每一份笔记，都是寄给未来的快递，寄件人签收时才觉得真香。",[11,94,95],{},"最后聊点感受：做技术这些年，越来越觉得最好的状态是既投入又抽离。投入是把事情做好，抽离是时不时跳出来看看方向对不对，两者缺一，要么辛苦没产出，要么轻松跑偏路。",[37,97,98],{"id":98},"小结",[11,100,101],{},"写完这篇下楼跑了个五公里，脑子里剩下的方案细节，居然是跑步的时候理顺的。",[11,103,104],{},"这篇写得断断续续，总算收尾，下篇见。",{"title":15,"searchDepth":16,"depth":17,"links":106},[107,108,109,110,111,112],{"id":39,"depth":16,"text":40},{"id":49,"depth":16,"text":49},{"id":55,"depth":16,"text":55},{"id":67,"depth":16,"text":67},{"id":83,"depth":16,"text":83},{"id":98,"depth":16,"text":98},[114],"AI","2024-08-22",false,{"excerpt":118},{"type":8,"value":119},[120],[11,121,35],{},"\u002Fposts\u002Fai\u002Frag-intro-6",404400,{"title":29,"description":35},"posts\u002Fai\u002Frag-intro-6",[127,128],"RAG","检索",[130],"ai",1348,"s-49gGew9yFvGDXGoI3PWfm9ArpEJIWQPHvtPCI2KQE",{"prev":134,"next":137},{"path":135,"title":136},"\u002Fposts\u002Fai\u002Frag-intro-5","RAG 入门：让模型回答你的私货（五）",{"path":138,"title":139},"\u002Fposts\u002Fbigdata\u002Fhive\u002Fhive","Hive简介",[141,150,180],{"id":5,"title":6,"body":142,"createdAt":19,"description":13,"extension":20,"meta":148,"navigation":22,"path":23,"seo":149,"stem":25,"__hash__":26},{"type":8,"value":143,"toc":146},[144],[11,145,13],{},{"title":15,"searchDepth":16,"depth":17,"links":147},[],{},{"description":13},{"id":151,"title":152,"body":153,"createdAt":173,"description":174,"extension":20,"meta":175,"navigation":22,"path":176,"seo":177,"stem":178,"__hash__":179},"notes\u002Fnotes\u002F2026-11-14-1.md","2026 11 14 1",{"type":8,"value":154,"toc":171},[155],[11,156,157,158,162,163,170],{},"站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 ",[159,160,161],"strong",{},"Markdown","，写链接也不用到编辑器：",[164,165,169],"a",{"href":166,"rel":167},"https:\u002F\u002Fcontent.nuxt.com",[168],"nofollow","Nuxt Content","。",{"title":15,"searchDepth":16,"depth":17,"links":172},[],"2026-11-14","站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 Markdown，写链接也不用到编辑器：Nuxt Content。",{},"\u002Fnotes\u002F2026-11-14-1",{"description":174},"notes\u002F2026-11-14-1","LLJX_RKU7cgpT6aHw4DZWUZNQ_G_UzELWPKbksJvzfs",{"id":181,"title":182,"body":183,"createdAt":198,"description":199,"extension":20,"meta":200,"navigation":22,"path":201,"seo":202,"stem":203,"__hash__":204},"notes\u002Fnotes\u002F2026-11-14-2.md","2026 11 14 2",{"type":8,"value":184,"toc":196},[185],[11,186,187,191,192,195],{},[188,189,190],"code",{},"readPixels"," 读不到内容不是 bug，是 ",[188,193,194],{},"preserveDrawingBuffer"," 默认关闭——帧提交后缓冲即被清空。",{"title":15,"searchDepth":16,"depth":17,"links":197},[],"2026-11-13","readPixels 读不到内容不是 bug，是 preserveDrawingBuffer 默认关闭——帧提交后缓冲即被清空。",{},"\u002Fnotes\u002F2026-11-14-2",{"description":199},"notes\u002F2026-11-14-2","i7xWqq2eNoU_seSbLQjqlB9gE51fM-PVLUEYCHBkOA4",1795273143646]