[{"data":1,"prerenderedAt":202},["ShallowReactive",2],{"notes-latest-1":3,"post:\u002Fposts\u002Fai\u002Fai-coding-tools-2":27,"surround:\u002Fposts\u002Fai\u002Fai-coding-tools-2":130,"notes-latest-3":137},[4],{"id":5,"title":6,"body":7,"createdAt":19,"description":13,"extension":20,"meta":21,"navigation":22,"path":23,"seo":24,"stem":25,"__hash__":26},"notes\u002Fnotes\u002F2026-11-14-1-2.md","2026 11 14 1 2",{"type":8,"value":9,"toc":14},"minimark",[10],[11,12,13],"p",{},"站点上线了「随笔」：支持一个文件多个随笔",{"title":15,"searchDepth":16,"depth":17,"links":18},"",2,3,[],"2026-11-17","md",{},true,"\u002Fnotes\u002F2026-11-14-1-2",{"description":13},"notes\u002F2026-11-14-1-2","hDP9fvaunHzVrZQ6QifuOtj9VrqbxlPb_52KE5wSjD0",{"id":28,"title":29,"author":30,"body":31,"categories":110,"comment":22,"cover":30,"createdAt":112,"description":35,"draft":113,"extension":20,"meta":114,"navigation":22,"path":119,"readingTime":120,"recommend":113,"seo":121,"series":30,"stem":122,"tags":123,"top":113,"topics":126,"updatedAt":30,"words":128,"__hash__":129},"posts\u002Fposts\u002Fai\u002Fai-coding-tools-2.md","AI 编程工具体验半年记（二）",null,{"type":8,"value":32,"toc":102},[33,36,40,43,46,49,52,55,58,61,64,67,70,73,76,78,81,84,87,90,93,96,99],[11,34,35],{},"这是一篇偏流水账的记录，重点不在结论，在过程和当时的判断依据，看官自行取用。",[37,38,39],"h2",{"id":39},"真实的使用感受",[11,41,42],{},"用 AI 编程工具半年，我的使用模式大致定型：样板代码、单元测试、写脚本、读陌生代码库时让它解释，这些场景效率提升非常明显，一天省个把小时是常态。但复杂业务逻辑的架构设计，它给的东西仍以平庸居多，不是不能用，而是需要我花力气审，审的成本经常超过自己写。",[11,44,45],{},"所以现在的定位很清楚：把它当一个打字飞快但需要验收的初级搭档。任务切得越细、上下文给得越准，产出越好；扔一个大需求让它自由发挥，基本等于给自己埋雷。",[37,47,48],{"id":48},"需要注意的地方",[11,50,51],{},"几个注意点：生成的代码必须过 review，风格一致性、边界处理、安全问题都要人工把关；隐私红线要清楚，公司代码能不能贴进工具，先看制度再动手；依赖它的负面效应是手感退化，我给自己定的规矩是核心算法部分亲手写，保持肌肉记忆。总的来说这半年工作流确实被改变了，与其争论 AI 能不能替代程序员，不如先把确定能提效的部分用起来。",[37,53,54],{"id":54},"过程中的两个坑",[11,56,57],{},"顺手记一个这阵子碰到的问题：服务 CPU 突然打满，top -H 找到罪魁线程，jstack 里转十六进制一查，是个正则在长文本上回溯。改成预编译加上入参长度限制之后就好了，正则这个东西真是不能随手写。",[11,59,60],{},"还有一次排查 OOM，堆内存看着没超，最后发现是元空间爆了，某个框架在运行时动态生成类。加了 -XX:MaxMetaspaceSize 先兜底，再定位到生成源头关掉，内存曲线立刻平了。",[11,62,63],{},"一条 SQL 索引明明在，但执行计划就是不走，折腾半天发现是字段上包了层函数。把函数挪到参数那边改写之后，从八秒降到八十毫秒，这种问题每次遇到都痛恨自己一开始没看执行计划。",[37,65,66],{"id":66},"延伸几句",[11,68,69],{},"成本和延迟是工程侧永远要面对的两个约束。该用小模型的不用大模型，该缓存的不重复推理，该批量的不逐条调。这些朴素的工程手段在 AI 时代依然全部适用，反而因为调用的单价更高，优化收益也更明显。",[11,71,72],{},"这一两年接触 AI 应用的整体感受：模型能力迭代太快，今天精心调的方案可能下个月就有更好的替代。所以架构上要把模型调用层做成可替换的，业务逻辑和模型细节之间留出隔离层，这可能是当下做 AI 应用最重要的一个设计决策。",[11,74,75],{},"评估是 AI 应用和传统应用最不一样的环节。传统功能对就是对错就是错，AI 输出是概率分布，需要一个评测集和量化指标来回答“效果好不好”。没有评测的 AI 功能迭代全靠感觉，感觉这个东西在团队协作里基本不可用。",[11,77,69],{},[37,79,80],{"id":80},"又想到一些",[11,82,83],{},"想想还是补一段：任何习惯的养成都绕不开启动成本，最有效的办法是把启动成本降到接近零。想跑就把鞋放门口，想写就把文档开着置顶，环境准备到位了，行动只是顺水推舟。",[11,85,86],{},"从更高的视角看，这类问题都有一个共同结构：短期收益和长期收益打架。短期的诱惑总是具体而生动，长期的回报抽象而遥远，赢家通常是那些把长期目标拆成短期可感的小奖励的人。",[11,88,89],{},"讲个题外话，做这类事情的时候最好留个记录的习惯，当时的判断依据比结果更珍贵。结果好可能只是运气好，把决策过程记下来，好运才可能被复制，坏运才可能被规避。",[11,91,92],{},"然后想说，承认不懂是这行的美德。这次遇到不懂的地方，老老实实补了两天的课，比硬着头皮往上糊的方案强太多。不懂装懂的代价从来不会消失，只是延期，还带利息。",[37,94,95],{"id":95},"写在最后",[11,97,98],{},"最近加班多了些，更新慢了一点，周五晚上泡杯茶写下这篇，算是给自己留点节奏。",[11,100,101],{},"剩下的想起来再记，这篇到此为止。",{"title":15,"searchDepth":16,"depth":17,"links":103},[104,105,106,107,108,109],{"id":39,"depth":16,"text":39},{"id":48,"depth":16,"text":48},{"id":54,"depth":16,"text":54},{"id":66,"depth":16,"text":66},{"id":80,"depth":16,"text":80},{"id":95,"depth":16,"text":95},[111],"AI","2026-10-03",false,{"excerpt":115},{"type":8,"value":116},[117],[11,118,35],{},"\u002Fposts\u002Fai\u002Fai-coding-tools-2",387300,{"title":29,"description":35},"posts\u002Fai\u002Fai-coding-tools-2",[124,125],"AI 编程","效率",[127],"ai",1291,"8-X97F36XYLXYV-boEmnDLczplhhv5ohBbvll4GiHxc",{"prev":131,"next":134},{"path":132,"title":133},"\u002Fposts\u002Fai\u002Fai-coding-tools","AI 编程工具体验半年记",{"path":135,"title":136},"\u002Fposts\u002Fai\u002Fai-coding-tools-3","AI 编程工具体验半年记（三）",[138,147,177],{"id":5,"title":6,"body":139,"createdAt":19,"description":13,"extension":20,"meta":145,"navigation":22,"path":23,"seo":146,"stem":25,"__hash__":26},{"type":8,"value":140,"toc":143},[141],[11,142,13],{},{"title":15,"searchDepth":16,"depth":17,"links":144},[],{},{"description":13},{"id":148,"title":149,"body":150,"createdAt":170,"description":171,"extension":20,"meta":172,"navigation":22,"path":173,"seo":174,"stem":175,"__hash__":176},"notes\u002Fnotes\u002F2026-11-14-1.md","2026 11 14 1",{"type":8,"value":151,"toc":168},[152],[11,153,154,155,159,160,167],{},"站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 ",[156,157,158],"strong",{},"Markdown","，写链接也不用到编辑器：",[161,162,166],"a",{"href":163,"rel":164},"https:\u002F\u002Fcontent.nuxt.com",[165],"nofollow","Nuxt Content","。",{"title":15,"searchDepth":16,"depth":17,"links":169},[],"2026-11-14","站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 Markdown，写链接也不用到编辑器：Nuxt Content。",{},"\u002Fnotes\u002F2026-11-14-1",{"description":171},"notes\u002F2026-11-14-1","LLJX_RKU7cgpT6aHw4DZWUZNQ_G_UzELWPKbksJvzfs",{"id":178,"title":179,"body":180,"createdAt":195,"description":196,"extension":20,"meta":197,"navigation":22,"path":198,"seo":199,"stem":200,"__hash__":201},"notes\u002Fnotes\u002F2026-11-14-2.md","2026 11 14 2",{"type":8,"value":181,"toc":193},[182],[11,183,184,188,189,192],{},[185,186,187],"code",{},"readPixels"," 读不到内容不是 bug，是 ",[185,190,191],{},"preserveDrawingBuffer"," 默认关闭——帧提交后缓冲即被清空。",{"title":15,"searchDepth":16,"depth":17,"links":194},[],"2026-11-13","readPixels 读不到内容不是 bug，是 preserveDrawingBuffer 默认关闭——帧提交后缓冲即被清空。",{},"\u002Fnotes\u002F2026-11-14-2",{"description":196},"notes\u002F2026-11-14-2","i7xWqq2eNoU_seSbLQjqlB9gE51fM-PVLUEYCHBkOA4",1795303381372]