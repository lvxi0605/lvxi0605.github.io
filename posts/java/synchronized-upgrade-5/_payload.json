[{"data":1,"prerenderedAt":200},["ShallowReactive",2],{"notes-latest-1":3,"post:\u002Fposts\u002Fjava\u002Fsynchronized-upgrade-5":27,"surround:\u002Fposts\u002Fjava\u002Fsynchronized-upgrade-5":128,"notes-latest-3":135},[4],{"id":5,"title":6,"body":7,"createdAt":19,"description":13,"extension":20,"meta":21,"navigation":22,"path":23,"seo":24,"stem":25,"__hash__":26},"notes\u002Fnotes\u002F2026-11-14-1-2.md","2026 11 14 1 2",{"type":8,"value":9,"toc":14},"minimark",[10],[11,12,13],"p",{},"站点上线了「随笔」：支持一个文件多个随笔",{"title":15,"searchDepth":16,"depth":17,"links":18},"",2,3,[],"2026-11-17","md",{},true,"\u002Fnotes\u002F2026-11-14-1-2",{"description":13},"notes\u002F2026-11-14-1-2","hDP9fvaunHzVrZQ6QifuOtj9VrqbxlPb_52KE5wSjD0",{"id":28,"title":29,"author":30,"body":31,"categories":108,"comment":22,"cover":30,"createdAt":110,"description":35,"draft":111,"extension":20,"meta":112,"navigation":22,"path":117,"readingTime":118,"recommend":111,"seo":119,"series":30,"stem":120,"tags":121,"top":111,"topics":124,"updatedAt":30,"words":126,"__hash__":127},"posts\u002Fposts\u002Fjava\u002Fsynchronized-upgrade-5.md","synchronized 的锁升级过程（五）",null,{"type":8,"value":32,"toc":100},[33,36,40,43,46,49,52,55,58,61,64,67,70,73,76,79,82,85,88,91,94,97],[11,34,35],{},"长话短说，这篇就是一次完整的记录，从问题怎么来的，到最后方案怎么定，中间的弯路也都保留。",[37,38,39],"h2",{"id":39},"从重量级锁说起",[11,41,42],{},"早期 synchronized 直接对应操作系统的互斥量，涉及用户态到内核态的切换，开销大，所以一直背着重量级锁的名声。JDK 6 之后引入了锁升级机制，对象头里的 Mark Word 会随着竞争情况在无锁、偏向锁、轻量级锁、重量级锁之间流转，大多数场景下根本走不到最重的那个状态。",[11,44,45],{},"偏向锁适合始终只有一个线程访问的场合，第一次获取后把线程 ID 记进 Mark Word，之后进入同步块只需要一次比较；一旦出现第二个线程，偏向就撤销，升级为轻量级锁，靠栈上的锁记录和 CAS 自旋来竞争；自旋失败次数多了、或者有第三个线程加入，才会膨胀成重量级锁，线程真正挂起排队。",[37,47,48],{"id":48},"实践中要知道的几点",[11,50,51],{},"理解锁升级对实践的价值在于两点：一是不要高估 synchronized 的开销，无竞争路径上它已经足够快，该用就用；二是要知道哪些代码模式会破坏这些优化，比如一个线程反复获取释放同一个锁、锁对象被 hashCode 打断偏向、或者同步块里包了慢 IO。另外注意，高版本 JDK 已经废弃了偏向锁，默认直接从轻量级锁开始，读旧资料的时候要留意版本背景。",[37,53,54],{"id":54},"踩坑记录",[11,56,57],{},"磁盘告警，日志把盘写满了。给应用日志配上 logrotate 加上保留天数，再顺手把历史日志清了。存储这种东西，没有监控告警之前，所有人都以为它不会满。",[11,59,60],{},"线程池的队列当初图省事用了无界，高峰期任务堆积，内存一路涨。改成有界队列加上合理的拒绝策略，宁可快速失败也别让问题积累到内存里爆出来。",[11,62,63],{},"数据迁移演练时发现字段长度截断，源库字符集和目标库不一样，同一段中文占的长度都不同。迁移脚本先在影子表跑一遍，这种事不演练，上了生产就是事故。",[37,65,66],{"id":66},"多聊两句",[11,68,69],{},"单元测试这件事，说起来都认同，写起来都嫌烦。我的折中方案是不追求覆盖率，只给核心逻辑写测试：边界条件、状态流转、容易改坏的地方。这几处有测试兜底，重构才有底气，其他地方随缘就好。",[11,71,72],{},"代码评审这些年我固定看三样东西：资源有没有释放、并发有没有保护、失败路径有没有处理。功能对不对通常作者自己会验证，这三样恰恰是测试跑不出来的，也是线上事故的高发区，评审时值得多花两分钟。",[11,74,75],{},"顺带说个写 Java 这些年的感受：语言本身的语法点翻来覆去就那些，真正拉开差距的是运行时的理解。同样一段代码，知道它在内存里怎么流转的人，能预判问题发生在哪里；只背八股的人，只能在报错之后被动接招。这也是我一直建议把源码读起来的原因。",[11,77,78],{},"排查并发问题有一套通用的思路值得记下：先确认是不是真并发，很多“偶现”最后发现是数据问题；再看是可见性、原子性还是有序性中的哪一类；最后才落到具体工具。顺序对了，方向就不会错，大多数时候我们是被表象带偏的。",[37,80,81],{"id":81},"继续聊聊",[11,83,84],{},"再补充一个角度：做这些事情的时候，工具的顺滑度影响巨大。同样的活，称手的工具能让摩擦力小一半，这种差异日积月累就是人和人的差距。定期审视自己的工具链，删掉碍事的，补上趁手的，值得当成一个固定动作。",[11,86,87],{},"由这件事联想到阅读习惯：资料要看一手来源，译文和二手转述经常带着传播者的理解偏差，偏差叠几层之后和原意面目全非。多花十分钟读原文，省下的是未来几小时的排查，这笔账怎么算都划算。",[11,89,90],{},"还有个感受越来越深：知识落地成文字的过程本身就是学习的一部分。很多自以为想清楚的东西，写出来才发现逻辑有洞。写作是最好的检验，这也是坚持写博客这么多年的理由之一，写不出来的就是还没学会的。",[37,92,93],{"id":93},"最后",[11,95,96],{},"楼下那家面馆老板都认识我了，加班晚归来一碗，很多难缠的问题都是吃完那碗面之后突然有思路的。",[11,98,99],{},"今天的记录就到这里，晚安。",{"title":15,"searchDepth":16,"depth":17,"links":101},[102,103,104,105,106,107],{"id":39,"depth":16,"text":39},{"id":48,"depth":16,"text":48},{"id":54,"depth":16,"text":54},{"id":66,"depth":16,"text":66},{"id":81,"depth":16,"text":81},{"id":93,"depth":16,"text":93},[109],"Java","2024-12-31",false,{"excerpt":113},{"type":8,"value":114},[115],[11,116,35],{},"\u002Fposts\u002Fjava\u002Fsynchronized-upgrade-5",384900,{"title":29,"description":35},"posts\u002Fjava\u002Fsynchronized-upgrade-5",[122,123],"并发","JVM",[125],"java",1283,"hEWUQNFw941wdMqto3Nkc-2d-MrnLh8GDSFiMsJuw6c",{"prev":129,"next":132},{"path":130,"title":131},"\u002Fposts\u002Fjava\u002Fsynchronized-upgrade-4","synchronized 的锁升级过程（四）",{"path":133,"title":134},"\u002Fposts\u002Fjava\u002Fsynchronized-upgrade-6","synchronized 的锁升级过程（六）",[136,145,175],{"id":5,"title":6,"body":137,"createdAt":19,"description":13,"extension":20,"meta":143,"navigation":22,"path":23,"seo":144,"stem":25,"__hash__":26},{"type":8,"value":138,"toc":141},[139],[11,140,13],{},{"title":15,"searchDepth":16,"depth":17,"links":142},[],{},{"description":13},{"id":146,"title":147,"body":148,"createdAt":168,"description":169,"extension":20,"meta":170,"navigation":22,"path":171,"seo":172,"stem":173,"__hash__":174},"notes\u002Fnotes\u002F2026-11-14-1.md","2026 11 14 1",{"type":8,"value":149,"toc":166},[150],[11,151,152,153,157,158,165],{},"站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 ",[154,155,156],"strong",{},"Markdown","，写链接也不用到编辑器：",[159,160,164],"a",{"href":161,"rel":162},"https:\u002F\u002Fcontent.nuxt.com",[163],"nofollow","Nuxt Content","。",{"title":15,"searchDepth":16,"depth":17,"links":167},[],"2026-11-14","站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 Markdown，写链接也不用到编辑器：Nuxt Content。",{},"\u002Fnotes\u002F2026-11-14-1",{"description":169},"notes\u002F2026-11-14-1","LLJX_RKU7cgpT6aHw4DZWUZNQ_G_UzELWPKbksJvzfs",{"id":176,"title":177,"body":178,"createdAt":193,"description":194,"extension":20,"meta":195,"navigation":22,"path":196,"seo":197,"stem":198,"__hash__":199},"notes\u002Fnotes\u002F2026-11-14-2.md","2026 11 14 2",{"type":8,"value":179,"toc":191},[180],[11,181,182,186,187,190],{},[183,184,185],"code",{},"readPixels"," 读不到内容不是 bug，是 ",[183,188,189],{},"preserveDrawingBuffer"," 默认关闭——帧提交后缓冲即被清空。",{"title":15,"searchDepth":16,"depth":17,"links":192},[],"2026-11-13","readPixels 读不到内容不是 bug，是 preserveDrawingBuffer 默认关闭——帧提交后缓冲即被清空。",{},"\u002Fnotes\u002F2026-11-14-2",{"description":194},"notes\u002F2026-11-14-2","i7xWqq2eNoU_seSbLQjqlB9gE51fM-PVLUEYCHBkOA4",1795707441383]