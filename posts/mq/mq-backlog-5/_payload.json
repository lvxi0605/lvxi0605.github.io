[{"data":1,"prerenderedAt":202},["ShallowReactive",2],{"notes-latest-1":3,"post:\u002Fposts\u002Fmq\u002Fmq-backlog-5":27,"surround:\u002Fposts\u002Fmq\u002Fmq-backlog-5":130,"notes-latest-3":137},[4],{"id":5,"title":6,"body":7,"createdAt":19,"description":13,"extension":20,"meta":21,"navigation":22,"path":23,"seo":24,"stem":25,"__hash__":26},"notes\u002Fnotes\u002F2026-11-14-1-2.md","2026 11 14 1 2",{"type":8,"value":9,"toc":14},"minimark",[10],[11,12,13],"p",{},"站点上线了「随笔」：支持一个文件多个随笔",{"title":15,"searchDepth":16,"depth":17,"links":18},"",2,3,[],"2026-11-17","md",{},true,"\u002Fnotes\u002F2026-11-14-1-2",{"description":13},"notes\u002F2026-11-14-1-2","hDP9fvaunHzVrZQ6QifuOtj9VrqbxlPb_52KE5wSjD0",{"id":28,"title":29,"author":30,"body":31,"categories":110,"comment":22,"cover":30,"createdAt":112,"description":35,"draft":113,"extension":20,"meta":114,"navigation":22,"path":119,"readingTime":120,"recommend":113,"seo":121,"series":30,"stem":122,"tags":123,"top":113,"topics":126,"updatedAt":30,"words":128,"__hash__":129},"posts\u002Fposts\u002Fmq\u002Fmq-backlog-5.md","消息积压的应急与根治（五）",null,{"type":8,"value":32,"toc":102},[33,36,40,43,46,49,52,55,58,61,64,67,70,73,76,78,81,84,87,90,93,96,99],[11,34,35],{},"这是一篇偏流水账的记录，重点不在结论，在过程和当时的判断依据，看官自行取用。",[37,38,39],"h2",{"id":39},"先止血再找因",[11,41,42],{},"积压的应急处理有个经典套路：先看消费逻辑里哪一步慢，如果是查库或调接口这种 IO，扩消费者实例通常有效，前提是分区数允许；分区数是吞吐上限，分区不够就临时新建一个大分区数的 topic，写一个只做搬运的消费者把积压转过去，再由大并发的消费者处理，处理完切回来。",[11,44,45],{},"但应急只是止血，真正要回答的是为什么积压：是流量突增、消费逻辑变慢、还是下游故障拖住了消费。不做归因的应急处理，下次还会在同一个地方摔。",[37,47,48],{"id":48},"日常的预防",[11,50,51],{},"日常预防三件事：把消费 lag 做成告警，设分级阈值，别等用户反馈；定期做消费端压测，知道自己的极限吞吐在哪；重要 topic 的分区数按峰值流量乘安全系数规划，扩分区虽然现在也支持，但提前规划总比临时救火从容。积压不可怕，可怕的是积压了很久才被业务方先发现。",[37,53,54],{"id":54},"记两个小问题",[11,56,57],{},"分页参数没做上限校验，被前端误传了个 pageSize 一万，数据库当场趴下。所有来自外部的参数都不可信，这句话说了十年，依然每年有人用事故重新验证一遍。",[11,59,60],{},"并行流里往共享 ArrayList 里塞数据，测试没跑出来，上线偶发丢数据。收集操作老老实实用 collect，共享可变状态在并发场景下永远是个雷，不管包装得多漂亮。",[11,62,63],{},"顺手记一个这阵子碰到的问题：服务 CPU 突然打满，top -H 找到罪魁线程，jstack 里转十六进制一查，是个正则在长文本上回溯。改成预编译加上入参长度限制之后就好了，正则这个东西真是不能随手写。",[37,65,66],{"id":66},"顺便一提",[11,68,69],{},"上下游协作的接口约定值得单独强调：消息的版本演进、字段增删的兼容策略，要在第一版就定好。消息一旦发出去就收不回来，下游的消费方也未必同步升级，兼容性欠的账在消息系统里特别难还。",[11,71,72],{},"监控消息系统时我固定看三组数字：生产速率、消费速率、积压量。三者的关系比绝对值重要，生产突增、消费停滞、积压陡涨，各自指向完全不同的问题，配上告警阈值之后，大多数问题能在用户感知之前处理掉。",[11,74,75],{},"消息队列用得久了会发现，它带来的问题不比解决的问题少：重复、乱序、积压、丢消息，每个都有应对方案，每个都要做对才行。引入之前先想清楚，这个异步解耦的收益到底值不值得养这套机制。",[11,77,69],{},[37,79,80],{"id":80},"另外记几笔",[11,82,83],{},"顺便说说协作里的体会：这类事自己闷头做效率最高，但闷头做完往往返工最多。适度地提前同步，把方向先对齐，看似慢了半天，实际省掉的是几天的返工。沟通的时机比沟通的技巧更值得琢磨。",[11,85,86],{},"其实回看这些年踩的坑，大坑几乎都和贪快有关。快不是错，错的是想跳过必要步骤的快，地基没打牢盖得越快塌得越响。慢下来把该做的做扎实，反而是最快的路径，这话说了很多年，每次验证都对。",[11,88,89],{},"有个观察分享给大家：技术的成长曲线不是线性的，是一段平台加一次跃迁。平台期最磨人，感觉学了很多没进步，其实是在攒素材，攒够了某个契机一到就突飞猛进。所以在平台期别否定自己，那是跃迁的前奏。",[11,91,92],{},"再补充一个角度：做这些事情的时候，工具的顺滑度影响巨大。同样的活，称手的工具能让摩擦力小一半，这种差异日积月累就是人和人的差距。定期审视自己的工具链，删掉碍事的，补上趁手的，值得当成一个固定动作。",[37,94,95],{"id":95},"最后",[11,97,98],{},"天冷了，敲键盘手有点僵，新入手的木质腕托派上了用场，顺便把欠的这篇写完。",[11,100,101],{},"大概就是这些，有不同做法欢迎评论区交流。",{"title":15,"searchDepth":16,"depth":17,"links":103},[104,105,106,107,108,109],{"id":39,"depth":16,"text":39},{"id":48,"depth":16,"text":48},{"id":54,"depth":16,"text":54},{"id":66,"depth":16,"text":66},{"id":80,"depth":16,"text":80},{"id":95,"depth":16,"text":95},[111],"消息队列","2024-07-19",false,{"excerpt":115},{"type":8,"value":116},[117],[11,118,35],{},"\u002Fposts\u002Fmq\u002Fmq-backlog-5",376200,{"title":29,"description":35},"posts\u002Fmq\u002Fmq-backlog-5",[124,125],"MQ","运维",[127],"mq",1254,"bJBZDImfwYLOlgw1cqee4QiwIFxGH_kQjTWt5VVKoyk",{"prev":131,"next":134},{"path":132,"title":133},"\u002Fposts\u002Fmq\u002Fmq-backlog-4","消息积压的应急与根治（四）",{"path":135,"title":136},"\u002Fposts\u002Fmq\u002Fmq-backlog-6","消息积压的应急与根治（六）",[138,147,177],{"id":5,"title":6,"body":139,"createdAt":19,"description":13,"extension":20,"meta":145,"navigation":22,"path":23,"seo":146,"stem":25,"__hash__":26},{"type":8,"value":140,"toc":143},[141],[11,142,13],{},{"title":15,"searchDepth":16,"depth":17,"links":144},[],{},{"description":13},{"id":148,"title":149,"body":150,"createdAt":170,"description":171,"extension":20,"meta":172,"navigation":22,"path":173,"seo":174,"stem":175,"__hash__":176},"notes\u002Fnotes\u002F2026-11-14-1.md","2026 11 14 1",{"type":8,"value":151,"toc":168},[152],[11,153,154,155,159,160,167],{},"站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 ",[156,157,158],"strong",{},"Markdown","，写链接也不用到编辑器：",[161,162,166],"a",{"href":163,"rel":164},"https:\u002F\u002Fcontent.nuxt.com",[165],"nofollow","Nuxt Content","。",{"title":15,"searchDepth":16,"depth":17,"links":169},[],"2026-11-14","站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 Markdown，写链接也不用到编辑器：Nuxt Content。",{},"\u002Fnotes\u002F2026-11-14-1",{"description":171},"notes\u002F2026-11-14-1","LLJX_RKU7cgpT6aHw4DZWUZNQ_G_UzELWPKbksJvzfs",{"id":178,"title":179,"body":180,"createdAt":195,"description":196,"extension":20,"meta":197,"navigation":22,"path":198,"seo":199,"stem":200,"__hash__":201},"notes\u002Fnotes\u002F2026-11-14-2.md","2026 11 14 2",{"type":8,"value":181,"toc":193},[182],[11,183,184,188,189,192],{},[185,186,187],"code",{},"readPixels"," 读不到内容不是 bug，是 ",[185,190,191],{},"preserveDrawingBuffer"," 默认关闭——帧提交后缓冲即被清空。",{"title":15,"searchDepth":16,"depth":17,"links":194},[],"2026-11-13","readPixels 读不到内容不是 bug，是 preserveDrawingBuffer 默认关闭——帧提交后缓冲即被清空。",{},"\u002Fnotes\u002F2026-11-14-2",{"description":196},"notes\u002F2026-11-14-2","i7xWqq2eNoU_seSbLQjqlB9gE51fM-PVLUEYCHBkOA4",1795274510222]