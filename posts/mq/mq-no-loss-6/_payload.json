[{"data":1,"prerenderedAt":204},["ShallowReactive",2],{"notes-latest-1":3,"post:\u002Fposts\u002Fmq\u002Fmq-no-loss-6":27,"surround:\u002Fposts\u002Fmq\u002Fmq-no-loss-6":132,"notes-latest-3":139},[4],{"id":5,"title":6,"body":7,"createdAt":19,"description":13,"extension":20,"meta":21,"navigation":22,"path":23,"seo":24,"stem":25,"__hash__":26},"notes\u002Fnotes\u002F2026-11-14-1-2.md","2026 11 14 1 2",{"type":8,"value":9,"toc":14},"minimark",[10],[11,12,13],"p",{},"站点上线了「随笔」：支持一个文件多个随笔",{"title":15,"searchDepth":16,"depth":17,"links":18},"",2,3,[],"2026-11-17","md",{},true,"\u002Fnotes\u002F2026-11-14-1-2",{"description":13},"notes\u002F2026-11-14-1-2","hDP9fvaunHzVrZQ6QifuOtj9VrqbxlPb_52KE5wSjD0",{"id":28,"title":29,"author":30,"body":31,"categories":112,"comment":22,"cover":30,"createdAt":114,"description":35,"draft":115,"extension":20,"meta":116,"navigation":22,"path":121,"readingTime":122,"recommend":115,"seo":123,"series":30,"stem":124,"tags":125,"top":115,"topics":128,"updatedAt":30,"words":130,"__hash__":131},"posts\u002Fposts\u002Fmq\u002Fmq-no-loss-6.md","消息不丢失的全链路设计（六）",null,{"type":8,"value":32,"toc":104},[33,36,40,43,46,49,52,55,58,61,64,67,70,73,76,78,80,83,86,89,92,95,98,101],[11,34,35],{},"趁热打铁，刚踩完坑就来记录，趁着记忆最新鲜，把当时的判断和后面的验证都写下来。",[37,38,39],"h2",{"id":39},"三个阶段三个保障",[11,41,42],{},"消息丢失可能发生在三个环节，每个环节有对应的保障。生产端用确认机制，发送后等 broker 的 ack，失败重试，本地消息表或者事务消息兜底业务和消息的一致性；存储端靠持久化，把刷盘策略设为同步或者至少同步刷盘副本数达标，多副本部署保证单机故障不丢；消费端关掉自动提交位移，业务处理成功后再确认，处理失败重试或进死信。",[11,44,45],{},"三个环节单独看都不复杂，难的是全链路一致地做。见过太多系统生产端做了确认，消费端却在自动提交，等于白忙。",[37,47,48],{"id":48},"端到端的验证",[11,50,51],{},"除了配置，还要做端到端的验证：压测时故意杀掉 broker、杀掉消费者，观察消息是否补齐；对账任务定期比对业务表和消息轨迹的数量。消息不丢失这个命题，最终要落到可验证的机制上，而不是配置文件里几行看似正确的参数。我们的做法是把关键链路的丢失率做成周报指标，数字长期为零才算真的可靠。",[37,53,54],{"id":54},"过程中的两个坑",[11,56,57],{},"crontab 里的脚本手动跑正常、定时跑就报错，环境变量不一致是老坑。把依赖的环境都写进脚本头部，或者干脆用绝对路径，别指望定时任务的运行环境和你的终端一样。",[11,59,60],{},"单元测试月底跑挂了，因为断言里依赖系统当前日期。注入 Clock 之后再测，时间随意控制。第一次遇到这种问题觉得很玄学，理解了之后觉得这是依赖注入最生动的教学案例。",[11,62,63],{},"grep 中文关键词死活匹配不上，最后确认是文件编码。iconv 转一道再查，两分钟的事排查了半小时，处理日志前先看编码，这个习惯值得保持。",[37,65,66],{"id":66},"延伸几句",[11,68,69],{},"消息队列用得久了会发现，它带来的问题不比解决的问题少：重复、乱序、积压、丢消息，每个都有应对方案，每个都要做对才行。引入之前先想清楚，这个异步解耦的收益到底值不值得养这套机制。",[11,71,72],{},"上下游协作的接口约定值得单独强调：消息的版本演进、字段增删的兼容策略，要在第一版就定好。消息一旦发出去就收不回来，下游的消费方也未必同步升级，兼容性欠的账在消息系统里特别难还。",[11,74,75],{},"监控消息系统时我固定看三组数字：生产速率、消费速率、积压量。三者的关系比绝对值重要，生产突增、消费停滞、积压陡涨，各自指向完全不同的问题，配上告警阈值之后，大多数问题能在用户感知之前处理掉。",[11,77,69],{},[11,79,72],{},[37,81,82],{"id":82},"又想到一些",[11,84,85],{},"平衡感很重要的一件事：投入和收益的比例。所有优化都值得先问一句，这件事的收益上限是多少，值多少投入。无限打磨一个低价值的东西是工程师最常见的温柔陷阱，包括我自己在内。",[11,87,88],{},"忍不住再夸一下记录的力量，上周刚整理的笔记，这次直接翻出来就用，十分钟解决了当时花一下午的问题。给自己留下的每一份笔记，都是寄给未来的快递，寄件人签收时才觉得真香。",[11,90,91],{},"最后聊点感受：做技术这些年，越来越觉得最好的状态是既投入又抽离。投入是把事情做好，抽离是时不时跳出来看看方向对不对，两者缺一，要么辛苦没产出，要么轻松跑偏路。",[11,93,94],{},"写着写着想到，很多技术选择本质上都是在回答同一个问题：这个方案在出问题的时候是什么样子。不出问题的方案人人都写得出来，区分度全在故障时刻的表现。多想一层失败路径，很多纠结就自动有了答案。",[37,96,97],{"id":97},"最后",[11,99,100],{},"最近加班多了些，更新慢了一点，周五晚上泡杯茶写下这篇，算是给自己留点节奏。",[11,102,103],{},"这篇就写到这，希望对你有点参考价值。",{"title":15,"searchDepth":16,"depth":17,"links":105},[106,107,108,109,110,111],{"id":39,"depth":16,"text":39},{"id":48,"depth":16,"text":48},{"id":54,"depth":16,"text":54},{"id":66,"depth":16,"text":66},{"id":82,"depth":16,"text":82},{"id":97,"depth":16,"text":97},[113],"消息队列","2026-06-20",false,{"excerpt":117},{"type":8,"value":118},[119],[11,120,35],{},"\u002Fposts\u002Fmq\u002Fmq-no-loss-6",398400,{"title":29,"description":35},"posts\u002Fmq\u002Fmq-no-loss-6",[126,127],"MQ","可靠性",[129],"mq",1328,"9gzsyKrtQSs2FHT60GPoRbw6hb1Lh1g7GCD3l7XRap0",{"prev":133,"next":136},{"path":134,"title":135},"\u002Fposts\u002Fmq\u002Fmq-no-loss-5","消息不丢失的全链路设计（五）",{"path":137,"title":138},"\u002Fposts\u002Fmq\u002Fmq-order","顺序消息的实现与代价",[140,149,179],{"id":5,"title":6,"body":141,"createdAt":19,"description":13,"extension":20,"meta":147,"navigation":22,"path":23,"seo":148,"stem":25,"__hash__":26},{"type":8,"value":142,"toc":145},[143],[11,144,13],{},{"title":15,"searchDepth":16,"depth":17,"links":146},[],{},{"description":13},{"id":150,"title":151,"body":152,"createdAt":172,"description":173,"extension":20,"meta":174,"navigation":22,"path":175,"seo":176,"stem":177,"__hash__":178},"notes\u002Fnotes\u002F2026-11-14-1.md","2026 11 14 1",{"type":8,"value":153,"toc":170},[154],[11,155,156,157,161,162,169],{},"站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 ",[158,159,160],"strong",{},"Markdown","，写链接也不用到编辑器：",[163,164,168],"a",{"href":165,"rel":166},"https:\u002F\u002Fcontent.nuxt.com",[167],"nofollow","Nuxt Content","。",{"title":15,"searchDepth":16,"depth":17,"links":171},[],"2026-11-14","站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 Markdown，写链接也不用到编辑器：Nuxt Content。",{},"\u002Fnotes\u002F2026-11-14-1",{"description":173},"notes\u002F2026-11-14-1","LLJX_RKU7cgpT6aHw4DZWUZNQ_G_UzELWPKbksJvzfs",{"id":180,"title":181,"body":182,"createdAt":197,"description":198,"extension":20,"meta":199,"navigation":22,"path":200,"seo":201,"stem":202,"__hash__":203},"notes\u002Fnotes\u002F2026-11-14-2.md","2026 11 14 2",{"type":8,"value":183,"toc":195},[184],[11,185,186,190,191,194],{},[187,188,189],"code",{},"readPixels"," 读不到内容不是 bug，是 ",[187,192,193],{},"preserveDrawingBuffer"," 默认关闭——帧提交后缓冲即被清空。",{"title":15,"searchDepth":16,"depth":17,"links":196},[],"2026-11-13","readPixels 读不到内容不是 bug，是 preserveDrawingBuffer 默认关闭——帧提交后缓冲即被清空。",{},"\u002Fnotes\u002F2026-11-14-2",{"description":198},"notes\u002F2026-11-14-2","i7xWqq2eNoU_seSbLQjqlB9gE51fM-PVLUEYCHBkOA4",1795274510653]