[{"data":1,"prerenderedAt":202},["ShallowReactive",2],{"notes-latest-1":3,"post:\u002Fposts\u002Fmq\u002Fmq-order":27,"surround:\u002Fposts\u002Fmq\u002Fmq-order":130,"notes-latest-3":137},[4],{"id":5,"title":6,"body":7,"createdAt":19,"description":13,"extension":20,"meta":21,"navigation":22,"path":23,"seo":24,"stem":25,"__hash__":26},"notes\u002Fnotes\u002F2026-11-14-1-2.md","2026 11 14 1 2",{"type":8,"value":9,"toc":14},"minimark",[10],[11,12,13],"p",{},"站点上线了「随笔」：支持一个文件多个随笔",{"title":15,"searchDepth":16,"depth":17,"links":18},"",2,3,[],"2026-11-17","md",{},true,"\u002Fnotes\u002F2026-11-14-1-2",{"description":13},"notes\u002F2026-11-14-1-2","hDP9fvaunHzVrZQ6QifuOtj9VrqbxlPb_52KE5wSjD0",{"id":28,"title":29,"author":30,"body":31,"categories":110,"comment":22,"cover":30,"createdAt":112,"description":35,"draft":113,"extension":20,"meta":114,"navigation":22,"path":119,"readingTime":120,"recommend":113,"seo":121,"series":30,"stem":122,"tags":123,"top":113,"topics":126,"updatedAt":30,"words":128,"__hash__":129},"posts\u002Fposts\u002Fmq\u002Fmq-order.md","顺序消息的实现与代价",null,{"type":8,"value":32,"toc":102},[33,36,40,43,46,49,52,55,58,61,64,67,70,73,76,78,81,84,87,90,93,96,99],[11,34,35],{},"长话短说，这篇就是一次完整的记录，从问题怎么来的，到最后方案怎么定，中间的弯路也都保留。",[37,38,39],"h2",{"id":39},"全局有序与局部有序",[11,41,42],{},"顺序消息要分清是全局有序还是局部有序。全局有序单队列单消费者，吞吐极差，业务上基本没人真需要；绝大多数场景要的是局部有序，比如同一个订单的状态变更按序处理。解法是按业务键分区，同一键的消息固定进同一分区，消费端同分区串行处理。",[11,44,45],{},"实现时有两个容易被忽略的坑：一是生产端的分区路由必须稳定，按 hash 打分区，同键永远同区；二是消费端串行要靠单线程消费同一分区，一旦处理失败，阻塞还是跳过的选择会影响后续消息的顺序语义，一般配重试队列把失败的先挪走，牺牲它的顺序保住整体吞吐。",[37,47,48],{"id":48},"先质疑需求",[11,50,51],{},"我的建议是先质疑需求：真的需要消息顺序吗？很多时候业务能接受最终一致，用版本号或时间戳在消费端做乱序防护，比维护严格顺序便宜得多。真需要顺序的场景，也把有序范围缩到最小，只对必须有序的那类消息用独立 topic 加分区键。顺序是有成本的，范围越大成本越高，能小则小。",[37,53,54],{"id":54},"踩坑记录",[11,56,57],{},"数据库连接池耗尽告警，顺着栈一看，事务方法里调了个远程接口，慢的时候一占好几秒。把远程调用挪出事务，事务粒度改小，连接池立刻宽松了。事务里只做该做的事。",[11,59,60],{},"crontab 里的脚本手动跑正常、定时跑就报错，环境变量不一致是老坑。把依赖的环境都写进脚本头部，或者干脆用绝对路径，别指望定时任务的运行环境和你的终端一样。",[11,62,63],{},"单元测试月底跑挂了，因为断言里依赖系统当前日期。注入 Clock 之后再测，时间随意控制。第一次遇到这种问题觉得很玄学，理解了之后觉得这是依赖注入最生动的教学案例。",[37,65,66],{"id":66},"多聊两句",[11,68,69],{},"消息队列用得久了会发现，它带来的问题不比解决的问题少：重复、乱序、积压、丢消息，每个都有应对方案，每个都要做对才行。引入之前先想清楚，这个异步解耦的收益到底值不值得养这套机制。",[11,71,72],{},"上下游协作的接口约定值得单独强调：消息的版本演进、字段增删的兼容策略，要在第一版就定好。消息一旦发出去就收不回来，下游的消费方也未必同步升级，兼容性欠的账在消息系统里特别难还。",[11,74,75],{},"监控消息系统时我固定看三组数字：生产速率、消费速率、积压量。三者的关系比绝对值重要，生产突增、消费停滞、积压陡涨，各自指向完全不同的问题，配上告警阈值之后，大多数问题能在用户感知之前处理掉。",[11,77,69],{},[37,79,80],{"id":80},"继续聊聊",[11,82,83],{},"平衡感很重要的一件事：投入和收益的比例。所有优化都值得先问一句，这件事的收益上限是多少，值多少投入。无限打磨一个低价值的东西是工程师最常见的温柔陷阱，包括我自己在内。",[11,85,86],{},"忍不住再夸一下记录的力量，上周刚整理的笔记，这次直接翻出来就用，十分钟解决了当时花一下午的问题。给自己留下的每一份笔记，都是寄给未来的快递，寄件人签收时才觉得真香。",[11,88,89],{},"最后聊点感受：做技术这些年，越来越觉得最好的状态是既投入又抽离。投入是把事情做好，抽离是时不时跳出来看看方向对不对，两者缺一，要么辛苦没产出，要么轻松跑偏路。",[11,91,92],{},"写着写着想到，很多技术选择本质上都是在回答同一个问题：这个方案在出问题的时候是什么样子。不出问题的方案人人都写得出来，区分度全在故障时刻的表现。多想一层失败路径，很多纠结就自动有了答案。",[37,94,95],{"id":95},"写在最后",[11,97,98],{},"写完这篇下楼跑了个五公里，脑子里剩下的方案细节，居然是跑步的时候理顺的。",[11,100,101],{},"如果你也遇到类似的情况，评论区聊聊。",{"title":15,"searchDepth":16,"depth":17,"links":103},[104,105,106,107,108,109],{"id":39,"depth":16,"text":39},{"id":48,"depth":16,"text":48},{"id":54,"depth":16,"text":54},{"id":66,"depth":16,"text":66},{"id":80,"depth":16,"text":80},{"id":95,"depth":16,"text":95},[111],"消息队列","2025-06-04",false,{"excerpt":115},{"type":8,"value":116},[117],[11,118,35],{},"\u002Fposts\u002Fmq\u002Fmq-order",384900,{"title":29,"description":35},"posts\u002Fmq\u002Fmq-order",[124,125],"MQ","顺序",[127],"mq",1283,"P7IfabOLByoPhfdTgqJrQXfBEI-_8zTIvHeqdu5cIz8",{"prev":131,"next":134},{"path":132,"title":133},"\u002Fposts\u002Fmq\u002Fmq-no-loss-6","消息不丢失的全链路设计（六）",{"path":135,"title":136},"\u002Fposts\u002Fmq\u002Fmq-order-2","顺序消息的实现与代价（二）",[138,147,177],{"id":5,"title":6,"body":139,"createdAt":19,"description":13,"extension":20,"meta":145,"navigation":22,"path":23,"seo":146,"stem":25,"__hash__":26},{"type":8,"value":140,"toc":143},[141],[11,142,13],{},{"title":15,"searchDepth":16,"depth":17,"links":144},[],{},{"description":13},{"id":148,"title":149,"body":150,"createdAt":170,"description":171,"extension":20,"meta":172,"navigation":22,"path":173,"seo":174,"stem":175,"__hash__":176},"notes\u002Fnotes\u002F2026-11-14-1.md","2026 11 14 1",{"type":8,"value":151,"toc":168},[152],[11,153,154,155,159,160,167],{},"站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 ",[156,157,158],"strong",{},"Markdown","，写链接也不用到编辑器：",[161,162,166],"a",{"href":163,"rel":164},"https:\u002F\u002Fcontent.nuxt.com",[165],"nofollow","Nuxt Content","。",{"title":15,"searchDepth":16,"depth":17,"links":169},[],"2026-11-14","站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 Markdown，写链接也不用到编辑器：Nuxt Content。",{},"\u002Fnotes\u002F2026-11-14-1",{"description":171},"notes\u002F2026-11-14-1","LLJX_RKU7cgpT6aHw4DZWUZNQ_G_UzELWPKbksJvzfs",{"id":178,"title":179,"body":180,"createdAt":195,"description":196,"extension":20,"meta":197,"navigation":22,"path":198,"seo":199,"stem":200,"__hash__":201},"notes\u002Fnotes\u002F2026-11-14-2.md","2026 11 14 2",{"type":8,"value":181,"toc":193},[182],[11,183,184,188,189,192],{},[185,186,187],"code",{},"readPixels"," 读不到内容不是 bug，是 ",[185,190,191],{},"preserveDrawingBuffer"," 默认关闭——帧提交后缓冲即被清空。",{"title":15,"searchDepth":16,"depth":17,"links":194},[],"2026-11-13","readPixels 读不到内容不是 bug，是 preserveDrawingBuffer 默认关闭——帧提交后缓冲即被清空。",{},"\u002Fnotes\u002F2026-11-14-2",{"description":196},"notes\u002F2026-11-14-2","i7xWqq2eNoU_seSbLQjqlB9gE51fM-PVLUEYCHBkOA4",1795274121073]