[{"data":1,"prerenderedAt":202},["ShallowReactive",2],{"notes-latest-1":3,"post:\u002Fposts\u002Fmq\u002Fmq-idempotent-3":27,"surround:\u002Fposts\u002Fmq\u002Fmq-idempotent-3":130,"notes-latest-3":137},[4],{"id":5,"title":6,"body":7,"createdAt":19,"description":13,"extension":20,"meta":21,"navigation":22,"path":23,"seo":24,"stem":25,"__hash__":26},"notes\u002Fnotes\u002F2026-11-14-1-2.md","2026 11 14 1 2",{"type":8,"value":9,"toc":14},"minimark",[10],[11,12,13],"p",{},"站点上线了「随笔」：支持一个文件多个随笔",{"title":15,"searchDepth":16,"depth":17,"links":18},"",2,3,[],"2026-11-17","md",{},true,"\u002Fnotes\u002F2026-11-14-1-2",{"description":13},"notes\u002F2026-11-14-1-2","hDP9fvaunHzVrZQ6QifuOtj9VrqbxlPb_52KE5wSjD0",{"id":28,"title":29,"author":30,"body":31,"categories":110,"comment":22,"cover":30,"createdAt":112,"description":35,"draft":113,"extension":20,"meta":114,"navigation":22,"path":119,"readingTime":120,"recommend":113,"seo":121,"series":30,"stem":122,"tags":123,"top":113,"topics":126,"updatedAt":30,"words":128,"__hash__":129},"posts\u002Fposts\u002Fmq\u002Fmq-idempotent-3.md","重复消费与幂等设计（三）",null,{"type":8,"value":32,"toc":102},[33,36,40,43,46,49,52,55,58,61,64,67,70,73,76,78,81,84,87,90,93,96,99],[11,34,35],{},"最近被问了几次同一个问题，发现口头表达总是漏要点，干脆写成文，以后直接甩链接。",[37,38,39],"h2",{"id":39},"为什么一定会有重复",[11,41,42],{},"先接受一个前提：分布式系统里消息的恰好一次传递基本是个传说，at least once 加上消费端幂等才是工程上的正解。重复的来源很日常：生产端重试导致同一条消息发了两遍，消费端处理成功但确认位移失败导致重新投递，负载均衡触发重分配也会带来重复。",[11,44,45],{},"幂等设计的第一选择是业务天然幂等：更新操作带上前置条件，把 insert 换成有唯一约束的 upsert。天然幂等覆盖不了的场景，用幂等表：消息唯一键做主键，处理前先插入，插入冲突说明处理过，直接跳过。表和业务操作放同一个本地事务里，保证标记和业务要么都成要么都不成。",[37,47,48],{"id":48},"几个补充建议",[11,50,51],{},"几个补充建议：唯一键的选取要来自业务语义而不是消息 ID，消息 ID 在重发场景下不可靠；幂等表要设归档策略，别让它变成新的大表；监控消费端的重复率，突然升高往往说明上游有异常重发。幂等做扎实之后，整套消息系统的心智负担会小很多，敢重试、敢迁移，都是幂等给的底气。",[37,53,54],{"id":54},"顺手记两个坑",[11,56,57],{},"发版之后用户还在用旧页面，报接口不存在的错。index.html 被强缓存了，给 HTML 加 no-cache、静态资源带 hash 长缓存，这是前端部署的标配，后端出身的我当年是真不知道。",[11,59,60],{},"数据库连接池耗尽告警，顺着栈一看，事务方法里调了个远程接口，慢的时候一占好几秒。把远程调用挪出事务，事务粒度改小，连接池立刻宽松了。事务里只做该做的事。",[11,62,63],{},"crontab 里的脚本手动跑正常、定时跑就报错，环境变量不一致是老坑。把依赖的环境都写进脚本头部，或者干脆用绝对路径，别指望定时任务的运行环境和你的终端一样。",[37,65,66],{"id":66},"一点延伸",[11,68,69],{},"监控消息系统时我固定看三组数字：生产速率、消费速率、积压量。三者的关系比绝对值重要，生产突增、消费停滞、积压陡涨，各自指向完全不同的问题，配上告警阈值之后，大多数问题能在用户感知之前处理掉。",[11,71,72],{},"消息队列用得久了会发现，它带来的问题不比解决的问题少：重复、乱序、积压、丢消息，每个都有应对方案，每个都要做对才行。引入之前先想清楚，这个异步解耦的收益到底值不值得养这套机制。",[11,74,75],{},"上下游协作的接口约定值得单独强调：消息的版本演进、字段增删的兼容策略，要在第一版就定好。消息一旦发出去就收不回来，下游的消费方也未必同步升级，兼容性欠的账在消息系统里特别难还。",[11,77,69],{},[37,79,80],{"id":80},"再补充几句",[11,82,83],{},"然后想说，承认不懂是这行的美德。这次遇到不懂的地方，老老实实补了两天的课，比硬着头皮往上糊的方案强太多。不懂装懂的代价从来不会消失，只是延期，还带利息。",[11,85,86],{},"平衡感很重要的一件事：投入和收益的比例。所有优化都值得先问一句，这件事的收益上限是多少，值多少投入。无限打磨一个低价值的东西是工程师最常见的温柔陷阱，包括我自己在内。",[11,88,89],{},"忍不住再夸一下记录的力量，上周刚整理的笔记，这次直接翻出来就用，十分钟解决了当时花一下午的问题。给自己留下的每一份笔记，都是寄给未来的快递，寄件人签收时才觉得真香。",[11,91,92],{},"最后聊点感受：做技术这些年，越来越觉得最好的状态是既投入又抽离。投入是把事情做好，抽离是时不时跳出来看看方向对不对，两者缺一，要么辛苦没产出，要么轻松跑偏路。",[37,94,95],{"id":95},"小结",[11,97,98],{},"最近加班多了些，更新慢了一点，周五晚上泡杯茶写下这篇，算是给自己留点节奏。",[11,100,101],{},"写完舒坦了，收工。",{"title":15,"searchDepth":16,"depth":17,"links":103},[104,105,106,107,108,109],{"id":39,"depth":16,"text":39},{"id":48,"depth":16,"text":48},{"id":54,"depth":16,"text":54},{"id":66,"depth":16,"text":66},{"id":80,"depth":16,"text":80},{"id":95,"depth":16,"text":95},[111],"消息队列","2026-02-15",false,{"excerpt":115},{"type":8,"value":116},[117],[11,118,35],{},"\u002Fposts\u002Fmq\u002Fmq-idempotent-3",375600,{"title":29,"description":35},"posts\u002Fmq\u002Fmq-idempotent-3",[124,125],"MQ","幂等",[127],"mq",1252,"6V3dyGLZkImDzz0RmiJhkDGSa4tmEku7WQ-OnDFhpn4",{"prev":131,"next":134},{"path":132,"title":133},"\u002Fposts\u002Fmq\u002Fmq-idempotent-2","重复消费与幂等设计（二）",{"path":135,"title":136},"\u002Fposts\u002Fmq\u002Fmq-idempotent-4","重复消费与幂等设计（四）",[138,147,177],{"id":5,"title":6,"body":139,"createdAt":19,"description":13,"extension":20,"meta":145,"navigation":22,"path":23,"seo":146,"stem":25,"__hash__":26},{"type":8,"value":140,"toc":143},[141],[11,142,13],{},{"title":15,"searchDepth":16,"depth":17,"links":144},[],{},{"description":13},{"id":148,"title":149,"body":150,"createdAt":170,"description":171,"extension":20,"meta":172,"navigation":22,"path":173,"seo":174,"stem":175,"__hash__":176},"notes\u002Fnotes\u002F2026-11-14-1.md","2026 11 14 1",{"type":8,"value":151,"toc":168},[152],[11,153,154,155,159,160,167],{},"站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 ",[156,157,158],"strong",{},"Markdown","，写链接也不用到编辑器：",[161,162,166],"a",{"href":163,"rel":164},"https:\u002F\u002Fcontent.nuxt.com",[165],"nofollow","Nuxt Content","。",{"title":15,"searchDepth":16,"depth":17,"links":169},[],"2026-11-14","站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 Markdown，写链接也不用到编辑器：Nuxt Content。",{},"\u002Fnotes\u002F2026-11-14-1",{"description":171},"notes\u002F2026-11-14-1","LLJX_RKU7cgpT6aHw4DZWUZNQ_G_UzELWPKbksJvzfs",{"id":178,"title":179,"body":180,"createdAt":195,"description":196,"extension":20,"meta":197,"navigation":22,"path":198,"seo":199,"stem":200,"__hash__":201},"notes\u002Fnotes\u002F2026-11-14-2.md","2026 11 14 2",{"type":8,"value":181,"toc":193},[182],[11,183,184,188,189,192],{},[185,186,187],"code",{},"readPixels"," 读不到内容不是 bug，是 ",[185,190,191],{},"preserveDrawingBuffer"," 默认关闭——帧提交后缓冲即被清空。",{"title":15,"searchDepth":16,"depth":17,"links":194},[],"2026-11-13","readPixels 读不到内容不是 bug，是 preserveDrawingBuffer 默认关闭——帧提交后缓冲即被清空。",{},"\u002Fnotes\u002F2026-11-14-2",{"description":196},"notes\u002F2026-11-14-2","i7xWqq2eNoU_seSbLQjqlB9gE51fM-PVLUEYCHBkOA4",1795275929371]