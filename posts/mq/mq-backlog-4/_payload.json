[{"data":1,"prerenderedAt":204},["ShallowReactive",2],{"notes-latest-1":3,"post:\u002Fposts\u002Fmq\u002Fmq-backlog-4":27,"surround:\u002Fposts\u002Fmq\u002Fmq-backlog-4":132,"notes-latest-3":139},[4],{"id":5,"title":6,"body":7,"createdAt":19,"description":13,"extension":20,"meta":21,"navigation":22,"path":23,"seo":24,"stem":25,"__hash__":26},"notes\u002Fnotes\u002F2026-11-14-1-2.md","2026 11 14 1 2",{"type":8,"value":9,"toc":14},"minimark",[10],[11,12,13],"p",{},"站点上线了「随笔」：支持一个文件多个随笔",{"title":15,"searchDepth":16,"depth":17,"links":18},"",2,3,[],"2026-11-17","md",{},true,"\u002Fnotes\u002F2026-11-14-1-2",{"description":13},"notes\u002F2026-11-14-1-2","hDP9fvaunHzVrZQ6QifuOtj9VrqbxlPb_52KE5wSjD0",{"id":28,"title":29,"author":30,"body":31,"categories":112,"comment":22,"cover":30,"createdAt":114,"description":35,"draft":115,"extension":20,"meta":116,"navigation":22,"path":121,"readingTime":122,"recommend":115,"seo":123,"series":30,"stem":124,"tags":125,"top":115,"topics":128,"updatedAt":30,"words":130,"__hash__":131},"posts\u002Fposts\u002Fmq\u002Fmq-backlog-4.md","消息积压的应急与根治（四）",null,{"type":8,"value":32,"toc":104},[33,36,40,43,46,49,52,55,58,61,64,67,70,73,76,78,80,83,86,89,92,95,98,101],[11,34,35],{},"想写这个话题很久了，一直没找到合适的角度，这篇先把核心的部分讲清楚，细节以后再展开。",[37,38,39],"h2",{"id":39},"先止血再找因",[11,41,42],{},"积压的应急处理有个经典套路：先看消费逻辑里哪一步慢，如果是查库或调接口这种 IO，扩消费者实例通常有效，前提是分区数允许；分区数是吞吐上限，分区不够就临时新建一个大分区数的 topic，写一个只做搬运的消费者把积压转过去，再由大并发的消费者处理，处理完切回来。",[11,44,45],{},"但应急只是止血，真正要回答的是为什么积压：是流量突增、消费逻辑变慢、还是下游故障拖住了消费。不做归因的应急处理，下次还会在同一个地方摔。",[37,47,48],{"id":48},"日常的预防",[11,50,51],{},"日常预防三件事：把消费 lag 做成告警，设分级阈值，别等用户反馈；定期做消费端压测，知道自己的极限吞吐在哪；重要 topic 的分区数按峰值流量乘安全系数规划，扩分区虽然现在也支持，但提前规划总比临时救火从容。积压不可怕，可怕的是积压了很久才被业务方先发现。",[37,53,54],{"id":54},"记两个小问题",[11,56,57],{},"RabbitMQ 队列堆积，消费者明明在跑。看配置 prefetch 设得太大，单条消息处理又慢，吞吐全耗在慢消息上。把 prefetch 调小，吞吐反而上去了，多不一定快。",[11,59,60],{},"前端拿 Long 类型的 id 显示成了另一个数，JS 的 Number 精度上限就到 2 的 53 次方。序列化时把 Long 转 String，这是前后端协作里经典的暗坑，吃过一次亏就会记一辈子。",[11,62,63],{},"定时任务上线后时间全不对，cron 是按服务器时区算的，容器里又是 UTC。统一时区这种事，应该在基础设施层一次做对，而不是每个应用各自打补丁。",[37,65,66],{"id":66},"顺便一提",[11,68,69],{},"监控消息系统时我固定看三组数字：生产速率、消费速率、积压量。三者的关系比绝对值重要，生产突增、消费停滞、积压陡涨，各自指向完全不同的问题，配上告警阈值之后，大多数问题能在用户感知之前处理掉。",[11,71,72],{},"消息队列用得久了会发现，它带来的问题不比解决的问题少：重复、乱序、积压、丢消息，每个都有应对方案，每个都要做对才行。引入之前先想清楚，这个异步解耦的收益到底值不值得养这套机制。",[11,74,75],{},"上下游协作的接口约定值得单独强调：消息的版本演进、字段增删的兼容策略，要在第一版就定好。消息一旦发出去就收不回来，下游的消费方也未必同步升级，兼容性欠的账在消息系统里特别难还。",[11,77,69],{},[11,79,72],{},[37,81,82],{"id":82},"另外记几笔",[11,84,85],{},"有时候会想，学一门新技术到底学到的是什么。语法和 API 会过时，真正的收获是它看问题的角度。多一门语言就多一副眼镜，同一副牌桌，能看到别人看不到的牌路，这是这么多年折腾下来最确定的回报。",[11,87,88],{},"记一个产生过的动摇：做到一半觉得这玩意儿是不是没什么意义。后来想通了，意义不是事情自带的，是你把它做完并沉淀下来之后长出来的。烂尾的才真的没意义，做完的最差也是一篇笔记。",[11,90,91],{},"顺便说说协作里的体会：这类事自己闷头做效率最高，但闷头做完往往返工最多。适度地提前同步，把方向先对齐，看似慢了半天，实际省掉的是几天的返工。沟通的时机比沟通的技巧更值得琢磨。",[11,93,94],{},"其实回看这些年踩的坑，大坑几乎都和贪快有关。快不是错，错的是想跳过必要步骤的快，地基没打牢盖得越快塌得越响。慢下来把该做的做扎实，反而是最快的路径，这话说了很多年，每次验证都对。",[37,96,97],{"id":97},"最后",[11,99,100],{},"楼下那家面馆老板都认识我了，加班晚归来一碗，很多难缠的问题都是吃完那碗面之后突然有思路的。",[11,102,103],{},"先记到这里，后面有新的进展再来补充。",{"title":15,"searchDepth":16,"depth":17,"links":105},[106,107,108,109,110,111],{"id":39,"depth":16,"text":39},{"id":48,"depth":16,"text":48},{"id":54,"depth":16,"text":54},{"id":66,"depth":16,"text":66},{"id":82,"depth":16,"text":82},{"id":97,"depth":16,"text":97},[113],"消息队列","2024-06-18",false,{"excerpt":117},{"type":8,"value":118},[119],[11,120,35],{},"\u002Fposts\u002Fmq\u002Fmq-backlog-4",392100,{"title":29,"description":35},"posts\u002Fmq\u002Fmq-backlog-4",[126,127],"MQ","运维",[129],"mq",1307,"KXZtT_Fi8ZFFCySYbU_p-q4yTD4OPzMIKVq339GYvXw",{"prev":133,"next":136},{"path":134,"title":135},"\u002Fposts\u002Fmq\u002Fmq-backlog-3","消息积压的应急与根治（三）",{"path":137,"title":138},"\u002Fposts\u002Fmq\u002Fmq-backlog-5","消息积压的应急与根治（五）",[140,149,179],{"id":5,"title":6,"body":141,"createdAt":19,"description":13,"extension":20,"meta":147,"navigation":22,"path":23,"seo":148,"stem":25,"__hash__":26},{"type":8,"value":142,"toc":145},[143],[11,144,13],{},{"title":15,"searchDepth":16,"depth":17,"links":146},[],{},{"description":13},{"id":150,"title":151,"body":152,"createdAt":172,"description":173,"extension":20,"meta":174,"navigation":22,"path":175,"seo":176,"stem":177,"__hash__":178},"notes\u002Fnotes\u002F2026-11-14-1.md","2026 11 14 1",{"type":8,"value":153,"toc":170},[154],[11,155,156,157,161,162,169],{},"站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 ",[158,159,160],"strong",{},"Markdown","，写链接也不用到编辑器：",[163,164,168],"a",{"href":165,"rel":166},"https:\u002F\u002Fcontent.nuxt.com",[167],"nofollow","Nuxt Content","。",{"title":15,"searchDepth":16,"depth":17,"links":171},[],"2026-11-14","站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 Markdown，写链接也不用到编辑器：Nuxt Content。",{},"\u002Fnotes\u002F2026-11-14-1",{"description":173},"notes\u002F2026-11-14-1","LLJX_RKU7cgpT6aHw4DZWUZNQ_G_UzELWPKbksJvzfs",{"id":180,"title":181,"body":182,"createdAt":197,"description":198,"extension":20,"meta":199,"navigation":22,"path":200,"seo":201,"stem":202,"__hash__":203},"notes\u002Fnotes\u002F2026-11-14-2.md","2026 11 14 2",{"type":8,"value":183,"toc":195},[184],[11,185,186,190,191,194],{},[187,188,189],"code",{},"readPixels"," 读不到内容不是 bug，是 ",[187,192,193],{},"preserveDrawingBuffer"," 默认关闭——帧提交后缓冲即被清空。",{"title":15,"searchDepth":16,"depth":17,"links":196},[],"2026-11-13","readPixels 读不到内容不是 bug，是 preserveDrawingBuffer 默认关闭——帧提交后缓冲即被清空。",{},"\u002Fnotes\u002F2026-11-14-2",{"description":198},"notes\u002F2026-11-14-2","i7xWqq2eNoU_seSbLQjqlB9gE51fM-PVLUEYCHBkOA4",1795274510185]