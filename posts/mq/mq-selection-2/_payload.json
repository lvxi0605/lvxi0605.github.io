[{"data":1,"prerenderedAt":202},["ShallowReactive",2],{"notes-latest-1":3,"post:\u002Fposts\u002Fmq\u002Fmq-selection-2":27,"surround:\u002Fposts\u002Fmq\u002Fmq-selection-2":130,"notes-latest-3":137},[4],{"id":5,"title":6,"body":7,"createdAt":19,"description":13,"extension":20,"meta":21,"navigation":22,"path":23,"seo":24,"stem":25,"__hash__":26},"notes\u002Fnotes\u002F2026-11-14-1-2.md","2026 11 14 1 2",{"type":8,"value":9,"toc":14},"minimark",[10],[11,12,13],"p",{},"站点上线了「随笔」：支持一个文件多个随笔",{"title":15,"searchDepth":16,"depth":17,"links":18},"",2,3,[],"2026-11-17","md",{},true,"\u002Fnotes\u002F2026-11-14-1-2",{"description":13},"notes\u002F2026-11-14-1-2","hDP9fvaunHzVrZQ6QifuOtj9VrqbxlPb_52KE5wSjD0",{"id":28,"title":29,"author":30,"body":31,"categories":110,"comment":22,"cover":30,"createdAt":112,"description":35,"draft":113,"extension":20,"meta":114,"navigation":22,"path":119,"readingTime":120,"recommend":113,"seo":121,"series":30,"stem":122,"tags":123,"top":113,"topics":126,"updatedAt":30,"words":128,"__hash__":129},"posts\u002Fposts\u002Fmq\u002Fmq-selection-2.md","RabbitMQ、Kafka、RocketMQ 怎么选（二）",null,{"type":8,"value":32,"toc":102},[33,36,40,43,46,49,52,55,58,61,64,67,70,73,76,78,81,84,87,90,93,96,99],[11,34,35],{},"趁热打铁，刚踩完坑就来记录，趁着记忆最新鲜，把当时的判断和后面的验证都写下来。",[37,38,39],"h2",{"id":39},"各自擅长什么",[11,41,42],{},"三者的基因不同。Kafka 为高吞吐流式场景而生，分区模型加顺序写盘，日志采集、数据管道、事件溯源这类场景是主场，但延迟语义和丰富的路由能力不是它的重点；RabbitMQ 路由模型灵活，交换机类型丰富，管理界面友好，适合业务消息和复杂分发逻辑，单机吞吐不如 Kafka；RocketMQ 面向业务消息设计，事务消息、定时消息、消息轨迹这些业务特性开箱即用，Java 技术栈接入成本低。",[11,44,45],{},"选型先列场景需求：要事务消息和延迟消息，RocketMQ 现成；大吞吐日志流，Kafka；复杂路由和低消息量，RabbitMQ 轻松。",[37,47,48],{"id":48},"生态与团队",[11,50,51],{},"除了功能清单还有两个现实因素：生态和团队。周边组件的兼容性、云厂商的托管支持、社区资料的丰富度都影响长期维护成本；团队熟悉的优先，MQ 的坑需要经验积累，用一个团队摸透的产品，好过高薪请一个大家都不熟的。我的结论是消息中间件没有全能选手，主用一个、场景必要时引入第二个，比追求一步到位更务实。",[37,53,54],{"id":54},"过程中的两个坑",[11,56,57],{},"前端拿 Long 类型的 id 显示成了另一个数，JS 的 Number 精度上限就到 2 的 53 次方。序列化时把 Long 转 String，这是前后端协作里经典的暗坑，吃过一次亏就会记一辈子。",[11,59,60],{},"定时任务上线后时间全不对，cron 是按服务器时区算的，容器里又是 UTC。统一时区这种事，应该在基础设施层一次做对，而不是每个应用各自打补丁。",[11,62,63],{},"分页参数没做上限校验，被前端误传了个 pageSize 一万，数据库当场趴下。所有来自外部的参数都不可信，这句话说了十年，依然每年有人用事故重新验证一遍。",[37,65,66],{"id":66},"延伸几句",[11,68,69],{},"消息队列用得久了会发现，它带来的问题不比解决的问题少：重复、乱序、积压、丢消息，每个都有应对方案，每个都要做对才行。引入之前先想清楚，这个异步解耦的收益到底值不值得养这套机制。",[11,71,72],{},"上下游协作的接口约定值得单独强调：消息的版本演进、字段增删的兼容策略，要在第一版就定好。消息一旦发出去就收不回来，下游的消费方也未必同步升级，兼容性欠的账在消息系统里特别难还。",[11,74,75],{},"监控消息系统时我固定看三组数字：生产速率、消费速率、积压量。三者的关系比绝对值重要，生产突增、消费停滞、积压陡涨，各自指向完全不同的问题，配上告警阈值之后，大多数问题能在用户感知之前处理掉。",[11,77,69],{},[37,79,80],{"id":80},"又想到一些",[11,82,83],{},"记一个产生过的动摇：做到一半觉得这玩意儿是不是没什么意义。后来想通了，意义不是事情自带的，是你把它做完并沉淀下来之后长出来的。烂尾的才真的没意义，做完的最差也是一篇笔记。",[11,85,86],{},"顺便说说协作里的体会：这类事自己闷头做效率最高，但闷头做完往往返工最多。适度地提前同步，把方向先对齐，看似慢了半天，实际省掉的是几天的返工。沟通的时机比沟通的技巧更值得琢磨。",[11,88,89],{},"其实回看这些年踩的坑，大坑几乎都和贪快有关。快不是错，错的是想跳过必要步骤的快，地基没打牢盖得越快塌得越响。慢下来把该做的做扎实，反而是最快的路径，这话说了很多年，每次验证都对。",[11,91,92],{},"有个观察分享给大家：技术的成长曲线不是线性的，是一段平台加一次跃迁。平台期最磨人，感觉学了很多没进步，其实是在攒素材，攒够了某个契机一到就突飞猛进。所以在平台期别否定自己，那是跃迁的前奏。",[37,94,95],{"id":95},"小结",[11,97,98],{},"天冷了，敲键盘手有点僵，新入手的木质腕托派上了用场，顺便把欠的这篇写完。",[11,100,101],{},"今天的记录就到这里，晚安。",{"title":15,"searchDepth":16,"depth":17,"links":103},[104,105,106,107,108,109],{"id":39,"depth":16,"text":39},{"id":48,"depth":16,"text":48},{"id":54,"depth":16,"text":54},{"id":66,"depth":16,"text":66},{"id":80,"depth":16,"text":80},{"id":95,"depth":16,"text":95},[111],"消息队列","2024-05-22",false,{"excerpt":115},{"type":8,"value":116},[117],[11,118,35],{},"\u002Fposts\u002Fmq\u002Fmq-selection-2",375000,{"title":29,"description":35},"posts\u002Fmq\u002Fmq-selection-2",[124,125],"MQ","选型",[127],"mq",1250,"6Srz_95_jyjwdk26D33GzQeTVSMLJEOgO9hbvqLUD6k",{"prev":131,"next":134},{"path":132,"title":133},"\u002Fposts\u002Fmq\u002Fmq-selection","RabbitMQ、Kafka、RocketMQ 怎么选",{"path":135,"title":136},"\u002Fposts\u002Fmq\u002Fmq-selection-3","RabbitMQ、Kafka、RocketMQ 怎么选（三）",[138,147,177],{"id":5,"title":6,"body":139,"createdAt":19,"description":13,"extension":20,"meta":145,"navigation":22,"path":23,"seo":146,"stem":25,"__hash__":26},{"type":8,"value":140,"toc":143},[141],[11,142,13],{},{"title":15,"searchDepth":16,"depth":17,"links":144},[],{},{"description":13},{"id":148,"title":149,"body":150,"createdAt":170,"description":171,"extension":20,"meta":172,"navigation":22,"path":173,"seo":174,"stem":175,"__hash__":176},"notes\u002Fnotes\u002F2026-11-14-1.md","2026 11 14 1",{"type":8,"value":151,"toc":168},[152],[11,153,154,155,159,160,167],{},"站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 ",[156,157,158],"strong",{},"Markdown","，写链接也不用到编辑器：",[161,162,166],"a",{"href":163,"rel":164},"https:\u002F\u002Fcontent.nuxt.com",[165],"nofollow","Nuxt Content","。",{"title":15,"searchDepth":16,"depth":17,"links":169},[],"2026-11-14","站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 Markdown，写链接也不用到编辑器：Nuxt Content。",{},"\u002Fnotes\u002F2026-11-14-1",{"description":171},"notes\u002F2026-11-14-1","LLJX_RKU7cgpT6aHw4DZWUZNQ_G_UzELWPKbksJvzfs",{"id":178,"title":179,"body":180,"createdAt":195,"description":196,"extension":20,"meta":197,"navigation":22,"path":198,"seo":199,"stem":200,"__hash__":201},"notes\u002Fnotes\u002F2026-11-14-2.md","2026 11 14 2",{"type":8,"value":181,"toc":193},[182],[11,183,184,188,189,192],{},[185,186,187],"code",{},"readPixels"," 读不到内容不是 bug，是 ",[185,190,191],{},"preserveDrawingBuffer"," 默认关闭——帧提交后缓冲即被清空。",{"title":15,"searchDepth":16,"depth":17,"links":194},[],"2026-11-13","readPixels 读不到内容不是 bug，是 preserveDrawingBuffer 默认关闭——帧提交后缓冲即被清空。",{},"\u002Fnotes\u002F2026-11-14-2",{"description":196},"notes\u002F2026-11-14-2","i7xWqq2eNoU_seSbLQjqlB9gE51fM-PVLUEYCHBkOA4",1795342439381]