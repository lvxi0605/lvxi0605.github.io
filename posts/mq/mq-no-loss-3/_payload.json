[{"data":1,"prerenderedAt":204},["ShallowReactive",2],{"notes-latest-1":3,"post:\u002Fposts\u002Fmq\u002Fmq-no-loss-3":27,"surround:\u002Fposts\u002Fmq\u002Fmq-no-loss-3":132,"notes-latest-3":139},[4],{"id":5,"title":6,"body":7,"createdAt":19,"description":13,"extension":20,"meta":21,"navigation":22,"path":23,"seo":24,"stem":25,"__hash__":26},"notes\u002Fnotes\u002F2026-11-14-1-2.md","2026 11 14 1 2",{"type":8,"value":9,"toc":14},"minimark",[10],[11,12,13],"p",{},"站点上线了「随笔」：支持一个文件多个随笔",{"title":15,"searchDepth":16,"depth":17,"links":18},"",2,3,[],"2026-11-17","md",{},true,"\u002Fnotes\u002F2026-11-14-1-2",{"description":13},"notes\u002F2026-11-14-1-2","hDP9fvaunHzVrZQ6QifuOtj9VrqbxlPb_52KE5wSjD0",{"id":28,"title":29,"author":30,"body":31,"categories":112,"comment":22,"cover":30,"createdAt":114,"description":35,"draft":115,"extension":20,"meta":116,"navigation":22,"path":121,"readingTime":122,"recommend":115,"seo":123,"series":30,"stem":124,"tags":125,"top":115,"topics":128,"updatedAt":30,"words":130,"__hash__":131},"posts\u002Fposts\u002Fmq\u002Fmq-no-loss-3.md","消息不丢失的全链路设计（三）",null,{"type":8,"value":32,"toc":104},[33,36,40,43,46,49,52,55,58,61,64,67,70,73,76,78,80,83,86,89,92,95,98,101],[11,34,35],{},"长话短说，这篇就是一次完整的记录，从问题怎么来的，到最后方案怎么定，中间的弯路也都保留。",[37,38,39],"h2",{"id":39},"三个阶段三个保障",[11,41,42],{},"消息丢失可能发生在三个环节，每个环节有对应的保障。生产端用确认机制，发送后等 broker 的 ack，失败重试，本地消息表或者事务消息兜底业务和消息的一致性；存储端靠持久化，把刷盘策略设为同步或者至少同步刷盘副本数达标，多副本部署保证单机故障不丢；消费端关掉自动提交位移，业务处理成功后再确认，处理失败重试或进死信。",[11,44,45],{},"三个环节单独看都不复杂，难的是全链路一致地做。见过太多系统生产端做了确认，消费端却在自动提交，等于白忙。",[37,47,48],{"id":48},"端到端的验证",[11,50,51],{},"除了配置，还要做端到端的验证：压测时故意杀掉 broker、杀掉消费者，观察消息是否补齐；对账任务定期比对业务表和消息轨迹的数量。消息不丢失这个命题，最终要落到可验证的机制上，而不是配置文件里几行看似正确的参数。我们的做法是把关键链路的丢失率做成周报指标，数字长期为零才算真的可靠。",[37,53,54],{"id":54},"过程中的两个坑",[11,56,57],{},"镜像优化前是 1.2G，换 alpine 基础镜像加上多阶段构建，砍到两百兆以内，拉取时间肉眼可见地降下来。构建上下文里别把无关文件拷进去，.dockerignore 值得认真配一次。",[11,59,60],{},"上传接口一直 413，代码怎么改都没用，最后才反应过来是 Nginx 的 client_max_body_size 默认 1m 挡住了。这种不在应用层的问题，排查方向一开始就该往链路上想。",[11,62,63],{},"线上 full GC 频繁但堆使用率不高，后来发现是大对象直接进了老年代。调整缓存分页大小加上堆参数之后稳住了，监控里老年代的曲线是最值得天天瞄一眼的东西。",[37,65,66],{"id":66},"延伸几句",[11,68,69],{},"消息队列用得久了会发现，它带来的问题不比解决的问题少：重复、乱序、积压、丢消息，每个都有应对方案，每个都要做对才行。引入之前先想清楚，这个异步解耦的收益到底值不值得养这套机制。",[11,71,72],{},"上下游协作的接口约定值得单独强调：消息的版本演进、字段增删的兼容策略，要在第一版就定好。消息一旦发出去就收不回来，下游的消费方也未必同步升级，兼容性欠的账在消息系统里特别难还。",[11,74,75],{},"监控消息系统时我固定看三组数字：生产速率、消费速率、积压量。三者的关系比绝对值重要，生产突增、消费停滞、积压陡涨，各自指向完全不同的问题，配上告警阈值之后，大多数问题能在用户感知之前处理掉。",[11,77,69],{},[11,79,72],{},[37,81,82],{"id":82},"又想到一些",[11,84,85],{},"还有个感受越来越深：知识落地成文字的过程本身就是学习的一部分。很多自以为想清楚的东西，写出来才发现逻辑有洞。写作是最好的检验，这也是坚持写博客这么多年的理由之一，写不出来的就是还没学会的。",[11,87,88],{},"过程中也反复体会到取舍的本质：没有完美的方案，只有当下约束下最合适的方案。把约束写清楚，方案的选择题就变成了证明题，这也是为什么我习惯先列约束再谈方案，顺序反了全是无效争论。",[11,90,91],{},"想想还是补一段：任何习惯的养成都绕不开启动成本，最有效的办法是把启动成本降到接近零。想跑就把鞋放门口，想写就把文档开着置顶，环境准备到位了，行动只是顺水推舟。",[11,93,94],{},"从更高的视角看，这类问题都有一个共同结构：短期收益和长期收益打架。短期的诱惑总是具体而生动，长期的回报抽象而遥远，赢家通常是那些把长期目标拆成短期可感的小奖励的人。",[37,96,97],{"id":97},"最后",[11,99,100],{},"写这篇之前刚给阳台的绿萝浇了水，照顾植物和写博客有个共同点，都靠长期的小坚持。",[11,102,103],{},"暂时记到这，下次接着说。",{"title":15,"searchDepth":16,"depth":17,"links":105},[106,107,108,109,110,111],{"id":39,"depth":16,"text":39},{"id":48,"depth":16,"text":48},{"id":54,"depth":16,"text":54},{"id":66,"depth":16,"text":66},{"id":82,"depth":16,"text":82},{"id":97,"depth":16,"text":97},[113],"消息队列","2025-05-29",false,{"excerpt":117},{"type":8,"value":118},[119],[11,120,35],{},"\u002Fposts\u002Fmq\u002Fmq-no-loss-3",398700,{"title":29,"description":35},"posts\u002Fmq\u002Fmq-no-loss-3",[126,127],"MQ","可靠性",[129],"mq",1329,"-4ZWCjeopTRJgpkbn9-b_qmH42Z3BP1TVOQURWcJGQo",{"prev":133,"next":136},{"path":134,"title":135},"\u002Fposts\u002Fmq\u002Fmq-no-loss-2","消息不丢失的全链路设计（二）",{"path":137,"title":138},"\u002Fposts\u002Fmq\u002Fmq-no-loss-4","消息不丢失的全链路设计（四）",[140,149,179],{"id":5,"title":6,"body":141,"createdAt":19,"description":13,"extension":20,"meta":147,"navigation":22,"path":23,"seo":148,"stem":25,"__hash__":26},{"type":8,"value":142,"toc":145},[143],[11,144,13],{},{"title":15,"searchDepth":16,"depth":17,"links":146},[],{},{"description":13},{"id":150,"title":151,"body":152,"createdAt":172,"description":173,"extension":20,"meta":174,"navigation":22,"path":175,"seo":176,"stem":177,"__hash__":178},"notes\u002Fnotes\u002F2026-11-14-1.md","2026 11 14 1",{"type":8,"value":153,"toc":170},[154],[11,155,156,157,161,162,169],{},"站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 ",[158,159,160],"strong",{},"Markdown","，写链接也不用到编辑器：",[163,164,168],"a",{"href":165,"rel":166},"https:\u002F\u002Fcontent.nuxt.com",[167],"nofollow","Nuxt Content","。",{"title":15,"searchDepth":16,"depth":17,"links":171},[],"2026-11-14","站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 Markdown，写链接也不用到编辑器：Nuxt Content。",{},"\u002Fnotes\u002F2026-11-14-1",{"description":173},"notes\u002F2026-11-14-1","LLJX_RKU7cgpT6aHw4DZWUZNQ_G_UzELWPKbksJvzfs",{"id":180,"title":181,"body":182,"createdAt":197,"description":198,"extension":20,"meta":199,"navigation":22,"path":200,"seo":201,"stem":202,"__hash__":203},"notes\u002Fnotes\u002F2026-11-14-2.md","2026 11 14 2",{"type":8,"value":183,"toc":195},[184],[11,185,186,190,191,194],{},[187,188,189],"code",{},"readPixels"," 读不到内容不是 bug，是 ",[187,192,193],{},"preserveDrawingBuffer"," 默认关闭——帧提交后缓冲即被清空。",{"title":15,"searchDepth":16,"depth":17,"links":196},[],"2026-11-13","readPixels 读不到内容不是 bug，是 preserveDrawingBuffer 默认关闭——帧提交后缓冲即被清空。",{},"\u002Fnotes\u002F2026-11-14-2",{"description":198},"notes\u002F2026-11-14-2","i7xWqq2eNoU_seSbLQjqlB9gE51fM-PVLUEYCHBkOA4",1795783656393]