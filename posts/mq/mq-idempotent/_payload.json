[{"data":1,"prerenderedAt":204},["ShallowReactive",2],{"notes-latest-1":3,"post:\u002Fposts\u002Fmq\u002Fmq-idempotent":27,"surround:\u002Fposts\u002Fmq\u002Fmq-idempotent":132,"notes-latest-3":139},[4],{"id":5,"title":6,"body":7,"createdAt":19,"description":13,"extension":20,"meta":21,"navigation":22,"path":23,"seo":24,"stem":25,"__hash__":26},"notes\u002Fnotes\u002F2026-11-14-1-2.md","2026 11 14 1 2",{"type":8,"value":9,"toc":14},"minimark",[10],[11,12,13],"p",{},"站点上线了「随笔」：支持一个文件多个随笔",{"title":15,"searchDepth":16,"depth":17,"links":18},"",2,3,[],"2026-11-17","md",{},true,"\u002Fnotes\u002F2026-11-14-1-2",{"description":13},"notes\u002F2026-11-14-1-2","hDP9fvaunHzVrZQ6QifuOtj9VrqbxlPb_52KE5wSjD0",{"id":28,"title":29,"author":30,"body":31,"categories":112,"comment":22,"cover":30,"createdAt":114,"description":35,"draft":115,"extension":20,"meta":116,"navigation":22,"path":121,"readingTime":122,"recommend":115,"seo":123,"series":30,"stem":124,"tags":125,"top":115,"topics":128,"updatedAt":30,"words":130,"__hash__":131},"posts\u002Fposts\u002Fmq\u002Fmq-idempotent.md","重复消费与幂等设计",null,{"type":8,"value":32,"toc":104},[33,36,40,43,46,49,52,55,58,61,64,67,70,73,76,78,80,83,86,89,92,95,98,101],[11,34,35],{},"之前写过类似的话题，这篇算补充篇，主要记最近新的体会，两篇对照着看会更完整一些。",[37,38,39],"h2",{"id":39},"为什么一定会有重复",[11,41,42],{},"先接受一个前提：分布式系统里消息的恰好一次传递基本是个传说，at least once 加上消费端幂等才是工程上的正解。重复的来源很日常：生产端重试导致同一条消息发了两遍，消费端处理成功但确认位移失败导致重新投递，负载均衡触发重分配也会带来重复。",[11,44,45],{},"幂等设计的第一选择是业务天然幂等：更新操作带上前置条件，把 insert 换成有唯一约束的 upsert。天然幂等覆盖不了的场景，用幂等表：消息唯一键做主键，处理前先插入，插入冲突说明处理过，直接跳过。表和业务操作放同一个本地事务里，保证标记和业务要么都成要么都不成。",[37,47,48],{"id":48},"几个补充建议",[11,50,51],{},"几个补充建议：唯一键的选取要来自业务语义而不是消息 ID，消息 ID 在重发场景下不可靠；幂等表要设归档策略，别让它变成新的大表；监控消费端的重复率，突然升高往往说明上游有异常重发。幂等做扎实之后，整套消息系统的心智负担会小很多，敢重试、敢迁移，都是幂等给的底气。",[37,53,54],{"id":54},"顺手记两个坑",[11,56,57],{},"上传接口一直 413，代码怎么改都没用，最后才反应过来是 Nginx 的 client_max_body_size 默认 1m 挡住了。这种不在应用层的问题，排查方向一开始就该往链路上想。",[11,59,60],{},"线上 full GC 频繁但堆使用率不高，后来发现是大对象直接进了老年代。调整缓存分页大小加上堆参数之后稳住了，监控里老年代的曲线是最值得天天瞄一眼的东西。",[11,62,63],{},"容器里日志时间和本地对不上，查了半天是时区，默认 UTC。在环境变量里把 TZ 设成 Asia\u002FShanghai，顺带把 JDK 参数也统一了，从此日志排查不用再做心算换算。",[37,65,66],{"id":66},"一点延伸",[11,68,69],{},"上下游协作的接口约定值得单独强调：消息的版本演进、字段增删的兼容策略，要在第一版就定好。消息一旦发出去就收不回来，下游的消费方也未必同步升级，兼容性欠的账在消息系统里特别难还。",[11,71,72],{},"监控消息系统时我固定看三组数字：生产速率、消费速率、积压量。三者的关系比绝对值重要，生产突增、消费停滞、积压陡涨，各自指向完全不同的问题，配上告警阈值之后，大多数问题能在用户感知之前处理掉。",[11,74,75],{},"消息队列用得久了会发现，它带来的问题不比解决的问题少：重复、乱序、积压、丢消息，每个都有应对方案，每个都要做对才行。引入之前先想清楚，这个异步解耦的收益到底值不值得养这套机制。",[11,77,69],{},[11,79,72],{},[37,81,82],{"id":82},"再补充几句",[11,84,85],{},"过程中也反复体会到取舍的本质：没有完美的方案，只有当下约束下最合适的方案。把约束写清楚，方案的选择题就变成了证明题，这也是为什么我习惯先列约束再谈方案，顺序反了全是无效争论。",[11,87,88],{},"想想还是补一段：任何习惯的养成都绕不开启动成本，最有效的办法是把启动成本降到接近零。想跑就把鞋放门口，想写就把文档开着置顶，环境准备到位了，行动只是顺水推舟。",[11,90,91],{},"从更高的视角看，这类问题都有一个共同结构：短期收益和长期收益打架。短期的诱惑总是具体而生动，长期的回报抽象而遥远，赢家通常是那些把长期目标拆成短期可感的小奖励的人。",[11,93,94],{},"讲个题外话，做这类事情的时候最好留个记录的习惯，当时的判断依据比结果更珍贵。结果好可能只是运气好，把决策过程记下来，好运才可能被复制，坏运才可能被规避。",[37,96,97],{"id":97},"小结",[11,99,100],{},"写完这篇正好十一点，窗外安静下来，这种时候码字效率出奇地高，就是第二天起床靠毅力。",[11,102,103],{},"这篇写得断断续续，总算收尾，下篇见。",{"title":15,"searchDepth":16,"depth":17,"links":105},[106,107,108,109,110,111],{"id":39,"depth":16,"text":39},{"id":48,"depth":16,"text":48},{"id":54,"depth":16,"text":54},{"id":66,"depth":16,"text":66},{"id":82,"depth":16,"text":82},{"id":97,"depth":16,"text":97},[113],"消息队列","2025-05-25",false,{"excerpt":117},{"type":8,"value":118},[119],[11,120,35],{},"\u002Fposts\u002Fmq\u002Fmq-idempotent",401400,{"title":29,"description":35},"posts\u002Fmq\u002Fmq-idempotent",[126,127],"MQ","幂等",[129],"mq",1338,"94v6_KHVt__VUpkASPnL1jZJs64L5ASTW6ujg2Hm7wE",{"prev":133,"next":136},{"path":134,"title":135},"\u002Fposts\u002Fmq\u002Fmq-backlog-6","消息积压的应急与根治（六）",{"path":137,"title":138},"\u002Fposts\u002Fmq\u002Fmq-idempotent-2","重复消费与幂等设计（二）",[140,149,179],{"id":5,"title":6,"body":141,"createdAt":19,"description":13,"extension":20,"meta":147,"navigation":22,"path":23,"seo":148,"stem":25,"__hash__":26},{"type":8,"value":142,"toc":145},[143],[11,144,13],{},{"title":15,"searchDepth":16,"depth":17,"links":146},[],{},{"description":13},{"id":150,"title":151,"body":152,"createdAt":172,"description":173,"extension":20,"meta":174,"navigation":22,"path":175,"seo":176,"stem":177,"__hash__":178},"notes\u002Fnotes\u002F2026-11-14-1.md","2026 11 14 1",{"type":8,"value":153,"toc":170},[154],[11,155,156,157,161,162,169],{},"站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 ",[158,159,160],"strong",{},"Markdown","，写链接也不用到编辑器：",[163,164,168],"a",{"href":165,"rel":166},"https:\u002F\u002Fcontent.nuxt.com",[167],"nofollow","Nuxt Content","。",{"title":15,"searchDepth":16,"depth":17,"links":171},[],"2026-11-14","站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 Markdown，写链接也不用到编辑器：Nuxt Content。",{},"\u002Fnotes\u002F2026-11-14-1",{"description":173},"notes\u002F2026-11-14-1","LLJX_RKU7cgpT6aHw4DZWUZNQ_G_UzELWPKbksJvzfs",{"id":180,"title":181,"body":182,"createdAt":197,"description":198,"extension":20,"meta":199,"navigation":22,"path":200,"seo":201,"stem":202,"__hash__":203},"notes\u002Fnotes\u002F2026-11-14-2.md","2026 11 14 2",{"type":8,"value":183,"toc":195},[184],[11,185,186,190,191,194],{},[187,188,189],"code",{},"readPixels"," 读不到内容不是 bug，是 ",[187,192,193],{},"preserveDrawingBuffer"," 默认关闭——帧提交后缓冲即被清空。",{"title":15,"searchDepth":16,"depth":17,"links":196},[],"2026-11-13","readPixels 读不到内容不是 bug，是 preserveDrawingBuffer 默认关闭——帧提交后缓冲即被清空。",{},"\u002Fnotes\u002F2026-11-14-2",{"description":198},"notes\u002F2026-11-14-2","i7xWqq2eNoU_seSbLQjqlB9gE51fM-PVLUEYCHBkOA4",1795707446325]