[{"data":1,"prerenderedAt":204},["ShallowReactive",2],{"notes-latest-1":3,"post:\u002Fposts\u002Fgolang\u002Fgo-cli-tool-5":27,"surround:\u002Fposts\u002Fgolang\u002Fgo-cli-tool-5":132,"notes-latest-3":139},[4],{"id":5,"title":6,"body":7,"createdAt":19,"description":13,"extension":20,"meta":21,"navigation":22,"path":23,"seo":24,"stem":25,"__hash__":26},"notes\u002Fnotes\u002F2026-11-14-1-2.md","2026 11 14 1 2",{"type":8,"value":9,"toc":14},"minimark",[10],[11,12,13],"p",{},"站点上线了「随笔」：支持一个文件多个随笔",{"title":15,"searchDepth":16,"depth":17,"links":18},"",2,3,[],"2026-11-17","md",{},true,"\u002Fnotes\u002F2026-11-14-1-2",{"description":13},"notes\u002F2026-11-14-1-2","hDP9fvaunHzVrZQ6QifuOtj9VrqbxlPb_52KE5wSjD0",{"id":28,"title":29,"author":30,"body":31,"categories":113,"comment":22,"cover":30,"createdAt":115,"description":35,"draft":116,"extension":20,"meta":117,"navigation":22,"path":122,"readingTime":123,"recommend":116,"seo":124,"series":30,"stem":125,"tags":126,"top":116,"topics":128,"updatedAt":30,"words":130,"__hash__":131},"posts\u002Fposts\u002Fgolang\u002Fgo-cli-tool-5.md","用 Go 写命令行小工具（五）",null,{"type":8,"value":32,"toc":105},[33,36,41,44,47,50,53,56,59,62,65,68,71,74,77,79,81,84,87,90,93,96,99,102],[11,34,35],{},"想写这个话题很久了，一直没找到合适的角度，这篇先把核心的部分讲清楚，细节以后再展开。",[37,38,40],"h2",{"id":39},"为什么用-go-写工具","为什么用 Go 写工具",[11,42,43],{},"工作里经常有些重复的小活：批量改配置、解析日志、生成代码骨架。这类活我现在的首选是 Go 写个小工具，理由很实际：交叉编译一行命令出 Windows 和 Linux 的单文件可执行，扔给同事不需要装运行时，这件事 Python 和 Java 都做不到这么干净。",[11,45,46],{},"生态也合适，cobra 管命令结构，flag 处理参数，标准库的文件和字符串处理足够覆盖八成需求。写一个两三百行的小工具通常一晚上，省下来的时间远超投入。",[37,48,49],{"id":49},"设计小建议",[11,51,52],{},"几个小建议：输入输出遵守 Unix 习惯，读标准输入、写标准输出，支持管道串联，工具的组合能力会超出预期；错误处理不吞，exit code 区分成败，方便脚本调用；把核心逻辑和命令行解析分层，后续要包装成 HTTP 服务也不用重写。我陆续攒了十来个这样的小工具放仓库里，回看它们像是这些年工作琐碎需求的化石层，还挺有意思。",[37,54,55],{"id":55},"过程中的两个坑",[11,57,58],{},"单元测试月底跑挂了，因为断言里依赖系统当前日期。注入 Clock 之后再测，时间随意控制。第一次遇到这种问题觉得很玄学，理解了之后觉得这是依赖注入最生动的教学案例。",[11,60,61],{},"grep 中文关键词死活匹配不上，最后确认是文件编码。iconv 转一道再查，两分钟的事排查了半小时，处理日志前先看编码，这个习惯值得保持。",[11,63,64],{},"磁盘告警，日志把盘写满了。给应用日志配上 logrotate 加上保留天数，再顺手把历史日志清了。存储这种东西，没有监控告警之前，所有人都以为它不会满。",[37,66,67],{"id":67},"延伸几句",[11,69,70],{},"从 Java 视角看 Go，最大的观念转变是“少即是多”。没有继承、没有异常、关键字只有二十几个，初看觉得简陋，用久了才发现这种约束把代码风格统一得很好，接手别人的 Go 项目远比接手 Java 项目轻松。",[11,72,73],{},"Go 的工程实践里有几个值得借鉴的习惯：错误显式处理让失败路径一目了然，接口的隐式实现让依赖方向更自由，标准库的覆盖面让第三方依赖保持在很少的数量。这些设计取舍背后是同一套价值观，值得带着欣赏的眼光去体会。",[11,75,76],{},"学习一门新语言的最好方式还是写一个完整的小东西，哪怕很小。教程看得再多，并发竞争、错误传播、项目组织这些问题只有在真实项目里才会一个个冒出来，解决它们的过程才是真正的学习。",[11,78,70],{},[11,80,73],{},[37,82,83],{"id":83},"又想到一些",[11,85,86],{},"另外觉得这件事里有个普遍适用的规律：复杂度不会消失，只会转移。你省掉的每一步设计，最后都会在排查、扩容或者交接的某个时刻加倍还回来。所谓好的方案，不过是把复杂度放到了值得的位置。",[11,88,89],{},"回顾这个过程，最大的教训其实是克制。可选项永远比需要的多，每个新方案看起来都比现状好一点，但都加上之后，系统就成了没人看得懂的拼贴画。做减法的判断比做加法的胆子更值钱。",[11,91,92],{},"这种事急不来，和锻炼身体是一个道理：练一天没变化，练三个月身体自己会说话。技术积累也是这样，每天一点，回过头看的时候差距已经拉开了，只是身在其中感觉不到而已。",[11,94,95],{},"想到一个问题：为什么同样的事情，不同的人做出来差别那么大。后来觉得答案在于对边界的处理，正常路径人人会写，边界和异常的处理习惯才是拉开差距的地方。做事和写代码一样，细节的密度决定成品的质量。",[37,97,98],{"id":98},"小结",[11,100,101],{},"周末在家调这个，家里领导问我看到底有什么乐趣，认真想了想，还真描述不上来，大概就是那种东西被自己理顺的舒服。",[11,103,104],{},"这篇就写到这，希望对你有点参考价值。",{"title":15,"searchDepth":16,"depth":17,"links":106},[107,108,109,110,111,112],{"id":39,"depth":16,"text":40},{"id":49,"depth":16,"text":49},{"id":55,"depth":16,"text":55},{"id":67,"depth":16,"text":67},{"id":83,"depth":16,"text":83},{"id":98,"depth":16,"text":98},[114],"Go","2023-08-28",false,{"excerpt":118},{"type":8,"value":119},[120],[11,121,35],{},"\u002Fposts\u002Fgolang\u002Fgo-cli-tool-5",404400,{"title":29,"description":35},"posts\u002Fgolang\u002Fgo-cli-tool-5",[114,127],"工具",[129],"golang",1348,"qEMd7H3XSGtThEDeM8a43m8_GIHDE7bHNfuDh6VOHyQ",{"prev":133,"next":136},{"path":134,"title":135},"\u002Fposts\u002Fgolang\u002Fgo-cli-tool-4","用 Go 写命令行小工具（四）",{"path":137,"title":138},"\u002Fposts\u002Fgolang\u002Fgo-cli-tool-6","用 Go 写命令行小工具（六）",[140,149,179],{"id":5,"title":6,"body":141,"createdAt":19,"description":13,"extension":20,"meta":147,"navigation":22,"path":23,"seo":148,"stem":25,"__hash__":26},{"type":8,"value":142,"toc":145},[143],[11,144,13],{},{"title":15,"searchDepth":16,"depth":17,"links":146},[],{},{"description":13},{"id":150,"title":151,"body":152,"createdAt":172,"description":173,"extension":20,"meta":174,"navigation":22,"path":175,"seo":176,"stem":177,"__hash__":178},"notes\u002Fnotes\u002F2026-11-14-1.md","2026 11 14 1",{"type":8,"value":153,"toc":170},[154],[11,155,156,157,161,162,169],{},"站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 ",[158,159,160],"strong",{},"Markdown","，写链接也不用到编辑器：",[163,164,168],"a",{"href":165,"rel":166},"https:\u002F\u002Fcontent.nuxt.com",[167],"nofollow","Nuxt Content","。",{"title":15,"searchDepth":16,"depth":17,"links":171},[],"2026-11-14","站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 Markdown，写链接也不用到编辑器：Nuxt Content。",{},"\u002Fnotes\u002F2026-11-14-1",{"description":173},"notes\u002F2026-11-14-1","LLJX_RKU7cgpT6aHw4DZWUZNQ_G_UzELWPKbksJvzfs",{"id":180,"title":181,"body":182,"createdAt":197,"description":198,"extension":20,"meta":199,"navigation":22,"path":200,"seo":201,"stem":202,"__hash__":203},"notes\u002Fnotes\u002F2026-11-14-2.md","2026 11 14 2",{"type":8,"value":183,"toc":195},[184],[11,185,186,190,191,194],{},[187,188,189],"code",{},"readPixels"," 读不到内容不是 bug，是 ",[187,192,193],{},"preserveDrawingBuffer"," 默认关闭——帧提交后缓冲即被清空。",{"title":15,"searchDepth":16,"depth":17,"links":196},[],"2026-11-13","readPixels 读不到内容不是 bug，是 preserveDrawingBuffer 默认关闭——帧提交后缓冲即被清空。",{},"\u002Fnotes\u002F2026-11-14-2",{"description":198},"notes\u002F2026-11-14-2","i7xWqq2eNoU_seSbLQjqlB9gE51fM-PVLUEYCHBkOA4",1795309540517]