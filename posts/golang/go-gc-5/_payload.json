[{"data":1,"prerenderedAt":203},["ShallowReactive",2],{"notes-latest-1":3,"post:\u002Fposts\u002Fgolang\u002Fgo-gc-5":27,"surround:\u002Fposts\u002Fgolang\u002Fgo-gc-5":131,"notes-latest-3":138},[4],{"id":5,"title":6,"body":7,"createdAt":19,"description":13,"extension":20,"meta":21,"navigation":22,"path":23,"seo":24,"stem":25,"__hash__":26},"notes\u002Fnotes\u002F2026-11-14-1-2.md","2026 11 14 1 2",{"type":8,"value":9,"toc":14},"minimark",[10],[11,12,13],"p",{},"站点上线了「随笔」：支持一个文件多个随笔",{"title":15,"searchDepth":16,"depth":17,"links":18},"",2,3,[],"2026-11-17","md",{},true,"\u002Fnotes\u002F2026-11-14-1-2",{"description":13},"notes\u002F2026-11-14-1-2","hDP9fvaunHzVrZQ6QifuOtj9VrqbxlPb_52KE5wSjD0",{"id":28,"title":29,"author":30,"body":31,"categories":112,"comment":22,"cover":30,"createdAt":114,"description":35,"draft":115,"extension":20,"meta":116,"navigation":22,"path":121,"readingTime":122,"recommend":115,"seo":123,"series":30,"stem":124,"tags":125,"top":115,"topics":127,"updatedAt":30,"words":129,"__hash__":130},"posts\u002Fposts\u002Fgolang\u002Fgo-gc-5.md","Go 的 GC 演进读后感（五）",null,{"type":8,"value":32,"toc":104},[33,36,40,43,46,49,52,55,58,61,64,67,70,73,76,78,80,83,86,89,92,95,98,101],[11,34,35],{},"趁热打铁，刚踩完坑就来记录，趁着记忆最新鲜，把当时的判断和后面的验证都写下来。",[37,38,39],"h2",{"id":39},"一路怎么走来",[11,41,42],{},"Go 的 GC 这十年的演进是个好故事：早期的 STW 以百毫秒计，1.8 之后换成三色标记加混合写屏障，STW 压到微秒级，用户基本无感。整个优化的方向很明确，不是追求吞吐极限，而是压停顿，这与它的服务端定位一致。",[11,44,45],{},"和 JVM 对比着看很有意思：Java 的分代假设在 Go 里被放弃了，因为逃逸分析把大量对象直接分配在栈上，堆上的对象寿命分布不再明显分代，于是 Go 选择不分代加并发标记清除，配合调整 GOGC 比例控制回收时机。同一个问题，两种语言的答案截然不同，根源在各自的工作负载。",[37,47,48],{"id":48},"对写代码的影响",[11,50,51],{},"写 Go 时的内存意识因此和 Java 不同：栈上分配意味着小对象很便宜，返回指针不必焦虑；sync.Pool 用于复用高频临时对象；预分配 slice 和 map 的容量能显著减少扩容拷贝。用 pprof 看分配热点，比背优化清单更有针对性。多读读两个生态的 GC 文档，对内存模型的理解会整体上一个台阶。",[37,53,54],{"id":54},"记两个小问题",[11,56,57],{},"容器里日志时间和本地对不上，查了半天是时区，默认 UTC。在环境变量里把 TZ 设成 Asia\u002FShanghai，顺带把 JDK 参数也统一了，从此日志排查不用再做心算换算。",[11,59,60],{},"Feign 的超时配置怎么改都不生效，最后发现是配置前缀少写了一层，配置根本没被读到。教训是改完配置要打印生效值确认，光看配置文件自我感觉良好是不行的。",[11,62,63],{},"Kafka 某个分区消费延迟特别高，看数据发现某大客户的消息占了总量一半，按 userId 分区全进了一个分区。大客户单独走一个 topic 才解决，倾斜问题在哪个中间件里都一样。",[37,65,66],{"id":66},"顺便一提",[11,68,69],{},"Go 的工程实践里有几个值得借鉴的习惯：错误显式处理让失败路径一目了然，接口的隐式实现让依赖方向更自由，标准库的覆盖面让第三方依赖保持在很少的数量。这些设计取舍背后是同一套价值观，值得带着欣赏的眼光去体会。",[11,71,72],{},"学习一门新语言的最好方式还是写一个完整的小东西，哪怕很小。教程看得再多，并发竞争、错误传播、项目组织这些问题只有在真实项目里才会一个个冒出来，解决它们的过程才是真正的学习。",[11,74,75],{},"从 Java 视角看 Go，最大的观念转变是“少即是多”。没有继承、没有异常、关键字只有二十几个，初看觉得简陋，用久了才发现这种约束把代码风格统一得很好，接手别人的 Go 项目远比接手 Java 项目轻松。",[11,77,69],{},[11,79,72],{},[37,81,82],{"id":82},"另外记几笔",[11,84,85],{},"忍不住再夸一下记录的力量，上周刚整理的笔记，这次直接翻出来就用，十分钟解决了当时花一下午的问题。给自己留下的每一份笔记，都是寄给未来的快递，寄件人签收时才觉得真香。",[11,87,88],{},"最后聊点感受：做技术这些年，越来越觉得最好的状态是既投入又抽离。投入是把事情做好，抽离是时不时跳出来看看方向对不对，两者缺一，要么辛苦没产出，要么轻松跑偏路。",[11,90,91],{},"写着写着想到，很多技术选择本质上都是在回答同一个问题：这个方案在出问题的时候是什么样子。不出问题的方案人人都写得出来，区分度全在故障时刻的表现。多想一层失败路径，很多纠结就自动有了答案。",[11,93,94],{},"这类经验在文档里通常只有一行字，背后的排查却是一整个下午。技术工作的大部分时间都花在这些不会写进简历的细节里，所以这些细节才更需要有人写出来，哪怕只是给未来某一天忘了的自己。",[37,96,97],{"id":97},"最后",[11,99,100],{},"中午和同事为这个方案争了半天，下午各自写了个小 demo 验证，最后他赢了，输得心服口服。",[11,102,103],{},"先记到这里，后面有新的进展再来补充。",{"title":15,"searchDepth":16,"depth":17,"links":105},[106,107,108,109,110,111],{"id":39,"depth":16,"text":39},{"id":48,"depth":16,"text":48},{"id":54,"depth":16,"text":54},{"id":66,"depth":16,"text":66},{"id":82,"depth":16,"text":82},{"id":97,"depth":16,"text":97},[113],"Go","2025-10-13",false,{"excerpt":117},{"type":8,"value":118},[119],[11,120,35],{},"\u002Fposts\u002Fgolang\u002Fgo-gc-5",406500,{"title":29,"description":35},"posts\u002Fgolang\u002Fgo-gc-5",[113,126],"GC",[128],"golang",1355,"dJZb5er68o34E9CitHG2cx7ZiE2spNXyxIasvcBop4w",{"prev":132,"next":135},{"path":133,"title":134},"\u002Fposts\u002Fgolang\u002Fgo-gc-4","Go 的 GC 演进读后感（四）",{"path":136,"title":137},"\u002Fposts\u002Fjava\u002Faqs-note","AQS 读源码的思路",[139,148,178],{"id":5,"title":6,"body":140,"createdAt":19,"description":13,"extension":20,"meta":146,"navigation":22,"path":23,"seo":147,"stem":25,"__hash__":26},{"type":8,"value":141,"toc":144},[142],[11,143,13],{},{"title":15,"searchDepth":16,"depth":17,"links":145},[],{},{"description":13},{"id":149,"title":150,"body":151,"createdAt":171,"description":172,"extension":20,"meta":173,"navigation":22,"path":174,"seo":175,"stem":176,"__hash__":177},"notes\u002Fnotes\u002F2026-11-14-1.md","2026 11 14 1",{"type":8,"value":152,"toc":169},[153],[11,154,155,156,160,161,168],{},"站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 ",[157,158,159],"strong",{},"Markdown","，写链接也不用到编辑器：",[162,163,167],"a",{"href":164,"rel":165},"https:\u002F\u002Fcontent.nuxt.com",[166],"nofollow","Nuxt Content","。",{"title":15,"searchDepth":16,"depth":17,"links":170},[],"2026-11-14","站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 Markdown，写链接也不用到编辑器：Nuxt Content。",{},"\u002Fnotes\u002F2026-11-14-1",{"description":172},"notes\u002F2026-11-14-1","LLJX_RKU7cgpT6aHw4DZWUZNQ_G_UzELWPKbksJvzfs",{"id":179,"title":180,"body":181,"createdAt":196,"description":197,"extension":20,"meta":198,"navigation":22,"path":199,"seo":200,"stem":201,"__hash__":202},"notes\u002Fnotes\u002F2026-11-14-2.md","2026 11 14 2",{"type":8,"value":182,"toc":194},[183],[11,184,185,189,190,193],{},[186,187,188],"code",{},"readPixels"," 读不到内容不是 bug，是 ",[186,191,192],{},"preserveDrawingBuffer"," 默认关闭——帧提交后缓冲即被清空。",{"title":15,"searchDepth":16,"depth":17,"links":195},[],"2026-11-13","readPixels 读不到内容不是 bug，是 preserveDrawingBuffer 默认关闭——帧提交后缓冲即被清空。",{},"\u002Fnotes\u002F2026-11-14-2",{"description":197},"notes\u002F2026-11-14-2","i7xWqq2eNoU_seSbLQjqlB9gE51fM-PVLUEYCHBkOA4",1795275200536]