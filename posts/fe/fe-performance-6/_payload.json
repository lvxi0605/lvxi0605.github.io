[{"data":1,"prerenderedAt":204},["ShallowReactive",2],{"notes-latest-1":3,"post:\u002Fposts\u002Ffe\u002Ffe-performance-6":27,"surround:\u002Fposts\u002Ffe\u002Ffe-performance-6":132,"notes-latest-3":139},[4],{"id":5,"title":6,"body":7,"createdAt":19,"description":13,"extension":20,"meta":21,"navigation":22,"path":23,"seo":24,"stem":25,"__hash__":26},"notes\u002Fnotes\u002F2026-11-14-1-2.md","2026 11 14 1 2",{"type":8,"value":9,"toc":14},"minimark",[10],[11,12,13],"p",{},"站点上线了「随笔」：支持一个文件多个随笔",{"title":15,"searchDepth":16,"depth":17,"links":18},"",2,3,[],"2026-11-17","md",{},true,"\u002Fnotes\u002F2026-11-14-1-2",{"description":13},"notes\u002F2026-11-14-1-2","hDP9fvaunHzVrZQ6QifuOtj9VrqbxlPb_52KE5wSjD0",{"id":28,"title":29,"author":30,"body":31,"categories":112,"comment":22,"cover":30,"createdAt":114,"description":35,"draft":115,"extension":20,"meta":116,"navigation":22,"path":121,"readingTime":122,"recommend":115,"seo":123,"series":30,"stem":124,"tags":125,"top":115,"topics":128,"updatedAt":30,"words":130,"__hash__":131},"posts\u002Fposts\u002Ffe\u002Ffe-performance-6.md","前端性能优化的检查清单（六）",null,{"type":8,"value":32,"toc":104},[33,36,40,43,46,49,52,55,58,61,64,67,70,73,76,78,80,83,86,89,92,95,98,101],[11,34,35],{},"长话短说，这篇就是一次完整的记录，从问题怎么来的，到最后方案怎么定，中间的弯路也都保留。",[37,38,39],"h2",{"id":39},"加载阶段",[11,41,42],{},"加载阶段的优化清单：静态资源上 CDN、开启压缩传输、图片用合适格式并按需加载、关键 CSS 内联、非关键脚本 defer 或异步加载、路由懒加载把首屏用不到的代码挪走。这些做完，首屏时间通常有肉眼可见的改善，而且基本都是配置层面的改动，性价比极高。",[11,44,45],{},"度量先行这个原则在这里尤其重要：Lighthouse 和 performance 面板先跑一遍基线，优化前后的数字对比着看，不然你以为的优化可能只是心理安慰。",[37,47,48],{"id":48},"运行阶段",[11,50,51],{},"运行阶段的重点是大列表和频繁交互：长列表用虚拟滚动，只渲染可视区；高频事件做防抖节流；大量 DOM 更新考虑批量处理；动画优先用 transform 和 opacity，避开触发重排的属性。还有缓存策略，合理的 HTTP 缓存配 Service Worker 能让二次访问快到瞬间打开。优化是个持续的过程，把性能预算写进开发约定，新功能上线前过一遍检查，比事后救火体面得多。",[37,53,54],{"id":54},"顺手记两个坑",[11,56,57],{},"Feign 的超时配置怎么改都不生效，最后发现是配置前缀少写了一层，配置根本没被读到。教训是改完配置要打印生效值确认，光看配置文件自我感觉良好是不行的。",[11,59,60],{},"Kafka 某个分区消费延迟特别高，看数据发现某大客户的消息占了总量一半，按 userId 分区全进了一个分区。大客户单独走一个 topic 才解决，倾斜问题在哪个中间件里都一样。",[11,62,63],{},"WebSocket 上线之后频繁断连，本地好好的，一上 Nginx 就出问题。代理默认不转发 Upgrade 头，补上之后世界清净了，这类中间件默认行为，不踩一次真的想不到。",[37,65,66],{"id":66},"一点延伸",[11,68,69],{},"样式和交互的还原度问题，多数根因在设计稿和实现之间缺少约定：间距系统、颜色变量、组件规范，这些设计系统的基本功建起来之后，页面的开发速度和一致性都会上一个台阶。",[11,71,72],{},"后端视角看前端这几年，最大的感受是前端工程化的成熟度已经不输后端：组件化、状态管理、构建优化、类型系统，该有的都有。所以“前端简单”的刻板印象早该更新了，做好不容易这件事在前端同样成立。",[11,74,75],{},"前后端协作的效率瓶颈经常出在接口约定上，先写接口文档再并行开发，比后端写完再通知前端快得多。类型定义共享、mock 数据同步生成，这些协作上的小投入，回报名远超想象。",[11,77,69],{},[11,79,72],{},[37,81,82],{"id":82},"再补充几句",[11,84,85],{},"顺带聊聊方法论：遇到不熟悉的领域，我的习惯是先把最小闭环跑通，哪怕每一步都很粗糙。跑通之后再逐段替换成正经实现，过程中每一步都有可运行的版本。这个思路在工作和生活里都屡试不爽，比憋大招的成功率高得多。",[11,87,88],{},"另外觉得这件事里有个普遍适用的规律：复杂度不会消失，只会转移。你省掉的每一步设计，最后都会在排查、扩容或者交接的某个时刻加倍还回来。所谓好的方案，不过是把复杂度放到了值得的位置。",[11,90,91],{},"回顾这个过程，最大的教训其实是克制。可选项永远比需要的多，每个新方案看起来都比现状好一点，但都加上之后，系统就成了没人看得懂的拼贴画。做减法的判断比做加法的胆子更值钱。",[11,93,94],{},"这种事急不来，和锻炼身体是一个道理：练一天没变化，练三个月身体自己会说话。技术积累也是这样，每天一点，回过头看的时候差距已经拉开了，只是身在其中感觉不到而已。",[37,96,97],{"id":97},"小结",[11,99,100],{},"周末在家调这个，家里领导问我看到底有什么乐趣，认真想了想，还真描述不上来，大概就是那种东西被自己理顺的舒服。",[11,102,103],{},"这篇就先这样，想到了什么再回来补。",{"title":15,"searchDepth":16,"depth":17,"links":105},[106,107,108,109,110,111],{"id":39,"depth":16,"text":39},{"id":48,"depth":16,"text":48},{"id":54,"depth":16,"text":54},{"id":66,"depth":16,"text":66},{"id":82,"depth":16,"text":82},{"id":97,"depth":16,"text":97},[113],"前端","2026-07-15",false,{"excerpt":117},{"type":8,"value":118},[119],[11,120,35],{},"\u002Fposts\u002Ffe\u002Ffe-performance-6",394500,{"title":29,"description":35},"posts\u002Ffe\u002Ffe-performance-6",[126,127],"性能","优化",[129],"fe",1315,"rDHOa7VyiD--R8mWRNdY7tgg--9OXlMtQFK6JIG9f1Y",{"prev":133,"next":136},{"path":134,"title":135},"\u002Fposts\u002Ffe\u002Ffe-performance-5","前端性能优化的检查清单（五）",{"path":137,"title":138},"\u002Fposts\u002Ffe\u002Fnuxt-migration","博客升级 Nuxt4 的迁移记录",[140,149,179],{"id":5,"title":6,"body":141,"createdAt":19,"description":13,"extension":20,"meta":147,"navigation":22,"path":23,"seo":148,"stem":25,"__hash__":26},{"type":8,"value":142,"toc":145},[143],[11,144,13],{},{"title":15,"searchDepth":16,"depth":17,"links":146},[],{},{"description":13},{"id":150,"title":151,"body":152,"createdAt":172,"description":173,"extension":20,"meta":174,"navigation":22,"path":175,"seo":176,"stem":177,"__hash__":178},"notes\u002Fnotes\u002F2026-11-14-1.md","2026 11 14 1",{"type":8,"value":153,"toc":170},[154],[11,155,156,157,161,162,169],{},"站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 ",[158,159,160],"strong",{},"Markdown","，写链接也不用到编辑器：",[163,164,168],"a",{"href":165,"rel":166},"https:\u002F\u002Fcontent.nuxt.com",[167],"nofollow","Nuxt Content","。",{"title":15,"searchDepth":16,"depth":17,"links":171},[],"2026-11-14","站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 Markdown，写链接也不用到编辑器：Nuxt Content。",{},"\u002Fnotes\u002F2026-11-14-1",{"description":173},"notes\u002F2026-11-14-1","LLJX_RKU7cgpT6aHw4DZWUZNQ_G_UzELWPKbksJvzfs",{"id":180,"title":181,"body":182,"createdAt":197,"description":198,"extension":20,"meta":199,"navigation":22,"path":200,"seo":201,"stem":202,"__hash__":203},"notes\u002Fnotes\u002F2026-11-14-2.md","2026 11 14 2",{"type":8,"value":183,"toc":195},[184],[11,185,186,190,191,194],{},[187,188,189],"code",{},"readPixels"," 读不到内容不是 bug，是 ",[187,192,193],{},"preserveDrawingBuffer"," 默认关闭——帧提交后缓冲即被清空。",{"title":15,"searchDepth":16,"depth":17,"links":196},[],"2026-11-13","readPixels 读不到内容不是 bug，是 preserveDrawingBuffer 默认关闭——帧提交后缓冲即被清空。",{},"\u002Fnotes\u002F2026-11-14-2",{"description":198},"notes\u002F2026-11-14-2","i7xWqq2eNoU_seSbLQjqlB9gE51fM-PVLUEYCHBkOA4",1795273149326]