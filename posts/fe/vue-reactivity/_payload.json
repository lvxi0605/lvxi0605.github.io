[{"data":1,"prerenderedAt":206},["ShallowReactive",2],{"notes-latest-1":3,"post:\u002Fposts\u002Ffe\u002Fvue-reactivity":27,"surround:\u002Fposts\u002Ffe\u002Fvue-reactivity":134,"notes-latest-3":141},[4],{"id":5,"title":6,"body":7,"createdAt":19,"description":13,"extension":20,"meta":21,"navigation":22,"path":23,"seo":24,"stem":25,"__hash__":26},"notes\u002Fnotes\u002F2026-11-14-1-2.md","2026 11 14 1 2",{"type":8,"value":9,"toc":14},"minimark",[10],[11,12,13],"p",{},"站点上线了「随笔」：支持一个文件多个随笔",{"title":15,"searchDepth":16,"depth":17,"links":18},"",2,3,[],"2026-11-17","md",{},true,"\u002Fnotes\u002F2026-11-14-1-2",{"description":13},"notes\u002F2026-11-14-1-2","hDP9fvaunHzVrZQ6QifuOtj9VrqbxlPb_52KE5wSjD0",{"id":28,"title":29,"author":30,"body":31,"categories":114,"comment":22,"cover":30,"createdAt":116,"description":35,"draft":117,"extension":20,"meta":118,"navigation":22,"path":123,"readingTime":124,"recommend":117,"seo":125,"series":30,"stem":126,"tags":127,"top":117,"topics":130,"updatedAt":30,"words":132,"__hash__":133},"posts\u002Fposts\u002Ffe\u002Fvue-reactivity.md","Vue3 响应式原理笔记",null,{"type":8,"value":32,"toc":106},[33,36,41,44,47,51,54,57,60,63,66,69,72,75,78,80,82,85,88,91,94,97,100,103],[11,34,35],{},"这是一篇偏流水账的记录，重点不在结论，在过程和当时的判断依据，看官自行取用。",[37,38,40],"h2",{"id":39},"从-defineproperty-到-proxy","从 defineProperty 到 Proxy",[11,42,43],{},"Vue2 的响应式靠 Object.defineProperty 逐个劫持属性，天生的缺陷是新增属性和数组下标赋值感知不到，于是有了 $set 这种补丁 API。Vue3 换成 Proxy，代理整个对象，增删属性、数组操作、甚至 Map Set 都能拦截，那些补丁和限制一并消失，这是 Vue3 响应式最实在的进步。",[11,45,46],{},"机制上 track 和 trigger 两个动作撑起了整个系统：渲染或 computed 执行时读取属性，触发 track 把依赖收集进一个以属性为键的集合；属性被改写时 trigger 找到集合里的副作用函数重新执行。依赖关系是运行时动态建立的，这也是为什么在 if 分支里读不读属性会影响更新。",[37,48,50],{"id":49},"ref-与-reactive","ref 与 reactive",[11,52,53],{},"ref 和 reactive 的区别是新手必问：reactive 只能包对象类型，解构后失去响应性；ref 通过 value 访问，基本类型也支持，跨函数传递和组合式函数里基本都用 ref。理解了代理的机制，这些规则就不用死记了。写多了之后我的建议是：状态定义从 ref 开始，组合式函数返回值全部 ref 化，代码的可预测性会好很多。",[37,55,56],{"id":56},"顺手记两个坑",[11,58,59],{},"多实例部署之后定时任务重复执行，同一个数据处理了两遍。加分布式锁当然可以，最后偷懒换了调度平台的分片路由，一行配置解决，前提是任务本身可以按分片拆。",[11,61,62],{},"遇到过消息重复消费，原因是网络抖动触发重试，业务库里多了脏数据。消费端加幂等表之后彻底解决，结论很简单：所有 MQ 的幂等都得消费端自己做，寄希望于恰好一次是不现实的。",[11,64,65],{},"接口偶发超时，压测环境复现不了，后来发现是连接池的 maxPoolSize 用了默认值，高峰期全在等连接。调大之后看监控，等待队列直接归零，这种参数还是得按自己的流量压一遍。",[37,67,68],{"id":68},"一点延伸",[11,70,71],{},"样式和交互的还原度问题，多数根因在设计稿和实现之间缺少约定：间距系统、颜色变量、组件规范，这些设计系统的基本功建起来之后，页面的开发速度和一致性都会上一个台阶。",[11,73,74],{},"后端视角看前端这几年，最大的感受是前端工程化的成熟度已经不输后端：组件化、状态管理、构建优化、类型系统，该有的都有。所以“前端简单”的刻板印象早该更新了，做好不容易这件事在前端同样成立。",[11,76,77],{},"前后端协作的效率瓶颈经常出在接口约定上，先写接口文档再并行开发，比后端写完再通知前端快得多。类型定义共享、mock 数据同步生成，这些协作上的小投入，回报名远超想象。",[11,79,71],{},[11,81,74],{},[37,83,84],{"id":84},"再补充几句",[11,86,87],{},"然后想说，承认不懂是这行的美德。这次遇到不懂的地方，老老实实补了两天的课，比硬着头皮往上糊的方案强太多。不懂装懂的代价从来不会消失，只是延期，还带利息。",[11,89,90],{},"平衡感很重要的一件事：投入和收益的比例。所有优化都值得先问一句，这件事的收益上限是多少，值多少投入。无限打磨一个低价值的东西是工程师最常见的温柔陷阱，包括我自己在内。",[11,92,93],{},"忍不住再夸一下记录的力量，上周刚整理的笔记，这次直接翻出来就用，十分钟解决了当时花一下午的问题。给自己留下的每一份笔记，都是寄给未来的快递，寄件人签收时才觉得真香。",[11,95,96],{},"最后聊点感受：做技术这些年，越来越觉得最好的状态是既投入又抽离。投入是把事情做好，抽离是时不时跳出来看看方向对不对，两者缺一，要么辛苦没产出，要么轻松跑偏路。",[37,98,99],{"id":99},"最后",[11,101,102],{},"中午和同事为这个方案争了半天，下午各自写了个小 demo 验证，最后他赢了，输得心服口服。",[11,104,105],{},"这篇就先这样，想到了什么再回来补。",{"title":15,"searchDepth":16,"depth":17,"links":107},[108,109,110,111,112,113],{"id":39,"depth":16,"text":40},{"id":49,"depth":16,"text":50},{"id":56,"depth":16,"text":56},{"id":68,"depth":16,"text":68},{"id":84,"depth":16,"text":84},{"id":99,"depth":16,"text":99},[115],"前端","2024-07-08",false,{"excerpt":119},{"type":8,"value":120},[121],[11,122,35],{},"\u002Fposts\u002Ffe\u002Fvue-reactivity",392400,{"title":29,"description":35},"posts\u002Ffe\u002Fvue-reactivity",[128,129],"Vue","响应式",[131],"fe",1308,"ZV4kJcN6lbkCeqybv4EGG2r3xXhTv1UwFY5y0LzKBQY",{"prev":135,"next":138},{"path":136,"title":137},"\u002Fposts\u002Ffe\u002Fnuxt-migration-6","博客升级 Nuxt4 的迁移记录（六）",{"path":139,"title":140},"\u002Fposts\u002Ffe\u002Fvue-reactivity-2","Vue3 响应式原理笔记（二）",[142,151,181],{"id":5,"title":6,"body":143,"createdAt":19,"description":13,"extension":20,"meta":149,"navigation":22,"path":23,"seo":150,"stem":25,"__hash__":26},{"type":8,"value":144,"toc":147},[145],[11,146,13],{},{"title":15,"searchDepth":16,"depth":17,"links":148},[],{},{"description":13},{"id":152,"title":153,"body":154,"createdAt":174,"description":175,"extension":20,"meta":176,"navigation":22,"path":177,"seo":178,"stem":179,"__hash__":180},"notes\u002Fnotes\u002F2026-11-14-1.md","2026 11 14 1",{"type":8,"value":155,"toc":172},[156],[11,157,158,159,163,164,171],{},"站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 ",[160,161,162],"strong",{},"Markdown","，写链接也不用到编辑器：",[165,166,170],"a",{"href":167,"rel":168},"https:\u002F\u002Fcontent.nuxt.com",[169],"nofollow","Nuxt Content","。",{"title":15,"searchDepth":16,"depth":17,"links":173},[],"2026-11-14","站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 Markdown，写链接也不用到编辑器：Nuxt Content。",{},"\u002Fnotes\u002F2026-11-14-1",{"description":175},"notes\u002F2026-11-14-1","LLJX_RKU7cgpT6aHw4DZWUZNQ_G_UzELWPKbksJvzfs",{"id":182,"title":183,"body":184,"createdAt":199,"description":200,"extension":20,"meta":201,"navigation":22,"path":202,"seo":203,"stem":204,"__hash__":205},"notes\u002Fnotes\u002F2026-11-14-2.md","2026 11 14 2",{"type":8,"value":185,"toc":197},[186],[11,187,188,192,193,196],{},[189,190,191],"code",{},"readPixels"," 读不到内容不是 bug，是 ",[189,194,195],{},"preserveDrawingBuffer"," 默认关闭——帧提交后缓冲即被清空。",{"title":15,"searchDepth":16,"depth":17,"links":198},[],"2026-11-13","readPixels 读不到内容不是 bug，是 preserveDrawingBuffer 默认关闭——帧提交后缓冲即被清空。",{},"\u002Fnotes\u002F2026-11-14-2",{"description":200},"notes\u002F2026-11-14-2","i7xWqq2eNoU_seSbLQjqlB9gE51fM-PVLUEYCHBkOA4",1795273150453]