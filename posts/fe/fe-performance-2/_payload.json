[{"data":1,"prerenderedAt":204},["ShallowReactive",2],{"notes-latest-1":3,"post:\u002Fposts\u002Ffe\u002Ffe-performance-2":27,"surround:\u002Fposts\u002Ffe\u002Ffe-performance-2":132,"notes-latest-3":139},[4],{"id":5,"title":6,"body":7,"createdAt":19,"description":13,"extension":20,"meta":21,"navigation":22,"path":23,"seo":24,"stem":25,"__hash__":26},"notes\u002Fnotes\u002F2026-11-14-1-2.md","2026 11 14 1 2",{"type":8,"value":9,"toc":14},"minimark",[10],[11,12,13],"p",{},"站点上线了「随笔」：支持一个文件多个随笔",{"title":15,"searchDepth":16,"depth":17,"links":18},"",2,3,[],"2026-11-17","md",{},true,"\u002Fnotes\u002F2026-11-14-1-2",{"description":13},"notes\u002F2026-11-14-1-2","hDP9fvaunHzVrZQ6QifuOtj9VrqbxlPb_52KE5wSjD0",{"id":28,"title":29,"author":30,"body":31,"categories":112,"comment":22,"cover":30,"createdAt":114,"description":35,"draft":115,"extension":20,"meta":116,"navigation":22,"path":121,"readingTime":122,"recommend":115,"seo":123,"series":30,"stem":124,"tags":125,"top":115,"topics":128,"updatedAt":30,"words":130,"__hash__":131},"posts\u002Fposts\u002Ffe\u002Ffe-performance-2.md","前端性能优化的检查清单（二）",null,{"type":8,"value":32,"toc":104},[33,36,40,43,46,49,52,55,58,61,64,67,70,73,76,78,80,83,86,89,92,95,98,101],[11,34,35],{},"这个话题其实挺老的，但每次实际用到还是会踩出点新东西，索性记一篇备查，也给后来的同学提个醒。",[37,38,39],"h2",{"id":39},"加载阶段",[11,41,42],{},"加载阶段的优化清单：静态资源上 CDN、开启压缩传输、图片用合适格式并按需加载、关键 CSS 内联、非关键脚本 defer 或异步加载、路由懒加载把首屏用不到的代码挪走。这些做完，首屏时间通常有肉眼可见的改善，而且基本都是配置层面的改动，性价比极高。",[11,44,45],{},"度量先行这个原则在这里尤其重要：Lighthouse 和 performance 面板先跑一遍基线，优化前后的数字对比着看，不然你以为的优化可能只是心理安慰。",[37,47,48],{"id":48},"运行阶段",[11,50,51],{},"运行阶段的重点是大列表和频繁交互：长列表用虚拟滚动，只渲染可视区；高频事件做防抖节流；大量 DOM 更新考虑批量处理；动画优先用 transform 和 opacity，避开触发重排的属性。还有缓存策略，合理的 HTTP 缓存配 Service Worker 能让二次访问快到瞬间打开。优化是个持续的过程，把性能预算写进开发约定，新功能上线前过一遍检查，比事后救火体面得多。",[37,53,54],{"id":54},"顺手记两个坑",[11,56,57],{},"并行流里往共享 ArrayList 里塞数据，测试没跑出来，上线偶发丢数据。收集操作老老实实用 collect，共享可变状态在并发场景下永远是个雷，不管包装得多漂亮。",[11,59,60],{},"顺手记一个这阵子碰到的问题：服务 CPU 突然打满，top -H 找到罪魁线程，jstack 里转十六进制一查，是个正则在长文本上回溯。改成预编译加上入参长度限制之后就好了，正则这个东西真是不能随手写。",[11,62,63],{},"还有一次排查 OOM，堆内存看着没超，最后发现是元空间爆了，某个框架在运行时动态生成类。加了 -XX:MaxMetaspaceSize 先兜底，再定位到生成源头关掉，内存曲线立刻平了。",[37,65,66],{"id":66},"一点延伸",[11,68,69],{},"后端视角看前端这几年，最大的感受是前端工程化的成熟度已经不输后端：组件化、状态管理、构建优化、类型系统，该有的都有。所以“前端简单”的刻板印象早该更新了，做好不容易这件事在前端同样成立。",[11,71,72],{},"前后端协作的效率瓶颈经常出在接口约定上，先写接口文档再并行开发，比后端写完再通知前端快得多。类型定义共享、mock 数据同步生成，这些协作上的小投入，回报名远超想象。",[11,74,75],{},"样式和交互的还原度问题，多数根因在设计稿和实现之间缺少约定：间距系统、颜色变量、组件规范，这些设计系统的基本功建起来之后，页面的开发速度和一致性都会上一个台阶。",[11,77,69],{},[11,79,72],{},[37,81,82],{"id":82},"再补充几句",[11,84,85],{},"从更高的视角看，这类问题都有一个共同结构：短期收益和长期收益打架。短期的诱惑总是具体而生动，长期的回报抽象而遥远，赢家通常是那些把长期目标拆成短期可感的小奖励的人。",[11,87,88],{},"讲个题外话，做这类事情的时候最好留个记录的习惯，当时的判断依据比结果更珍贵。结果好可能只是运气好，把决策过程记下来，好运才可能被复制，坏运才可能被规避。",[11,90,91],{},"然后想说，承认不懂是这行的美德。这次遇到不懂的地方，老老实实补了两天的课，比硬着头皮往上糊的方案强太多。不懂装懂的代价从来不会消失，只是延期，还带利息。",[11,93,94],{},"平衡感很重要的一件事：投入和收益的比例。所有优化都值得先问一句，这件事的收益上限是多少，值多少投入。无限打磨一个低价值的东西是工程师最常见的温柔陷阱，包括我自己在内。",[37,96,97],{"id":97},"小结",[11,99,100],{},"写完这篇下楼跑了个五公里，脑子里剩下的方案细节，居然是跑步的时候理顺的。",[11,102,103],{},"就写到这吧，锅里还炖着东西，得去看一眼。",{"title":15,"searchDepth":16,"depth":17,"links":105},[106,107,108,109,110,111],{"id":39,"depth":16,"text":39},{"id":48,"depth":16,"text":48},{"id":54,"depth":16,"text":54},{"id":66,"depth":16,"text":66},{"id":82,"depth":16,"text":82},{"id":97,"depth":16,"text":97},[113],"前端","2025-11-12",false,{"excerpt":117},{"type":8,"value":118},[119],[11,120,35],{},"\u002Fposts\u002Ffe\u002Ffe-performance-2",384300,{"title":29,"description":35},"posts\u002Ffe\u002Ffe-performance-2",[126,127],"性能","优化",[129],"fe",1281,"Ao2Z1YRoFDr7Qk5U4ZhvHMIt5hJBjgMDPQ6EVZ5CxFo",{"prev":133,"next":136},{"path":134,"title":135},"\u002Fposts\u002Ffe\u002Ffe-performance","前端性能优化的检查清单",{"path":137,"title":138},"\u002Fposts\u002Ffe\u002Ffe-performance-3","前端性能优化的检查清单（三）",[140,149,179],{"id":5,"title":6,"body":141,"createdAt":19,"description":13,"extension":20,"meta":147,"navigation":22,"path":23,"seo":148,"stem":25,"__hash__":26},{"type":8,"value":142,"toc":145},[143],[11,144,13],{},{"title":15,"searchDepth":16,"depth":17,"links":146},[],{},{"description":13},{"id":150,"title":151,"body":152,"createdAt":172,"description":173,"extension":20,"meta":174,"navigation":22,"path":175,"seo":176,"stem":177,"__hash__":178},"notes\u002Fnotes\u002F2026-11-14-1.md","2026 11 14 1",{"type":8,"value":153,"toc":170},[154],[11,155,156,157,161,162,169],{},"站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 ",[158,159,160],"strong",{},"Markdown","，写链接也不用到编辑器：",[163,164,168],"a",{"href":165,"rel":166},"https:\u002F\u002Fcontent.nuxt.com",[167],"nofollow","Nuxt Content","。",{"title":15,"searchDepth":16,"depth":17,"links":171},[],"2026-11-14","站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 Markdown，写链接也不用到编辑器：Nuxt Content。",{},"\u002Fnotes\u002F2026-11-14-1",{"description":173},"notes\u002F2026-11-14-1","LLJX_RKU7cgpT6aHw4DZWUZNQ_G_UzELWPKbksJvzfs",{"id":180,"title":181,"body":182,"createdAt":197,"description":198,"extension":20,"meta":199,"navigation":22,"path":200,"seo":201,"stem":202,"__hash__":203},"notes\u002Fnotes\u002F2026-11-14-2.md","2026 11 14 2",{"type":8,"value":183,"toc":195},[184],[11,185,186,190,191,194],{},[187,188,189],"code",{},"readPixels"," 读不到内容不是 bug，是 ",[187,192,193],{},"preserveDrawingBuffer"," 默认关闭——帧提交后缓冲即被清空。",{"title":15,"searchDepth":16,"depth":17,"links":196},[],"2026-11-13","readPixels 读不到内容不是 bug，是 preserveDrawingBuffer 默认关闭——帧提交后缓冲即被清空。",{},"\u002Fnotes\u002F2026-11-14-2",{"description":198},"notes\u002F2026-11-14-2","i7xWqq2eNoU_seSbLQjqlB9gE51fM-PVLUEYCHBkOA4",1795304795100]