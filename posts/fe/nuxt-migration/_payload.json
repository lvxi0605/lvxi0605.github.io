[{"data":1,"prerenderedAt":204},["ShallowReactive",2],{"notes-latest-1":3,"post:\u002Fposts\u002Ffe\u002Fnuxt-migration":27,"surround:\u002Fposts\u002Ffe\u002Fnuxt-migration":132,"notes-latest-3":139},[4],{"id":5,"title":6,"body":7,"createdAt":19,"description":13,"extension":20,"meta":21,"navigation":22,"path":23,"seo":24,"stem":25,"__hash__":26},"notes\u002Fnotes\u002F2026-11-14-1-2.md","2026 11 14 1 2",{"type":8,"value":9,"toc":14},"minimark",[10],[11,12,13],"p",{},"站点上线了「随笔」：支持一个文件多个随笔",{"title":15,"searchDepth":16,"depth":17,"links":18},"",2,3,[],"2026-11-17","md",{},true,"\u002Fnotes\u002F2026-11-14-1-2",{"description":13},"notes\u002F2026-11-14-1-2","hDP9fvaunHzVrZQ6QifuOtj9VrqbxlPb_52KE5wSjD0",{"id":28,"title":29,"author":30,"body":31,"categories":112,"comment":22,"cover":30,"createdAt":114,"description":35,"draft":115,"extension":20,"meta":116,"navigation":22,"path":121,"readingTime":122,"recommend":115,"seo":123,"series":30,"stem":124,"tags":125,"top":115,"topics":128,"updatedAt":30,"words":130,"__hash__":131},"posts\u002Fposts\u002Ffe\u002Fnuxt-migration.md","博客升级 Nuxt4 的迁移记录",null,{"type":8,"value":32,"toc":104},[33,36,40,43,46,49,52,55,58,61,64,67,70,73,76,78,80,83,86,89,92,95,98,101],[11,34,35],{},"写技术文章对我来说主要是个复盘的过程，写不清楚的地方往往就是还没想清楚的地方。",[37,38,39],"h2",{"id":39},"迁移的动机",[11,41,42],{},"这个博客最初是 Nuxt 2 加 Content v1 的组合，跑了好几年一直稳定，让我下定决心重写的有两个原因：Nuxt 2 停止维护，生态的新东西都发布在 Nuxt 3 之后的版本上；Content v1 的查询能力太弱，文章一多总觉得别扭。趁着假期把整个站推倒重来，Nuxt 4 加 Content v3 加 Nuxt UI。",[11,44,45],{},"工作量比预期大的点在 Content v3：collection 和 schema 要显式声明，查询从 where 链式换成了新的 API，代码高亮从 Prism 换 Shiki，相关的配置和样式都要重做。",[37,47,48],{"id":48},"经验教训",[11,50,51],{},"记几条经验：迁移不要恋战，逐页对照重写比修修补补快，反正代码量不大；URL 策略提前定好，Content v3 会按自己的规则生成路径，中文标题会被剥掉，我在钩子里按原始路径还原，保住了历史链接；静态预渲染和 PWA 的组合要理清缓存策略，这次把 Service Worker 的导航回退关掉才解决刷新跳首页的问题。整个站现在的构建和维护体验都比以前好，这笔重构投入值回票价。",[37,53,54],{"id":54},"记两个小问题",[11,56,57],{},"grep 中文关键词死活匹配不上，最后确认是文件编码。iconv 转一道再查，两分钟的事排查了半小时，处理日志前先看编码，这个习惯值得保持。",[11,59,60],{},"磁盘告警，日志把盘写满了。给应用日志配上 logrotate 加上保留天数，再顺手把历史日志清了。存储这种东西，没有监控告警之前，所有人都以为它不会满。",[11,62,63],{},"线程池的队列当初图省事用了无界，高峰期任务堆积，内存一路涨。改成有界队列加上合理的拒绝策略，宁可快速失败也别让问题积累到内存里爆出来。",[37,65,66],{"id":66},"顺便一提",[11,68,69],{},"后端视角看前端这几年，最大的感受是前端工程化的成熟度已经不输后端：组件化、状态管理、构建优化、类型系统，该有的都有。所以“前端简单”的刻板印象早该更新了，做好不容易这件事在前端同样成立。",[11,71,72],{},"前后端协作的效率瓶颈经常出在接口约定上，先写接口文档再并行开发，比后端写完再通知前端快得多。类型定义共享、mock 数据同步生成，这些协作上的小投入，回报名远超想象。",[11,74,75],{},"样式和交互的还原度问题，多数根因在设计稿和实现之间缺少约定：间距系统、颜色变量、组件规范，这些设计系统的基本功建起来之后，页面的开发速度和一致性都会上一个台阶。",[11,77,69],{},[11,79,72],{},[37,81,82],{"id":82},"另外记几笔",[11,84,85],{},"想到一个问题：为什么同样的事情，不同的人做出来差别那么大。后来觉得答案在于对边界的处理，正常路径人人会写，边界和异常的处理习惯才是拉开差距的地方。做事和写代码一样，细节的密度决定成品的质量。",[11,87,88],{},"写到这里顺便吐个槽，这类事情最难的部分往往不是技术本身，是说服别人相信它值得投入。方案再好，落不到排期上都是空谈，所以学会用数据的语言讲价值，算是这些年额外的必修课。",[11,90,91],{},"有时候会想，学一门新技术到底学到的是什么。语法和 API 会过时，真正的收获是它看问题的角度。多一门语言就多一副眼镜，同一副牌桌，能看到别人看不到的牌路，这是这么多年折腾下来最确定的回报。",[11,93,94],{},"记一个产生过的动摇：做到一半觉得这玩意儿是不是没什么意义。后来想通了，意义不是事情自带的，是你把它做完并沉淀下来之后长出来的。烂尾的才真的没意义，做完的最差也是一篇笔记。",[37,96,97],{"id":97},"写在最后",[11,99,100],{},"天冷了，敲键盘手有点僵，新入手的木质腕托派上了用场，顺便把欠的这篇写完。",[11,102,103],{},"先记到这里，后面有新的进展再来补充。",{"title":15,"searchDepth":16,"depth":17,"links":105},[106,107,108,109,110,111],{"id":39,"depth":16,"text":39},{"id":48,"depth":16,"text":48},{"id":54,"depth":16,"text":54},{"id":66,"depth":16,"text":66},{"id":82,"depth":16,"text":82},{"id":97,"depth":16,"text":97},[113],"前端","2023-04-18",false,{"excerpt":117},{"type":8,"value":118},[119],[11,120,35],{},"\u002Fposts\u002Ffe\u002Fnuxt-migration",388500,{"title":29,"description":35},"posts\u002Ffe\u002Fnuxt-migration",[126,127],"Nuxt","博客",[129],"fe",1295,"WV3XClNEU7y7qcPIjpItH-5Bw47xKJ2EsOXtJWAIg1k",{"prev":133,"next":136},{"path":134,"title":135},"\u002Fposts\u002Ffe\u002Ffe-performance-6","前端性能优化的检查清单（六）",{"path":137,"title":138},"\u002Fposts\u002Ffe\u002Fnuxt-migration-2","博客升级 Nuxt4 的迁移记录（二）",[140,149,179],{"id":5,"title":6,"body":141,"createdAt":19,"description":13,"extension":20,"meta":147,"navigation":22,"path":23,"seo":148,"stem":25,"__hash__":26},{"type":8,"value":142,"toc":145},[143],[11,144,13],{},{"title":15,"searchDepth":16,"depth":17,"links":146},[],{},{"description":13},{"id":150,"title":151,"body":152,"createdAt":172,"description":173,"extension":20,"meta":174,"navigation":22,"path":175,"seo":176,"stem":177,"__hash__":178},"notes\u002Fnotes\u002F2026-11-14-1.md","2026 11 14 1",{"type":8,"value":153,"toc":170},[154],[11,155,156,157,161,162,169],{},"站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 ",[158,159,160],"strong",{},"Markdown","，写链接也不用到编辑器：",[163,164,168],"a",{"href":165,"rel":166},"https:\u002F\u002Fcontent.nuxt.com",[167],"nofollow","Nuxt Content","。",{"title":15,"searchDepth":16,"depth":17,"links":171},[],"2026-11-14","站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 Markdown，写链接也不用到编辑器：Nuxt Content。",{},"\u002Fnotes\u002F2026-11-14-1",{"description":173},"notes\u002F2026-11-14-1","LLJX_RKU7cgpT6aHw4DZWUZNQ_G_UzELWPKbksJvzfs",{"id":180,"title":181,"body":182,"createdAt":197,"description":198,"extension":20,"meta":199,"navigation":22,"path":200,"seo":201,"stem":202,"__hash__":203},"notes\u002Fnotes\u002F2026-11-14-2.md","2026 11 14 2",{"type":8,"value":183,"toc":195},[184],[11,185,186,190,191,194],{},[187,188,189],"code",{},"readPixels"," 读不到内容不是 bug，是 ",[187,192,193],{},"preserveDrawingBuffer"," 默认关闭——帧提交后缓冲即被清空。",{"title":15,"searchDepth":16,"depth":17,"links":196},[],"2026-11-13","readPixels 读不到内容不是 bug，是 preserveDrawingBuffer 默认关闭——帧提交后缓冲即被清空。",{},"\u002Fnotes\u002F2026-11-14-2",{"description":198},"notes\u002F2026-11-14-2","i7xWqq2eNoU_seSbLQjqlB9gE51fM-PVLUEYCHBkOA4",1795273150165]