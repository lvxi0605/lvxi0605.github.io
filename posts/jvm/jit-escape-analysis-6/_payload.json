[{"data":1,"prerenderedAt":204},["ShallowReactive",2],{"notes-latest-1":3,"post:\u002Fposts\u002Fjvm\u002Fjit-escape-analysis-6":27,"surround:\u002Fposts\u002Fjvm\u002Fjit-escape-analysis-6":132,"notes-latest-3":139},[4],{"id":5,"title":6,"body":7,"createdAt":19,"description":13,"extension":20,"meta":21,"navigation":22,"path":23,"seo":24,"stem":25,"__hash__":26},"notes\u002Fnotes\u002F2026-11-14-1-2.md","2026 11 14 1 2",{"type":8,"value":9,"toc":14},"minimark",[10],[11,12,13],"p",{},"站点上线了「随笔」：支持一个文件多个随笔",{"title":15,"searchDepth":16,"depth":17,"links":18},"",2,3,[],"2026-11-17","md",{},true,"\u002Fnotes\u002F2026-11-14-1-2",{"description":13},"notes\u002F2026-11-14-1-2","hDP9fvaunHzVrZQ6QifuOtj9VrqbxlPb_52KE5wSjD0",{"id":28,"title":29,"author":30,"body":31,"categories":113,"comment":22,"cover":30,"createdAt":115,"description":35,"draft":116,"extension":20,"meta":117,"navigation":22,"path":122,"readingTime":123,"recommend":116,"seo":124,"series":30,"stem":125,"tags":126,"top":116,"topics":128,"updatedAt":30,"words":130,"__hash__":131},"posts\u002Fposts\u002Fjvm\u002Fjit-escape-analysis-6.md","JIT 优化与逃逸分析（六）",null,{"type":8,"value":32,"toc":105},[33,36,40,43,46,49,52,55,58,61,64,67,70,73,76,79,81,84,87,90,93,96,99,102],[11,34,35],{},"又是拖了很久才动笔的一篇，草稿箱里躺了快一个月，趁周末把思路理一理，一次写完。",[37,38,39],"h2",{"id":39},"代码是怎么变快的",[11,41,42],{},"Java 并不是天生就慢，字节码解释执行一段之后，热点代码会被即时编译成本地机器码，途径有 C1 和 C2 两级编译器，前者快后者狠。方法调用次数或者循环回边次数达到阈值就触发编译，这也是为什么很多接口刚启动时慢，跑一会儿就快了，预热这个词的来源就在这。",[11,44,45],{},"逃逸分析是 C2 里很有意思的优化：分析对象的作用域，如果对象不会逃出方法或者线程，就可以做标量替换，对象干脆不分配在堆上，字段直接展开在栈上；锁消除也是同理，局部对象上的同步可以直接删掉。这些优化对你完全透明，但会显著改变性能测试的结果。",[37,47,48],{"id":48},"对写代码的影响",[11,50,51],{},"它对写代码的启示有两面：一方面不必过度担心小对象的分配成本，JVM 大概率比你优化得好；另一方面做性能对比测试时要充分预热，否则测的是解释执行的性能，结论可能完全跑偏。想看编译过程可以加 -XX:+PrintCompilation，写 demo 验证优化行为时特别直观，强烈建议动手玩一次。",[37,53,54],{"id":54},"过程中的两个坑",[11,56,57],{},"线程池的队列当初图省事用了无界，高峰期任务堆积，内存一路涨。改成有界队列加上合理的拒绝策略，宁可快速失败也别让问题积累到内存里爆出来。",[11,59,60],{},"数据迁移演练时发现字段长度截断，源库字符集和目标库不一样，同一段中文占的长度都不同。迁移脚本先在影子表跑一遍，这种事不演练，上了生产就是事故。",[11,62,63],{},"@Transactional 加在私有方法上、或者同类里自调用，事务都是不生效的，因为绕过了代理对象。这类 AOP 的坑，理解了代理机制就一目了然，没理解之前就是玄学。",[37,65,66],{"id":66},"延伸几句",[11,68,69],{},"补充一个看问题的角度：JVM 的各种机制不是孤立的知识点，把它们串起来的主线是“如何让内存和 CPU 的使用更高效”。理解了这条主线，很多设计就不需要死记硬背，比如为什么分代、为什么要 JIT、为什么有线程本地缓冲。",[11,71,72],{},"线上 JVM 问题有一个基本盘：内存问题看趋势，CPU 问题看线程，两者都依赖平时留好监控和日志。事故时刻的第一手现场最珍贵，参数要在平时配好，出事才不会两手空空。",[11,74,75],{},"调优这个词容易让人兴奋，但实践里大多数所谓的调优，其实是把不合理的配置纠正回合理范围。真正的精细调优空间很小，而且高度依赖具体负载，别把调优神化，更别在没有监控数据的情况下凭感觉动参数。",[11,77,78],{},"版本迭代对 JVM 知识的影响比想象中大，很多流行于博客的结论在新的 JDK 里已经变了。看资料先看版本背景，自己动手验证一遍，这个习惯能避免把过时的结论当成真理用很多年。",[11,80,69],{},[37,82,83],{"id":83},"又想到一些",[11,85,86],{},"想想还是补一段：任何习惯的养成都绕不开启动成本，最有效的办法是把启动成本降到接近零。想跑就把鞋放门口，想写就把文档开着置顶，环境准备到位了，行动只是顺水推舟。",[11,88,89],{},"从更高的视角看，这类问题都有一个共同结构：短期收益和长期收益打架。短期的诱惑总是具体而生动，长期的回报抽象而遥远，赢家通常是那些把长期目标拆成短期可感的小奖励的人。",[11,91,92],{},"讲个题外话，做这类事情的时候最好留个记录的习惯，当时的判断依据比结果更珍贵。结果好可能只是运气好，把决策过程记下来，好运才可能被复制，坏运才可能被规避。",[11,94,95],{},"然后想说，承认不懂是这行的美德。这次遇到不懂的地方，老老实实补了两天的课，比硬着头皮往上糊的方案强太多。不懂装懂的代价从来不会消失，只是延期，还带利息。",[37,97,98],{"id":98},"小结",[11,100,101],{},"泡的茶忘了喝，回过神已经凉透了，进入状态的时候对时间的感知就剩这点不好。",[11,103,104],{},"暂时记到这，下次接着说。",{"title":15,"searchDepth":16,"depth":17,"links":106},[107,108,109,110,111,112],{"id":39,"depth":16,"text":39},{"id":48,"depth":16,"text":48},{"id":54,"depth":16,"text":54},{"id":66,"depth":16,"text":66},{"id":83,"depth":16,"text":83},{"id":98,"depth":16,"text":98},[114],"JVM","2026-04-05",false,{"excerpt":118},{"type":8,"value":119},[120],[11,121,35],{},"\u002Fposts\u002Fjvm\u002Fjit-escape-analysis-6",393900,{"title":29,"description":35},"posts\u002Fjvm\u002Fjit-escape-analysis-6",[114,127],"性能",[129],"jvm",1313,"NMcllRuu0GdW_cACGU8sdj1l-nA5K04Uw1L0a0lM92s",{"prev":133,"next":136},{"path":134,"title":135},"\u002Fposts\u002Fjvm\u002Fjit-escape-analysis-5","JIT 优化与逃逸分析（五）",{"path":137,"title":138},"\u002Fposts\u002Fjvm\u002Fjvm-memory-area","JVM 运行时内存区域梳理",[140,149,179],{"id":5,"title":6,"body":141,"createdAt":19,"description":13,"extension":20,"meta":147,"navigation":22,"path":23,"seo":148,"stem":25,"__hash__":26},{"type":8,"value":142,"toc":145},[143],[11,144,13],{},{"title":15,"searchDepth":16,"depth":17,"links":146},[],{},{"description":13},{"id":150,"title":151,"body":152,"createdAt":172,"description":173,"extension":20,"meta":174,"navigation":22,"path":175,"seo":176,"stem":177,"__hash__":178},"notes\u002Fnotes\u002F2026-11-14-1.md","2026 11 14 1",{"type":8,"value":153,"toc":170},[154],[11,155,156,157,161,162,169],{},"站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 ",[158,159,160],"strong",{},"Markdown","，写链接也不用到编辑器：",[163,164,168],"a",{"href":165,"rel":166},"https:\u002F\u002Fcontent.nuxt.com",[167],"nofollow","Nuxt Content","。",{"title":15,"searchDepth":16,"depth":17,"links":171},[],"2026-11-14","站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 Markdown，写链接也不用到编辑器：Nuxt Content。",{},"\u002Fnotes\u002F2026-11-14-1",{"description":173},"notes\u002F2026-11-14-1","LLJX_RKU7cgpT6aHw4DZWUZNQ_G_UzELWPKbksJvzfs",{"id":180,"title":181,"body":182,"createdAt":197,"description":198,"extension":20,"meta":199,"navigation":22,"path":200,"seo":201,"stem":202,"__hash__":203},"notes\u002Fnotes\u002F2026-11-14-2.md","2026 11 14 2",{"type":8,"value":183,"toc":195},[184],[11,185,186,190,191,194],{},[187,188,189],"code",{},"readPixels"," 读不到内容不是 bug，是 ",[187,192,193],{},"preserveDrawingBuffer"," 默认关闭——帧提交后缓冲即被清空。",{"title":15,"searchDepth":16,"depth":17,"links":196},[],"2026-11-13","readPixels 读不到内容不是 bug，是 preserveDrawingBuffer 默认关闭——帧提交后缓冲即被清空。",{},"\u002Fnotes\u002F2026-11-14-2",{"description":198},"notes\u002F2026-11-14-2","i7xWqq2eNoU_seSbLQjqlB9gE51fM-PVLUEYCHBkOA4",1795348510546]