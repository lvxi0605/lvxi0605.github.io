[{"data":1,"prerenderedAt":203},["ShallowReactive",2],{"notes-latest-1":3,"post:\u002Fposts\u002Fredis\u002Fredis-persist-2":27,"surround:\u002Fposts\u002Fredis\u002Fredis-persist-2":131,"notes-latest-3":138},[4],{"id":5,"title":6,"body":7,"createdAt":19,"description":13,"extension":20,"meta":21,"navigation":22,"path":23,"seo":24,"stem":25,"__hash__":26},"notes\u002Fnotes\u002F2026-11-14-1-2.md","2026 11 14 1 2",{"type":8,"value":9,"toc":14},"minimark",[10],[11,12,13],"p",{},"站点上线了「随笔」：支持一个文件多个随笔",{"title":15,"searchDepth":16,"depth":17,"links":18},"",2,3,[],"2026-11-17","md",{},true,"\u002Fnotes\u002F2026-11-14-1-2",{"description":13},"notes\u002F2026-11-14-1-2","hDP9fvaunHzVrZQ6QifuOtj9VrqbxlPb_52KE5wSjD0",{"id":28,"title":29,"author":30,"body":31,"categories":112,"comment":22,"cover":30,"createdAt":114,"description":35,"draft":115,"extension":20,"meta":116,"navigation":22,"path":121,"readingTime":122,"recommend":115,"seo":123,"series":30,"stem":124,"tags":125,"top":115,"topics":127,"updatedAt":30,"words":129,"__hash__":130},"posts\u002Fposts\u002Fredis\u002Fredis-persist-2.md","RDB 与 AOF 的取舍（二）",null,{"type":8,"value":32,"toc":104},[33,36,40,43,46,49,52,55,58,61,64,67,70,73,76,78,80,83,86,89,92,95,98,101],[11,34,35],{},"前几天有同事问到这个，我口头讲了一遍，回头想想还是写成文章更完整，也算把自己的理解再过一遍。",[37,38,39],"h2",{"id":39},"两种机制",[11,41,42],{},"RDB 是某个时刻的内存快照，fork 子进程把数据整体写成二进制文件，恢复快、文件紧凑，但两次快照之间的数据会随宕机丢失。AOF 把每条写命令追加到文件里，丢数据少，按 everysec 配置最多丢一秒，但文件大恢复慢，靠重写机制压缩体积。",[11,44,45],{},"fork 本身有成本，实例越大 fork 越慢，期间主进程复制页表会占用内存，大实例上做 RDB 的瞬间可能引发抖动，这是很多线上故障的实际源头，监控里要有体现。",[37,47,48],{"id":48},"怎么组合",[11,50,51],{},"组合策略的常见姿势：两种都开，RDB 做冷备和快速恢复，AOF 保证尽量不丢；对纯缓存场景可以都关或者只开低频 RDB，丢了就全量重建，把 Redis 定位清楚比纠结参数更重要。另外恢复演练别省，备份没验证过恢复的，等于没有备份，这句话对 Redis 对数据库都成立。",[37,53,54],{"id":54},"过程中的两个坑",[11,56,57],{},"Kafka 某个分区消费延迟特别高，看数据发现某大客户的消息占了总量一半，按 userId 分区全进了一个分区。大客户单独走一个 topic 才解决，倾斜问题在哪个中间件里都一样。",[11,59,60],{},"WebSocket 上线之后频繁断连，本地好好的，一上 Nginx 就出问题。代理默认不转发 Upgrade 头，补上之后世界清净了，这类中间件默认行为，不踩一次真的想不到。",[11,62,63],{},"发版之后用户还在用旧页面，报接口不存在的错。index.html 被强缓存了，给 HTML 加 no-cache、静态资源带 hash 长缓存，这是前端部署的标配，后端出身的我当年是真不知道。",[37,65,66],{"id":66},"延伸几句",[11,68,69],{},"Redis 的很多事故复盘下来都是“没想到会用成这样”：没想到一个 key 会涨到几百兆，没想到一个 hash 会有千万级字段。所以架构评审时对 Redis 的使用多做一句灵魂拷问：这个结构的规模上限是多少，通常能省掉未来很多夜晚。",[11,71,72],{},"用 Redis 的这些年的一个整体感受：它把复杂性从性能转移到了运维。单线程模型保证了简单和快，但内存水位、大 key、热点 key 这些问题都需要自己盯。用好它的关键不是多学几个命令，是建立起一套日常巡检的习惯。",[11,74,75],{},"缓存和数据库的一致性是个永恒话题，没有银弹，只有按业务容忍度选方案。先问自己：不一致的窗口期多大可以接受？答案决定了用失效、用双删还是用订阅 binlog 的异步更新，很多争论其实是没先对齐这个前提。",[11,77,69],{},[11,79,72],{},[37,81,82],{"id":82},"又想到一些",[11,84,85],{},"想想还是补一段：任何习惯的养成都绕不开启动成本，最有效的办法是把启动成本降到接近零。想跑就把鞋放门口，想写就把文档开着置顶，环境准备到位了，行动只是顺水推舟。",[11,87,88],{},"从更高的视角看，这类问题都有一个共同结构：短期收益和长期收益打架。短期的诱惑总是具体而生动，长期的回报抽象而遥远，赢家通常是那些把长期目标拆成短期可感的小奖励的人。",[11,90,91],{},"讲个题外话，做这类事情的时候最好留个记录的习惯，当时的判断依据比结果更珍贵。结果好可能只是运气好，把决策过程记下来，好运才可能被复制，坏运才可能被规避。",[11,93,94],{},"然后想说，承认不懂是这行的美德。这次遇到不懂的地方，老老实实补了两天的课，比硬着头皮往上糊的方案强太多。不懂装懂的代价从来不会消失，只是延期，还带利息。",[37,96,97],{"id":97},"写在最后",[11,99,100],{},"写完这篇正好十一点，窗外安静下来，这种时候码字效率出奇地高，就是第二天起床靠毅力。",[11,102,103],{},"记录完毕，方便以后自己回来翻。",{"title":15,"searchDepth":16,"depth":17,"links":105},[106,107,108,109,110,111],{"id":39,"depth":16,"text":39},{"id":48,"depth":16,"text":48},{"id":54,"depth":16,"text":54},{"id":66,"depth":16,"text":66},{"id":82,"depth":16,"text":82},{"id":97,"depth":16,"text":97},[113],"Redis","2023-02-22",false,{"excerpt":117},{"type":8,"value":118},[119],[11,120,35],{},"\u002Fposts\u002Fredis\u002Fredis-persist-2",385500,{"title":29,"description":35},"posts\u002Fredis\u002Fredis-persist-2",[113,126],"持久化",[128],"redis",1285,"mGEbFP5v0VhwpxZjJDdmnDHS8IJqe0Z7T5Lhl7WestQ",{"prev":132,"next":135},{"path":133,"title":134},"\u002Fposts\u002Fredis\u002Fredis-persist","RDB 与 AOF 的取舍",{"path":136,"title":137},"\u002Fposts\u002Fredis\u002Fredis-persist-3","RDB 与 AOF 的取舍（三）",[139,148,178],{"id":5,"title":6,"body":140,"createdAt":19,"description":13,"extension":20,"meta":146,"navigation":22,"path":23,"seo":147,"stem":25,"__hash__":26},{"type":8,"value":141,"toc":144},[142],[11,143,13],{},{"title":15,"searchDepth":16,"depth":17,"links":145},[],{},{"description":13},{"id":149,"title":150,"body":151,"createdAt":171,"description":172,"extension":20,"meta":173,"navigation":22,"path":174,"seo":175,"stem":176,"__hash__":177},"notes\u002Fnotes\u002F2026-11-14-1.md","2026 11 14 1",{"type":8,"value":152,"toc":169},[153],[11,154,155,156,160,161,168],{},"站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 ",[157,158,159],"strong",{},"Markdown","，写链接也不用到编辑器：",[162,163,167],"a",{"href":164,"rel":165},"https:\u002F\u002Fcontent.nuxt.com",[166],"nofollow","Nuxt Content","。",{"title":15,"searchDepth":16,"depth":17,"links":170},[],"2026-11-14","站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 Markdown，写链接也不用到编辑器：Nuxt Content。",{},"\u002Fnotes\u002F2026-11-14-1",{"description":172},"notes\u002F2026-11-14-1","LLJX_RKU7cgpT6aHw4DZWUZNQ_G_UzELWPKbksJvzfs",{"id":179,"title":180,"body":181,"createdAt":196,"description":197,"extension":20,"meta":198,"navigation":22,"path":199,"seo":200,"stem":201,"__hash__":202},"notes\u002Fnotes\u002F2026-11-14-2.md","2026 11 14 2",{"type":8,"value":182,"toc":194},[183],[11,184,185,189,190,193],{},[186,187,188],"code",{},"readPixels"," 读不到内容不是 bug，是 ",[186,191,192],{},"preserveDrawingBuffer"," 默认关闭——帧提交后缓冲即被清空。",{"title":15,"searchDepth":16,"depth":17,"links":195},[],"2026-11-13","readPixels 读不到内容不是 bug，是 preserveDrawingBuffer 默认关闭——帧提交后缓冲即被清空。",{},"\u002Fnotes\u002F2026-11-14-2",{"description":197},"notes\u002F2026-11-14-2","i7xWqq2eNoU_seSbLQjqlB9gE51fM-PVLUEYCHBkOA4",1795342440746]