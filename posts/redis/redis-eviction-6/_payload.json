[{"data":1,"prerenderedAt":203},["ShallowReactive",2],{"notes-latest-1":3,"post:\u002Fposts\u002Fredis\u002Fredis-eviction-6":27,"surround:\u002Fposts\u002Fredis\u002Fredis-eviction-6":131,"notes-latest-3":138},[4],{"id":5,"title":6,"body":7,"createdAt":19,"description":13,"extension":20,"meta":21,"navigation":22,"path":23,"seo":24,"stem":25,"__hash__":26},"notes\u002Fnotes\u002F2026-11-14-1-2.md","2026 11 14 1 2",{"type":8,"value":9,"toc":14},"minimark",[10],[11,12,13],"p",{},"站点上线了「随笔」：支持一个文件多个随笔",{"title":15,"searchDepth":16,"depth":17,"links":18},"",2,3,[],"2026-11-17","md",{},true,"\u002Fnotes\u002F2026-11-14-1-2",{"description":13},"notes\u002F2026-11-14-1-2","hDP9fvaunHzVrZQ6QifuOtj9VrqbxlPb_52KE5wSjD0",{"id":28,"title":29,"author":30,"body":31,"categories":112,"comment":22,"cover":30,"createdAt":114,"description":35,"draft":115,"extension":20,"meta":116,"navigation":22,"path":121,"readingTime":122,"recommend":115,"seo":123,"series":30,"stem":124,"tags":125,"top":115,"topics":127,"updatedAt":30,"words":129,"__hash__":130},"posts\u002Fposts\u002Fredis\u002Fredis-eviction-6.md","内存淘汰策略与碎片整理（六）",null,{"type":8,"value":32,"toc":104},[33,36,40,43,46,49,52,55,58,61,64,67,70,73,76,78,80,83,86,89,92,95,98,101],[11,34,35],{},"这篇起因是个很小的问题，本来打算随手改掉就算了，展开之后发现值得单独写一篇。",[37,38,39],"h2",{"id":39},"策略怎么选",[11,41,42],{},"内存满了之后的淘汰策略有八种，核心区别是淘汰范围：只淘汰带过期时间的键，还是在全部键里淘汰；算法上有近似 LRU、LFU、随机和按 TTL。纯缓存场景大多数团队用 allkeys-lru 或 allkeys-lfu，热点数据留存效果好；如果 Redis 里混存了不能丢的数据，千万别选 allkeys 系列，否则内存一满连业务数据都被清了。",[11,44,45],{},"LFU 适合访问频率差异大的场景，LRU 偶尔的批量扫描会把真正的热点挤出去，两种算法没有绝对优劣，看访问模式选。",[37,47,48],{"id":48},"碎片与水位",[11,50,51],{},"除了淘汰，还有两个运维关注点：内存碎片率长期高于 1.5 说明写入删除模式比较碎，考虑开启主动碎片整理；maxmemory 要留出复制缓冲区和其他开销的余量，不能拍着物理内存顶配。我的习惯是给每个 Redis 实例画两条线，水位 70% 预警 85% 处置，配合容量规划按季度过一遍增长曲线，内存问题基本都能在爆掉之前安排好。",[37,53,54],{"id":54},"记两个小问题",[11,56,57],{},"线上 full GC 频繁但堆使用率不高，后来发现是大对象直接进了老年代。调整缓存分页大小加上堆参数之后稳住了，监控里老年代的曲线是最值得天天瞄一眼的东西。",[11,59,60],{},"容器里日志时间和本地对不上，查了半天是时区，默认 UTC。在环境变量里把 TZ 设成 Asia\u002FShanghai，顺带把 JDK 参数也统一了，从此日志排查不用再做心算换算。",[11,62,63],{},"Feign 的超时配置怎么改都不生效，最后发现是配置前缀少写了一层，配置根本没被读到。教训是改完配置要打印生效值确认，光看配置文件自我感觉良好是不行的。",[37,65,66],{"id":66},"顺便一提",[11,68,69],{},"缓存和数据库的一致性是个永恒话题，没有银弹，只有按业务容忍度选方案。先问自己：不一致的窗口期多大可以接受？答案决定了用失效、用双删还是用订阅 binlog 的异步更新，很多争论其实是没先对齐这个前提。",[11,71,72],{},"Redis 的很多事故复盘下来都是“没想到会用成这样”：没想到一个 key 会涨到几百兆，没想到一个 hash 会有千万级字段。所以架构评审时对 Redis 的使用多做一句灵魂拷问：这个结构的规模上限是多少，通常能省掉未来很多夜晚。",[11,74,75],{},"用 Redis 的这些年的一个整体感受：它把复杂性从性能转移到了运维。单线程模型保证了简单和快，但内存水位、大 key、热点 key 这些问题都需要自己盯。用好它的关键不是多学几个命令，是建立起一套日常巡检的习惯。",[11,77,69],{},[11,79,72],{},[37,81,82],{"id":82},"另外记几笔",[11,84,85],{},"过程中也反复体会到取舍的本质：没有完美的方案，只有当下约束下最合适的方案。把约束写清楚，方案的选择题就变成了证明题，这也是为什么我习惯先列约束再谈方案，顺序反了全是无效争论。",[11,87,88],{},"想想还是补一段：任何习惯的养成都绕不开启动成本，最有效的办法是把启动成本降到接近零。想跑就把鞋放门口，想写就把文档开着置顶，环境准备到位了，行动只是顺水推舟。",[11,90,91],{},"从更高的视角看，这类问题都有一个共同结构：短期收益和长期收益打架。短期的诱惑总是具体而生动，长期的回报抽象而遥远，赢家通常是那些把长期目标拆成短期可感的小奖励的人。",[11,93,94],{},"讲个题外话，做这类事情的时候最好留个记录的习惯，当时的判断依据比结果更珍贵。结果好可能只是运气好，把决策过程记下来，好运才可能被复制，坏运才可能被规避。",[37,96,97],{"id":97},"写在最后",[11,99,100],{},"写这篇之前刚给阳台的绿萝浇了水，照顾植物和写博客有个共同点，都靠长期的小坚持。",[11,102,103],{},"先记到这里，后面有新的进展再来补充。",{"title":15,"searchDepth":16,"depth":17,"links":105},[106,107,108,109,110,111],{"id":39,"depth":16,"text":39},{"id":48,"depth":16,"text":48},{"id":54,"depth":16,"text":54},{"id":66,"depth":16,"text":66},{"id":82,"depth":16,"text":82},{"id":97,"depth":16,"text":97},[113],"Redis","2023-09-09",false,{"excerpt":117},{"type":8,"value":118},[119],[11,120,35],{},"\u002Fposts\u002Fredis\u002Fredis-eviction-6",398100,{"title":29,"description":35},"posts\u002Fredis\u002Fredis-eviction-6",[113,126],"运维",[128],"redis",1327,"UbbyXiBF8EuDq5J0qb0MovIrpaqGj8Y0opUFB5yPvxE",{"prev":132,"next":135},{"path":133,"title":134},"\u002Fposts\u002Fredis\u002Fredis-eviction-5","内存淘汰策略与碎片整理（五）",{"path":136,"title":137},"\u002Fposts\u002Fredis\u002Fredis-lock","分布式锁的演进过程",[139,148,178],{"id":5,"title":6,"body":140,"createdAt":19,"description":13,"extension":20,"meta":146,"navigation":22,"path":23,"seo":147,"stem":25,"__hash__":26},{"type":8,"value":141,"toc":144},[142],[11,143,13],{},{"title":15,"searchDepth":16,"depth":17,"links":145},[],{},{"description":13},{"id":149,"title":150,"body":151,"createdAt":171,"description":172,"extension":20,"meta":173,"navigation":22,"path":174,"seo":175,"stem":176,"__hash__":177},"notes\u002Fnotes\u002F2026-11-14-1.md","2026 11 14 1",{"type":8,"value":152,"toc":169},[153],[11,154,155,156,160,161,168],{},"站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 ",[157,158,159],"strong",{},"Markdown","，写链接也不用到编辑器：",[162,163,167],"a",{"href":164,"rel":165},"https:\u002F\u002Fcontent.nuxt.com",[166],"nofollow","Nuxt Content","。",{"title":15,"searchDepth":16,"depth":17,"links":170},[],"2026-11-14","站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 Markdown，写链接也不用到编辑器：Nuxt Content。",{},"\u002Fnotes\u002F2026-11-14-1",{"description":172},"notes\u002F2026-11-14-1","LLJX_RKU7cgpT6aHw4DZWUZNQ_G_UzELWPKbksJvzfs",{"id":179,"title":180,"body":181,"createdAt":196,"description":197,"extension":20,"meta":198,"navigation":22,"path":199,"seo":200,"stem":201,"__hash__":202},"notes\u002Fnotes\u002F2026-11-14-2.md","2026 11 14 2",{"type":8,"value":182,"toc":194},[183],[11,184,185,189,190,193],{},[186,187,188],"code",{},"readPixels"," 读不到内容不是 bug，是 ",[186,191,192],{},"preserveDrawingBuffer"," 默认关闭——帧提交后缓冲即被清空。",{"title":15,"searchDepth":16,"depth":17,"links":195},[],"2026-11-13","readPixels 读不到内容不是 bug，是 preserveDrawingBuffer 默认关闭——帧提交后缓冲即被清空。",{},"\u002Fnotes\u002F2026-11-14-2",{"description":197},"notes\u002F2026-11-14-2","i7xWqq2eNoU_seSbLQjqlB9gE51fM-PVLUEYCHBkOA4",1795303401513]