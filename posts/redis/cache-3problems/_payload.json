[{"data":1,"prerenderedAt":203},["ShallowReactive",2],{"notes-latest-1":3,"post:\u002Fposts\u002Fredis\u002Fcache-3problems":27,"surround:\u002Fposts\u002Fredis\u002Fcache-3problems":131,"notes-latest-3":138},[4],{"id":5,"title":6,"body":7,"createdAt":19,"description":13,"extension":20,"meta":21,"navigation":22,"path":23,"seo":24,"stem":25,"__hash__":26},"notes\u002Fnotes\u002F2026-11-14-1-2.md","2026 11 14 1 2",{"type":8,"value":9,"toc":14},"minimark",[10],[11,12,13],"p",{},"站点上线了「随笔」：支持一个文件多个随笔",{"title":15,"searchDepth":16,"depth":17,"links":18},"",2,3,[],"2026-11-17","md",{},true,"\u002Fnotes\u002F2026-11-14-1-2",{"description":13},"notes\u002F2026-11-14-1-2","hDP9fvaunHzVrZQ6QifuOtj9VrqbxlPb_52KE5wSjD0",{"id":28,"title":29,"author":30,"body":31,"categories":112,"comment":22,"cover":30,"createdAt":114,"description":35,"draft":115,"extension":20,"meta":116,"navigation":22,"path":121,"readingTime":122,"recommend":115,"seo":123,"series":30,"stem":124,"tags":125,"top":115,"topics":127,"updatedAt":30,"words":129,"__hash__":130},"posts\u002Fposts\u002Fredis\u002Fcache-3problems.md","缓存穿透、击穿、雪崩的应对",null,{"type":8,"value":32,"toc":104},[33,36,40,43,46,49,52,55,58,61,64,67,70,73,76,78,80,83,86,89,92,95,98,101],[11,34,35],{},"前几天有同事问到这个，我口头讲了一遍，回头想想还是写成文章更完整，也算把自己的理解再过一遍。",[37,38,39],"h2",{"id":39},"三个问题三个方向",[11,41,42],{},"这三个问题名字像绕口令，本质各不相同。穿透是查根本不存在的数据，缓存永远不命中，请求全打到库里，对策是空值缓存加短过期，入口再加布隆过滤器把恶意流量挡掉；击穿是某个热点 key 过期瞬间，大量请求同时回源，对策是互斥重建或者逻辑过期；雪崩是大批 key 同时过期或缓存整体不可用，对策是过期时间加随机抖动、多级缓存和限流兜底。",[11,44,45],{},"三者共同的底层逻辑是：缓存和数据库之间的可用性联动没有设计好。想清楚缓存挂了之后系统以什么姿态降级运行，比背对策更重要。",[37,47,48],{"id":48},"我的加固习惯",[11,50,51],{},"我的加固习惯是三件事：热点 key 的重建加单飞锁，保证同一时刻只有一个请求回源；所有缓存写入都带随机化的过期时间；核心接口配上缓存命中率的监控，命中率突降往往就是事故前兆。真出过一次雪崩的团队，之后写缓存代码都会下意识多想两秒，这学费交一次就够。",[37,53,54],{"id":54},"顺手记两个坑",[11,56,57],{},"crontab 里的脚本手动跑正常、定时跑就报错，环境变量不一致是老坑。把依赖的环境都写进脚本头部，或者干脆用绝对路径，别指望定时任务的运行环境和你的终端一样。",[11,59,60],{},"单元测试月底跑挂了，因为断言里依赖系统当前日期。注入 Clock 之后再测，时间随意控制。第一次遇到这种问题觉得很玄学，理解了之后觉得这是依赖注入最生动的教学案例。",[11,62,63],{},"grep 中文关键词死活匹配不上，最后确认是文件编码。iconv 转一道再查，两分钟的事排查了半小时，处理日志前先看编码，这个习惯值得保持。",[37,65,66],{"id":66},"一点延伸",[11,68,69],{},"Redis 的很多事故复盘下来都是“没想到会用成这样”：没想到一个 key 会涨到几百兆，没想到一个 hash 会有千万级字段。所以架构评审时对 Redis 的使用多做一句灵魂拷问：这个结构的规模上限是多少，通常能省掉未来很多夜晚。",[11,71,72],{},"用 Redis 的这些年的一个整体感受：它把复杂性从性能转移到了运维。单线程模型保证了简单和快，但内存水位、大 key、热点 key 这些问题都需要自己盯。用好它的关键不是多学几个命令，是建立起一套日常巡检的习惯。",[11,74,75],{},"缓存和数据库的一致性是个永恒话题，没有银弹，只有按业务容忍度选方案。先问自己：不一致的窗口期多大可以接受？答案决定了用失效、用双删还是用订阅 binlog 的异步更新，很多争论其实是没先对齐这个前提。",[11,77,69],{},[11,79,72],{},[37,81,82],{"id":82},"再补充几句",[11,84,85],{},"然后想说，承认不懂是这行的美德。这次遇到不懂的地方，老老实实补了两天的课，比硬着头皮往上糊的方案强太多。不懂装懂的代价从来不会消失，只是延期，还带利息。",[11,87,88],{},"平衡感很重要的一件事：投入和收益的比例。所有优化都值得先问一句，这件事的收益上限是多少，值多少投入。无限打磨一个低价值的东西是工程师最常见的温柔陷阱，包括我自己在内。",[11,90,91],{},"忍不住再夸一下记录的力量，上周刚整理的笔记，这次直接翻出来就用，十分钟解决了当时花一下午的问题。给自己留下的每一份笔记，都是寄给未来的快递，寄件人签收时才觉得真香。",[11,93,94],{},"最后聊点感受：做技术这些年，越来越觉得最好的状态是既投入又抽离。投入是把事情做好，抽离是时不时跳出来看看方向对不对，两者缺一，要么辛苦没产出，要么轻松跑偏路。",[37,96,97],{"id":97},"最后",[11,99,100],{},"最近加班多了些，更新慢了一点，周五晚上泡杯茶写下这篇，算是给自己留点节奏。",[11,102,103],{},"大概就是这些，有不同做法欢迎评论区交流。",{"title":15,"searchDepth":16,"depth":17,"links":105},[106,107,108,109,110,111],{"id":39,"depth":16,"text":39},{"id":48,"depth":16,"text":48},{"id":54,"depth":16,"text":54},{"id":66,"depth":16,"text":66},{"id":82,"depth":16,"text":82},{"id":97,"depth":16,"text":97},[113],"Redis","2023-08-22",false,{"excerpt":117},{"type":8,"value":118},[119],[11,120,35],{},"\u002Fposts\u002Fredis\u002Fcache-3problems",406200,{"title":29,"description":35},"posts\u002Fredis\u002Fcache-3problems",[113,126],"缓存",[128],"redis",1354,"tLC9UGwIyIcNVd8TwYXEOuBs76RZ9bBABp32hTos3P8",{"prev":132,"next":135},{"path":133,"title":134},"\u002Fposts\u002Fprepare\u002F消息队列","消息队列",{"path":136,"title":137},"\u002Fposts\u002Fredis\u002Fcache-3problems-2","缓存穿透、击穿、雪崩的应对（二）",[139,148,178],{"id":5,"title":6,"body":140,"createdAt":19,"description":13,"extension":20,"meta":146,"navigation":22,"path":23,"seo":147,"stem":25,"__hash__":26},{"type":8,"value":141,"toc":144},[142],[11,143,13],{},{"title":15,"searchDepth":16,"depth":17,"links":145},[],{},{"description":13},{"id":149,"title":150,"body":151,"createdAt":171,"description":172,"extension":20,"meta":173,"navigation":22,"path":174,"seo":175,"stem":176,"__hash__":177},"notes\u002Fnotes\u002F2026-11-14-1.md","2026 11 14 1",{"type":8,"value":152,"toc":169},[153],[11,154,155,156,160,161,168],{},"站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 ",[157,158,159],"strong",{},"Markdown","，写链接也不用到编辑器：",[162,163,167],"a",{"href":164,"rel":165},"https:\u002F\u002Fcontent.nuxt.com",[166],"nofollow","Nuxt Content","。",{"title":15,"searchDepth":16,"depth":17,"links":170},[],"2026-11-14","站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 Markdown，写链接也不用到编辑器：Nuxt Content。",{},"\u002Fnotes\u002F2026-11-14-1",{"description":172},"notes\u002F2026-11-14-1","LLJX_RKU7cgpT6aHw4DZWUZNQ_G_UzELWPKbksJvzfs",{"id":179,"title":180,"body":181,"createdAt":196,"description":197,"extension":20,"meta":198,"navigation":22,"path":199,"seo":200,"stem":201,"__hash__":202},"notes\u002Fnotes\u002F2026-11-14-2.md","2026 11 14 2",{"type":8,"value":182,"toc":194},[183],[11,184,185,189,190,193],{},[186,187,188],"code",{},"readPixels"," 读不到内容不是 bug，是 ",[186,191,192],{},"preserveDrawingBuffer"," 默认关闭——帧提交后缓冲即被清空。",{"title":15,"searchDepth":16,"depth":17,"links":195},[],"2026-11-13","readPixels 读不到内容不是 bug，是 preserveDrawingBuffer 默认关闭——帧提交后缓冲即被清空。",{},"\u002Fnotes\u002F2026-11-14-2",{"description":197},"notes\u002F2026-11-14-2","i7xWqq2eNoU_seSbLQjqlB9gE51fM-PVLUEYCHBkOA4",1795278779667]