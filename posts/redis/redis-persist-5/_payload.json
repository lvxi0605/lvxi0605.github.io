[{"data":1,"prerenderedAt":203},["ShallowReactive",2],{"notes-latest-1":3,"post:\u002Fposts\u002Fredis\u002Fredis-persist-5":27,"surround:\u002Fposts\u002Fredis\u002Fredis-persist-5":131,"notes-latest-3":138},[4],{"id":5,"title":6,"body":7,"createdAt":19,"description":13,"extension":20,"meta":21,"navigation":22,"path":23,"seo":24,"stem":25,"__hash__":26},"notes\u002Fnotes\u002F2026-11-14-1-2.md","2026 11 14 1 2",{"type":8,"value":9,"toc":14},"minimark",[10],[11,12,13],"p",{},"站点上线了「随笔」：支持一个文件多个随笔",{"title":15,"searchDepth":16,"depth":17,"links":18},"",2,3,[],"2026-11-17","md",{},true,"\u002Fnotes\u002F2026-11-14-1-2",{"description":13},"notes\u002F2026-11-14-1-2","hDP9fvaunHzVrZQ6QifuOtj9VrqbxlPb_52KE5wSjD0",{"id":28,"title":29,"author":30,"body":31,"categories":112,"comment":22,"cover":30,"createdAt":114,"description":35,"draft":115,"extension":20,"meta":116,"navigation":22,"path":121,"readingTime":122,"recommend":115,"seo":123,"series":30,"stem":124,"tags":125,"top":115,"topics":127,"updatedAt":30,"words":129,"__hash__":130},"posts\u002Fposts\u002Fredis\u002Fredis-persist-5.md","RDB 与 AOF 的取舍（五）",null,{"type":8,"value":32,"toc":104},[33,36,40,43,46,49,52,55,58,61,64,67,70,73,76,78,80,83,86,89,92,95,98,101],[11,34,35],{},"这周把手头的事告一段落，过程中有点小发现，正好坐下来写下来，算是给这段时间留个记号。",[37,38,39],"h2",{"id":39},"两种机制",[11,41,42],{},"RDB 是某个时刻的内存快照，fork 子进程把数据整体写成二进制文件，恢复快、文件紧凑，但两次快照之间的数据会随宕机丢失。AOF 把每条写命令追加到文件里，丢数据少，按 everysec 配置最多丢一秒，但文件大恢复慢，靠重写机制压缩体积。",[11,44,45],{},"fork 本身有成本，实例越大 fork 越慢，期间主进程复制页表会占用内存，大实例上做 RDB 的瞬间可能引发抖动，这是很多线上故障的实际源头，监控里要有体现。",[37,47,48],{"id":48},"怎么组合",[11,50,51],{},"组合策略的常见姿势：两种都开，RDB 做冷备和快速恢复，AOF 保证尽量不丢；对纯缓存场景可以都关或者只开低频 RDB，丢了就全量重建，把 Redis 定位清楚比纠结参数更重要。另外恢复演练别省，备份没验证过恢复的，等于没有备份，这句话对 Redis 对数据库都成立。",[37,53,54],{"id":54},"过程中的两个坑",[11,56,57],{},"数据迁移演练时发现字段长度截断，源库字符集和目标库不一样，同一段中文占的长度都不同。迁移脚本先在影子表跑一遍，这种事不演练，上了生产就是事故。",[11,59,60],{},"@Transactional 加在私有方法上、或者同类里自调用，事务都是不生效的，因为绕过了代理对象。这类 AOP 的坑，理解了代理机制就一目了然，没理解之前就是玄学。",[11,62,63],{},"服务注册状态看着正常，流量却没打过来。心跳超时加上保护阈值，Nacos 短暂摘除了实例。注册中心的状态和真实可用性是两回事，健康检查永远要结合业务探活来看。",[37,65,66],{"id":66},"延伸几句",[11,68,69],{},"Redis 的很多事故复盘下来都是“没想到会用成这样”：没想到一个 key 会涨到几百兆，没想到一个 hash 会有千万级字段。所以架构评审时对 Redis 的使用多做一句灵魂拷问：这个结构的规模上限是多少，通常能省掉未来很多夜晚。",[11,71,72],{},"用 Redis 的这些年的一个整体感受：它把复杂性从性能转移到了运维。单线程模型保证了简单和快，但内存水位、大 key、热点 key 这些问题都需要自己盯。用好它的关键不是多学几个命令，是建立起一套日常巡检的习惯。",[11,74,75],{},"缓存和数据库的一致性是个永恒话题，没有银弹，只有按业务容忍度选方案。先问自己：不一致的窗口期多大可以接受？答案决定了用失效、用双删还是用订阅 binlog 的异步更新，很多争论其实是没先对齐这个前提。",[11,77,69],{},[11,79,72],{},[37,81,82],{"id":82},"又想到一些",[11,84,85],{},"最后聊点感受：做技术这些年，越来越觉得最好的状态是既投入又抽离。投入是把事情做好，抽离是时不时跳出来看看方向对不对，两者缺一，要么辛苦没产出，要么轻松跑偏路。",[11,87,88],{},"写着写着想到，很多技术选择本质上都是在回答同一个问题：这个方案在出问题的时候是什么样子。不出问题的方案人人都写得出来，区分度全在故障时刻的表现。多想一层失败路径，很多纠结就自动有了答案。",[11,90,91],{},"这类经验在文档里通常只有一行字，背后的排查却是一整个下午。技术工作的大部分时间都花在这些不会写进简历的细节里，所以这些细节才更需要有人写出来，哪怕只是给未来某一天忘了的自己。",[11,93,94],{},"顺带聊聊方法论：遇到不熟悉的领域，我的习惯是先把最小闭环跑通，哪怕每一步都很粗糙。跑通之后再逐段替换成正经实现，过程中每一步都有可运行的版本。这个思路在工作和生活里都屡试不爽，比憋大招的成功率高得多。",[37,96,97],{"id":97},"写在最后",[11,99,100],{},"写完这篇下楼跑了个五公里，脑子里剩下的方案细节，居然是跑步的时候理顺的。",[11,102,103],{},"暂时记到这，下次接着说。",{"title":15,"searchDepth":16,"depth":17,"links":105},[106,107,108,109,110,111],{"id":39,"depth":16,"text":39},{"id":48,"depth":16,"text":48},{"id":54,"depth":16,"text":54},{"id":66,"depth":16,"text":66},{"id":82,"depth":16,"text":82},{"id":97,"depth":16,"text":97},[113],"Redis","2026-09-19",false,{"excerpt":117},{"type":8,"value":118},[119],[11,120,35],{},"\u002Fposts\u002Fredis\u002Fredis-persist-5",397800,{"title":29,"description":35},"posts\u002Fredis\u002Fredis-persist-5",[113,126],"持久化",[128],"redis",1326,"fXkdAHFg3oHGsnsCVlHEbQ0fvXkMbP0w9jruoudopkc",{"prev":132,"next":135},{"path":133,"title":134},"\u002Fposts\u002Fredis\u002Fredis-persist-4","RDB 与 AOF 的取舍（四）",{"path":136,"title":137},"\u002Fposts\u002Fredis\u002Fredis-persist-6","RDB 与 AOF 的取舍（六）",[139,148,178],{"id":5,"title":6,"body":140,"createdAt":19,"description":13,"extension":20,"meta":146,"navigation":22,"path":23,"seo":147,"stem":25,"__hash__":26},{"type":8,"value":141,"toc":144},[142],[11,143,13],{},{"title":15,"searchDepth":16,"depth":17,"links":145},[],{},{"description":13},{"id":149,"title":150,"body":151,"createdAt":171,"description":172,"extension":20,"meta":173,"navigation":22,"path":174,"seo":175,"stem":176,"__hash__":177},"notes\u002Fnotes\u002F2026-11-14-1.md","2026 11 14 1",{"type":8,"value":152,"toc":169},[153],[11,154,155,156,160,161,168],{},"站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 ",[157,158,159],"strong",{},"Markdown","，写链接也不用到编辑器：",[162,163,167],"a",{"href":164,"rel":165},"https:\u002F\u002Fcontent.nuxt.com",[166],"nofollow","Nuxt Content","。",{"title":15,"searchDepth":16,"depth":17,"links":170},[],"2026-11-14","站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 Markdown，写链接也不用到编辑器：Nuxt Content。",{},"\u002Fnotes\u002F2026-11-14-1",{"description":172},"notes\u002F2026-11-14-1","LLJX_RKU7cgpT6aHw4DZWUZNQ_G_UzELWPKbksJvzfs",{"id":179,"title":180,"body":181,"createdAt":196,"description":197,"extension":20,"meta":198,"navigation":22,"path":199,"seo":200,"stem":201,"__hash__":202},"notes\u002Fnotes\u002F2026-11-14-2.md","2026 11 14 2",{"type":8,"value":182,"toc":194},[183],[11,184,185,189,190,193],{},[186,187,188],"code",{},"readPixels"," 读不到内容不是 bug，是 ",[186,191,192],{},"preserveDrawingBuffer"," 默认关闭——帧提交后缓冲即被清空。",{"title":15,"searchDepth":16,"depth":17,"links":195},[],"2026-11-13","readPixels 读不到内容不是 bug，是 preserveDrawingBuffer 默认关闭——帧提交后缓冲即被清空。",{},"\u002Fnotes\u002F2026-11-14-2",{"description":197},"notes\u002F2026-11-14-2","i7xWqq2eNoU_seSbLQjqlB9gE51fM-PVLUEYCHBkOA4",1795309552572]