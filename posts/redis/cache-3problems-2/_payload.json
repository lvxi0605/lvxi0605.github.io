[{"data":1,"prerenderedAt":201},["ShallowReactive",2],{"notes-latest-1":3,"post:\u002Fposts\u002Fredis\u002Fcache-3problems-2":27,"surround:\u002Fposts\u002Fredis\u002Fcache-3problems-2":129,"notes-latest-3":136},[4],{"id":5,"title":6,"body":7,"createdAt":19,"description":13,"extension":20,"meta":21,"navigation":22,"path":23,"seo":24,"stem":25,"__hash__":26},"notes\u002Fnotes\u002F2026-11-14-1-2.md","2026 11 14 1 2",{"type":8,"value":9,"toc":14},"minimark",[10],[11,12,13],"p",{},"站点上线了「随笔」：支持一个文件多个随笔",{"title":15,"searchDepth":16,"depth":17,"links":18},"",2,3,[],"2026-11-17","md",{},true,"\u002Fnotes\u002F2026-11-14-1-2",{"description":13},"notes\u002F2026-11-14-1-2","hDP9fvaunHzVrZQ6QifuOtj9VrqbxlPb_52KE5wSjD0",{"id":28,"title":29,"author":30,"body":31,"categories":110,"comment":22,"cover":30,"createdAt":112,"description":35,"draft":113,"extension":20,"meta":114,"navigation":22,"path":119,"readingTime":120,"recommend":113,"seo":121,"series":30,"stem":122,"tags":123,"top":113,"topics":125,"updatedAt":30,"words":127,"__hash__":128},"posts\u002Fposts\u002Fredis\u002Fcache-3problems-2.md","缓存穿透、击穿、雪崩的应对（二）",null,{"type":8,"value":32,"toc":102},[33,36,40,43,46,49,52,55,58,61,64,67,70,73,76,78,81,84,87,90,93,96,99],[11,34,35],{},"这个话题其实挺老的，但每次实际用到还是会踩出点新东西，索性记一篇备查，也给后来的同学提个醒。",[37,38,39],"h2",{"id":39},"三个问题三个方向",[11,41,42],{},"这三个问题名字像绕口令，本质各不相同。穿透是查根本不存在的数据，缓存永远不命中，请求全打到库里，对策是空值缓存加短过期，入口再加布隆过滤器把恶意流量挡掉；击穿是某个热点 key 过期瞬间，大量请求同时回源，对策是互斥重建或者逻辑过期；雪崩是大批 key 同时过期或缓存整体不可用，对策是过期时间加随机抖动、多级缓存和限流兜底。",[11,44,45],{},"三者共同的底层逻辑是：缓存和数据库之间的可用性联动没有设计好。想清楚缓存挂了之后系统以什么姿态降级运行，比背对策更重要。",[37,47,48],{"id":48},"我的加固习惯",[11,50,51],{},"我的加固习惯是三件事：热点 key 的重建加单飞锁，保证同一时刻只有一个请求回源；所有缓存写入都带随机化的过期时间；核心接口配上缓存命中率的监控，命中率突降往往就是事故前兆。真出过一次雪崩的团队，之后写缓存代码都会下意识多想两秒，这学费交一次就够。",[37,53,54],{"id":54},"顺手记两个坑",[11,56,57],{},"磁盘告警，日志把盘写满了。给应用日志配上 logrotate 加上保留天数，再顺手把历史日志清了。存储这种东西，没有监控告警之前，所有人都以为它不会满。",[11,59,60],{},"线程池的队列当初图省事用了无界，高峰期任务堆积，内存一路涨。改成有界队列加上合理的拒绝策略，宁可快速失败也别让问题积累到内存里爆出来。",[11,62,63],{},"数据迁移演练时发现字段长度截断，源库字符集和目标库不一样，同一段中文占的长度都不同。迁移脚本先在影子表跑一遍，这种事不演练，上了生产就是事故。",[37,65,66],{"id":66},"一点延伸",[11,68,69],{},"缓存和数据库的一致性是个永恒话题，没有银弹，只有按业务容忍度选方案。先问自己：不一致的窗口期多大可以接受？答案决定了用失效、用双删还是用订阅 binlog 的异步更新，很多争论其实是没先对齐这个前提。",[11,71,72],{},"Redis 的很多事故复盘下来都是“没想到会用成这样”：没想到一个 key 会涨到几百兆，没想到一个 hash 会有千万级字段。所以架构评审时对 Redis 的使用多做一句灵魂拷问：这个结构的规模上限是多少，通常能省掉未来很多夜晚。",[11,74,75],{},"用 Redis 的这些年的一个整体感受：它把复杂性从性能转移到了运维。单线程模型保证了简单和快，但内存水位、大 key、热点 key 这些问题都需要自己盯。用好它的关键不是多学几个命令，是建立起一套日常巡检的习惯。",[11,77,69],{},[37,79,80],{"id":80},"再补充几句",[11,82,83],{},"忍不住再夸一下记录的力量，上周刚整理的笔记，这次直接翻出来就用，十分钟解决了当时花一下午的问题。给自己留下的每一份笔记，都是寄给未来的快递，寄件人签收时才觉得真香。",[11,85,86],{},"最后聊点感受：做技术这些年，越来越觉得最好的状态是既投入又抽离。投入是把事情做好，抽离是时不时跳出来看看方向对不对，两者缺一，要么辛苦没产出，要么轻松跑偏路。",[11,88,89],{},"写着写着想到，很多技术选择本质上都是在回答同一个问题：这个方案在出问题的时候是什么样子。不出问题的方案人人都写得出来，区分度全在故障时刻的表现。多想一层失败路径，很多纠结就自动有了答案。",[11,91,92],{},"这类经验在文档里通常只有一行字，背后的排查却是一整个下午。技术工作的大部分时间都花在这些不会写进简历的细节里，所以这些细节才更需要有人写出来，哪怕只是给未来某一天忘了的自己。",[37,94,95],{"id":95},"最后",[11,97,98],{},"写完这篇下楼跑了个五公里，脑子里剩下的方案细节，居然是跑步的时候理顺的。",[11,100,101],{},"就写到这吧，锅里还炖着东西，得去看一眼。",{"title":15,"searchDepth":16,"depth":17,"links":103},[104,105,106,107,108,109],{"id":39,"depth":16,"text":39},{"id":48,"depth":16,"text":48},{"id":54,"depth":16,"text":54},{"id":66,"depth":16,"text":66},{"id":80,"depth":16,"text":80},{"id":95,"depth":16,"text":95},[111],"Redis","2023-08-04",false,{"excerpt":115},{"type":8,"value":116},[117],[11,118,35],{},"\u002Fposts\u002Fredis\u002Fcache-3problems-2",384000,{"title":29,"description":35},"posts\u002Fredis\u002Fcache-3problems-2",[111,124],"缓存",[126],"redis",1280,"lf2Mw-VUuU887rDCMk_awIty8zuDdude_d7_ib_C4Ww",{"prev":130,"next":133},{"path":131,"title":132},"\u002Fposts\u002Fredis\u002Fcache-3problems","缓存穿透、击穿、雪崩的应对",{"path":134,"title":135},"\u002Fposts\u002Fredis\u002Fcache-3problems-3","缓存穿透、击穿、雪崩的应对（三）",[137,146,176],{"id":5,"title":6,"body":138,"createdAt":19,"description":13,"extension":20,"meta":144,"navigation":22,"path":23,"seo":145,"stem":25,"__hash__":26},{"type":8,"value":139,"toc":142},[140],[11,141,13],{},{"title":15,"searchDepth":16,"depth":17,"links":143},[],{},{"description":13},{"id":147,"title":148,"body":149,"createdAt":169,"description":170,"extension":20,"meta":171,"navigation":22,"path":172,"seo":173,"stem":174,"__hash__":175},"notes\u002Fnotes\u002F2026-11-14-1.md","2026 11 14 1",{"type":8,"value":150,"toc":167},[151],[11,152,153,154,158,159,166],{},"站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 ",[155,156,157],"strong",{},"Markdown","，写链接也不用到编辑器：",[160,161,165],"a",{"href":162,"rel":163},"https:\u002F\u002Fcontent.nuxt.com",[164],"nofollow","Nuxt Content","。",{"title":15,"searchDepth":16,"depth":17,"links":168},[],"2026-11-14","站点上线了「随笔」：随手记一句话，不必凑成一篇博客。正文支持 Markdown，写链接也不用到编辑器：Nuxt Content。",{},"\u002Fnotes\u002F2026-11-14-1",{"description":170},"notes\u002F2026-11-14-1","LLJX_RKU7cgpT6aHw4DZWUZNQ_G_UzELWPKbksJvzfs",{"id":177,"title":178,"body":179,"createdAt":194,"description":195,"extension":20,"meta":196,"navigation":22,"path":197,"seo":198,"stem":199,"__hash__":200},"notes\u002Fnotes\u002F2026-11-14-2.md","2026 11 14 2",{"type":8,"value":180,"toc":192},[181],[11,182,183,187,188,191],{},[184,185,186],"code",{},"readPixels"," 读不到内容不是 bug，是 ",[184,189,190],{},"preserveDrawingBuffer"," 默认关闭——帧提交后缓冲即被清空。",{"title":15,"searchDepth":16,"depth":17,"links":193},[],"2026-11-13","readPixels 读不到内容不是 bug，是 preserveDrawingBuffer 默认关闭——帧提交后缓冲即被清空。",{},"\u002Fnotes\u002F2026-11-14-2",{"description":195},"notes\u002F2026-11-14-2","i7xWqq2eNoU_seSbLQjqlB9gE51fM-PVLUEYCHBkOA4",1795275930449]